def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog=prog(),
        allow_abbrev=False,
        description="Fleet git tools: a thin client for the hosted simple-tools MCP git tools. "
        "Every operation runs on the hosted server as this bot's own identity; there is no direct path. "
        "clone, fetch, pull, ls-remote, bundle and archive use local git over the hosted read-only route, "
        "with no GitHub token on this machine.",
    )
    sub = p.add_subparsers(dest="cmd", required=True)
    pl = sub.add_parser(
        "list", help="list the git tools the server advertises right now", allow_abbrev=False
    )
    pl.add_argument("--json", action="store_true")
    flavour = pl.add_mutually_exclusive_group()
    flavour.add_argument("--reads", dest="flavour", action="store_const", const="reads", default="all")
    flavour.add_argument("--writes", dest="flavour", action="store_const", const="writes")
    ps = sub.add_parser("show", help="show one advertised tool's schema", allow_abbrev=False)
    ps.add_argument("tool")
    ps.add_argument("--json", action="store_true")
    pw = sub.add_parser(
        "whoami", help="show the identity the hosted server reports for this bearer", allow_abbrev=False
    )
    pw.add_argument("--json", action="store_true")
    pr = sub.add_parser("readiness", help="read-only PR report; never merge authorization", allow_abbrev=False)
    pr.add_argument("repo")
    pr.add_argument("number", type=int)
    pr.add_argument("--expected-head", help="fail closed if the current full head SHA differs")
    pc = sub.add_parser(
        "call", help="call one tool:  call NAME --args-json JSON|@FILE|-", allow_abbrev=False
    )
    pc.add_argument("tool")
    pc.add_argument(
        "--args-json",
        metavar="JSON|@FILE|-",
        help="arguments as a JSON object, @file, or - for stdin (default: {})",
    )
    pc.add_argument("--json", action="store_true", help="print structured content and text as JSON")
    pk = sub.add_parser("clone", help="clone a repo as this bot:  clone OWNER/NAME [FOLDER]", allow_abbrev=False)
    pk.add_argument("repo")
    pk.add_argument("dir", nargs="?")
    pk.add_argument("--depth", type=int)
    pk.add_argument("--branch")
    pk.add_argument("--partial", action="store_true", help="fetch file contents only when they are needed")
    pf = sub.add_parser("fetch", help="fetch into a clone as this bot", allow_abbrev=False)
    pf.add_argument("remote", nargs="?", default="origin")
    pf.add_argument("refspec", nargs="*")
    pf.add_argument("--dir", default=".", help="the clone (default: this folder)")
    pf.add_argument("--prune", action="store_true")
    pu = sub.add_parser("pull", help="fast-forward a clone as this bot", allow_abbrev=False)
    pu.add_argument("remote", nargs="?", default="origin")
    pu.add_argument("--dir", default=".", help="the clone (default: this folder)")
    pr = sub.add_parser("ls-remote", help="list a repo's refs:  ls-remote OWNER/NAME [REF]", allow_abbrev=False)
    pr.add_argument("repo")
    pr.add_argument("ref", nargs="?")
    pb = sub.add_parser("bundle", help="write a git bundle of a repo:  bundle OWNER/NAME OUTPUT", allow_abbrev=False)
    pb.add_argument("repo")
    pb.add_argument("output")
    pa = sub.add_parser(
        "archive", help="write a tar, tar.gz or zip of one ref:  archive OWNER/NAME OUTPUT", allow_abbrev=False
    )
    pa.add_argument("repo")
    pa.add_argument("output")
    pa.add_argument("--ref", default="HEAD", help="a branch or tag (default: HEAD)")
    pp = sub.add_parser(
        "publish", help="commit local files to a branch, with no inline base64", allow_abbrev=False
    )
    pp.add_argument("--repo", required=True, help="owner/name")
    pp.add_argument("--branch", required=True)
    pp.add_argument("--message", required=True)
    pp.add_argument("--base", help="create the branch from this branch first")
    pp.add_argument(
        "--file", action="append", default=[], metavar="LOCAL[=REPO_PATH]", help="repeatable;  up to 2 MiB per file"
    )
    return p


def main(argv: list[str] | None = None) -> int:
    a = build_parser().parse_args(argv)
    # One overall budget for the verb:  the identities probe, every discovery page and the target call
    # all draw from it, and a request that cannot start inside it is never sent.
    overall_deadline = time.monotonic() + OVERALL_DEADLINE_S
    args = None
    bearer = remote_bearer()
    whoami_out = None
    # Exactly one identities result before ANY discovery, display or target call:  it establishes the
    # actor (the server's own principal - an undeclared caller is never anonymous and never picks the
    # identity) and a declared seat must match it.
    declared = declared_seat()  # a broken declaration is refused before anything leaves
    whoami_out = remote_call(IDENTITIES_TOOL, {}, False, bearer, overall_deadline)
    server_seat = establish_principal(whoami_out)
    if declared is not None and declared != server_seat:
        die(
            f"the server reports this bearer as {server_seat}, not the declared {declared};  refusing",
            EXIT_AUTH,
        )
    if a.cmd == "whoami":
        return cmd_whoami(whoami_out, a)
    transfer = {
        "clone": cmd_clone,
        "fetch": cmd_fetch,
        "pull": cmd_pull,
        "ls-remote": cmd_ls_remote,
        "bundle": cmd_bundle,
        "archive": cmd_archive,
    }
    if a.cmd in transfer:
        # The identities answer above already proved this bearer;  git needs no tool discovery.
        return transfer[a.cmd](a, bearer)
    tools = discover_tools(bearer, overall_deadline)
    if a.cmd == "readiness":
        return cmd_readiness(tools, a, bearer, server_seat, overall_deadline)
    if a.cmd == "publish":
        return cmd_publish(tools, a, bearer, server_seat, overall_deadline)
    if a.cmd == "list":
        return cmd_list(tools, a)
    if a.cmd == "show":
        return cmd_show(tools, a)
    return cmd_call(tools, a, bearer, args, server_seat, overall_deadline)


if __name__ == "__main__":
    raise SystemExit(main())
