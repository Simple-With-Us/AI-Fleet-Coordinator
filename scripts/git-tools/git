def _refusal_detail_of(result: dict) -> str:
    """` (reason=<closed reason>[, github_status=<4xx>])` from a relay_refused result, else "".

    Reads the same candidates as `_error_code_of`.  `reason` must be an exact member of the closed set;
    `github_status` must be a real int in 400..499 other than 429 (a bool is not an int here).  Nothing
    else from the result is shown."""
    candidates = []
    sc = result.get("structuredContent")
    if isinstance(sc, dict):
        candidates.append(sc)
    meta = result.get("_meta")
    if isinstance(meta, dict) and isinstance(meta.get("simple-tools/error"), dict):
        candidates.append(meta["simple-tools/error"])
    for part in result.get("content") or []:
        if isinstance(part, dict) and isinstance(part.get("text"), str):
            try:
                obj = strict_loads(part["text"])
            except (ValueError, RecursionError):
                continue
            if isinstance(obj, dict):
                candidates.append(obj)
                break
    for cand in candidates:
        # The reason must come from the same object that carries the relay_refused code, never
        # from a different candidate (a sibling object could name another refusal's cause).
        if cand.get("code") != "relay_refused":
            continue
        reason = cand.get("reason")
        if isinstance(reason, str) and reason in _REFUSAL_REASONS:
            status = cand.get("github_status")
            if type(status) is int and 400 <= status <= 499 and status != 429:
                return f" (reason={reason}, github_status={status})"
            return f" (reason={reason})"
    return ""


# ----------------------------------------------------------------- answer parsing (mirrors board)


def _depth_ok(text: str) -> bool:
    depth = 0
    in_string = escaped = False
    for ch in text:
        if in_string:
            if escaped:
                escaped = False
            elif ch == "\\":
                escaped = True
            elif ch == '"':
                in_string = False
        elif ch == '"':
            in_string = True
        elif ch in "[{":
            depth += 1
            if depth > REMOTE_MAX_DEPTH:
                return False
        elif ch in "]}":
            depth -= 1
    return True


def _nodes_ok(value) -> bool:
    stack, count = [value], 0
    while stack:
        item = stack.pop()
        count += 1
        if count > REMOTE_MAX_NODES:
            return False
        if isinstance(item, dict):
            stack.extend(item.values())
        elif isinstance(item, list):
            stack.extend(item)
    return True


def _events(ctype: str, raw: bytes) -> list[str]:
    """The JSON texts of one answer:  the body itself, or each Server-Sent Event (its `data:` lines joined by a
    newline, as the SSE format defines, comments and other fields ignored)."""
    text = raw.decode("utf-8", "replace")
    if "text/event-stream" not in ctype.lower():
        return [text]
    events, current = [], []
    for line in text.replace("\r\n", "\n").replace("\r", "\n").split("\n"):
        if line == "":
            if current:
                events.append("\n".join(current))
                current = []
        elif line.startswith("data:"):
            value = line[5:]
            current.append(value[1:] if value.startswith(" ") else value)
    if current:
        events.append("\n".join(current))
    return events


def _rpc_result(ctype: str, raw: bytes, write: bool):
    """The result object of one JSON-RPC answer, or (None, message).  Only an allow-listed code leaves this
    function on the error path:  the server's own message text is untrusted and can echo the caller's input,
    so it is never copied into an error."""
    unknown = _REMOTE_UNKNOWN if write else ""
    msg = None
    for text in _events(ctype, raw):
        if not _depth_ok(text):
            return None, "the hosted endpoint sent an answer that nests too deeply" + unknown
        try:
            candidate = strict_loads(text)
        except (ValueError, RecursionError):
            continue
        if (
            isinstance(candidate, dict)
            and candidate.get("jsonrpc") == "2.0"
            and type(candidate.get("id")) is int
            and candidate["id"] == 1
            and ("result" in candidate) != ("error" in candidate)
        ):
            msg = candidate
            break
    if msg is None:
        return None, "the hosted endpoint sent no readable answer to the call" + unknown
    if not _nodes_ok(msg):
        return None, "the hosted endpoint sent an oversized answer" + unknown
    if "error" in msg:
        err = msg["error"]
        code = err.get("code") if isinstance(err, dict) else None
        shown = code if isinstance(code, str) and code in _REMOTE_CODES else "error"
        return None, "the hosted endpoint refused the call" + (
            "" if shown == "error" else f" ({shown})"
        )
    result = msg.get("result")
    if not isinstance(result, dict):
        return None, "the hosted endpoint sent no result" + unknown
    return result, ""


def _failure(exc: "_TransportError", write: bool) -> str:
    if exc.reason == "truncated response":
        return (
            "the hosted endpoint closed the answer before its declared length"
            + (_REMOTE_UNKNOWN if write and exc.sent else "")
            + " (no direct fallback)"
        )
    if not exc.sent:
        # Provably never left this host (DNS, refused connection, certificate
        # check):  the endpoint really could not be reached.
        return "the hosted endpoint could not be reached (no direct fallback)"
    # The request may have been sent:  `sent` is only False for failures that provably never
    # left, so a timeout wrapped in URLError (a connect timeout cannot be told from a send
    # timeout, and a write must be treated as possibly sent) lands here too.  So this does not
    # assert that the endpoint was reachable, only that no answer arrived (deadline, closed SSL
    # socket, transport error).  Saying "could not be reached" for the common case sent seats
    # chasing a phantom outage and falling back to gh (AFC-638).
    return (
        "the hosted endpoint's answer was lost or never arrived"
        + (_REMOTE_UNKNOWN if write else "")
        + " (no direct fallback)"
    )


def _status_message(status: int, write: bool) -> str:
    if status in (401, 403):
        return "the hosted endpoint refused this bearer (not valid, expired, paused or not accepted for MCP)"
    return f"the hosted endpoint answered HTTP {status}" + (
        _REMOTE_UNKNOWN if write and (status >= 500 or status == 408) else ""
    )


# ----------------------------------------------------------------- secret scanning (remote mode has no unscanned route)

_SCANNER = None


def _scanner():
    """The fleet's secret scanner (scripts/simple_tools/secretscan.py, standard library only), loaded by path.
    If it cannot be loaded nothing is sent:  there is no unscanned route."""
    global _SCANNER
    if _SCANNER is not None:
        return _SCANNER
    path = Path(os.path.realpath(__file__)).parent.parent / "simple_tools" / "secretscan.py"
    try:
        spec = importlib.util.spec_from_file_location("_git_secretscan", str(path))
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
    except (OSError, ImportError, AttributeError, SyntaxError):
        die(
            "the secret scanner is not available, so nothing was sent (there is no unscanned route)",
            EXIT_ERROR,
        )
    _SCANNER = module
    return module


def _scan_arguments(arguments, bearer: str, tool: str | None = None) -> str | None:
    """The first argument field the fleet secret scanner flags, as `secret_scan:<field>` (the field name only,
    never the text or any part of it), or None.  Every string at any depth is checked, and the bearer itself
    always matches."""
    scanner = _scanner()
    files = {}
    if isinstance(arguments, dict) and tool in {"gr_wf_file_put", "gr_wf_files_put"}:
        repo = arguments.get("repo")
        rows = [arguments] if tool == "gr_wf_file_put" else arguments.get("files", [])
        if isinstance(repo, str) and isinstance(rows, list):
            for i, row in enumerate(rows):
                if isinstance(row, dict) and isinstance(row.get("path"), str):
                    field = "content_b64" if tool == "gr_wf_file_put" else f"files[{i}].content_b64"
                    files[field] = (repo, row["path"])
    stack = [("", arguments)]
    while stack:
        path, value = stack.pop()
        if isinstance(value, str):
            if path.endswith("content_b64"):
                # Base64 of ordinary bytes looks like a token, and it hides a real one, so the decoded text is what is
                # scanned.  Anything that does not decode is scanned as it came.
                try:
                    value = base64.b64decode(value, validate=True).decode("utf-8", "replace")
                except (binascii.Error, ValueError):
                    pass
            known = [bearer] if bearer else []
            if path in files and callable(getattr(scanner, "scan_file", None)):
                hit = scanner.scan_file(*files[path], value, known)
            else:
                hit = scanner.scan(value, known=known)
            if hit is not None:
                return "secret_scan:" + (path or "arguments")
        elif isinstance(value, dict):
            stack.extend((f"{path}.{k}" if path else str(k), v) for k, v in value.items())
        elif isinstance(value, (list, tuple)):
            stack.extend((f"{path}[{i}]", v) for i, v in enumerate(value))
    return None


# ----------------------------------------------------------------- the one remote round trip


def _rpc(bearer: str, method: str, params: dict, write: bool, deadline: float | None = None):
    """One JSON-RPC POST to the fixed endpoint.  Returns the result object.  Never retried.
    `deadline` is the verb's overall budget:  a call whose budget is already gone is never started (a
    write refused that way is definitely NOT sent), and a call that does start gets only the remaining
    budget."""
    body = json.dumps(
        {"jsonrpc": "2.0", "id": 1, "method": method, "params": params}
    ).encode()
    timeout = REMOTE_TIMEOUT_S
    if deadline is not None:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            # Nothing left for this request, so it never leaves:  for a write that is a certainty,
            # not the in-flight uncertainty wording.
            die(
                "the overall time budget was exhausted before this call"
                + ("; the write was not sent" if write else ""),
                EXIT_ERROR,
            )
        timeout = min(REMOTE_TIMEOUT_S, remaining)
    try:
        status, ctype, raw = _remote_post(
            REMOTE_MCP_URL,
            {
                "Content-Type": "application/json",
                "Accept": "application/json, text/event-stream",
                "MCP-Protocol-Version": REMOTE_PROTOCOL_VERSION,
                "Authorization": "Bearer " + bearer,
                "User-Agent": USER_AGENT,
            },
            body,
            timeout,
        )
    except _TransportError as exc:
        die(_failure(exc, write), EXIT_ERROR)
    if status in (401, 403):
        die(_status_message(status, write), EXIT_AUTH)
    if status != 200:
        die(_status_message(status, write), EXIT_ERROR)
    result, problem = _rpc_result(ctype, raw, write)
    if problem:
        die(problem, EXIT_ERROR)
    return result


def remote_call(tool: str, arguments: dict, write: bool, bearer: str, deadline: float | None = None) -> dict:
    """One tools/call.  Returns {"structured":..., "text":...}.  Never retried."""
    hit = _scan_arguments(arguments, bearer, tool)
    if hit:
        die(f"refused before sending: {hit}", EXIT_USAGE)
    result = _rpc(
        bearer, "tools/call", {"name": tool, "arguments": arguments}, write, deadline
    )
    content = result.get("content")
    sc = result.get("structuredContent")
    if (
        (content is not None and not isinstance(content, list))
        or any(
            not isinstance(p, dict) or ("text" in p and not isinstance(p["text"], str))
            for p in content or []
        )
        or (sc is not None and not isinstance(sc, dict))
        or not isinstance(result.get("isError", False), bool)
    ):
        die(
            "the hosted endpoint sent a result in an unexpected shape"
            + (_REMOTE_UNKNOWN if write else ""),
            EXIT_ERROR,
        )
    if result.get("isError"):
        code = _error_code_of(result)
        shown = code if code is not None else "error"
        note = _REMOTE_UNKNOWN if write and code == "outcome_unknown" else ""
        detail = _refusal_detail_of(result) if code == "relay_refused" else ""
        # retry-after is the only other field ever shown, and only bounded.
        retry = None
        meta = result.get("_meta")
        for source in (sc if isinstance(sc, dict) else {}, meta.get("simple-tools/error") if isinstance(meta, dict) and isinstance(meta.get("simple-tools/error"), dict) else {}):
            value = source.get("retry_after_s", source.get("retry_after"))
            if isinstance(value, (int, float)) and not isinstance(value, bool) and 0 <= value <= 86400:
                retry = value
                break
        after = f", retry after {int(-(-retry // 1))}s" if retry is not None else ""
        die(f"{tool} failed on the hosted server: {shown}{detail}{after}{note}", EXIT_ERROR)
    parts = [
        c.get("text")
        for c in content or []
        if isinstance(c, dict) and c.get("type") == "text"
    ]
    return {
        "structured": sc if isinstance(sc, dict) else {},
        "text": "\n".join(t for t in parts if isinstance(t, str)),
    }


# ----------------------------------------------------------------- runtime discovery (the only tool authority)


def discover_tools(bearer: str, deadline: float | None = None) -> dict:
    """The git tools THIS caller's endpoint serves right now, via bounded tools/list pages:  at most
    DISCOVERY_MAX_PAGES pages, DISCOVERY_MAX_TOOLS tools, each cursor a fresh bounded string (a repeat is a
    loop and refuses), every advertised tool shape-validated.  Read/write is NOT taken from the answer:  the
    pinned reviewed read set decides, and an unknown action is a write."""
    tools: dict = {}
    cursor = None
    seen_cursors = set()
    for _ in range(DISCOVERY_MAX_PAGES):
        params = {"cursor": cursor} if cursor is not None else {}
        result = _rpc(bearer, "tools/list", params, False, deadline)
        page = result.get("tools")
        if not isinstance(page, list):
            die("the hosted endpoint answered tools/list without a tools array")
        for entry in page:
            if len(tools) >= DISCOVERY_MAX_TOOLS:
                die("the hosted endpoint advertised too many tools")
            if (
                not isinstance(entry, dict)
                or not isinstance(entry.get("name"), str)
                or TOOL_NAME_RE.fullmatch(entry["name"]) is None
            ):
                continue  # not a git tool;  other families exist on the same endpoint
            name = entry["name"]
            if name in tools:
                die("the hosted endpoint advertised the same tool twice")
            schema = entry.get("inputSchema")
            if not _schema_ok(schema):
                die(f"the hosted endpoint advertised {name} with a missing or unreadable schema")
            # tools/list is untrusted operational data:  descriptions are display text through _visible,
            # never instructions, and bounded before storing.
            description = entry.get("description")
            title = entry.get("title")
            if (
                isinstance(description, str) and len(description) > 4096
                or isinstance(title, str) and len(title) > 512
            ):
                die(f"the hosted endpoint advertised {name} with an oversized description")
            tools[name] = {
                "name": name,
                "title": title if isinstance(title, str) else "",
                "description": description if isinstance(description, str) else "",
                "read": name in READ_TOOLS,
                "input_bytes": INPUT_LIMITS.get(name, DEFAULT_INPUT_LIMIT),
                "schema": schema,
            }
        nxt = result.get("nextCursor")
        if nxt is None:  # absent or JSON null:  the only normal end of the list
            break
        if (
            not isinstance(nxt, str)
            or not nxt  # an empty cursor is malformed, never a terminator
            or len(nxt) > DISCOVERY_MAX_CURSOR
            or nxt in seen_cursors
            or nxt == cursor
        ):
            die("the hosted endpoint sent a malformed or repeating tools/list cursor")
        seen_cursors.add(nxt)
        cursor = nxt
    else:
        die(f"the hosted endpoint kept paging past {DISCOVERY_MAX_PAGES} pages")
    if not tools:
        die("the hosted endpoint advertises no git tools to this bearer")
    return tools


