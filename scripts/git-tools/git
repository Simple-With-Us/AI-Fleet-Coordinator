def _pattern_known(pattern: str) -> bool:
    return hashlib.sha256(pattern.encode("utf-8")).hexdigest() in _KNOWN_PATTERN_DIGESTS


def _as_limit_target(resource) -> tuple:
    """The (soft, hard) RLIMIT_AS values to set:  the 1 GiB cap clamped DOWN to the platform's actual
    hard limit, which is never raised (an unprivileged fixed value can exceed it - macOS rejects that
    outright with ValueError).  Pure computation, unit-testable;  supplementary defense-in-depth only -
    the real allocation bound is the exact 18-pattern contract:  nothing unrecognized is ever compiled,
    on any OS."""
    _soft, hard = resource.getrlimit(resource.RLIMIT_AS)
    cap = 1 << 30
    target = cap if hard == resource.RLIM_INFINITY else min(cap, hard)
    return target, hard


def _patterns_match(checks, end: float):
    """Run every (pattern, value) search - and the pattern COMPILES - in one isolated child process with
    a hard bound.  Untrusted tools/list patterns can backtrack catastrophically on CPU that no RPC or
    socket deadline can interrupt, so the bound is a child this process may KILL (the child only;  this
    process never sends itself signals).  `end` is ONE absolute monotonic deadline shared by all
    pattern work in this validation, capped by the verb's overall budget.  The child also gets POSIX
    rlimits (CPU seconds;  address space clamped to the platform's own hard limit) where the platform
    supports them, and when that required safety is unavailable there is no run at all.  Only the exact
    reviewed pattern set (_KNOWN_PATTERN_DIGESTS) ever reaches the child, so compile and search sizes
    are verified facts on every platform.  Returns True/False for a definite verdict, or None when the
    bound expired, the pattern is unrecognized, or the child died without a verdict:  an unverifiable
    pattern is refused, never trusted."""
    if not checks:
        return True
    # The exact contract, checked before forking:  an unrecognized pattern is never compiled anywhere.
    if not all(_pattern_known(pattern) for pattern, _v in checks):
        return None
    if not hasattr(os, "fork"):  # non-POSIX:  no enforceable bound exists;  refuse rather than risk it
        return None
    try:
        import resource  # POSIX rlimits:  the child's CPU/address-space bounds
    except ImportError:
        return None  # required safety unavailable:  fail closed
    if time.monotonic() >= end:
        return None
    try:
        read_fd, write_fd = os.pipe()
    except OSError:
        return None
    try:
        pid = os.fork()
    except OSError:
        os.close(read_fd)
        os.close(write_fd)
        return None
    if pid == 0:  # child:  limits first, then re work, then a one-byte verdict;  never returns
        try:
            os.close(read_fd)
            try:
                cpu = max(1, int(end - time.monotonic()) + 1)
                resource.setrlimit(resource.RLIMIT_CPU, (cpu, cpu))
            except (OSError, ValueError):
                os._exit(3)  # the CPU bound is required safety:  no verdict without it
            try:
                # Supplementary:  clamp the address-space cap DOWN to the platform's actual hard limit
                # (an unprivileged fixed value can exceed it - macOS raises ValueError).  Never raises
                # the hard limit;  failure is tolerated because only the exact reviewed pattern set is accepted
                # (Darwin may not enforce RLIMIT_AS).
                target, hard = _as_limit_target(resource)
                if target > 0:
                    resource.setrlimit(resource.RLIMIT_AS, (target, hard))
            except (AttributeError, OSError, ValueError):
                pass
            verdict = False
            try:
                if not all(_pattern_known(pattern) for pattern, _v in checks):
                    os._exit(4)  # unrecognized pattern:  no verdict, refused upstream
                verdict = all(
                    re.search(re.compile(pattern), value) for pattern, value in checks
                )
            except (re.error, ValueError, MemoryError, RecursionError):
                verdict = False
            try:
                os.write(write_fd, b"1" if verdict else b"0")
            except OSError:
                pass
        finally:
            os._exit(0)
    os.close(write_fd)
    try:
        while True:
            done, _status = os.waitpid(pid, os.WNOHANG)
            if done == pid:
                try:
                    data = os.read(read_fd, 1)
                except OSError:
                    data = b""
                if not data:
                    return None  # exited without a verdict (e.g. limits unavailable):  unverifiable
                return data == b"1"
            if time.monotonic() >= end:
                try:
                    os.kill(pid, signal.SIGKILL)  # the isolated child, never this process
                except OSError:
                    pass
                try:
                    os.waitpid(pid, 0)
                except OSError:
                    pass
                return None
            time.sleep(0.005)
    except BaseException:
        # This process is going down:  kill and reap OUR child rather than leave it burning CPU.
        try:
            os.kill(pid, signal.SIGKILL)
        except Exception:
            pass
        try:
            os.waitpid(pid, 0)
        except Exception:
            pass
        raise
    finally:
        os.close(read_fd)


def _is_number(value) -> bool:
    return isinstance(value, (int, float)) and not isinstance(value, bool)


def _is_nonneg_int(value) -> bool:
    return isinstance(value, int) and not isinstance(value, bool) and value >= 0


def _schema_constraints_ok(schema, depth: int = 0) -> bool:
    """Every constraint this client interprets has the type the check relies on, recursively:  required
    lists, properties maps, anyOf variants, items, numeric bounds, length/item bounds, pattern (must
    compile) and enum.  tools/list is untrusted:  a malformed leaf makes the whole advertised schema
    unreadable (a clean refusal at discovery), never a TypeError traceback during validation."""
    if not isinstance(schema, dict) or depth > 8:
        return False
    if schema.get("type") is not None and not isinstance(schema["type"], str):
        return False
    required = schema.get("required")
    if required is not None and (
        not isinstance(required, list) or not all(isinstance(x, str) for x in required)
    ):
        return False
    if not all(_is_number(schema[k]) for k in ("minimum", "maximum") if k in schema):
        return False
    if not all(
        _is_nonneg_int(schema[k])
        for k in ("minLength", "maxLength", "minItems", "maxItems")
        if k in schema
    ):
        return False
    # A pattern is never compiled or searched in this process:  both happen only inside the isolated,
    # deadline-bounded child in _patterns_match (compile cost included).  Here it must be a string from
    # the exact reviewed set - anything unrecognized fails closed (the child re-checks by digest).
    pattern = schema.get("pattern")
    if pattern is not None and (
        not isinstance(pattern, str) or not _pattern_known(pattern)
    ):
        return False
    enum = schema.get("enum")
    if enum is not None and not isinstance(enum, list):
        return False
    items = schema.get("items")
    if items is not None and not _schema_constraints_ok(items, depth + 1):
        return False
    props = schema.get("properties")
    if props is not None and (
        not isinstance(props, dict)
        or len(props) > 200
        or not all(isinstance(k, str) for k in props)
        or not all(_schema_constraints_ok(v, depth + 1) for v in props.values())
    ):
        return False
    any_of = schema.get("anyOf")
    if any_of is not None and (
        not isinstance(any_of, list)
        or not all(_schema_constraints_ok(v, depth + 1) for v in any_of)
    ):
        return False
    return True


def _schema_ok(schema) -> bool:
    """A discovered input schema is usable:  an object schema whose required/properties are ordinary and
    whose leaf constraints are well-typed all the way down."""
    if not isinstance(schema, dict) or not _nodes_ok(schema):
        return False
    if schema.get("type") not in (None, "object"):
        return False
    return _schema_constraints_ok(schema)


# ----------------------------------------------------------------- client-side argument validation (the server remains the enforcement boundary)


def _bounded(value, max_bytes: int) -> bool:
    """The Worker's structural input guard (gr-workflow-v1.js boundedWorkflowInput):  depth, node, key, string
    and total-byte limits, evaluated before any schema read."""
    stack = [(value, 0)]
    nodes = 0
    total = 0
    while stack:
        item, depth = stack.pop()
        nodes += 1
        if nodes > 500 or depth > 6:
            return False
        if isinstance(item, str):
            if len(item) > max_bytes:
                return False
            total += len(item.encode("utf-8", "replace"))
        elif isinstance(item, dict):
            if len(item) > 100:
                return False
            for k, v in item.items():
                if not isinstance(k, str):
                    return False
                stack.append((k, depth + 1))
                stack.append((v, depth + 1))
        elif isinstance(item, list):
            stack.extend((v, depth + 1) for v in item)
    return total <= max_bytes


def _type_ok(schema: dict, value, pattern_checks=None) -> bool:
    """The Worker's typeOk:  one JSON-schema leaf check (type, pattern, enum, lengths, numeric bounds,
    items).  `pattern` is NOT searched here:  with a collector, the (pattern, value) pair is deferred
    to the isolated deadline-bounded child (_patterns_match) and this leaf is tentatively True."""
    kind = schema.get("type")
    if kind == "integer":
        if isinstance(value, bool) or not isinstance(value, int):
            return False
        # Discovery already refused a malformed bound;  guard anyway, so a bad leaf is a clean False
        # and never a TypeError.
        lo, hi = schema.get("minimum"), schema.get("maximum")
        if lo is not None and (not _is_number(lo) or value < lo):
            return False
        if hi is not None and (not _is_number(hi) or value > hi):
            return False
        return True
    if kind == "boolean":
        return isinstance(value, bool)
    if kind == "array":
        if not isinstance(value, list):
            return False
        lo, hi = schema.get("minItems"), schema.get("maxItems")
        if lo is not None and (not _is_nonneg_int(lo) or len(value) < lo):
            return False
        if hi is not None and (not _is_nonneg_int(hi) or len(value) > hi):
            return False
        items = schema.get("items")
        if isinstance(items, dict):
            return all(
                _object_ok(items, v, pattern_checks=pattern_checks)
                if items.get("type") == "object"
                else _type_ok(items, v, pattern_checks)
                for v in value
            )
        return True
    if kind == "object":
        return _object_ok(schema, value, pattern_checks=pattern_checks)
    if kind == "string" or kind is None:
        if not isinstance(value, str):
            return False
        pattern = schema.get("pattern")
        if pattern is not None:
            if not isinstance(pattern, str):
                return False
            if pattern_checks is None:  # direct caller without the sandbox:  match inline
                try:
                    if not re.search(pattern, value):
                        return False
                except re.error:
                    return False
            else:
                pattern_checks.append((pattern, value))
        enum = schema.get("enum")
        if enum is not None and (not isinstance(enum, list) or value not in enum):
            return False
        lo, hi = schema.get("minLength"), schema.get("maxLength")
        if lo is not None and (not _is_nonneg_int(lo) or len(value) < lo):
            return False
        if hi is not None and (not _is_nonneg_int(hi) or len(value) > hi):
            return False
        return True
    return True  # unknown type keyword:  leave it to the server


def _object_ok(schema: dict, value, tolerate_identity: bool = False, pattern_checks=None) -> bool:
    """validWfV1Args2:  every required key present, every present key known, each value type-ok.
    tolerate_identity lets a write's `identity` be absent here because this client fills it itself."""
    if not isinstance(value, dict):
        return False
    props = schema.get("properties") or {}
    for key in schema.get("required") or ():
        if key not in value and not (tolerate_identity and key == "identity"):
            return False
    for key, item in value.items():
        if key not in props:
            return False
        if isinstance(props[key], dict) and not _type_ok(props[key], item, pattern_checks):
            return False
    return True


def validate_arguments(entry: dict, args, deadline: float | None = None) -> None:
    """Early failure only:  mirrors the Worker's boundary checks (bounded input, exact keys, leaf types,
    anyOf variants, per-action byte limit) against the DISCOVERED schema.  The server enforces its own copy
    plus the per-action refinements (file content budget, read-expansion rules) this client does not
    duplicate. Discovery restricts patterns to the exact reviewed set; compile and search run in a
    child with a wall-clock deadline. The overall deadline is checked before validation starts."""
    name = entry["name"]
    schema = entry.get("schema") or {}
    if not isinstance(args, dict):
        die(f"{name}: arguments must be a JSON object", EXIT_USAGE)
    tolerate = not entry["read"]

    # ONE absolute end for ALL pattern work in this validation - every variant, every fork:  the
    # dedicated cap and the verb's overall deadline, whichever ends first.
    pattern_end = time.monotonic() + _PATTERN_CHECK_MAX_S
    if deadline is not None:
        pattern_end = min(pattern_end, deadline)

    def check_patterns(checks):
        """True/False a definite verdict;  dies on an unverifiable one (bound expired or no sandbox)."""
        verdict = _patterns_match(checks, pattern_end)
        if verdict is None:
            die(
                f"{name}: argument pattern checks did not complete within the time budget"
                + ("; the write was not sent" if tolerate else ""),
                EXIT_ERROR,
            )
        return verdict

    if deadline is not None and time.monotonic() > deadline:
        # Nothing validated, nothing sent:  a write refused here is definitely not sent.
        die(
            "the overall time budget was exhausted before argument validation"
            + ("; the write was not sent" if tolerate else ""),
            EXIT_ERROR,
        )
    limit = entry.get("input_bytes") or DEFAULT_INPUT_LIMIT
    if not _bounded(args, limit):
        die(f"{name}: arguments exceed the structural input limits", EXIT_USAGE)
    if len(json.dumps(args, separators=(",", ":"), ensure_ascii=False).encode()) > limit:
        die(f"{name}: arguments exceed the {limit}-byte input limit", EXIT_USAGE)
    any_of = schema.get("anyOf")
    variants = [v for v in any_of if isinstance(v, dict)] if isinstance(any_of, list) else []
    if not variants:
        checks = []
        if not _object_ok(schema, args, tolerate_identity=tolerate, pattern_checks=checks):
            die(
                f"{name}: arguments do not match its schema (`{prog()} show {name}` prints it)",
                EXIT_USAGE,
            )
        if not check_patterns(checks):
            die(
                f"{name}: arguments do not match its schema (`{prog()} show {name}` prints it)",
                EXIT_USAGE,
            )
        return
    # Intersection semantics:  the root constraints AND at least one variant.  A key declared by BOTH
    # keeps the ROOT schema in the merged map (so its constraints always apply) and is ALSO checked
    # against the variant's schema - overlapping constraints intersect, they never replace.  A key only
    # the variant declares is checked by the variant's schema and is unknown to every other variant;
    # required keys are the root's union the variant's.  Nothing is weakened globally:  a key no root
    # and no variant declares still fails every variant's unknown-key check.
    root = dict(schema)
    root.pop("anyOf", None)
    root_props = root.get("properties") or {}
    root_required = set(root.get("required") or ())
    for variant in variants:
        merged = dict(root)
        merged["required"] = sorted(root_required | set(variant.get("required") or ()))
        props = dict(root_props)
        overlap = []
        variant_props = variant.get("properties")
        if isinstance(variant_props, dict):
            for key, subschema in variant_props.items():
                if key in root_props:
                    overlap.append((key, subschema))
                else:
                    props[key] = subschema
        merged["properties"] = props
        vchecks = []  # initialized for EVERY variant, properties or not
        if _object_ok(
            merged, args, tolerate_identity=tolerate, pattern_checks=vchecks
        ) and all(
            not isinstance(subschema, dict)
            or key not in args
            or _type_ok(subschema, args[key], vchecks)
            for key, subschema in overlap
        ):
            if check_patterns(vchecks):
                return
    die(
        f"{name}: arguments do not match any supported variant (`{prog()} show {name}` prints the schema)",
        EXIT_USAGE,
    )


# ----------------------------------------------------------------- actor resolution (reads AND writes, mismatch refused before the target call)


def establish_principal(out: dict) -> str:
    """The server principal from ONE identities result, strictly:  authenticated_seat and default_identity
    must AGREE when both are usable (a contradiction is refused, never preferred over), at least one must be
    usable, and the server's own advertised identities must include the reported seat when it advertises
    any.  No target call has happened at this point:  no uncertainty wording."""
    sc = out["structured"]
    usable = []
    for key in ("authenticated_seat", "default_identity"):
        value = sc.get(key)
        if value is None:
            continue  # absent or explicit null:  the legacy fallback to the other field
        if not isinstance(value, str) or SEAT_PATTERN.fullmatch(value) is None:
            # Present and non-null but malformed:  refuse rather than silently ignore it.
            die("the hosted server reported a malformed seat field", EXIT_AUTH)
        usable.append(value)
    if not usable:
        die("the hosted server did not report a usable seat for this bearer", EXIT_AUTH)
    if len(set(usable)) > 1:
        die("the hosted server reported contradictory seats for this bearer", EXIT_AUTH)
    seat = usable[0]
    advertised = sc.get("identities")
    if not isinstance(advertised, list) or not advertised or not all(
        isinstance(entry, dict)
        and isinstance(entry.get("identity"), str)
        and SEAT_PATTERN.fullmatch(entry["identity"])
        for entry in advertised
    ):
        die("the hosted server advertised no usable identities", EXIT_AUTH)
    if seat not in [entry["identity"] for entry in advertised]:
        die("the hosted server's advertised identities do not include its reported seat", EXIT_AUTH)
    return seat


def authenticated_seat(bearer: str, deadline: float | None = None) -> str:
    """The seat the server reports for this bearer, via the hosted identities tool."""
    return establish_principal(remote_call(IDENTITIES_TOOL, {}, False, bearer, deadline))


def resolve_actor(
    entry: dict,
    args: dict,
    bearer: str,
    server_seat: str | None = None,
    deadline: float | None = None,
) -> dict:
    """The actor for a read OR a write.  A declared seat and an explicit identity must agree with each other
    and with the seat the server reports for this bearer;  any mismatch is refused BEFORE the target call -
    whether or not the tool takes an `identity` argument (the assertion is never skipped).
    When the tool takes `identity` the resolved seat is injected;  there is no passthrough.  `server_seat`
    threads the probe main() already made so a call probes at most once."""
    schema = entry.get("schema") or {}
    takes_identity = "identity" in (schema.get("properties") or {})
    declared = declared_seat()
    given = args.get("identity")
    if given is not None and (not isinstance(given, str) or SEAT_PATTERN.fullmatch(given) is None):
        die("identity must be a seat name (uppercase, e.g. CODEX)", EXIT_USAGE)
    if declared is not None and given is not None and given != declared:
        die(
            f"identity {given} does not match the declared seat {declared};  this client never acts as "
            "another seat",
            EXIT_USAGE,
        )
    wanted = given or declared
    if wanted is None and not takes_identity:
        return args  # nothing declared, nothing to inject:  no probe is owed
    seat = server_seat or authenticated_seat(bearer, deadline)
    if wanted is not None and seat != wanted:
        die(
            f"the server reports this bearer as {seat}, not {wanted};  refusing before the call",
            EXIT_AUTH,
        )
    if not takes_identity:
        return args
    return {**args, "identity": seat}


# ----------------------------------------------------------------- verbs


def _print_result(out: dict, as_json: bool) -> int:
    if as_json:
        print(json.dumps({"structured": out["structured"], "text": out["text"]}, indent=2))
    elif out["text"]:
        print(_visible(out["text"]))
    else:
        print(json.dumps(out["structured"], indent=2))
    return 0


def cmd_list(tools: dict, a) -> int:
    rows = [t for t in tools.values() if a.flavour == "all" or (t["read"] == (a.flavour == "reads"))]
    if a.json:
        print(
            json.dumps(
                [
                    {
                        "name": t["name"],
                        "read": t["read"],
                        "description": t["description"],
                    }
                    for t in rows
                ],
                indent=2,
            )
        )
    else:
        for t in rows:
            print(f"{'read' if t['read'] else 'write'}  {t['name']}")
        print(
            f"{len(rows)} tools.  `{prog()} show NAME` prints one schema;  "
            f"the hosted server may still refuse a listed tool (listing is not execution proof).",
            file=sys.stderr,
        )
    return 0


def cmd_show(tools: dict, a) -> int:
    entry = tools.get(a.tool)
    if entry is None:
        die(f"unknown tool {a.tool!r};  `{prog()} list` lists what the server advertises", EXIT_USAGE)
    if a.json:
        print(json.dumps(entry, indent=2))
    else:
        print(f"{entry['name']}  ({'read' if entry['read'] else 'write'})")
        if entry.get("title"):
            print(_visible(entry["title"]))
        if entry.get("description"):
            print(_visible(entry["description"]))
        print(json.dumps(entry["schema"], indent=2))
    return 0


def _read_args_json(a) -> dict:
    raw = a.args_json
    try:
        if raw is None:
            return {}
        if raw == "-":
            raw = sys.stdin.read(ARGS_MAX_BYTES + 1)
            if len(raw) > ARGS_MAX_BYTES:
                die(f"--args-json exceeds {ARGS_MAX_BYTES} bytes", EXIT_USAGE)
        elif raw.startswith("@"):
            path = raw[1:]
            try:
                with open(path, "r") as handle:
                    raw = handle.read(ARGS_MAX_BYTES + 1)
            except OSError:
                die(f"cannot read {path!r}", EXIT_USAGE)
            if len(raw) > ARGS_MAX_BYTES:
                # The path only:  raw now holds file CONTENTS and an error must never echo any of it.
                die(f"--args-json @{path!r} exceeds {ARGS_MAX_BYTES} bytes", EXIT_USAGE)
    except UnicodeDecodeError:
        die("--args-json is not valid UTF-8", EXIT_USAGE)
    if len(raw.encode("utf-8", "replace")) > ARGS_MAX_BYTES:
        die(f"--args-json exceeds {ARGS_MAX_BYTES} bytes", EXIT_USAGE)
    if not _depth_ok(raw):
        die("--args-json nests too deeply", EXIT_USAGE)
    try:
        args = strict_loads(raw)
    except (ValueError, RecursionError):
        # Generic only:  the parser's own message can echo the caller's duplicate key or value.
        die("--args-json is not valid JSON", EXIT_USAGE)
    if not isinstance(args, dict):
        die("--args-json must be a JSON object", EXIT_USAGE)
    return args


def cmd_call(
    tools: dict,
    a,
    bearer: str,
    args: dict | None = None,
    server_seat: str | None = None,
    deadline: float | None = None,
) -> int:
    entry = tools.get(a.tool)
    if entry is None:
        die(f"unknown tool {a.tool!r};  `{prog()} list` lists what the server advertises", EXIT_USAGE)
    if args is None:
        args = _read_args_json(a)
    # The caller's own arguments are validated before the actor probe (a refused call costs no extra call),
    # and secret-scanned inside remote_call before anything is sent:  there is no unscanned route.
    validate_arguments(entry, args, deadline)
    args = resolve_actor(entry, args, bearer, server_seat, deadline)
    return _print_result(remote_call(a.tool, args, not entry["read"], bearer, deadline), a.json)


def cmd_whoami(out: dict, a) -> int:
    if a.json:
        return _print_result(out, True)
    sc = out["structured"]
    shown = [
        k
        for k in ("authenticated_seat", "default_identity", "transport")
        if sc.get(k)
    ]
    for k in shown:
        print(f"{k}: {_visible(str(sc[k]))}")
    for ident in sc.get("identities") or []:
        if isinstance(ident, dict) and ident.get("identity"):
            print(f"identity: {_visible(str(ident['identity']))}")
    if not shown:
        print(json.dumps(sc, indent=2))
    return 0


# ----------------------------------------------------------------- git transfer and file publishing


def _git_binary() -> str:
    found = shutil.which("git")
    if not found:
        die("git is not installed on this machine", EXIT_ERROR)
    return found


def _transport_env(bearer: str) -> dict:
    """git's environment for the hosted read-only route.  The bearer stays out of argv, and no GitHub credential is here.

    git rewrites github.com to the route for this one process, so a clone's stored remote stays the plain GitHub URL.
    """
    base = GIT_ROUTE_BASE
    config = [
        (f"url.{base}/git/.insteadOf", "https://github.com/"),
        (f"url.{base}/git/.insteadOf", "git@github.com:"),
        (f"http.{base}/.extraHeader", f"Authorization: Bearer {bearer}"),
        ("http.postBuffer", str(GIT_POST_BUFFER_BYTES)),
        ("http.followRedirects", "false"),  # the bearer goes to the route and nowhere a redirect points
        ("credential.helper", ""),
    ]
    env = dict(os.environ)
    env.update({"GIT_TERMINAL_PROMPT": "0", "GIT_CONFIG_COUNT": str(len(config))})
    for index, (key, value) in enumerate(config):
        env[f"GIT_CONFIG_KEY_{index}"] = key
        env[f"GIT_CONFIG_VALUE_{index}"] = value
    return env


def _run_git(args: list[str], bearer: str, cwd: str | None = None) -> int:
    """Run one git command through the route.  git's stderr never reaches the terminal:  a remote failure can put
    response bodies, headers or request details there, and redacting the bearer does not make the stream safe, so
    only the exit status is reported.  An interrupted wait terminates and reaps the child, so a runner SIGTERM
    cannot leave an orphan git behind."""
    previous = signal.getsignal(signal.SIGTERM)

    def _interrupted(signum, frame):
        raise InterruptedError(f"interrupted by signal {signum}")

    signal.signal(signal.SIGTERM, _interrupted)
    try:
        try:
            proc = subprocess.Popen(
                [_git_binary(), *args],
                env=_transport_env(bearer),
                cwd=cwd,
                stdin=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        except FileNotFoundError:
            die("git is not installed or not on PATH", 127)
        except OSError as exc:
            die(f"git could not start ({type(exc).__name__})", EXIT_ERROR)
        try:
            proc.wait(timeout=GIT_TIMEOUT_S)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()
            die(f"git timed out after {GIT_TIMEOUT_S} seconds", EXIT_ERROR)
        except BaseException:
            try:
                proc.terminate()
            except ProcessLookupError:
                pass
            try:
                proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait()
            raise
    finally:
        signal.signal(signal.SIGTERM, previous)
    if proc.returncode:
        sys.stderr.write(f"git exited with status {proc.returncode}\n")
    return proc.returncode


def _repo_url(repo: str) -> str:
    if REPO_PATTERN.fullmatch(repo) is None or ".." in repo:
        die("the repo must be written owner/name", EXIT_USAGE)
    return f"https://github.com/{repo}.git"


def _plain_arg(value: str, what: str) -> str:
    """A value that git could read as an option is refused, not passed on."""
    if not value or value.startswith("-") or "\0" in value:
        die(f"{what} must not be empty or start with a dash", EXIT_USAGE)
    return value


def _clone_destination(a) -> str:
    """The clone folder, made mode 0700 when this command creates it;  a symlink or a non-directory is refused,
    and an existing directory keeps its own permissions."""
    raw = a.dir if a.dir else a.repo.rsplit("/", 1)[-1]
    _plain_arg(raw, "the folder")
    target = os.path.abspath(raw)
    if os.path.islink(target):
        die("the clone folder must not be a symlink", EXIT_USAGE)
    if os.path.lexists(target):
        if not os.path.isdir(target):
            die("the clone folder must be a directory", EXIT_USAGE)
        return target
    try:
        os.makedirs(target, mode=0o700)
        os.chmod(target, 0o700)
    except OSError as exc:
        die(f"cannot create the clone folder ({type(exc).__name__})", EXIT_ERROR)
    return target


def cmd_clone(a, bearer: str) -> int:
    args = ["clone"]
    if a.depth is not None:
        if a.depth < 1:
            die("--depth must be at least 1", EXIT_USAGE)
        args += ["--depth", str(a.depth)]
    if a.branch:
        args += ["--branch", _plain_arg(a.branch, "--branch")]
    if a.partial:
        args.append("--filter=blob:none")
    url = _repo_url(a.repo)  # before any destination filesystem work:  a bad repo changes nothing on disk
    destination = _clone_destination(a)
    args += ["--", url, destination]
    return _run_git(args, bearer)


def cmd_fetch(a, bearer: str) -> int:
    args = ["-C", a.dir, "fetch"]
    if a.prune:
        args.append("--prune")
    args += ["--", _plain_arg(a.remote, "the remote"), *[_plain_arg(r, "a refspec") for r in a.refspec]]
    return _run_git(args, bearer)


def cmd_pull(a, bearer: str) -> int:
    return _run_git(["-C", a.dir, "pull", "--ff-only", "--", _plain_arg(a.remote, "the remote")], bearer)


def cmd_ls_remote(a, bearer: str) -> int:
    args = ["ls-remote", "--", _repo_url(a.repo)]
    if a.ref:
        args.append(_plain_arg(a.ref, "the ref"))
    return _run_git(args, bearer)


def _new_output(path: str) -> str:
    target = os.path.abspath(path)
    if os.path.lexists(target):
        die(f"{path!r} already exists;  this command never overwrites a file", EXIT_USAGE)
    return target


def cmd_bundle(a, bearer: str) -> int:
    """A git bundle of every branch and tag, made from a throwaway mirror."""
    target = _new_output(a.output)
    with tempfile.TemporaryDirectory(prefix="simple-git-") as tmp:
        mirror = os.path.join(tmp, "mirror.git")
        code = _run_git(["clone", "--quiet", "--mirror", "--", _repo_url(a.repo), mirror], bearer)
        if code:
            return code
        code = _run_git(["-C", mirror, "bundle", "create", "--quiet", target, "--all"], bearer)
    if not code:
        print(target)
    return code


def cmd_archive(a, bearer: str) -> int:
    """A tar, tar.gz or zip of one ref, named by the output's extension, from a throwaway shallow fetch."""
    target = _new_output(a.output)
    if not target.endswith((".tar", ".tar.gz", ".tgz", ".zip")):
        die("the output must end in .tar, .tar.gz, .tgz or .zip", EXIT_USAGE)
    ref = _plain_arg(a.ref, "--ref")
    url = _repo_url(a.repo)
    with tempfile.TemporaryDirectory(prefix="simple-git-") as tmp:
        code = _run_git(["init", "--quiet", "--bare", tmp], bearer)
        if code:
            return code
        code = _run_git(["-C", tmp, "fetch", "--quiet", "--depth", "1", "--", url, ref], bearer)
        if code:
            return code
        code = _run_git(["-C", tmp, "archive", "-o", target, "FETCH_HEAD"], bearer)
    if not code:
        print(target)
    return code


def _publish_files(specs: list[str]) -> list[tuple[str, bytes]]:
    """Each LOCAL or LOCAL=REPO_PATH read and checked before anything is sent."""
    files: list[tuple[str, bytes]] = []
    seen: set[str] = set()
    total = 0
    for spec in specs:
        # Split on the LAST "=" only when its left side is an existing, non-symlink file;  a local path may
        # itself contain "=", and truncating it at the first one would read the wrong file or fail outright.
        local, separator, repo_path = spec.rpartition("=")
        if not separator or os.path.islink(local) or not os.path.isfile(local):
            local, repo_path = spec, spec
        if not local or not repo_path or repo_path in seen:
            die(f"--file {spec!r} is empty or repeats a repo path", EXIT_USAGE)
        seen.add(repo_path)
        if os.path.islink(local) or not os.path.isfile(local):
            die(f"{local!r} is not a regular file", EXIT_USAGE)
        size = os.path.getsize(local)
        if size == 0:
            die(f"{local!r} is empty;  the server takes no empty file", EXIT_USAGE)
        if size > PUBLISH_MAX_FILE_BYTES:
            die(f"{local!r} is {size} bytes;  one file may be {PUBLISH_MAX_FILE_BYTES} at most", EXIT_USAGE)
        total += size
        if len(seen) > PUBLISH_MAX_FILES or total > PUBLISH_MAX_TOTAL_BYTES:
            die(
                f"a publish may be {PUBLISH_MAX_FILES} files and {PUBLISH_MAX_TOTAL_BYTES} bytes at most",
                EXIT_USAGE,
            )
        try:
            with open(local, "rb") as handle:
                files.append((repo_path, handle.read(PUBLISH_MAX_FILE_BYTES + 1)))
        except OSError:
            die(f"cannot read {local!r}", EXIT_USAGE)
    return files


def _publish_batches(files: list[tuple[str, bytes]]) -> list[list[tuple[str, bytes]]]:
    """Groups that each fit one commit:  PUBLISH_MAX_COMMIT_FILES files and PUBLISH_MAX_COMMIT_BYTES at most."""
    batches: list[list[tuple[str, bytes]]] = []
    current: list[tuple[str, bytes]] = []
    size = 0
    for item in files:
        if current and (len(current) >= PUBLISH_MAX_COMMIT_FILES or size + len(item[1]) > PUBLISH_MAX_COMMIT_BYTES):
            batches.append(current)
            current, size = [], 0
        current.append(item)
        size += len(item[1])
    if current:
        batches.append(current)
    return batches


def _branch_head(result: dict) -> str:
    structured = result.get("structured") if isinstance(result, dict) else None
    branch = structured.get("branch") if isinstance(structured, dict) else None
    commit = branch.get("commit") if isinstance(branch, dict) else None
    sha = commit.get("sha") if isinstance(commit, dict) else None
    if not isinstance(sha, str) or re.fullmatch(r"[0-9a-f]{40}", sha) is None:
        die("the server did not report the branch head", EXIT_ERROR)
    return sha


def _tool_call(tools: dict, name: str, args: dict, bearer: str, seat: str, deadline: float) -> dict:
    entry = tools.get(name)
    if entry is None:
        die(f"the server does not offer {name} to this bearer", EXIT_ERROR)
    validate_arguments(entry, args, deadline)
    args = resolve_actor(entry, args, bearer, seat, deadline)
    return remote_call(name, args, not entry["read"], bearer, deadline)


# ----------------------------------------------------------------- publish outcome store
#
# A publish is several commits fenced on each other.  The store makes a RERUN safe:  each batch's outcome is
# durable (ok / unknown / refused) under one stable key for the whole operation, a batch recorded unknown is
# never replayed by this client, and batches already visible on the remote branch are skipped by content.


def _fsync_dir(directory: Path) -> None:
    """Durability means the name survives the crash too:  fsync the directory after an atomic replace."""
    fd = os.open(directory, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def _publish_store_path() -> Path:
    base = os.environ.get("SIMPLE_GIT_STATE_DIR") or os.path.join(os.path.expanduser("~"), ".simple-tools")
    return Path(base) / "publish-outcomes.json"


def _publish_key(repo: str, branch: str, base, message: str, files) -> str:
    """One stable key for the whole publish operation:  same goal, same content, same key."""
    canonical = json.dumps(
        {
            "repo": repo,
            "branch": branch,
            "base": base,
            "message": message,
            "files": [[path, hashlib.sha256(data).hexdigest()] for path, data in files],
        },
        separators=(",", ":"),
    )
    return hashlib.sha256(canonical.encode()).hexdigest()


_RECONCILE_BARRIER = "_reconciliation_required"


def _publish_store_load() -> dict:
    """A corrupt store is never treated as empty state:  the unreadable file is quarantined aside (kept as
    evidence, never overwritten) and the store becomes one durable reconciliation barrier.  The barrier
    fails every later publish closed - across restarts and repeated invocations.  There is no in-tool
    settlement or barrier-clearing path:  recovery is an operator reconciling the quarantined records
    against each original operation's own receipt and restoring or rebuilding the store by hand.  An
    absent record is not proof its operation never ran, and branch content shows desired state, not an
    original operation's settled outcome."""
    path = _publish_store_path()
    try:
        with open(path) as handle:
            store = json.load(handle)
    except FileNotFoundError:
        quarantines = (
            sorted(path.parent.glob(path.name + ".corrupt-*"), key=lambda q: q.stat().st_mtime)
            if path.parent.is_dir()
            else []
        )
        if quarantines:
            # A missing store beside a quarantined corruption is the crash window between quarantining and
            # persisting the barrier:  fail closed here too, never silently restart with empty state.
            latest = quarantines[-1]
            return {
                _RECONCILE_BARRIER: {
                    "quarantine": latest.name,
                    "recorded_at": int(latest.stat().st_mtime),
                    "reason": "the publish outcome store is missing beside a quarantined corruption;  every record it held is unproven until reconciled",
                }
            }
        return {}  # the normal first run:  no outcomes recorded yet
    except (json.JSONDecodeError, ValueError):
        quarantine = path.with_name(f"{path.name}.corrupt-{int(time.time())}-{os.getpid()}")
        barrier = {
            _RECONCILE_BARRIER: {
                "quarantine": quarantine.name,
                "recorded_at": int(time.time()),
                "reason": "the publish outcome store was corrupt;  every record it held is unproven until reconciled",
            }
        }
        # Persist the barrier BEFORE moving the corrupt file aside:  a crash anywhere in this sequence still
        # fails closed - either the barrier is durable in place, or the store is missing beside a quarantine
        # sibling, which the FileNotFoundError branch above turns into the same barrier.
        try:
            fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
            with os.fdopen(fd, "w") as handle:
                json.dump(barrier, handle)
                handle.flush()
                os.fsync(handle.fileno())
            os.replace(path, quarantine)
            os.replace(tmp, path)
            _fsync_dir(path.parent)
        except OSError as exc:
            die(f"the publish outcome store is corrupt and cannot be quarantined ({type(exc).__name__})", EXIT_ERROR)
        print(
            f"the publish outcome store was corrupt;  quarantined to {quarantine};  reconciliation is required before publishing",
            file=sys.stderr,
        )
        return barrier
    except OSError as exc:
        # An unavailable registry is not an empty one:  fail closed and name the path rather than publish
        # without verifiable prior outcomes.
        die(
            f"the publish outcome store at {path} cannot be read ({type(exc).__name__});  reconcile it before publishing",
            EXIT_ERROR,
        )
    if not isinstance(store, dict):
        die(f"the publish outcome store at {path} is not an object;  reconcile it before publishing", EXIT_ERROR)
    return store


def _publish_state_dir() -> Path:
    """The store's private directory, created 0700 and verified to be a real directory:  a symlinked path would
    redirect durable outcome state outside its intended location, so it is refused before anything is written."""
    path = _publish_store_path().parent
    if path.is_symlink():
        die(f"the publish state directory {path} is a symlink;  refusing to keep publish state there", EXIT_USAGE)
    try:
        path.mkdir(mode=0o700, parents=True, exist_ok=True)
    except FileExistsError:
        # A dangling symlink or a non-directory at the path:  exist_ok only covers a real directory.
        die(f"the publish state directory {path} is not a usable directory;  refusing to keep publish state there", EXIT_USAGE)
    if path.is_symlink():
        die(f"the publish state directory {path} is a symlink;  refusing to keep publish state there", EXIT_USAGE)
    return path


def _publish_store_lock(deadline_s: float = 30.0):
    """One cross-process lock held for a publish's whole send phase:  independent CLI writers are serialized, so
    no read-modify-write can lose another run's record, and a batch recorded unknown is seen - and honored -
    by every later run of the same operation before it sends anything.  flock releases if the process dies, and
    acquisition is bounded:  a wedged holder stops later publishes for the deadline, not forever."""
    _publish_state_dir()
    path = _publish_store_path()
    handle = open(path.with_suffix(".lock"), "w")
    deadline = time.monotonic() + deadline_s
    while True:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return handle
        except OSError:
            if time.monotonic() >= deadline:
                handle.close()
                die("another publish holds the outcome-store lock;  try again shortly", EXIT_ERROR)
            time.sleep(0.1)


def _publish_store_save(store: dict) -> None:
    path = _publish_store_path()
    try:
        _publish_state_dir()
        # A unique sibling per save:  os.replace stays atomic, and concurrent writers never share a temp name.
        fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
        with os.fdopen(fd, "w") as handle:
            json.dump(store, handle)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp, path)
        _fsync_dir(path.parent)
    except OSError as exc:
        die(f"the publish outcome store cannot be written ({type(exc).__name__})", EXIT_ERROR)


def _publish_state(store: dict, key: str) -> dict:
    return store.setdefault(key, {"batches": {}})


def _outcome_of(fn) -> tuple[str, dict | None]:
    """("ok", result) / ("refused", None) / ("unknown", None) for one write call, by its own printed verdict."""
    err = io.StringIO()
    try:
        with contextlib.redirect_stderr(err):
            return "ok", fn()
    except SystemExit:
        text = err.getvalue()
        sys.stderr.write(text)  # the verdict is the caller's to see;  only its CLASS is consumed here
        unknown = (
            _REMOTE_UNKNOWN in text
            or "outcome_unknown" in text
            or "did not answer" in text
            or "was cut off" in text
        )
        return ("unknown" if unknown else "refused"), None


def _git_blob_sha(data: bytes) -> str:
    return hashlib.sha1(b"blob " + str(len(data)).encode() + b"\0" + data, usedforsecurity=False).hexdigest()


_PUBLISH_PATH = re.compile(r"^(?!/)(?!.*//)(?!.*(?:^|/)[.]{1,2}(?:/|$))(?!.*[/]$)[A-Za-z0-9._/+@~-]{1,1024}$")


def _publish_path_check(path: str) -> None:
    """The relay's own per-file write rules, mirrored so a bad path in a LATER batch is refused before the first
    commit is sent, never after earlier batches have landed.  The default-branch guard needs no mirror:  it
    refuses the first batch like the last, so it cannot leave a partial chain."""
    if _PUBLISH_PATH.fullmatch(path) is None:
        die(f"{path!r} is not a repo path the relay accepts", EXIT_USAGE)
    if path in (".github", ".github/workflows") or path.startswith(".github/workflows/"):
        die(f"{path!r} is a workflow path;  publish cannot write it", EXIT_USAGE)


def _publish_payload(repo: str, branch: str, message: str, number: int, count: int, batch) -> dict:
    return {
        "repo": repo,
        "branch": branch,
        "message": message if count == 1 else f"{message} (part {number} of {count})",
        "files": [
            {"path": path, "content_b64": base64.b64encode(data).decode("ascii")} for path, data in batch
        ],
    }


def cmd_publish(tools: dict, a, bearer: str, seat: str, deadline: float) -> int:
    """Commit local files to a branch as this bot, with no base64 for the caller to pass by hand.

    Files past one commit's limits go in several commits, in order, each fenced on the head the last one left.
    Nothing retries:  an unknown outcome stops here, as every other write in this client does.  A corrupt
    outcome store becomes a durable reconciliation barrier:  every later run stops before any write, and
    recovery is manual reconciliation against original receipts, never an in-tool settlement.
    """
    files = _publish_files(a.file)
    if not files:
        die("name at least one --file", EXIT_USAGE)
    _repo_url(a.repo)
    batches = _publish_batches(files)
    # Every commit is checked before the first is sent, so a bad path or a flagged file in a later batch cannot leave a
    # partial publish on the branch.  One batch's base64 payload exists at a time, so a large publish does not
    # hold the whole encoded set in memory.
    entry = tools.get("gr_wf_files_put")
    if entry is None:
        die("the server does not offer gr_wf_files_put to this bearer", EXIT_ERROR)
    for number, batch in enumerate(batches, 1):
        for path, _data in batch:
            _publish_path_check(path)
        payload = _publish_payload(a.repo, a.branch, a.message, number, len(batches), batch)
        validate_arguments(entry, {**payload, "expected_head_sha": "0" * 40}, deadline)
        hit = _scan_arguments(payload, bearer, "gr_wf_files_put")
        if hit is not None:
            die(f"refused before sending:  {hit}", EXIT_USAGE)
        del payload
    lock = _publish_store_lock()
    try:
        store = _publish_store_load()
        barrier = store.get(_RECONCILE_BARRIER)
        if barrier is not None:
            # A durable barrier, not a one-shot exit:  every invocation fails closed here, before ANY write
            # (branch creation included), until the operator reconciles every quarantined record by hand.
            # Branch content cannot prove an original operation was never dispatched.
            if not isinstance(barrier, dict):
                die(
                    f"the publish outcome store at {_publish_store_path()} holds a malformed reconciliation barrier;  "
                    "reconcile and rebuild the store by hand - this client has no automatic settlement path",
                    EXIT_ERROR,
                )
            _publish_store_save(store)
            quarantine = barrier.get("quarantine")
            location = _publish_store_path()
            named = (
                f";  quarantined corruption: {location.with_name(quarantine)}"
                if isinstance(quarantine, str)
                else ""
            )
            die(
                f"the publish outcome store at {location} requires reconciliation{named}:  "
                "settle every quarantined record against the original operation's own receipt, then "
                "restore or rebuild the store by hand - this client has no automatic settlement path",
                EXIT_ERROR,
            )
        state = _publish_state(store, _publish_key(a.repo, a.branch, a.base, a.message, files))
        if a.base:
            branch_state = state["batches"].get("branch")
            if branch_state == "unknown":
                die(
                    "an earlier branch creation's outcome is unknown;  check the branch before running this again",
                    EXIT_ERROR,
                )
            if branch_state != "ok":
                # The base head is fetched only when the branch still needs creating:  a rerun whose branch
                # exists fences on the branch's own current head below, not on the base.
                base = _branch_head(_tool_call(tools, "gr_wf_branch_get", {"repo": a.repo, "branch": a.base}, bearer, seat, deadline))
                outcome, _ = _outcome_of(
                    lambda: _tool_call(
                        tools, "gr_wf_branch_create", {"repo": a.repo, "branch": a.branch, "sha": base}, bearer, seat, deadline
                    )
                )
                if outcome == "unknown":
                    state["batches"]["branch"] = "unknown"
                    _publish_store_save(store)
                    die("the branch creation's outcome is unknown;  check the branch before running this again", EXIT_ERROR)
                if outcome == "ok":
                    state["batches"]["branch"] = "ok"
                    _publish_store_save(store)
                if outcome == "refused":
                    # A definite refusal still stops the publish:  later writes must not follow a failed
                    # branch creation.  The key is reusable - nothing was created, a corrected rerun may try again.
                    state["batches"]["branch"] = "refused"
                    _publish_store_save(store)
                    raise SystemExit(EXIT_ERROR)
            # Fence on the branch's CURRENT head, not the original base:  an earlier run may already have
            # landed batches on it, and reconciling against a stale head would reapply them or mis-fence.
            head = _branch_head(
                _tool_call(tools, "gr_wf_branch_get", {"repo": a.repo, "branch": a.branch}, bearer, seat, deadline)
            )
        else:
            head = _branch_head(_tool_call(tools, "gr_wf_branch_get", {"repo": a.repo, "branch": a.branch}, bearer, seat, deadline))
        remote = _remote_tree_shas(tools, a.repo, head, bearer, seat, deadline)
        live = remote if remote is not None else {}
        for number, batch in enumerate(batches, 1):
            prior = state["batches"].get(str(number))
            if prior == "unknown":
                _publish_store_save(store)
                die(
                    f"batch {number}'s earlier outcome is unknown;  check the branch before running this again",
                    EXIT_ERROR,
                )
            pending = [(path, data) for path, data in batch if live.get(path) != _git_blob_sha(data)]
            if prior == "ok":
                if remote is None or not pending:
                    print(f"batch {number} already committed by an earlier run")
                    continue
                # The ledger says this batch landed but the branch's live tree disagrees:  an external
                # reset or rewrite dropped it.  Trust the live tree over the ledger and recommit the
                # missing files, fenced on the current head like any other batch.
                print(f"batch {number} was recorded ok but is missing from the branch;  recommitting")
            if not pending:
                state["batches"][str(number)] = "ok"
                _publish_store_save(store)
                print(f"batch {number} already on the branch")
                continue
            payload = _publish_payload(a.repo, a.branch, a.message, number, len(batches), pending)
            outcome, out = _outcome_of(
                lambda: _tool_call(tools, "gr_wf_files_put", {**payload, "expected_head_sha": head}, bearer, seat, deadline)
            )
            if outcome == "unknown":
                state["batches"][str(number)] = "unknown"
                _publish_store_save(store)
                die(
                    f"batch {number}'s outcome is unknown;  check the branch before running this again",
                    EXIT_ERROR,
                )
            if outcome == "refused":
                # Definite:  nothing was written, so record the refusal like a refused branch creation - a
                # corrected rerun reuses the key and tries the batch again.
                state["batches"][str(number)] = "refused"
                _publish_store_save(store)
                raise SystemExit(EXIT_ERROR)
            structured = out.get("structured") if isinstance(out, dict) else None
            commit = structured.get("commit") if isinstance(structured, dict) else None
            if not isinstance(commit, str) or re.fullmatch(r"[0-9a-f]{40}", commit) is None:
                die("the server did not report the new commit;  check the branch before trying again", EXIT_ERROR)
            head = commit
            for path, data in pending:
                live[path] = _git_blob_sha(data)
            state["batches"][str(number)] = "ok"
            _publish_store_save(store)
            print(f"{commit}  {len(payload['files'])} file(s)")
        return 0
    finally:
        lock.close()

def _remote_tree_shas(tools: dict, repo: str, head: str, bearer: str, seat: str, deadline: float) -> dict | None:
    """path -> blob sha for the branch head's tree, for skip-what-already-matches;  None when unreadable,
    so a ledger "ok" record is trusted only when the live tree could actually be checked against it."""
    if tools.get("gr_wf_tree") is None:
        return None
    try:
        err = io.StringIO()
        with contextlib.redirect_stderr(err):
            out = _tool_call(tools, "gr_wf_tree", {"repo": repo, "sha": head, "recursive": True}, bearer, seat, deadline)
    except SystemExit:
        return None
    structured = out.get("structured") if isinstance(out, dict) else None
    tree = structured.get("tree") if isinstance(structured, dict) else None
    if not isinstance(tree, list):
        return None
    return {
        item["path"]: item["sha"]
        for item in tree
        if isinstance(item, dict)
        and item.get("type") == "blob"
        and isinstance(item.get("path"), str)
        and isinstance(item.get("sha"), str)
    }


# A report, never a merge authorization. Only existing reviewed read tools are used.
class ReadinessUnknown(ValueError):
    pass


def collect_readiness(read, repo, number, expected_head=None, max_pages=20):
    """Bounded, non-atomic observations. Missing coverage never becomes zero findings."""
    report = {"repo": repo, "number": number, "report_only": True,
              "merge_authorized": False, "complete": False, "verdict": "unknown",
              "blockers": [], "unknowns": [], "coverage": {}}

    def require(ok, reason):
        if not ok:
            raise ReadinessUnknown(reason)

    def pull():
        p = read("gr_wf_pr_get", {"repo": repo, "number": number}).get("pull")
        require(isinstance(p, dict) and type(p.get("number")) is int and p["number"] == number,
                "PR identity missing or mismatched")
        require(p.get("state") in ("open", "closed") and type(p.get("draft")) is bool
                and type(p.get("merged")) is bool, "PR lifecycle incomplete")
        for side in ("head", "base"):
            require(isinstance(p.get(side), dict)
                    and isinstance(p[side].get("sha"), str)
                    and re.fullmatch(r"[0-9a-f]{40}", p[side]["sha"]), "PR head/base missing")
        return p

    try:
        require(isinstance(repo, str) and REPO_PATTERN.fullmatch(repo) is not None and ".." not in repo
                and type(number) is int and 0 < number <= 1000000000000, "invalid repo or PR number")
        require(expected_head is None or (isinstance(expected_head, str)
                and re.fullmatch(r"[0-9a-f]{40}", expected_head)), "expected head must be a full SHA")
        first = pull()
        head, base = first["head"]["sha"], first["base"]["sha"]
        report.update(head=head, base=base, state=first["state"], draft=first["draft"],
                      merged=first["merged"])
        require(expected_head is None or expected_head == head, "expected head no longer current")
        # This action is review THREADS, not issue comments or line-comment lists.
        threads, seen, cursors, cursor = [], set(), set(), None
        for _ in range(max_pages):
            args = {"repo": repo, "number": number}
            if cursor is not None:
                args["cursor"] = cursor
            connection = read("gr_wf_review_threads", args).get("threads")
            require(isinstance(connection, dict) and isinstance(connection.get("nodes"), list)
                    and isinstance(connection.get("pageInfo"), dict), "review-thread connection incomplete")
            page = connection["pageInfo"]
            require(type(page.get("hasNextPage")) is bool, "review-thread pagination unknown")
            for row in connection["nodes"]:
                require(isinstance(row, dict) and isinstance(row.get("id"), str)
                        and row["id"] and row["id"] not in seen
                        and type(row.get("isResolved")) is bool
                        and type(row.get("isOutdated")) is bool, "review-thread row missing or duplicate")
                seen.add(row["id"])
                # No external prose is emitted as instructions or authorization.
                threads.append({k: row[k] for k in ("id", "isResolved", "isOutdated")})
            if page["hasNextPage"] is False:
                break
            cursor = page.get("endCursor")
            require(isinstance(cursor, str) and re.fullmatch(r"[A-Za-z0-9_/=+-]{1,256}", cursor)
                    and cursor not in cursors, "review-thread cursor missing or repeated")
            cursors.add(cursor)
        else:
            raise ReadinessUnknown("review-thread page bound reached")
        report["review_threads"] = {"total": len(threads),
                                    "unresolved": [r for r in threads if not r["isResolved"]]}
        report["coverage"]["review_threads"] = "complete"
        if report["review_threads"]["unresolved"]:
            report["blockers"].append("unresolved_review_threads")

        checked = read("gr_wf_checks", {"repo": repo, "ref": head, "per_page": 50})
        require(checked.get("complete") is True and isinstance(checked.get("checks"), list),
                "check-run census incomplete or unknown")
        check_rows, ids = [], set()
        for c in checked["checks"]:
            require(isinstance(c, dict) and type(c.get("id")) is int and c["id"] not in ids
                    and c.get("head_sha") == head and isinstance(c.get("name"), str)
                    and c.get("status") in ("queued", "in_progress", "completed", "waiting", "pending", "requested"),
                    "check-run row missing, duplicate or wrong head")
            ids.add(c["id"])
            require(c["status"] != "completed" or c.get("conclusion") in
                    ("success", "failure", "neutral", "cancelled", "skipped", "timed_out", "action_required", "stale", "startup_failure"),
                    "check-run conclusion unknown")
            check_rows.append({k: c.get(k) for k in ("id", "name", "status", "conclusion")})
        report["checks"] = check_rows
        report["coverage"]["check_runs"] = "complete"
        if not check_rows:
            report["unknowns"].append("no_check_runs_observed")
        if any(c["status"] != "completed" or c["conclusion"] not in ("success", "neutral", "skipped") for c in check_rows):
            report["blockers"].append("checks_incomplete_or_unsuccessful")

        statuses = read("gr_wf_commit_statuses", {"repo": repo, "sha": head, "per_page": 50})
        require(statuses.get("complete") is True and isinstance(statuses.get("statuses"), list),
                "commit-status history incomplete")
        # REST statuses are newest first. Older failures must not override their latest context.
        latest = {}
        for s in statuses["statuses"]:
            require(isinstance(s, dict) and isinstance(s.get("context"), str) and s["context"]
                    and s.get("state") in ("pending", "success", "error", "failure"), "commit-status row unknown")
            latest.setdefault(s["context"], s["state"])
        report["commit_statuses"] = latest
        report["coverage"]["commit_statuses"] = "complete"
        if any(v != "success" for v in latest.values()):
            report["blockers"].append("commit_statuses_unsuccessful")

        reviews, review_ids = [], set()
        for page_num in range(1, max_pages + 1):
            page = read("gr_wf_pr_reviews_page", {"repo": repo, "number": number,
                        "expected_head_sha": head, "page": page_num, "per_page": 50})
            require(page.get("head_sha") == head and page.get("number") == number
                    and page.get("page") == page_num and type(page.get("has_more")) is bool
                    and isinstance(page.get("reviews"), list), "review page incomplete or wrong head")
            for r in page["reviews"]:
                require(isinstance(r, dict) and type(r.get("id")) is int and r["id"] not in review_ids
                        and isinstance(r.get("author"), dict) and type(r["author"].get("id")) is int
                        and r.get("state") in ("APPROVED", "CHANGES_REQUESTED", "COMMENTED", "DISMISSED", "PENDING")
                        and isinstance(r.get("commit_id"), str) and re.fullmatch(r"[0-9a-f]{40}", r["commit_id"]),
                        "review identity/state missing or duplicate")
                review_ids.add(r["id"])
                reviews.append({"id": r["id"], "author_id": r["author"]["id"],
                                "state": r["state"], "commit_id": r["commit_id"]})
            if not page["has_more"]:
                break
        else:
            raise ReadinessUnknown("review page bound reached")
        report["reviews"] = reviews
        report["coverage"]["review_records"] = "complete"
        if not any(r["commit_id"] == head and r["state"] in ("APPROVED", "COMMENTED") for r in reviews):
            report["unknowns"].append("no_completed_current_head_review_observed")
        # Latest decisive review per author, including old-head requests still requiring attention.
        decisions, latest_ids = {}, {}
        for r in reviews:
            if r["state"] in ("APPROVED", "CHANGES_REQUESTED", "DISMISSED"):
                if r["id"] > latest_ids.get(r["author_id"], -1):
                    latest_ids[r["author_id"]] = r["id"]
                    decisions[r["author_id"]] = r["state"]
        if "CHANGES_REQUESTED" in decisions.values() or any(r["state"] == "PENDING" for r in reviews):
            report["blockers"].append("review_changes_requested_or_pending")

        last = pull()
        require((last["head"]["sha"], last["base"]["sha"], last["state"], last["draft"], last["merged"])
                == (head, base, first["state"], first["draft"], first["merged"]), "PR changed during report; re-read needed")
        report["coverage"]["head_base_rechecked"] = True
        state = last.get("mergeable_state")
        report["github_merge_state"] = state if isinstance(state, str) else "unknown"
        report["github_block_reason"] = "unknown"  # REST exposes state, not the UI's exact rule reason.
        if first["state"] != "open" or first["draft"] or first["merged"]:
            report["blockers"].append("PR_not_open_non_draft")
        if last.get("mergeable") is False or state in ("blocked", "dirty", "behind", "draft"):
            report["blockers"].append("github_merge_state_" + str(state))
        elif last.get("mergeable") is not True or state != "clean":
            report["unknowns"].append("github_merge_state_not_clean")
        report["complete"] = True
    except ReadinessUnknown as exc:
        report["unknowns"].append(str(exc))
    report["limitations"] = ["Observations are not atomic; changes after the final read are possible.",
        "Repository rules, required reviewer identity and owner authority are not evaluated.",
        "GitHub exact block reason is unavailable from these approved reads; never infer a policy waiver."]
    report["verdict"] = "blocked" if report["blockers"] else "unknown" if report["unknowns"] or not report["complete"] else "observed_checks_passed"
    return report


def cmd_readiness(tools, a, bearer, server_seat, deadline):
    def read(name, args):
        entry = tools.get(name)
        if not entry or entry.get("read") is not True or name not in READ_TOOLS:
            raise ReadinessUnknown("required read unavailable: " + name)
        try:
            validate_arguments(entry, args, deadline)
            args = resolve_actor(entry, args, bearer, server_seat, deadline)
            out = remote_call(name, args, False, bearer, deadline)
        except SystemExit:
            raise ReadinessUnknown("required read failed: " + name) from None
        value = out.get("structured")
        if not isinstance(value, dict) or not value:
            raise ReadinessUnknown("structured read unavailable: " + name)
        return value
    report = collect_readiness(read, a.repo, a.number, a.expected_head)
    print(json.dumps(report, indent=2))
    return 0 if report["verdict"] == "observed_checks_passed" else 1


