def prog() -> str:
    # The wrapper records the name it was INSTALLED under before any interpreter re-exec (which would
    # otherwise replace argv[0] with the real script path);  without it, argv[0] itself is the source.
    chosen = env(_ENV_STEM + "_ARGV0").strip() or os.path.basename(sys.argv[0] or "git")
    # _visible leaves newline and tab printable by design;  in the program name they would split die()
    # lines on stderr (a caller-controlled environment could spoof log lines), so escape them here.
    return _visible(chosen).replace("\n", "\\n").replace("\t", "\\t")


def die(msg: str, code: int = EXIT_ERROR) -> "NoReturn":  # noqa: F821
    sys.stderr.write(f"{prog()}: {msg}\n")
    raise SystemExit(code)


def env(name: str) -> str:
    return os.environ.get(name, "")


ARGS_MAX_BYTES = 8 * 1024 * 1024


def _no_constant(value):
    raise ValueError("non-finite numbers are not JSON")


def _strict_object(pairs):
    out = {}
    for key, value in pairs:
        if key in out:
            raise ValueError("duplicate JSON key")
        out[key] = value
    return out


def strict_loads(text):
    """JSON with no duplicate keys and no NaN/Infinity, for caller arguments and server answers alike."""
    return json.loads(text, object_pairs_hook=_strict_object, parse_constant=_no_constant)


def _visible(text: str) -> str:
    """Hosted text with control characters (other than newline and tab) shown as \\xNN, so it cannot drive the terminal."""
    return _REMOTE_CONTROL_RE.sub(lambda m: "\\x%02x" % ord(m.group()), text)


# ----------------------------------------------------------------- seat declaration (mirrors the host's seat helper)


def declared_seat() -> str | None:
    """The seat this process says it is, or None when it says nothing.  Same precedence and conflict rules as
    the host's seat-remote-defaults helper;  used only to fill or check the `identity` argument, never to pick
    a credential."""
    launcher = env("AGENT_LAUNCHER").strip()
    launch_seat = env("AGENT_LAUNCH_SEAT").strip().upper()
    seat = env("AGENT_SEAT").strip().upper()
    tag = env("AGENT_TAG").strip().upper()
    if launcher and not launch_seat:
        die("AGENT_LAUNCHER is set without AGENT_LAUNCH_SEAT", EXIT_USAGE)
    if launch_seat and not launcher:
        die("AGENT_LAUNCH_SEAT is set without AGENT_LAUNCHER", EXIT_USAGE)
    declared = [v for v in (launch_seat, seat, tag) if v]
    if len(set(declared)) > 1:
        die("conflicting seat declarations in the environment", EXIT_USAGE)
    if not declared:
        return None
    if SEAT_PATTERN.fullmatch(declared[0]) is None:
        die("the declared seat name has an invalid format", EXIT_USAGE)
    return declared[0]


def _prompt_terminal_available() -> bool:
    """A hidden prompt needs a real terminal to hide the answer on.  getpass reads the CONTROLLING
    terminal (/dev/tty), not stdin, so `call --args-json -` with piped JSON still prompts - and the
    prompt never consumes the piped stdin.  Where there is no controlling terminal, fall back to an
    interactive stdin (a console without /dev/tty);  a detached caller (stdin missing or not a
    terminal either) gets no prompt and the clean refusal below."""
    try:
        fd = os.open("/dev/tty", os.O_RDONLY)
    except OSError:
        try:
            return sys.stdin is not None and sys.stdin.isatty()
        except (ValueError, OSError):
            return False
    os.close(fd)
    return True


def remote_bearer() -> str:
    """The CLI user's OWN bearer:  SIMPLE_TOOLS_BEARER from the environment (automation), otherwise one
    hidden prompt on the controlling terminal.  The answer is held only in process memory for the
    session - never an argument, history, a file this tool writes or a log line."""
    v = env(REMOTE_BEARER_ENV)
    if not v and _prompt_terminal_available():
        try:
            with warnings.catch_warnings():
                # A terminal that refuses echo control must fail CLOSED:  getpass warns (GetPassWarning)
                # and would then read the bearer ECHOED.  Turn the warning into an error so the fallback
                # dies before a single character is read or echoed - the echoed path never runs.
                warnings.simplefilter("error", getpass.GetPassWarning)
                v = getpass.getpass(f"{prog()} bearer (input hidden): ").strip()
        except KeyboardInterrupt:
            # Ctrl-C at the prompt is a clean interruption (128 + SIGINT), never a masked
            # missing-credential error or a traceback.
            sys.stderr.write("\n")
            raise SystemExit(130) from None
        except EOFError:
            v = ""
        except getpass.GetPassWarning:
            die(
                f"this terminal could not hide your bearer input;  set {REMOTE_BEARER_ENV} instead - "
                "an echoed bearer is never read",
                EXIT_NO_CREDS,
            )
    if not v:
        die(
            f"your own simple-tools bearer is required:  set {REMOTE_BEARER_ENV} or answer the hidden "
            "prompt;  there is no fallback and no other credential source",
            EXIT_NO_CREDS,
        )
    if not REMOTE_BEARER_RE.fullmatch(v):
        die(
            "the supplied bearer is not a bearer token (unexpected characters or length)",
            EXIT_NO_CREDS,
        )
    return v


# ----------------------------------------------------------------- transport (mirrors scripts/linear-board/board's pinned hosted transport)


class _TransportError(Exception):
    """The request did not produce an HTTP answer.  `sent` is False only when it provably never left
    (name lookup, refused connection, certificate check);  every other stage is treated as sent."""

    def __init__(self, sent: bool, reason: str = "") -> None:
        super().__init__(reason)
        self.sent = sent
        self.reason = reason


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    """Refuse every redirect, so the Authorization header never follows a 3xx."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def _remote_post(url: str, headers: dict, body: bytes, timeout: float) -> tuple[int, str, bytes]:
    """The one network call of the remote transport:  (status, content type, body).  Tests replace this.
    Redirects are never followed (the Authorization header must not leave the fixed origin), the body is
    read under one total deadline and one byte cap.  Never retried."""
    deadline = time.monotonic() + timeout
    op = urllib.request.build_opener(urllib.request.ProxyHandler({}), _NoRedirect())
    req = urllib.request.Request(url, data=body, method="POST", headers=headers)
    try:
        with op.open(req, timeout=timeout) as r:
            chunks, total = [], 0
            sock = getattr(getattr(getattr(r, "fp", None), "raw", None), "_sock", None)
            if sock is None:
                # Without the socket the remaining budget cannot be applied to each read, so a stalled body could
                # outlast the deadline:  fail closed rather than read unbounded.
                raise _TransportError(True, "transport")
            while True:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise _TransportError(True, "deadline")
                sock.settimeout(remaining)
                try:
                    chunk = r.read1(65536)
                except AttributeError:
                    # read1's partial-read semantics serve the slow-drip deadline and an ordinary
                    # http.client.HTTPResponse provides it;  a wrapped response that cannot read this
                    # way is a transport failure here, never a traceback.
                    raise _TransportError(True, "transport") from None
                if time.monotonic() > deadline:
                    raise _TransportError(True, "deadline")
                if not chunk:
                    break
                total += len(chunk)
                if total > REMOTE_MAX_BYTES:
                    raise _TransportError(True, "too large")
                chunks.append(chunk)
            return r.status, r.headers.get("Content-Type", ""), b"".join(chunks)
    except urllib.error.HTTPError as exc:
        exc.close()
        return exc.code, "", b""
    except urllib.error.URLError as exc:
        unsent = isinstance(
            exc.reason, (socket.gaierror, ConnectionRefusedError, ssl.SSLCertVerificationError)
        )
        raise _TransportError(not unsent, "unreachable") from None
    except _TransportError:
        raise
    except (http.client.HTTPException, OSError, ValueError):
        raise _TransportError(True, "transport") from None


def _error_code_of(result: dict) -> str | None:
    """The hosted server's error code from a tools/call-style result:  structuredContent, then
    `_meta["agent-sync/error"]`, then the first text part that is a JSON object.  Only allow-listed codes
    are recognized;  anything else (or nothing) is None."""
    candidates = []
    sc = result.get("structuredContent")
    if isinstance(sc, dict):
        candidates.append(sc)
    meta = result.get("_meta")
    if isinstance(meta, dict) and isinstance(meta.get("agent-sync/error"), dict):
        candidates.append(meta["agent-sync/error"])
    for part in result.get("content") or []:
        if isinstance(part, dict) and isinstance(part.get("text"), str):
            try:
                obj = strict_loads(part["text"])
            except (ValueError, RecursionError):
                continue
            if isinstance(obj, dict):
                candidates.append(obj)
                break
    for cand in candidates:
        code = cand.get("code")
        if isinstance(code, str) and code in _REMOTE_CODES:
            return code
    return None


# ----------------------------------------------------------------- answer parsing (mirrors board)


def _depth_ok(text: str) -> bool:
    depth = 0
    in_string = escaped = False
    for ch in text:
        if in_string:
            if escaped:
                escaped = False
            elif ch == "\\":
                escaped = True
            elif ch == '"':
                in_string = False
        elif ch == '"':
            in_string = True
        elif ch in "[{":
            depth += 1
            if depth > REMOTE_MAX_DEPTH:
                return False
        elif ch in "]}":
            depth -= 1
    return True


def _nodes_ok(value) -> bool:
    stack, count = [value], 0
    while stack:
        item = stack.pop()
        count += 1
        if count > REMOTE_MAX_NODES:
            return False
        if isinstance(item, dict):
            stack.extend(item.values())
        elif isinstance(item, list):
            stack.extend(item)
    return True


def _events(ctype: str, raw: bytes) -> list[str]:
    """The JSON texts of one answer:  the body itself, or each Server-Sent Event (its `data:` lines joined by a
    newline, as the SSE format defines, comments and other fields ignored)."""
    text = raw.decode("utf-8", "replace")
    if "text/event-stream" not in ctype.lower():
        return [text]
    events, current = [], []
    for line in text.replace("\r\n", "\n").replace("\r", "\n").split("\n"):
        if line == "":
            if current:
                events.append("\n".join(current))
                current = []
        elif line.startswith("data:"):
            value = line[5:]
            current.append(value[1:] if value.startswith(" ") else value)
    if current:
        events.append("\n".join(current))
    return events


def _rpc_result(ctype: str, raw: bytes, write: bool):
    """The result object of one JSON-RPC answer, or (None, message).  Only an allow-listed code leaves this
    function on the error path:  the server's own message text is untrusted and can echo the caller's input,
    so it is never copied into an error."""
    unknown = _REMOTE_UNKNOWN if write else ""
    msg = None
    for text in _events(ctype, raw):
        if not _depth_ok(text):
            return None, "the hosted endpoint sent an answer that nests too deeply" + unknown
        try:
            candidate = strict_loads(text)
        except (ValueError, RecursionError):
            continue
        if (
            isinstance(candidate, dict)
            and candidate.get("jsonrpc") == "2.0"
            and type(candidate.get("id")) is int
            and candidate["id"] == 1
            and ("result" in candidate) != ("error" in candidate)
        ):
            msg = candidate
            break
    if msg is None:
        return None, "the hosted endpoint sent no readable answer to the call" + unknown
    if not _nodes_ok(msg):
        return None, "the hosted endpoint sent an oversized answer" + unknown
    if "error" in msg:
        err = msg["error"]
        code = err.get("code") if isinstance(err, dict) else None
        shown = code if isinstance(code, str) and code in _REMOTE_CODES else "error"
        return None, "the hosted endpoint refused the call" + (
            "" if shown == "error" else f" ({shown})"
        )
    result = msg.get("result")
    if not isinstance(result, dict):
        return None, "the hosted endpoint sent no result" + unknown
    return result, ""


def _failure(exc: "_TransportError", write: bool) -> str:
    if write and exc.sent:
        return (
            "the hosted endpoint did not answer"
            + _REMOTE_UNKNOWN
            + " (no direct fallback)"
        )
    return "the hosted endpoint could not be reached (no direct fallback)"


def _status_message(status: int, write: bool) -> str:
    if status in (401, 403):
        return "the hosted endpoint refused this bearer (not valid, expired, paused or not accepted for MCP)"
    return f"the hosted endpoint answered HTTP {status}" + (
        _REMOTE_UNKNOWN if write and (status >= 500 or status == 408) else ""
    )


# ----------------------------------------------------------------- secret scanning (remote mode has no unscanned route)

_SCANNER = None


def _scanner():
    """The fleet's secret scanner (scripts/agent_sync/secretscan.py, standard library only), loaded by path.
    If it cannot be loaded nothing is sent:  there is no unscanned route."""
    global _SCANNER
    if _SCANNER is not None:
        return _SCANNER
    path = Path(os.path.realpath(__file__)).parent.parent / "agent_sync" / "secretscan.py"
    try:
        spec = importlib.util.spec_from_file_location("_git_secretscan", str(path))
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
    except (OSError, ImportError, AttributeError, SyntaxError):
        die(
            "the secret scanner is not available, so nothing was sent (there is no unscanned route)",
            EXIT_ERROR,
        )
    _SCANNER = module
    return module


def _scan_arguments(arguments, bearer: str) -> str | None:
    """The first argument field the fleet secret scanner flags, as `secret_scan:<field>` (the field name only,
    never the text or any part of it), or None.  Every string at any depth is checked, and the bearer itself
    always matches."""
    scanner = _scanner()
    stack = [("", arguments)]
    while stack:
        path, value = stack.pop()
        if isinstance(value, str):
            if scanner.scan(value, known=[bearer] if bearer else []) is not None:
                return "secret_scan:" + (path or "arguments")
        elif isinstance(value, dict):
            stack.extend((f"{path}.{k}" if path else str(k), v) for k, v in value.items())
        elif isinstance(value, (list, tuple)):
            stack.extend((f"{path}[{i}]", v) for i, v in enumerate(value))
    return None


# ----------------------------------------------------------------- the one remote round trip


def _rpc(bearer: str, method: str, params: dict, write: bool, deadline: float | None = None):
    """One JSON-RPC POST to the fixed endpoint.  Returns the result object.  Never retried.
    `deadline` is the verb's overall budget:  a call whose budget is already gone is never started (a
    write refused that way is definitely NOT sent), and a call that does start gets only the remaining
    budget."""
    body = json.dumps(
        {"jsonrpc": "2.0", "id": 1, "method": method, "params": params}
    ).encode()
    timeout = REMOTE_TIMEOUT_S
    if deadline is not None:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            # Nothing left for this request, so it never leaves:  for a write that is a certainty,
            # not the in-flight uncertainty wording.
            die(
                "the overall time budget was exhausted before this call"
                + ("; the write was not sent" if write else ""),
                EXIT_ERROR,
            )
        timeout = min(REMOTE_TIMEOUT_S, remaining)
    try:
        status, ctype, raw = _remote_post(
            REMOTE_MCP_URL,
            {
                "Content-Type": "application/json",
                "Accept": "application/json, text/event-stream",
                "MCP-Protocol-Version": REMOTE_PROTOCOL_VERSION,
                "Authorization": "Bearer " + bearer,
                "User-Agent": USER_AGENT,
            },
            body,
            timeout,
        )
    except _TransportError as exc:
        die(_failure(exc, write), EXIT_ERROR)
    if status in (401, 403):
        die(_status_message(status, write), EXIT_AUTH)
    if status != 200:
        die(_status_message(status, write), EXIT_ERROR)
    result, problem = _rpc_result(ctype, raw, write)
    if problem:
        die(problem, EXIT_ERROR)
    return result


def remote_call(tool: str, arguments: dict, write: bool, bearer: str, deadline: float | None = None) -> dict:
    """One tools/call.  Returns {"structured":..., "text":...}.  Never retried."""
    hit = _scan_arguments(arguments, bearer)
    if hit:
        die(f"refused before sending: {hit}", EXIT_USAGE)
    result = _rpc(
        bearer, "tools/call", {"name": tool, "arguments": arguments}, write, deadline
    )
    content = result.get("content")
    sc = result.get("structuredContent")
    if (
        (content is not None and not isinstance(content, list))
        or any(
            not isinstance(p, dict) or ("text" in p and not isinstance(p["text"], str))
            for p in content or []
        )
        or (sc is not None and not isinstance(sc, dict))
        or not isinstance(result.get("isError", False), bool)
    ):
        die(
            "the hosted endpoint sent a result in an unexpected shape"
            + (_REMOTE_UNKNOWN if write else ""),
            EXIT_ERROR,
        )
    if result.get("isError"):
        code = _error_code_of(result)
        shown = code if code is not None else "error"
        note = _REMOTE_UNKNOWN if write and code == "outcome_unknown" else ""
        # retry-after is the only other field ever shown, and only bounded.
        retry = None
        meta = result.get("_meta")
        for source in (sc if isinstance(sc, dict) else {}, meta.get("agent-sync/error") if isinstance(meta, dict) and isinstance(meta.get("agent-sync/error"), dict) else {}):
            value = source.get("retry_after_s", source.get("retry_after"))
            if isinstance(value, (int, float)) and not isinstance(value, bool) and 0 <= value <= 86400:
                retry = value
                break
        after = f", retry after {int(-(-retry // 1))}s" if retry is not None else ""
        die(f"{tool} failed on the hosted server: {shown}{after}{note}", EXIT_ERROR)
    parts = [
        c.get("text")
        for c in content or []
        if isinstance(c, dict) and c.get("type") == "text"
    ]
    return {
        "structured": sc if isinstance(sc, dict) else {},
        "text": "\n".join(t for t in parts if isinstance(t, str)),
    }


# ----------------------------------------------------------------- runtime discovery (the only tool authority)


def discover_tools(bearer: str, deadline: float | None = None) -> dict:
    """The git tools THIS caller's endpoint serves right now, via bounded tools/list pages:  at most
    DISCOVERY_MAX_PAGES pages, DISCOVERY_MAX_TOOLS tools, each cursor a fresh bounded string (a repeat is a
    loop and refuses), every advertised tool shape-validated.  Read/write is NOT taken from the answer:  the
    pinned reviewed read set decides, and an unknown action is a write."""
    tools: dict = {}
    cursor = None
    seen_cursors = set()
    for _ in range(DISCOVERY_MAX_PAGES):
        params = {"cursor": cursor} if cursor is not None else {}
        result = _rpc(bearer, "tools/list", params, False, deadline)
        page = result.get("tools")
        if not isinstance(page, list):
            die("the hosted endpoint answered tools/list without a tools array")
        for entry in page:
            if len(tools) >= DISCOVERY_MAX_TOOLS:
                die("the hosted endpoint advertised too many tools")
            if (
                not isinstance(entry, dict)
                or not isinstance(entry.get("name"), str)
                or TOOL_NAME_RE.fullmatch(entry["name"]) is None
            ):
                continue  # not a git tool;  other families exist on the same endpoint
            name = entry["name"]
            if name in tools:
                die("the hosted endpoint advertised the same tool twice")
            schema = entry.get("inputSchema")
            if not _schema_ok(schema):
                die(f"the hosted endpoint advertised {name} with a missing or unreadable schema")
            # tools/list is untrusted operational data:  descriptions are display text through _visible,
            # never instructions, and bounded before storing.
            description = entry.get("description")
            title = entry.get("title")
            if (
                isinstance(description, str) and len(description) > 4096
                or isinstance(title, str) and len(title) > 512
            ):
                die(f"the hosted endpoint advertised {name} with an oversized description")
            tools[name] = {
                "name": name,
                "title": title if isinstance(title, str) else "",
                "description": description if isinstance(description, str) else "",
                "read": name in READ_TOOLS,
                "input_bytes": INPUT_LIMITS.get(name, DEFAULT_INPUT_LIMIT),
                "schema": schema,
            }
        nxt = result.get("nextCursor")
        if nxt is None:  # absent or JSON null:  the only normal end of the list
            break
        if (
            not isinstance(nxt, str)
            or not nxt  # an empty cursor is malformed, never a terminator
            or len(nxt) > DISCOVERY_MAX_CURSOR
            or nxt in seen_cursors
            or nxt == cursor
        ):
            die("the hosted endpoint sent a malformed or repeating tools/list cursor")
        seen_cursors.add(nxt)
        cursor = nxt
    else:
        die(f"the hosted endpoint kept paging past {DISCOVERY_MAX_PAGES} pages")
    if not tools:
        die("the hosted endpoint advertises no git tools to this bearer")
    return tools


