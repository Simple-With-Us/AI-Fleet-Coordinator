# AFC-359:  regexes matched against "<where>:<path>" for every hit `retire-secrets-dir.sh check` finds.
# <where> is a repo folder name under ~/Code (scanned on origin/main), `checkout:<dir>` (a git checkout under ~/apps),
# or `mac` (an absolute path, so a `mac` key always has a "/" right after the colon).
# An entry here is a mention that is NOT a reader:  a guard that denies access, third-party code, a backup copy, a data
# dump or a test.  Anything else must be migrated to `fleet-secrets get` (Infisical Fleet-OPS, prod).
# Comment-only mentions are NOT listed here on purpose:  they are being reworded in their own files.
# Each regex matches the key, which has no line number:  end a file regex with `$`.

# ---- Group 1:  this script, its test and its allowlist.
^AI-Fleet-Coordinator:scripts/(retire-secrets-dir|test-retire-secrets-dir)

# ---- Group 2:  (none.)  The writer, its script and the one-time seeder are MOVED to ~/apps/_retired by
# `retire-secrets-dir.sh bootout`;  that folder is not scanned.  While the writer is still loaded the check FAILS.

# ---- Group 3:  guards that DENY access to the folder, and word lists that feed a guard.
# secret-guard hooks, their lane-tools copy secret_guard.py, and their tests.
secret[_-]guard
# The guard's word list (".secrets" is one entry in a list of sensitive words).
^AI-Fleet-Coordinator:scripts/fleet_lanes/install_tools\.py$
^mac:.*/apps/lane-tools/fleet_lanes/install_tools\.py$
# BotFleet tool-policy deny lists (protected paths) and the checkouts of BotFleet.
^(BotFleet|checkout:[^:]+):server/(auto-approve|bot-cwd|tool-policy)\.ts$
# HogHunter disk cleaner:  never delete the folder.
^(HogHunter|checkout:hoghunter-[^:]+):(Sources/Storage/DiskCleaner\.swift|scripts/clean\.sh)$
# A .gitignore entry keeps the folder out of git.
(:|/)\.gitignore$

# ---- Group 4:  exclude lists (names of paths a lint must not publish, not reads of them).
^(Fleet-OPS|checkout:fleet-ops[^:]*):scripts/handbook/allowlist\.json$
^mac:.*/apps/handbook-sync/allowlist\.json$

# ---- Group 5:  third-party and vendored code.
^mac:.*/\.cursor/extensions/
^mac:.*/typeshed-fallback/
^mac:.*/apps/upstream/
^mac:.*/apps/_preserved-patches/

# ---- Group 6:  backup and pre-sync copies, and old config copies.
^mac:.*/apps/.*/\.backup-[^/]*/
^mac:.*\.(orig|bak[^/]*)$
^mac:.*/AGENT-SYNC\.md\.pre-sync-

# ---- Group 7:  data dumps (tool output, not code).
# Codex app state files that record past commands and chats;  not read by anything of ours.
^mac:.*/\.codex/(\.codex-global-state\.json|process_manager/chat_processes\.json)$
^mac:.*/apps/\.monitor-mac/findings\.json$
^mac:.*/apps/output\.json$
^mac:.*/apps/bf-strip-kick-grok-scan-[^/]*\.json$

# ---- Group 8:  tests and fixtures.  Spot-checked 2026-10-19:  each builds a temp HOME or secrets dir (mkdtemp,
# tempfile, tmpdir, $self.secrets_dir), stubs fleet-secrets, or only asserts that the folder is DENIED or absent.
# Repos and checkouts only (a `mac` key has a "/" after the colon, so it never matches).
^(checkout:[^:]+|[^:/]+):([^/:][^:]*/)?(tests?|Tests?|__tests__|fixtures)/
^(checkout:[^:]+|[^:/]+):([^/:][^:]*/)?(test[_-][^/]*|[^/]*[._-]test\.[^/]*|[^/]*Tests?\.[^/]*)$

# ---- Group 9:  Autorotate is dead and stays archived (Jay's ruling, AFC-359);  it is excluded from the migration
# and from this check.
^Autorotate:
^mac:.*/(rotate\.py|autorotate[^/]*)$

# ---- Group 10:  dated records and historical write-ups (not instructions).
(EFFORT-LOG|HANDOFF-|ROTATION)

# ---- Group 11:  reviewed leftovers from the per-repo sweeps (AFC-359, Oct 19).  Each file was read in context:  a guard that
# denies the folder, a test that only asserts the folder is denied or absent (temp HOME or a stubbed fleet-secrets), or the
# word `secrets` after a dot (a property or jq filter, not a path).
# Small repos.
^(Congress\.Trade:(app/src/delivery/__tests__/healthCache\.test\.ts|app/src/secrets/infisical\.ts|app/sync_db\.ts|app/vendor/congress-trading-shared/src/infisicalSettings\.ts|scripts/infisical-secrets-safe\.sh)|(HogHunter|DealDex|ContactLogo|CodeCaps|FleetLink|Personal-Site):scripts/infisical-fetch\.mjs|Clutch:(scripts/infisical-fetch\.mjs|src/shared/infisicalSettings\.ts)|congress-trading-shared:src/infisicalSettings\.ts|HogHunter:Tests/HogHunterTests/MaintainInfisicalTests\.swift|DealDex:src/lib/server/app-settings\.test\.ts|ContactLogo:web/scripts/infisical-settings\.ts|CodeCaps:scripts/cursor-cloud-start\.sh|FleetLink:(scripts/ios-load-signing\.mjs|test/ios-signing\.test\.mjs)|Personal-Site:site/tests/unit/settings\.test\.ts)$
^HogHunter:(Sources/Storage/DiskCleaner\.swift|scripts/clean\.sh|scripts/hoghunter-mcp\.py)$
^(HogHunter:Tests/HogHunterTests/DiskCleanerTests\.swift|(HogHunter|DealDex|ContactLogo|CodeCaps):scripts/ios-fleet/test-asc-credentials\.sh|FleetLink:test/skill-install\.test\.mjs|Congress\.Trade:scripts/ios-ship-workflow\.test\.mjs)$
# Socratic-Trade and Usage-Monitor.
^Socratic-Trade:scripts/infisical-secrets-safe\.sh$
^Socratic-Trade:test/(infisical-settings|infisical-bootstrap|ios-manual-signing)\.test\.ts$
^Usage-Monitor:(ios/.*\.swift|scripts/(infisical-fetch|local-keys-bundle)\.mjs|src/lib/(__tests__/local-keys-bundle\.test|infisical-provider-sync|platform-status/probes/secrets)\.ts)$
# BotFleet and Fleet-OPS.
^BotFleet:server/(auto-approve|bot-cwd|tool-policy)\.ts$
^BotFleet:(server/tool-policy\.test\.ts|server/zulip/credentials\.test\.ts|server/drivers/acp/allowlist-core\.test\.ts|scripts/ios-ship-workflow\.node-test\.mjs)$
^Fleet-OPS:scripts/handbook/(build\.mjs|sync\.mjs|allowlist\.json|tests/build\.test\.mjs)$

# ---- Group 12:  fleetlink-legacy is retired (its GitHub repo is gone;  FleetLink origin/main deploys the new `fleetlink-api`
# Worker, which has no ~/.secrets text).  The legacy Worker `fleet-share-api` was redeployed as v62 with the setup text
# pointing at `fleet-secrets --path /fleetlink-auth`;  the fix lives only in the CLAUDE hotfix lane
# (~/apps/lanes/fleetlink/claude-legacy-hotfix, skipped by the check) and must not be pushed.  The ~/Code checkout still
# holds the old text:  idle.
^fleetlink-legacy:

# ---- Group 13:  AFC leftovers after the sweep (#696), each read in context.
# Explicit override with NO default:  AGENT_SYNC_SECRETS_DIR / secrets_dir points somewhere only when the caller sets it.
^AI-Fleet-Coordinator:scripts/agent_sync/(config|identities|zulip|launchd|listener_cli|daemon|mcp/stdio)\.py$
# fleet_rag/infisical_settings.py:61-62 IDENTITY_FILE_DEFAULT is a cloud-machine path under ~/workspace (the recall service
# host), NOT this Mac's ~/.secrets.  Left unchanged on purpose.
^AI-Fleet-Coordinator:scripts/fleet_rag/infisical_settings\.py$
# Guards and never-stage lists:  fleet_work_backup.py:257 (name filter), fleet_lanes/install_tools.py:834,842 (word list),
# fleet_rag/sources.py:88,1326 (ingest exclude list), zulip_provision_bots.py:207-211 (refuses to write into the folder).
^AI-Fleet-Coordinator:scripts/(fleet-work-backup/fleet_work_backup|fleet_rag/sources|zulip_provision_bots)\.py$

# ---- Group 14:  live Mac copies of reviewed files (see the repo entries above for the reasons).
# fleet_work_backup.py:257 is a never-stage name filter.  handbook-sync:  the public-output lint that BLOCKS paths under the folder
# (build.mjs:323, sync.mjs:535), a comment that the file is never read (sync.mjs:831) and a state record naming a commit subject.
^mac:.*/apps/fleet-work-backup/fleet_work_backup\.py$
^mac:.*/apps/handbook-sync/(build\.mjs|sync\.mjs|state\.json)$
# An idle copy of BotFleet's companion that no LaunchAgent or pm2 job runs (companion/src/apns.ts default key path).
^mac:.*/apps/botfleet-mm-connected-apps-copy/
