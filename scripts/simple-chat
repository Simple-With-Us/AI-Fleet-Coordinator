#!/usr/bin/env python3
"""simple-chat: the fleet's Zulip coordination CLI.  See scripts/agent_sync/README.md.

This file is symlinked as ~/.local/bin/simple-chat, so it resolves its own real path before it
puts the scripts directory on sys.path.

`attach` and `detach` (the Claude Code hooks run them on every prompt and Stop) are dispatched
before the CLI is imported, so the hook path loads only light modules.  So is `letter`, the
session-letter hook (AFC-564).

Under launchd or a GUI app, `/usr/bin/env python3` can be the system Python 3.9, which cannot
run this package.  Then the script re-runs itself with a Homebrew python3 when one exists.
This part must stay valid Python 3.9."""
import os
import sys

if sys.version_info < (3, 11):
    for candidate in ("/opt/homebrew/bin/python3", "/usr/local/bin/python3"):
        if os.access(candidate, os.X_OK) and os.path.realpath(candidate) != os.path.realpath(sys.executable):
            os.execv(candidate, [candidate, os.path.realpath(__file__)] + sys.argv[1:])
    sys.stderr.write("simple-chat: Python 3.11 or newer is required (found %d.%d)\n" % sys.version_info[:2])
    sys.exit(1)

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

# SIMPLE_CHAT_REMOTE=1 never runs listener verbs locally:  skip the fast path so cli.main refuses them.
if (
    __name__ == "__main__"
    and len(sys.argv) > 1
    and sys.argv[1] in ("attach", "detach")
    and os.environ.get("SIMPLE_CHAT_REMOTE", "").strip() != "1"
):
    from agent_sync.attach import main as attach_main  # noqa: E402

    sys.exit(attach_main(sys.argv[2:], command=sys.argv[1]))

# `letter` (AFC-564) is the Claude Code session-letter hook and its registry side;  it is local like attach.
if (
    __name__ == "__main__"
    and len(sys.argv) > 1
    and sys.argv[1] == "letter"
    and os.environ.get("SIMPLE_CHAT_REMOTE", "").strip() != "1"
):
    from agent_sync.claude_letter import main as letter_main  # noqa: E402

    sys.exit(letter_main(sys.argv[2:]))

# Deterministic handbook service is not a roster seat or an admin API escape hatch.
if __name__ == "__main__" and len(sys.argv) > 1 and sys.argv[1] == "handbook-service":
    from agent_sync.handbook_service import main as handbook_main
    sys.exit(handbook_main(sys.argv[2:]))

# --- seat remote defaults (host helper, optional) ---
_SEAT_HELPER_ANCHOR = "/"


def _seat_defaults(command):
    """Run the host's seat helper when the host has installed one.  The helper picks the declared seat's own
    hosted route and holds no credential.  ABSENT (a missing path component or file) is the optional case:  do
    nothing, the tool behaves as before.  PRESENT but not trustworthy, or failing for any reason other than its
    own SystemExit, is a refusal (exit 3):  a broken or swapped helper never degrades to an un-routed run.
    Trust is checked on file descriptors:  the directory chain is walked from the anchor with no symlink
    followed (each directory owned by root or this user and closed to group/other write), the file is opened
    O_NOFOLLOW|O_NONBLOCK from its parent fd, must be a regular single-link file owned by this user and closed
    to group/other write, and the code that runs is exactly the bytes read from that open descriptor."""
    import errno
    import pwd
    import stat

    uid = os.getuid()
    try:
        folder = os.path.join(pwd.getpwuid(uid).pw_dir, ".config", "fleet-cli")
    except KeyError:
        return
    anchor = os.path.normpath(_SEAT_HELPER_ANCHOR)
    folder = os.path.normpath(folder)
    prefix = anchor if anchor.endswith("/") else anchor + "/"
    if folder != anchor and not folder.startswith(prefix):
        return
    parts = [p for p in folder[len(anchor):].split("/") if p]
    name = "seat-remote-defaults.py"
    fds = []
    code = None
    try:
        try:
            flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
            current = os.open(anchor, flags)
            fds.append(current)
            chain = [current]
            for part in parts:
                current = os.open(part, flags, dir_fd=current)
                fds.append(current)
                chain.append(current)
            for fd in chain:
                info = os.fstat(fd)
                if info.st_uid not in (0, uid) or info.st_mode & 0o022:
                    raise PermissionError
            fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK, dir_fd=current)
            fds.append(fd)
        except OSError as exc:
            if exc.errno == errno.ENOENT:
                return
            raise
        info = os.fstat(fd)
        if (
            not stat.S_ISREG(info.st_mode)
            or info.st_uid != uid
            or info.st_mode & 0o022
            or info.st_nlink != 1
            or not 0 < info.st_size <= 262144
        ):
            raise PermissionError
        data = b""
        while len(data) <= 262144:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            data += chunk
        if len(data) != info.st_size:
            raise PermissionError
        path = os.path.join(folder, name)
        code = compile(data, path, "exec")
    except Exception:
        sys.stderr.write("fleet-cli: the seat helper could not be trusted\n")
        raise SystemExit(3) from None
    finally:
        for fd in fds:
            try:
                os.close(fd)
            except OSError:
                pass
    try:
        exec(code, {"__name__": "__seat_helper__", "__file__": path, "fleet_command": command})
    except SystemExit:
        raise
    except Exception:
        sys.stderr.write("fleet-cli: the seat helper failed\n")
        raise SystemExit(3) from None


# --- end seat remote defaults ---

from agent_sync.cli import main  # noqa: E402

if __name__ == "__main__":
    _seat_defaults("simple-chat")
    sys.exit(main(sys.argv[1:], prog="simple-chat"))