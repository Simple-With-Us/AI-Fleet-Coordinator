#!/usr/bin/env python3
"""The Antigravity platform's ONLY unique part:  its delivery mechanism (owner ruling, Nov 10-11).

Everything else is the ONE shared router, simple_tools/wake_router.py.  Antigravity wakes
a chat with a headless agy run on the picked conversation;  the command template below is
this platform's entire contribution.

Python 3.11+, standard library only.
"""

from __future__ import annotations

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from simple_tools.wake_router import RouterSpec, serve_with

SPEC = RouterSpec(
    seat="AG",
    platform="antigravity",
    display="Antigravity",
    delivery_argv=(
        "/mnt/fleet-extra/apps/cli/agy/bin/agy",
        "--conversation",
        "{session_id}",
        "-p",
        "{wake_text}",
    ),
)

if __name__ == "__main__":
    sys.exit(serve_with(SPEC, sys.argv[1:]))
