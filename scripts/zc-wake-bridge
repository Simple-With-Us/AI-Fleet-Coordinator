#!/usr/bin/env python3
"""zc-wake-bridge:  the webhook the Operator's http wake reaches, and the deliverer that turns
one wake into a prompt in a specific ZCode thread (OPS-1048, owner request Nov 7, 2026).

The chain.  A message that tags @ZC or DMs the seat lands in the seat's inbox on the listener
that holds it (the Mac instance today).  When the seat's section carries wake = "http", the
listener POSTs the fixed agent-sync-wake/1 contract to the seat's routine URL, signed with the
routine key, the same path the Grok personas and Jet follow.  This bridge is that routine's
receiver:  it answers the POST, remembers the wake id, resolves which lettered ZCode session the
wake belongs to, and runs the delivery command in that session.

It holds no Zulip key and no listener state.  Its one secret is the routine key, read from a
0600 file on every request.  Its registry access is the Operator's read API, signed as the
OPERATOR principal from the environment the unit sources (the same shared env file the letter
hooks use).  Message bodies never pass through it:  the wake payload carries metadata and a
bounded excerpt, and the delivered prompt names the thread, never quotes it.

Delivery.  The command is configuration (a template in the config file), because the model a
headless ZCode run uses is the desktop's provider order, and which provider that should be is
the owner's call:  on this server the first entry (MiniMax) holds a dead key today, so delivery
ships disabled (config delivery_enabled false) and every wake this bridge accepts is still
logged, deduped and answered.  The target resolution is deterministic:  the live zcode
registration whose title shares the wake topic's words, else the most recently seen live
registration on this host;  a session the store calls a subagent or one whose host this bridge
cannot reach (the Mac desktop has no zcode CLI) is skipped with the reason logged.

Usage:
  zc-wake-bridge serve [--bind ADDR] [--port N] [--config FILE] [--state DIR]
  zc-wake-bridge deliver --wake-id ID [--topic T] [--channel C] [--link URL] [--config FILE]

Python 3.11+, standard library only.
"""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from typing import Any

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

CONTRACT = "agent-sync-wake/1"
SEAT = "ZC"
DEFAULT_PORT = 8791
MAX_BODY = 64 * 1024
MAX_TITLE = 120
SEEN_CAP = 200
SESSION_ID_RE = re.compile(r"^[A-Za-z0-9._-]{1,128}$")
WORD_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9_-]{2,}")
STOP_WORDS = frozenset(
    "the a an and or of to in on for with at by from zcode ops ale the this that".split()
)

ENV_URL = "SIMPLE_TOOLS_OPERATOR_REGISTRY_URL"
ENV_PRINCIPAL = "SIMPLE_TOOLS_OPERATOR_REGISTRY_PRINCIPAL"
ENV_KEY = "SIMPLE_TOOLS_OPERATOR_REGISTRY_KEY"

WAKE_TEXT = (
    "[{seat}\u00b7wake] You were tagged in Zulip:  #{channel} / {topic}.  {link}\n"
    "Wake id {wake_id}.  Read your inbox with `simple-chat inbox --peek`, respond in that "
    "thread, and follow your seat rules.  This prompt was delivered by the Operator's wake "
    "bridge;  the message text is not quoted here on purpose."
)

DEFAULT_CONFIG = {
    "delivery_enabled": False,
    "command_template": ["zcode", "--resume", "{session_id}", "-p", "{wake_text}"],
    "timeout_seconds": 900,
    "target_host": "server",
}


def state_dir(env: dict[str, str]) -> Path:
    base = env.get("ZC_WAKE_STATE") or os.path.join(
        str(env.get("HOME") or os.path.expanduser("~")), ".local", "state"
    )
    return Path(base) / "zc-wake"


def load_config(path: Path) -> dict[str, Any]:
    config = dict(DEFAULT_CONFIG)
    try:
        loaded = json.loads(path.read_text(encoding="utf-8"))
        if isinstance(loaded, dict):
            for key in DEFAULT_CONFIG:
                if key in loaded:
                    config[key] = loaded[key]
    except (OSError, ValueError):
        pass
    return config


def read_key(env: dict[str, str]) -> str:
    path = Path(env.get("ZC_WAKE_KEY_FILE") or str(state_dir(env) / "routine-key"))
    try:
        key = path.read_text(encoding="utf-8").strip()
        mode = os.stat(path).st_mode & 0o777
    except OSError:
        return ""
    if mode & 0o077 or len(key) < 16:
        return ""
    return key


# --------------------------------------------------------------------------------------------
# The registry read:  which lettered sessions are live, and which one the wake belongs to.
# --------------------------------------------------------------------------------------------


def registry_history(env: dict[str, str], limit: int = 50) -> list[dict[str, Any]]:
    """The Operator registry's zcode rows, over its read API.  Empty on any failure:  a wake
    that cannot see the registry is logged undelivered, never guessed."""
    seam = (env.get("ZC_WAKE_HISTORY_FILE") or "").strip()
    if seam:
        # A test seam, named like the other stand-in variables in this repo's tests:  the rows
        # a real call would have brought back, so no network is involved in a test.
        try:
            with open(seam, encoding="utf-8") as fh:
                answer = json.load(fh)
            if isinstance(answer, list):
                return answer
            return answer.get("items") or [] if isinstance(answer, dict) else []
        except (OSError, ValueError):
            return []
    url = (env.get(ENV_URL) or "").strip()
    if not url:
        return []
    principal = (env.get(ENV_PRINCIPAL) or "").strip() or "OPERATOR"
    key = (env.get(ENV_KEY) or "").strip()
    if not key:
        return []
    from agent_sync import listener_registry as RG

    path = RG.PREFIX + "history"
    query = "platform=zcode&limit=%d" % limit
    try:
        parts = urllib.parse.urlsplit(url)
        target = url.rstrip("/") + path + "?" + query
        request = urllib.request.Request(target, method="GET")
        headers = RG.headers(key, "GET", path, query, principal, b"", time.time())
        for name, value in headers.items():
            request.add_header(name, value)
        with urllib.request.urlopen(request, timeout=10) as response:
            answer = json.loads(response.read().decode("utf-8"))
    except (OSError, ValueError, KeyError):
        return []
    rows = answer.get("rows") or answer.get("records") or answer.get("items") or []
    return rows if isinstance(rows, list) else []


def _words(text: str) -> set[str]:
    return {w for w in WORD_RE.findall(text or "") if w.lower() not in STOP_WORDS}


def pick_target(
    rows: list[dict[str, Any]], topic: str, store: Path, target_host: str
) -> tuple[str, str]:
    """(native session id, why) for the best live row, or ("", reason).  Rows that resolve to a
    session the store calls a subagent, or that live on another host, never win."""
    topic_words = _words(topic)
    best: tuple[float, float, str] = (0.0, 0.0, "")
    fallback: tuple[float, str] = (0.0, "")
    for row in rows:
        if not isinstance(row, dict):
            continue
        if row.get("retired_at") or row.get("closed_at") or str(row.get("state") or "") == "closed":
            continue  # a retired letter or a closed registration is not a chat to wake
        host = str(row.get("verified_host") or "")
        if target_host and host and host != target_host:
            continue
        sid = str(row.get("native_session_id") or "")
        if not SESSION_ID_RE.fullmatch(sid):
            continue
        if _is_subagent(store, sid):
            continue
        seen = float(row.get("assigned_at") or 0)
        title_words = _words(str(row.get("title") or ""))
        overlap = len(topic_words & title_words) if topic_words else 0
        candidate = (float(overlap), seen, sid)
        if overlap > 0 and candidate[:2] > best[:2]:
            best = candidate
        if seen > fallback[0]:
            fallback = (seen, sid)
    if best[2]:
        return best[2], "topic-match"
    if fallback[1]:
        return fallback[1], "most-recent"
    return "", "no-live-session"


def _is_subagent(store: Path, sid: str) -> bool:
    try:
        import sqlite3

        conn = sqlite3.connect("file:%s?mode=ro" % store, uri=True, timeout=5)
        try:
            row = conn.execute(
                "SELECT task_type FROM session WHERE id = ?", (sid,)
            ).fetchone()
        finally:
            conn.close()
        return bool(row) and str(row[0] or "") == "subagent_child"
    except (OSError, ValueError):
        return False


# --------------------------------------------------------------------------------------------
# Delivery:  one prompt into one session, once, with a lock and a receipt.
# --------------------------------------------------------------------------------------------


def seen_ids(path: Path) -> set[str]:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        return {str(x) for x in data} if isinstance(data, list) else set()
    except (OSError, ValueError):
        return set()


def remember_id(path: Path, wake_id: str) -> None:
    ids = sorted(seen_ids(path) | {wake_id})[-SEEN_CAP:]
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    tmp = path.with_suffix(".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(json.dumps(ids) + "\n")
    os.replace(tmp, path)


def session_lock(store_dir: Path, sid: str):
    """An exclusive mark per target session, so one wake waits rather than two turns clobber
    one thread.  The lock lives on a descriptor this process holds for the delivery."""
    store_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    return open(os.open(str(store_dir / ("session-%s.lock" % sid)), os.O_CREAT | os.O_RDWR, 0o600), "w")


def deliver(
    env: dict[str, str],
    config: dict[str, Any],
    *,
    wake_id: str,
    topic: str,
    channel: str,
    link: str,
    log_path: Path | None = None,
) -> dict[str, Any]:
    """Resolve the target and run the delivery command.  The answer is the receipt:  delivered
    true or false, with the reason either way.  Never raises."""
    if not config.get("delivery_enabled"):
        return {"delivered": False, "reason": "delivery-disabled"}
    store = Path(env.get("ZC_WAKE_STORE") or os.path.join(
        str(env.get("HOME") or os.path.expanduser("~")), ".zcode", "cli", "db", "db.sqlite"
    ))
    rows = registry_history(env)
    sid, why = pick_target(rows, topic, store, str(config.get("target_host") or "server"))
    if not sid:
        return {"delivered": False, "reason": why}
    text = WAKE_TEXT.format(
        seat=SEAT, channel=channel or "-", topic=topic or "-", link=link or "", wake_id=wake_id
    )
    argv = [
        str(part).replace("{session_id}", sid).replace("{wake_text}", text)
        for part in (config.get("command_template") or [])
    ]
    if not argv:
        return {"delivered": False, "reason": "no-command"}
    lock_path = state_dir(env)
    with session_lock(lock_path, sid) as lock:
        try:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return {"delivered": False, "reason": "session-busy", "session_id": sid}
        spawn_env = dict(env)
        spawn_env["AGENT_LAUNCHER"] = "agent-sync-wake"
        spawn_env["AGENT_LAUNCH_SEAT"] = SEAT
        try:
            import subprocess

            proc = subprocess.run(
                argv,
                env=spawn_env,
                capture_output=True,
                timeout=int(config.get("timeout_seconds") or 900),
                check=False,
            )
            delivered = proc.returncode == 0
            reason = "ok" if delivered else "command-failed-%d" % proc.returncode
        except subprocess.TimeoutExpired:
            delivered, reason = False, "command-timeout"
        except OSError as exc:
            delivered, reason = False, "command-error-%s" % type(exc).__name__
    receipt = {
        "at": time.time(),
        "wake_id": wake_id,
        "session_id": sid,
        "picked": why,
        "delivered": delivered,
        "reason": reason,
    }
    if log_path is None:
        log_path = state_dir(env) / "delivery.jsonl"
    try:
        log_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        with open(log_path, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(receipt, sort_keys=True) + "\n")
    except OSError:
        pass
    return receipt


# --------------------------------------------------------------------------------------------
# The HTTP receiver.
# --------------------------------------------------------------------------------------------


def make_handler(env: dict[str, str], config: dict[str, Any], receipts: list[dict[str, Any]]):
    class Handler(BaseHTTPRequestHandler):
        def log_message(self, fmt: str, *args: Any) -> None:  # default logging prints paths
            pass

        def _answer(self, code: int, payload: dict[str, Any]) -> None:
            body = (json.dumps(payload) + "\n").encode("utf-8")
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self) -> None:
            if self.path == "/health":
                self._answer(200, {"ok": True, "seat": SEAT})
            else:
                self._answer(404, {"error": "not found"})

        def do_POST(self) -> None:
            key = read_key(env)
            if not key:
                self._answer(503, {"error": "the routine key is missing or unreadable"})
                return
            auth = self.headers.get("Authorization") or ""
            if auth != "Bearer %s" % key:
                self._answer(401, {"error": "bad bearer"})
                return
            if not re.fullmatch(r"/wake/[A-Z0-9][A-Z0-9_-]{0,31}", self.path or ""):
                self._answer(404, {"error": "not found"})
                return
            length = int(self.headers.get("Content-Length") or 0)
            if length <= 0 or length > MAX_BODY:
                self._answer(413, {"error": "body size refused"})
                return
            try:
                payload = json.loads(self.rfile.read(length).decode("utf-8"))
            except (ValueError, UnicodeDecodeError):
                self._answer(400, {"error": "body is not JSON"})
                return
            if not isinstance(payload, dict) or payload.get("contract") != CONTRACT:
                self._answer(400, {"error": "unknown contract"})
                return
            if str(payload.get("seat") or "") != SEAT:
                self._answer(403, {"error": "seat mismatch"})
                return
            wake_id = str(payload.get("wake_id") or "")
            if not SESSION_ID_RE.fullmatch(wake_id):
                self._answer(400, {"error": "wake_id missing or malformed"})
                return
            seen_path = state_dir(env) / "seen.json"
            if wake_id in seen_ids(seen_path):
                self._answer(200, {"delivered": False, "reason": "already-seen", "wake_id": wake_id})
                return
            remember_id(seen_path, wake_id)
            receipt = deliver(
                env,
                config,
                wake_id=wake_id,
                topic=str(payload.get("topic") or ""),
                channel=str(payload.get("channel") or ""),
                link=str(payload.get("zulip_link") or ""),
            )
            receipts.append({"wake_id": wake_id, **receipt})
            del receipts[:-50]
            self._answer(200, {"wake_id": wake_id, **receipt})

    return Handler


def serve(env: dict[str, str], bind: str, port: int, config: dict[str, Any]) -> int:
    receipts: list[dict[str, Any]] = []
    server = ThreadingHTTPServer((bind, port), make_handler(env, config, receipts))
    server.daemon_threads = True
    print("zc-wake-bridge listening on %s:%d for seat %s" % (bind, port, SEAT), flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
    return 0


def main(argv: list[str] | None = None) -> int:
    env = dict(os.environ)
    parser = argparse.ArgumentParser(prog="zc-wake-bridge")
    sub = parser.add_subparsers(dest="cmd", required=True)
    p_serve = sub.add_parser("serve")
    p_serve.add_argument("--bind", default="127.0.0.1")
    p_serve.add_argument("--port", type=int, default=DEFAULT_PORT)
    p_deliver = sub.add_parser("deliver")
    p_deliver.add_argument("--wake-id", required=True)
    p_deliver.add_argument("--topic", default="")
    p_deliver.add_argument("--channel", default="")
    p_deliver.add_argument("--link", default="")
    for p in (p_serve, p_deliver):
        p.add_argument("--config", default="")
    args = parser.parse_args(argv)
    config_path = Path(
        args.config
        or env.get("ZC_WAKE_CONFIG")
        or str(state_dir(env) / "config.json")
    )
    config = load_config(config_path)
    if args.cmd == "serve":
        return serve(env, args.bind, args.port, config)
    receipt = deliver(
        env,
        config,
        wake_id=args.wake_id,
        topic=args.topic,
        channel=args.channel,
        link=args.link,
    )
    print(json.dumps(receipt, sort_keys=True))
    return 0 if receipt.get("delivered") else 1


if __name__ == "__main__":
    sys.exit(main())
