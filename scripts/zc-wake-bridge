#!/usr/bin/env python3
"""The ZCode platform's ONLY unique part:  its delivery mechanism (owner ruling, Nov 10-11).

Everything else - the receiver, dedupe, the deterministic pick, receipts, the
accept-then-deliver worker - is the ONE shared router, simple_tools/wake_router.py.
ZCode wakes a chat with a headless resume of the picked session;  the command template
below is this platform's entire contribution.

Python 3.11+, standard library only.
"""

from __future__ import annotations

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from simple_tools.wake_router import RouterSpec, serve_with

SPEC = RouterSpec(
    seat="ZC",
    platform="zcode",
    display="ZCode",
    target_pattern=r"^sess_[A-Za-z0-9._-]{1,123}$",
    thread_link_form="zcode://session/{sid}",
    delivery_argv=(
        "/home/jay/.local/bin/zcode",
        "--resume",
        "{session_id}",
        "-p",
        "{wake_text}",
    ),
)

if __name__ == "__main__":
    sys.exit(serve_with(SPEC, sys.argv[1:]))
