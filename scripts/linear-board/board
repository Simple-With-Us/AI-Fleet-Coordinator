def read_private_file(path: str, flag: str) -> bytes:
    """The bytes of a file a seat handed over so its text stays out of argv:  a regular file owned by
    the caller with mode exactly 0600 or 0400, at most INPUT_MAX_BYTES.  The checks run on the open
    descriptor (O_NOFOLLOW refuses a symlink, O_NONBLOCK keeps a FIFO from hanging), so the file cannot
    be swapped between the check and the read.  Anything else exits 2.  The text is never echoed."""
    flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | getattr(os, "O_CLOEXEC", 0)
    try:
        fd = os.open(path, flags)
    except OSError as e:
        if e.errno == errno.ELOOP:
            die(f"{flag} {path}: is a symbolic link;  pass the real file", EXIT_USAGE)
        die(f"{flag} {path}: cannot open it ({e.strerror or type(e).__name__})", EXIT_USAGE)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            die(f"{flag} {path}: not a regular file", EXIT_USAGE)
        if st.st_uid != os.geteuid():
            die(f"{flag} {path}: not owned by you", EXIT_USAGE)
        mode = stat.S_IMODE(st.st_mode)
        if mode not in (0o600, 0o400):
            die(f"{flag} {path}: mode {mode:04o} is not 0600 or 0400, so others may read or change it;  "
                f"run chmod 600 on it first", EXIT_USAGE)
        if st.st_size > INPUT_MAX_BYTES:
            die(f"{flag} {path}: more than {INPUT_MAX_BYTES // 1024} KB", EXIT_USAGE)
        data = b""
        while len(data) <= INPUT_MAX_BYTES:
            chunk = os.read(fd, INPUT_MAX_BYTES + 1 - len(data))
            if not chunk:
                break
            data += chunk
        return data
    finally:
        os.close(fd)


def read_text_input(src: str, flag: str) -> str:
    """Text for --desc-file, --fix-file or --text-file:  the private file at `src`, or standard input
    for `-`.  At most INPUT_MAX_BYTES of strict UTF-8, else exit 2."""
    if src == "-":
        data = sys.stdin.buffer.read(INPUT_MAX_BYTES + 1)
        where = "standard input"
    else:
        data = read_private_file(src, flag)
        where = src
    if len(data) > INPUT_MAX_BYTES:
        die(f"{flag} {where}: more than {INPUT_MAX_BYTES // 1024} KB", EXIT_USAGE)
    try:
        return data.decode("utf-8")
    except UnicodeDecodeError:
        die(f"{flag} {where}: not valid UTF-8", EXIT_USAGE)


def flat_label(raw: str | None, flag: str = "--label") -> str:
    """The canonical name of an allowed flat label, or exit 2 saying why it is refused.  Matching ignores
    case and surrounding spaces, so Needs-Owner is needs-owner and never a second label."""
    name = (raw or "").strip()
    low = name.lower()
    if low in FLAT_LABELS:
        return low
    if low.startswith(CLAIM_PREFIX):
        why = "a claimed:* label is a claim;  `board claim` writes it"
    elif low.startswith(SEAT_PREFIX):
        why = "a seat:* label is attribution;  `board claim` and `board file` write it"
    elif low.split("/", 1)[0] in ("kind", "severity", "env") or low in ("kind", "severity", "env"):
        why = "Kind, Severity and Env are single-select groups;  use --kind, --severity or --env"
    elif low in KINDS:
        why = "that is a Kind;  use --kind"
    elif low.upper() in SEVERITIES:
        why = "that is a Severity;  use --severity"
    elif low in ENVS:
        why = "that is an Env;  use --env"
    else:
        why = "it is not one of the flat labels this CLI may set"
    die(f"{flag} {raw!r}: {why}.  Allowed:  {', '.join(FLAT_LABELS)}", EXIT_USAGE)


def flat_labels(raws: list[str] | None, flag: str = "--label") -> list[str]:
    """Validated, de-duplicated flat label names in the order given."""
    out: list[str] = []
    for raw in raws or []:
        name = flat_label(raw, flag)
        if name not in out:
            out.append(name)
    return out


def prepare_inputs(a) -> None:
    """Validate flags and read every --*-file before any credential is read or request is sent, so a bad
    input exits 2 having touched nothing.  Runs after the writes-off gate:  a gated write never reads a
    file (or standard input)."""
    if a.cmd in ("file", "list"):
        a.labels = flat_labels(a.labels)
    if a.cmd == "label":
        a.label_name = flat_label(a.label_name, "NAME")
    files = []
    if a.cmd == "file":
        files = [("--desc-file", a.desc_file, "desc"), ("--fix-file", a.fix_file, "fix")]
    elif a.cmd == "comment":
        files = [("--text-file", a.text_file, "text")]
    files = [f for f in files if f[1] is not None]
    if sum(1 for f in files if f[1] == "-") > 1:
        die("only one of --desc-file and --fix-file can read standard input (-)", EXIT_USAGE)
    for flag, src, attr in files:
        text = read_text_input(src, flag)
        if a.cmd == "comment" and not text.strip():
            die(f"{flag} {'standard input' if src == '-' else src}: the comment text is empty", EXIT_USAGE)
        setattr(a, attr, text)


# ----------------------------------------------------------------- credentials and token

def cred_path() -> Path:
    return Path(env("LINEAR_FLEET_ENV") or (Path.home() / ".secrets" / "Linear" / "Fleet.env")).expanduser()


def token_cache_path() -> Path:
    return Path(env("LINEAR_FLEET_TOKEN_CACHE")
                or (Path.home() / ".secrets" / "Linear" / "cache" / "Fleet.token")).expanduser()


ID_KEYS = ("LINEAR_CLIENT_ID", "LINEAR_FLEET_CLIENT_ID")
SECRET_KEYS = ("LINEAR_CLIENT_SECRET", "LINEAR_FLEET_CLIENT_SECRET")
ENV_PAIR = "environment (LINEAR_CLIENT_ID, LINEAR_CLIENT_SECRET)"


def seat_env_key(seat: str) -> str:
    """The seat as it appears in variable names:  GROK-WEB is GROK_WEB."""
    return seat.replace("-", "_")


def fleet_app_name() -> str:
    return env("LINEAR_FLEET_APP_NAME", "Fleet")


class Identity:
    """The Linear app a run acts as, where its credentials came from (`where`
    is a path or variable names, never a value), the token cache that belongs
    to it, and the viewer names Linear may answer with for it.

    kind "seat":   the seat's own app, from <SEAT>.env or LINEAR_<SEAT>_CLIENT_ID.
    kind "fleet":  the shared Fleet app, from Fleet.env.
    kind "env":    LINEAR_CLIENT_ID and LINEAR_CLIENT_SECRET, a cloud runtime's
                   pair, which may hold the seat's app or Fleet."""

    def __init__(self, kind: str, seat: str, cid: str, sec: str, where: str, cache: Path,
                 accept: tuple, label: str):
        self.kind, self.seat, self.cid, self.sec = kind, seat, cid, sec
        self.where, self.cache, self.accept, self.label = where, cache, accept, label


def read_cred_file(p: Path, id_keys: tuple, secret_keys: tuple) -> tuple[str, str]:
    vals: dict[str, str] = {}
    try:
        for line in p.read_text().splitlines():
            s = line.strip()
            if s.startswith("export "):
                s = s[7:].strip()
            if "=" not in s or s.startswith("#"):
                continue
            k, v = s.split("=", 1)
            k = k.strip()
            if k in id_keys or k in secret_keys:
                vals[k] = v.strip().strip('"').strip("'")
    except OSError as e:
        die(f"cannot read {p} ({type(e).__name__})", EXIT_NO_CREDS)
    return (next((vals[k] for k in id_keys if vals.get(k)), ""),
            next((vals[k] for k in secret_keys if vals.get(k)), ""))


def resolve_identity(seat: str = "") -> Identity:
    """Which Linear app this run acts as.  Only OAuth client credentials of a
    fleet app are read:  a personal or admin API key never is, from any file or
    variable, so the CLI cannot act as Jay.  The first that applies wins:

    1. LINEAR_CLIENT_ID and LINEAR_CLIENT_SECRET in the environment (a cloud
       runtime's pair).  They may hold the seat's app or Fleet; the cache is
       the Fleet one, as before.
    2. With AGENT_SEAT naming a seat in SEAT_APP_NAMES:  <SEAT>.env beside
       Fleet.env, then LINEAR_<SEAT>_CLIENT_ID and LINEAR_<SEAT>_CLIENT_SECRET
       in the environment.  The cache is <SEAT>.token beside Fleet.token.
    3. Fleet.env, the shared Fleet app (every read without AGENT_SEAT, and a
       seat with no app yet)."""
    fleet = fleet_app_name()
    fleet_file = cred_path()
    if fleet_file.suffix != ".env":
        die(f"LINEAR_FLEET_ENV must name a .env file holding only the Fleet app's client credentials; "
            f"refusing {fleet_file}", EXIT_USAGE)
    app = SEAT_APP_NAMES.get(seat, "") if seat else ""
    app_names = seat_app_names(seat)
    cid_e = os.environ.get("LINEAR_CLIENT_ID", "").strip()
    sec_e = os.environ.get("LINEAR_CLIENT_SECRET", "").strip()
    if cid_e and sec_e:
        return Identity("env", seat, cid_e, sec_e, ENV_PAIR, token_cache_path(),
                        tuple(n for n in (*app_names, fleet) if n), "LINEAR_CLIENT_ID app")
    seat_file = fleet_file.parent / f"{seat}.env" if app else None
    k = seat_env_key(seat)
    if app:
        seat_cache = token_cache_path().parent / f"{seat}.token"
        if seat_file.is_file():
            cid, sec = read_cred_file(seat_file, ("LINEAR_CLIENT_ID", f"LINEAR_{k}_CLIENT_ID"),
                                      ("LINEAR_CLIENT_SECRET", f"LINEAR_{k}_CLIENT_SECRET"))
            if not (cid and sec):
                die(f"{seat_file} has no LINEAR_CLIENT_ID and LINEAR_CLIENT_SECRET.  Put the {app} app's "
                    f"client credentials in it, or move it aside so {seat} uses the shared {fleet} app.",
                    EXIT_NO_CREDS)
            return Identity("seat", seat, cid, sec, str(seat_file), seat_cache, app_names, f"{app} seat app")
        cid_s = os.environ.get(f"LINEAR_{k}_CLIENT_ID", "").strip()
        sec_s = os.environ.get(f"LINEAR_{k}_CLIENT_SECRET", "").strip()
        if cid_s and sec_s:
            return Identity("seat", seat, cid_s, sec_s,
                            f"environment (LINEAR_{k}_CLIENT_ID, LINEAR_{k}_CLIENT_SECRET)",
                            seat_cache, app_names, f"{app} seat app")
    if fleet_file.is_file():
        cid, sec = read_cred_file(fleet_file, ID_KEYS, SECRET_KEYS)
        if cid and sec:
            return Identity("fleet", seat, cid, sec, str(fleet_file), token_cache_path(), (fleet,),
                            f"shared {fleet} app")
    state = "has no LINEAR_CLIENT_ID and LINEAR_CLIENT_SECRET" if fleet_file.is_file() else "is missing"
    seat_part = (f", and {seat} has no app credentials of its own ({seat_file}, or LINEAR_{k}_CLIENT_ID and "
                 f"LINEAR_{k}_CLIENT_SECRET)") if app else ""
    die(f"no Fleet credentials: {fleet_file} {state}, and LINEAR_CLIENT_ID and LINEAR_CLIENT_SECRET are not "
        f"set{seat_part}.  Jay creates the Fleet Linear app and its client credentials first (linear-migration "
        "design section 2).  Until then use BOARD_BACKEND=mac-collab.", EXIT_NO_CREDS)


def _read_cache(fd: int) -> dict:
    os.lseek(fd, 0, os.SEEK_SET)
    raw = b""
    while True:
        chunk = os.read(fd, 65536)
        if not chunk:
            break
        raw += chunk
    try:
        cache = json.loads(raw) if raw.strip() else {}
    except ValueError:
        cache = {}
    return cache if isinstance(cache, dict) else {}


def _write_cache(fd: int, cache: dict) -> None:
    os.lseek(fd, 0, os.SEEK_SET)
    os.ftruncate(fd, 0)
    os.write(fd, json.dumps(cache).encode())
    os.fsync(fd)


class Auth:
    """The token of one identity, from that identity's own flock-protected
    cache file, so two seats on one host never share a token or a lock.
    Mints at most once per 24 hours per host and cache file (design section
    2).  The token is never printed."""

    def __init__(self, token_url: str, ident: Identity | None = None):
        self.token_url = token_url
        # None:  resolved with no seat at the first request, so a caller that
        # names none (relabel_claims.py) acts as the shared Fleet app.
        self.ident = ident
        self.token: str | None = None
        self.info: dict = {}
        self.where = ""

    def identity(self) -> Identity:
        if self.ident is None:
            self.ident = resolve_identity("")
        return self.ident

    @property
    def label(self) -> str:
        return self.ident.label if self.ident else f"shared {fleet_app_name()} app"

    @staticmethod
    def _fingerprint(cid: str, sec: str) -> str:
        return hashlib.sha256(f"linear-board:creds:{cid}:{sec}".encode()).hexdigest()[:16]

    def _open(self) -> int:
        path = self.identity().cache
        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o600)
        fcntl.flock(fd, fcntl.LOCK_EX)
        os.fchmod(fd, 0o600)
        return fd

    @staticmethod
    def _close(fd: int) -> None:
        try:
            fcntl.flock(fd, fcntl.LOCK_UN)
        finally:
            os.close(fd)

    def get(self, failed: str | None = None) -> str:
        if self.token and self.token != failed:
            return self.token
        ident = self.identity()
        self.where = ident.where
        fp = self._fingerprint(ident.cid, ident.sec)
        fd = self._open()
        try:
            cache = _read_cache(fd)
            now = time.time()
            tok = cache.get("access_token")
            same = cache.get("cred_fp") == fp
            if tok and same and tok != failed and float(cache.get("expires_at") or 0) - now > 3600:
                self.token, self.info = tok, cache
                return tok
            minted = float(cache.get("minted_at") or 0)
            if same and now - minted < 86400 and env("LINEAR_BOARD_REMINT") != "1":
                why = f"Linear refused the cached {ident.label} token" if tok and tok == failed else \
                      f"the cached {ident.label} token is unusable"
                die(f"{why}, and this host minted it {central(minted)}, under 24 hours ago.  Not minting "
                    "again (design section 2: at most one mint a day per host).  If the app was rotated, "
                    "update its credentials file; to force one mint, rerun with LINEAR_BOARD_REMINT=1.",
                    EXIT_AUTH)
            new = self._mint(ident)
            cache = {
                "access_token": new["access_token"],
                "token_type": new.get("token_type") or "Bearer",
                "scope": new.get("scope") or SCOPE,
                "minted_at": now,
                "expires_at": now + float(new.get("expires_in") or 30 * 86400),
                "mint_count": int(cache.get("mint_count") or 0) + 1,
                "cred_fp": fp,
            }
            _write_cache(fd, cache)
            self.token, self.info = cache["access_token"], cache
            return self.token
        finally:
            self._close(fd)

    def remember_viewer(self, viewer: dict, org: dict) -> None:
        """Keep who Linear says the current token belongs to in that token's
        cache entry.  A mint writes a fresh entry, so the record never
        outlives its token, and the write check costs one viewer request per
        mint rather than one per write."""
        if not self.token:
            return
        fd = self._open()
        try:
            cache = _read_cache(fd)
            if cache.get("access_token") != self.token:
                return
            cache["viewer"] = {"name": viewer.get("name"), "app": bool(viewer.get("app")),
                               "workspace": org.get("urlKey")}
            _write_cache(fd, cache)
            self.info = cache
        finally:
            self._close(fd)

    def viewer(self, L: "Linear") -> dict:
        """{name, app, workspace} for the current token:  from its cache entry,
        or one viewer request that is then kept there."""
        self.get()
        v = self.info.get("viewer")
        if isinstance(v, dict) and v.get("name"):
            return v
        try:
            d = L.call(Q_WHOAMI)
        except GqlError as e:
            die(f"cannot confirm which Linear app the credentials in {self.where} belong to: {e}", EXIT_AUTH)
        vw, org = d.get("viewer") or {}, d.get("organization") or {}
        self.remember_viewer(vw, org)
        return {"name": vw.get("name"), "app": bool(vw.get("app")), "workspace": org.get("urlKey")}

    def _mint(self, ident: Identity) -> dict:
        body = urllib.parse.urlencode({
            "grant_type": "client_credentials", "client_id": ident.cid, "client_secret": ident.sec,
            "scope": SCOPE,
        }).encode()
        req = urllib.request.Request(self.token_url, data=body, method="POST", headers={
            "Content-Type": "application/x-www-form-urlencoded", "User-Agent": USER_AGENT})
        timeout = env_float("LINEAR_BOARD_TIMEOUT", 60)
        try:
            with opener().open(req, timeout=timeout) as r:
                js = json.loads(r.read() or b"{}")
        except urllib.error.HTTPError as e:
            try:
                js = json.loads(e.read() or b"{}")
            except ValueError:
                js = {}
            err = str(js.get("error") or "")[:80]
            desc = str(js.get("error_description") or "")[:200]
            die(f"minting the {ident.label} token failed: HTTP {e.code} {err} {desc}".rstrip(), EXIT_AUTH)
        except (urllib.error.URLError, http.client.HTTPException, OSError, ValueError) as e:
            die(f"cannot reach Linear to mint the {ident.label} token ({type(e).__name__})", EXIT_ERROR)
        if not isinstance(js, dict) or not js.get("access_token"):
            die(f"minting the {ident.label} token failed: Linear answered without an access token", EXIT_AUTH)
        return js


def write_identity_problem(ident: Identity, v: dict) -> str:
    """Why this identity may not write, from what Linear says its viewer is;
    empty when it may."""
    name = v.get("name")
    want = " or ".join(repr(n) for n in ident.accept)
    if not v.get("app"):
        why = f"Linear says the credentials in {ident.where} belong to a person ({name!r}), not an app"
    elif not app_name_ok(name, ident.accept, ident.seat):
        why = f"Linear says the credentials in {ident.where} belong to the {name!r} app, not {want}"
    elif v.get("workspace") != WORKSPACE_URL_KEY:
        why = f"the credentials in {ident.where} act in workspace {v.get('workspace')!r}, not {WORKSPACE_URL_KEY!r}"
    else:
        return ""
    if ident.kind == "seat":
        fix = (f"They look swapped with another seat's.  Put the {' or '.join(ident.accept)} app's client credentials "
               f"there, or move them aside so {ident.seat} writes as the shared {fleet_app_name()} app.")
    else:
        fix = ("Set LINEAR_CLIENT_ID and LINEAR_CLIENT_SECRET to this seat's app or the shared "
               f"{fleet_app_name()} app, or unset them.")
    return f"{why}.  {fix}"


def check_write_identity(L: "Linear", auth: Auth) -> None:
    """Before a write, a seat app (or the environment's pair) must be the app
    it claims to be:  swapped credentials would sign one seat's words as
    another's.  Reads skip this.  The shared Fleet app is not checked here,
    as before."""
    ident = auth.identity()
    if ident.kind == "fleet":
        return
    problem = write_identity_problem(ident, auth.viewer(L))
    if problem:
        die(f"refusing to write as {ident.seat}: {problem}  Reads still work.", EXIT_NO_CREDS)


# ----------------------------------------------------------------- GraphQL client

class GqlError(Exception):
    def __init__(self, errors: list, data=None):
        self.errors = [e for e in (errors or []) if isinstance(e, dict)] or [{"message": "unknown error"}]
        self.data = data
        super().__init__("; ".join((e.get("message") or "error")[:300] for e in self.errors))

    def not_found(self) -> bool:
        for e in self.errors:
            code = str((e.get("extensions") or {}).get("code") or "").upper()
            if code in ("NOT_FOUND", "ENTITY_NOT_FOUND") or \
                    re.search(r"not found|could not find|does not exist", e.get("message") or "", re.I):
                return True
        return False


def _err_code(e: dict) -> str:
    ext = e.get("extensions") or {}
    return str(ext.get("code") or ext.get("type") or "").upper().replace(" ", "_")


def _is_ratelimit(e: dict) -> bool:
    return _err_code(e) == "RATELIMITED" or "rate limit" in (e.get("message") or "").lower()


def _is_auth_error(e: dict) -> bool:
    return _err_code(e) in ("AUTHENTICATION_ERROR", "UNAUTHENTICATED")


class Linear:
    def __init__(self, auth: Auth, url: str):
        self.auth = auth
        self.url = url
        self.opener = opener()
        self.timeout = env_float("LINEAR_BOARD_TIMEOUT", 60)
        self.base_delay = env_float("LINEAR_BOARD_BACKOFF_BASE", 2.0)
        self.max_wait = env_float("LINEAR_BOARD_MAX_WAIT", 90.0)
        self.requests = 0
        # Mutations of the running verb that already landed, so a give-up part
        # way through a multi-step verb says what was applied instead of
        # "not applied".  `rerun` is the advice that goes with them.
        self.landed: list[str] = []
        self.rerun = "Rerunning the same command is safe and finishes the rest."

    def partial(self) -> str:
        if not self.landed:
            return ""
        return ("  The command stopped part way.  Already applied: " + "; ".join(self.landed) + ".  "
                + self.rerun)

    def fail(self, msg: str, code: int = EXIT_ERROR) -> "NoReturn":  # noqa: F821
        """die(), naming any mutation of this verb that already landed."""
        die(msg + self.partial(), code)

    def _post(self, body: bytes, token: str):
        req = urllib.request.Request(self.url, data=body, method="POST", headers={
            "Content-Type": "application/json", "Authorization": f"Bearer {token}",
            "User-Agent": USER_AGENT})
        self.requests += 1
        try:
            with self.opener.open(req, timeout=self.timeout) as r:
                raw = r.read()
                return r.status, (json.loads(raw) if raw else {}), {k.lower(): v for k, v in r.headers.items()}
        except urllib.error.HTTPError as e:
            if 300 <= e.code < 400:
                die(f"Linear answered with a redirect (HTTP {e.code}); refusing to follow it")
            raw = e.read() or b""
            try:
                js = json.loads(raw)
            except ValueError:
                js = {}
            return e.code, (js if isinstance(js, dict) else {}), {k.lower(): v for k, v in (e.headers or {}).items()}

    @staticmethod
    def _reset_at(hdrs: dict) -> float | None:
        stamps = []
        for h in ("x-ratelimit-requests-reset", "x-ratelimit-complexity-reset",
                  "x-ratelimit-endpoint-requests-reset"):
            v = hdrs.get(h)
            if v and v.isdigit():
                stamps.append(int(v) / 1000.0)
        ra = hdrs.get("retry-after")
        if ra and re.fullmatch(r"\d+(\.\d+)?", ra):
            stamps.append(time.time() + float(ra))
        return max(stamps) if stamps else None

    def call(self, query: str, variables: dict | None = None) -> dict:
        """Data of one GraphQL operation.  Raises GqlError on GraphQL errors.
        Retries Linear's rate limit (HTTP 400 RATELIMITED, or 429), 5xx and
        transport errors with backoff, never past LINEAR_BOARD_MAX_WAIT."""
        body = json.dumps({"query": query, "variables": variables or {}}).encode()
        deadline = time.time() + self.max_wait
        delay = self.base_delay
        token = self.auth.get()
        reminted = False
        for _ in range(12):
            try:
                status, js, hdrs = self._post(body, token)
            except (urllib.error.URLError, http.client.HTTPException, OSError) as e:
                if time.time() + delay > deadline:
                    self.fail(f"no usable response from Linear ({type(e).__name__}); the last request was not "
                              "confirmed.  Raise LINEAR_BOARD_TIMEOUT or LINEAR_BOARD_MAX_WAIT on a loaded host.")
                time.sleep(delay)
                delay = min(delay * 2, 30)
                continue
            errs = js.get("errors") or []
            if status == 429 or any(_is_ratelimit(e) for e in errs):
                reset = self._reset_at(hdrs)
                wait = max((reset - time.time()) if reset else 0, delay)
                if time.time() + wait > deadline:
                    when = central(reset) if reset else "within the hour"
                    die(f"Linear rate limit: the {self.auth.label}'s budget resets {when}."
                        + (self.partial() or "  This request was not applied; rerun it after the reset."),
                        EXIT_RATE_LIMIT)
                time.sleep(wait)
                delay = min(delay * 2, 30)
                continue
            if status == 401 or any(_is_auth_error(e) for e in errs):
                if reminted:
                    die(f"Linear refused a freshly minted {self.auth.label} token; check the app in Linear's API settings",
                        EXIT_AUTH)
                token = self.auth.get(failed=token)
                reminted = True
                continue
            if status == 403:
                die(f"Linear answered 403: the {self.auth.label} may not do this (scope or team access)", EXIT_AUTH)
            if status >= 500:
                if time.time() + delay > deadline:
                    self.fail(f"Linear answered HTTP {status} until LINEAR_BOARD_MAX_WAIT ran out")
                time.sleep(delay)
                delay = min(delay * 2, 30)
                continue
            data = js.get("data")
            if errs or data is None:
                raise GqlError(errs or [{"message": f"HTTP {status} with no data"}], data)
            return data
        self.fail("gave up after repeated retries against Linear")

    def paginate(self, query: str, variables: dict, path: tuple, page: int, limit: int | None = None):
        """Yield nodes of the connection at `path`, following endCursor."""
        after = None
        got = 0
        while True:
            data = self.call(query, dict(variables, first=page, after=after))
            conn = data
            for k in path:
                conn = (conn or {}).get(k)
            if not conn:
                return
            for n in conn.get("nodes") or []:
                yield n
                got += 1
                if limit is not None and got >= limit:
                    return
            info = conn.get("pageInfo") or {}
            if not info.get("hasNextPage") or not info.get("endCursor"):
                return
            after = info["endCursor"]


# ----------------------------------------------------------------- GraphQL text
# Every connection names an explicit first:, and every list follows pageInfo.

F_ISSUE = """
fragment BoardIssue on Issue {
  id identifier title url priority createdAt updatedAt
  state { id name type }
  team { id key name }
  labels(first: 50) { nodes { id name parent { name } } }
}"""
Q_ISSUE = """query BoardIssue($id: String!) {
  issue(id: $id) {
    ...BoardIssue
    description
    attachments(first: 50) { nodes { url title } }
    relations(first: 50) { nodes { type relatedIssue { id identifier } } }
    inverseRelations(first: 50) { nodes { type issue { id identifier } } }
  }
}""" + F_ISSUE
Q_COMMENTS = """query BoardComments($id: String!, $first: Int!, $after: String) {
  issue(id: $id) {
    comments(first: $first, after: $after) {
      pageInfo { hasNextPage endCursor }
      nodes { id body createdAt user { id name app } }
    }
  }
}"""
Q_LIST = """query BoardList($filter: IssueFilter, $first: Int!, $after: String) {
  issues(filter: $filter, first: $first, after: $after, orderBy: createdAt) {
    pageInfo { hasNextPage endCursor }
    nodes { ...BoardIssue }
  }
}""" + F_ISSUE
Q_COUNT = """query BoardCount($filter: IssueFilter, $first: Int!, $after: String) {
  issues(filter: $filter, first: $first, after: $after) {
    pageInfo { hasNextPage endCursor }
    nodes { id }
  }
}"""
Q_TEAMS = """query BoardTeams($first: Int!, $after: String) {
  teams(first: $first, after: $after) {
    pageInfo { hasNextPage endCursor }
    nodes { id key name issueCount states(first: 50) { nodes { id name type } } }
  }
}"""
Q_LABELS = """query BoardLabels($first: Int!, $after: String) {
  issueLabels(first: $first, after: $after) {
    pageInfo { hasNextPage endCursor }
