# ---------------------------------------------------------------- remote read transport (opt-in)
#
# SIMPLE_BOARD_REMOTE=1 sends the three read verbs (whoami, show, list) to the hosted ST-MCP endpoint with the
# bot's OWN bearer, which the hosted service resolves to exactly one identity and one Linear app.  Nothing here
# reads a Linear credential, mints a token or touches the Linear cache.  The endpoint is the fixed constant
# below (no environment override), the bearer comes from the process environment only (SIMPLE_TOOLS_BEARER,
# never an argument, file or log line), and a failure never falls back to the direct path.  Every other verb
# is refused in this mode rather than run directly.  The prefix of the bearer is a claim and is never used to
# pick a seat:  the answer to whoami names the identity, as the server decided it.
REMOTE_MCP_URL = "https://agents.simplewithus.com/mcp"
REMOTE_BEARER_ENV = "SIMPLE_TOOLS_BEARER"
REMOTE_TIMEOUT_S = 40
REMOTE_PROTOCOL_VERSION = "2025-06-18"
REMOTE_READ_VERBS = ("whoami", "show", "list")
REMOTE_WRITE_VERBS = ("claim", "comment", "status", "file")
REMOTE_VERBS = REMOTE_READ_VERBS + REMOTE_WRITE_VERBS
REMOTE_LIST_FLAGS = {"team": "team", "env": None, "status": "status", "severity": "severity",
                     "source_kind": "kind", "labels": None, "limit": "limit"}
REMOTE_BEARER_RE = re.compile(r"[A-Za-z0-9_\-]{20,200}")


def remote_selected() -> bool:
    return env("SIMPLE_BOARD_REMOTE") == "1" or native_echo_selected()


REMOTE_MAX_BYTES = 4_000_000
REMOTE_MAX_DEPTH = 64
REMOTE_MAX_NODES = 100_000
# The error codes the hosted server can return (the ToolError codes in scripts/agent-sync-mcp/src);  a test keeps
# this list in step with that source.  Anything else, including a code that merely looks safe, prints as "error".
_REMOTE_CODES = frozenset(
    (
        "invalid_argument",
        "unavailable",
        "upstream_error",
        "not_authorized",
        "rate_limited",
        "not_configured",
        "outcome_unknown",
        "paused",
        "linear_error",
        "internal",
        "response_too_large",
        "refused_secret",
        "not_found",
        "channel_not_allowed",
        "claim_held",
        "zulip_error",
        "writes_disabled",
        "unknown_tool",
        "session_required",
        "relay_refused",
        "identity_required",
        "identity_not_allowed",
        "forbidden",
        "fleetlink_seat_disabled",
        "fleetlink_refused",
        "dm_not_allowed",
        "budget_exhausted",
    )
)
_REMOTE_CONTROL_RE = re.compile(r"[\x00-\x08\x0b-\x1f\x7f-\x9f]")
_REMOTE_UNKNOWN = "; the write may or may not have been applied, check before sending it again"


def _remote_visible(text: str) -> str:
    """Hosted text with control characters (other than newline and tab) shown as \\xNN, so it cannot drive the terminal."""
    return _REMOTE_CONTROL_RE.sub(lambda m: "\\x%02x" % ord(m.group()), text)


class _TransportError(Exception):
    """The request did not produce an HTTP answer.  `sent` is False only when it provably never left
    (name lookup, refused connection, certificate check);  every other stage is treated as sent."""

    def __init__(self, sent: bool, reason: str = "") -> None:
        super().__init__(reason)
        self.sent = sent
        self.reason = reason


def _remote_post(url: str, headers: dict, body: bytes, timeout: float) -> tuple[int, str, bytes]:
    """The one network call of the remote transport:  (status, content type, body).  Tests replace this.
    Redirects are never followed (the Authorization header must not leave the fixed origin), the body is
    read under one total deadline and one byte cap."""
    deadline = time.monotonic() + timeout
    op = urllib.request.build_opener(urllib.request.ProxyHandler({}), _RemoteNoRedirect())
    req = urllib.request.Request(url, data=body, method="POST", headers=headers)
    try:
        with op.open(req, timeout=timeout) as r:
            chunks, total = [], 0
            sock = getattr(getattr(getattr(r, "fp", None), "raw", None), "_sock", None)
            if sock is None:
                # Without the socket the remaining budget cannot be applied to each read, so a stalled body could
                # outlast the deadline:  fail closed rather than read unbounded.
                raise _TransportError(True, "transport")
            while True:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise _TransportError(True, "deadline")
                sock.settimeout(remaining)
                chunk = r.read1(65536)
                if time.monotonic() > deadline:
                    raise _TransportError(True, "deadline")
                if not chunk:
                    break
                total += len(chunk)
                if total > REMOTE_MAX_BYTES:
                    raise _TransportError(True, "too large")
                chunks.append(chunk)
            return r.status, r.headers.get("Content-Type", ""), b"".join(chunks)
    except urllib.error.HTTPError as exc:
        exc.close()
        return exc.code, "", b""
    except urllib.error.URLError as exc:
        unsent = isinstance(exc.reason, (socket.gaierror, ConnectionRefusedError, ssl.SSLCertVerificationError))
        raise _TransportError(not unsent, "unreachable") from None
    except _TransportError:
        raise
    except (http.client.HTTPException, OSError, ValueError):
        raise _TransportError(True, "transport") from None


class _RemoteNoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        return None


def _remote_depth_ok(text: str) -> bool:
    depth = 0
    in_string = escaped = False
    for ch in text:
        if in_string:
            if escaped:
                escaped = False
            elif ch == "\\":
                escaped = True
            elif ch == '"':
                in_string = False
        elif ch == '"':
            in_string = True
        elif ch in "[{":
            depth += 1
            if depth > REMOTE_MAX_DEPTH:
                return False
        elif ch in "]}":
            depth -= 1
    return True


def _remote_nodes_ok(value) -> bool:
    stack, count = [value], 0
    while stack:
        item = stack.pop()
        count += 1
        if count > REMOTE_MAX_NODES:
            return False
        if isinstance(item, dict):
            stack.extend(item.values())
        elif isinstance(item, list):
            stack.extend(item)
    return True


def _remote_events(ctype: str, raw: bytes) -> list[str]:
    """The JSON texts of one answer:  the body itself, or each Server-Sent Event (its `data:` lines joined by a
    newline, as the SSE format defines, comments and other fields ignored)."""
    text = raw.decode("utf-8", "replace")
    if "text/event-stream" not in ctype.lower():
        return [text]
    events, current = [], []
    for line in text.replace("\r\n", "\n").replace("\r", "\n").split("\n"):
        if line == "":
            if current:
                events.append("\n".join(current))
                current = []
        elif line.startswith("data:"):
            value = line[5:]
            current.append(value[1:] if value.startswith(" ") else value)
    if current:
        events.append("\n".join(current))
    return events


def _remote_code(value) -> str:
    """A server error code, only when it is one of the codes the hosted server defines;  anything else is "error"."""
    return value if isinstance(value, str) and value in _REMOTE_CODES else "error"


def _remote_error_object(result: dict, sc) -> dict:
    """The hosted server's error object.  The server answers a tool error with isError and NO structuredContent: the
    object (code, retry_after_s, ...) is in `_meta["agent-sync/error"]` and, as JSON, in the first text part.  A
    structuredContent that carries a code still wins.  Only the code and the retry-after are ever shown, and
    the code only when it is allow-listed, so nothing the server wrote is copied."""
    if isinstance(sc, dict) and "code" in sc:
        return sc
    meta = result.get("_meta")
    cand = meta.get("agent-sync/error") if isinstance(meta, dict) else None
    if not isinstance(cand, dict):
        cand = None
        for part in result.get("content") or []:
            if isinstance(part, dict) and isinstance(part.get("text"), str):
                try:
                    obj = json.loads(part["text"])
                except (ValueError, RecursionError):
                    obj = None
                cand = obj if isinstance(obj, dict) else None
                break
    return cand if isinstance(cand, dict) else (sc if isinstance(sc, dict) else {})


def _remote_answer(ctype: str, raw: bytes, tool: str, write: bool):
    """The tools/call result of one answer, or (None, message).  Returns (result, "") on success.  Only an
    allow-listed code and a bounded retry-after leave this function:  the server's own message text is
    untrusted and can echo the caller's input, so it is never copied into an error."""
    unknown = _REMOTE_UNKNOWN if write else ""
    msg = None
    for text in _remote_events(ctype, raw):
        if not _remote_depth_ok(text):
            return None, "the hosted endpoint sent an answer that nests too deeply" + unknown
        try:
            candidate = json.loads(text)
        except (ValueError, RecursionError):
            continue
        if (
            isinstance(candidate, dict)
            and candidate.get("jsonrpc") == "2.0"
            and type(candidate.get("id")) is int
            and candidate["id"] == 1
            and ("result" in candidate) != ("error" in candidate)
        ):
            msg = candidate
            break
    if msg is None:
        return None, "the hosted endpoint sent no readable answer to the call" + unknown
    if not _remote_nodes_ok(msg):
        return None, "the hosted endpoint sent an oversized answer" + unknown
    if "error" in msg:
        err = msg["error"]
        code = _remote_code(err.get("code")) if isinstance(err, dict) else "error"
        return None, "the hosted endpoint refused the call" + ("" if code == "error" else f" ({code})")
    result = msg.get("result")
    if not isinstance(result, dict):
        return None, "the hosted endpoint sent no result" + unknown
    content = result.get("content")
    sc = result.get("structuredContent")
    if (
        (content is not None and not isinstance(content, list))
        or any(not isinstance(p, dict) or ("text" in p and not isinstance(p["text"], str)) for p in content or [])
        or (sc is not None and not isinstance(sc, dict))
        or not isinstance(result.get("isError", False), bool)
    ):
        return None, "the hosted endpoint sent a result in an unexpected shape" + unknown
    if result.get("isError"):
        eo = _remote_error_object(result, sc)
        code = _remote_code(eo.get("code"))
        retry = eo.get("retry_after_s", eo.get("retry_after"))
        after = f", retry after {retry}s" if isinstance(retry, int) and not isinstance(retry, bool) and 0 <= retry <= 86400 else ""
        note = _REMOTE_UNKNOWN if write and code == "outcome_unknown" else ""
        return None, f"{tool} failed on the hosted server: {code}{after}{note}"
    return result, ""


def _remote_failure(exc: "_TransportError", write: bool) -> str:
    if write and exc.sent:
        return "the hosted endpoint did not answer" + _REMOTE_UNKNOWN + " (no direct fallback in remote mode)"
    return "the hosted endpoint could not be reached (no direct fallback in remote mode)"


def _remote_status_message(status: int, write: bool) -> str:
    if status in (401, 403):
        return "the hosted endpoint refused this bearer (not valid, expired, paused or not accepted for MCP)"
    return f"the hosted endpoint answered HTTP {status}" + (
        _REMOTE_UNKNOWN if write and (status >= 500 or status == 408) else ""
    )


def _remote_scan_arguments(scanner, arguments, bearer: str) -> str | None:
    """The first argument field the fleet secret scanner flags, as `secret_scan:<field>` (the field name only,
    never the text or any part of it), or None.  Every string at any depth is checked, and the bearer itself
    always matches."""
    stack = [("", arguments)]
    while stack:
        path, value = stack.pop()
        if isinstance(value, str):
            if scanner.scan(value, known=[bearer]) is not None:
                return "secret_scan:" + (path or "arguments")
        elif isinstance(value, dict):
            stack.extend((f"{path}.{k}" if path else str(k), v) for k, v in value.items())
        elif isinstance(value, (list, tuple)):
            stack.extend((f"{path}[{i}]", v) for i, v in enumerate(value))
    return None


def native_echo_selected() -> bool:
    return env("SIMPLE_BOARD_NATIVE_ECHO") == "1"


def _native_echo_post(body: bytes, write: bool):
    """Fixed existing root-controlled ECHO custody transport; no credential export."""
    if os.geteuid() != 0:
        die("native ECHO board transport requires the existing root-controlled launch context", EXIT_AUTH)
    initialize = {"jsonrpc": "2.0", "id": 0, "method": "initialize", "params": {
        "protocolVersion": REMOTE_PROTOCOL_VERSION, "capabilities": {},
        "clientInfo": {"name": "simple-board", "version": "1"}}}
    notification = {"jsonrpc": "2.0", "method": "notifications/initialized"}
    data = json.dumps(initialize).encode() + b"\n" + json.dumps(notification).encode() + b"\n" + body + b"\n"
    try:
        proc = subprocess.run(["/usr/bin/python3", "-I", "/usr/local/libexec/assigned-echo-mcp/linux-custody.py"],
            input=data, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=REMOTE_TIMEOUT_S,
            env={"PATH": "/usr/bin:/bin"}, check=False)
        if proc.returncode or len(proc.stdout) > 3 * REMOTE_MAX_BYTES:
            raise ValueError("native transport failed")
        lines = [json.loads(line) for line in proc.stdout.splitlines() if line.strip()]
        if len(lines) != 2 or any(not isinstance(x, dict) for x in lines):
            raise ValueError("invalid native response")
        hello, answer = lines
        if hello.get("id") != 0 or not isinstance(hello.get("result"), dict) or answer.get("id") != 1:
            raise ValueError("native response mismatch")
        result = answer.get("result")
        if write and isinstance(result, dict) and result.get("isError") and not isinstance(result.get("structuredContent"), dict):
            # The existing native adapter reports uncertain transport failures in
            # content only. Preserve UNKNOWN rather than treating it as a refusal.
            result["structuredContent"] = {"code": "outcome_unknown"}
        return 200, "application/json", json.dumps(answer).encode()
    except (OSError, ValueError, RecursionError, subprocess.SubprocessError):
        die("native ECHO transport unavailable; " +
            ("write outcome unknown, do not replay before checking the target" if write else "no direct-credential fallback"), EXIT_ERROR)


def remote_bearer() -> str:
    v = env(REMOTE_BEARER_ENV)
    if not v:
        die(f"remote mode needs this bot's own bearer in {REMOTE_BEARER_ENV}; there is no fallback to direct "
            "credentials and no other source", EXIT_NO_CREDS)
    if not REMOTE_BEARER_RE.fullmatch(v):
        die(f"{REMOTE_BEARER_ENV} is not a bearer token (unexpected characters or length)", EXIT_NO_CREDS)
    return v


def _remote_scanner():
    """The fleet's secret scanner (scripts/agent_sync/secretscan.py, standard library only), loaded by path.  If it
    cannot be loaded nothing is sent:  remote mode has no unscanned route."""
    import importlib.util

    path = Path(os.path.realpath(__file__)).parent.parent / "agent_sync" / "secretscan.py"
    try:
        spec = importlib.util.spec_from_file_location("_remote_secretscan", str(path))
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        return module
    except (OSError, ImportError, AttributeError, SyntaxError):
        die("the secret scanner is not available, so nothing was sent (remote mode has no unscanned route)",
            EXIT_ERROR)


def remote_call(tool: str, arguments: dict, write: bool = False) -> dict:
    """One tools/call to the fixed endpoint.  Returns the tool's structuredContent."""
    bearer = "" if native_echo_selected() else remote_bearer()
    hit = _remote_scan_arguments(_remote_scanner(), arguments, bearer)
    if hit:
        die(f"refused before sending: {hit}", EXIT_USAGE)
    body = json.dumps({"jsonrpc": "2.0", "id": 1, "method": "tools/call",
                       "params": {"name": tool, "arguments": arguments}}).encode()
    try:
        status, ctype, raw = _native_echo_post(body, write) if native_echo_selected() else _remote_post(REMOTE_MCP_URL, {
            "Content-Type": "application/json", "Accept": "application/json, text/event-stream",
            "MCP-Protocol-Version": REMOTE_PROTOCOL_VERSION, "Authorization": "Bearer " + bearer,
            "User-Agent": "simple-board-remote/1"}, body, REMOTE_TIMEOUT_S)
    except _TransportError as exc:
        die(_remote_failure(exc, write), EXIT_ERROR)
    if status in (401, 403):
        die(_remote_status_message(status, write), EXIT_AUTH)
    if status != 200:
        die(_remote_status_message(status, write), EXIT_ERROR)
    result, problem = _remote_answer(ctype, raw, tool, write)
    if problem:
        die(problem, EXIT_ERROR)
    sc = result.get("structuredContent")
    if not isinstance(sc, dict):
        die("the hosted endpoint sent no structured result", EXIT_ERROR)
    # The hosted list/show keep the issue rows, comment bodies, labels and duplicate relations in the text
    # content (a fenced envelope); structuredContent carries only a summary.  Keep both.
    parts = [c.get("text") for c in result.get("content") or [] if isinstance(c, dict) and c.get("type") == "text"]
    return {"structured": sc, "text": "\n".join(t for t in parts if isinstance(t, str))}


def remote_write(a) -> dict:
    """claim / comment / status / file to the hosted linear_* tool of the same meaning.  Needs its own switch
    (SIMPLE_BOARD_REMOTE_WRITES=1);  the hosted server also keeps writes off until its LINEAR_TOOLS_WRITES
    deploy flag is on, and says so.  Options with no hosted equivalent are refused, never ignored.  --by is an
    identity claim:  it is checked against the seat the server reports for this bearer before anything is sent."""
    if env("SIMPLE_BOARD_REMOTE_WRITES") != "1":
        die(f"`{a.cmd}` is a write:  set SIMPLE_BOARD_REMOTE_WRITES=1 as well as SIMPLE_BOARD_REMOTE=1 to send it "
            "to the hosted server (it is not sent directly instead)", EXIT_USAGE)
    unsupported = {"claim": ("steal", "reason", "location", "env"), "comment": ("location", "env", "text_file"),
                   "status": ("resolution",),
                   "file": ("fix", "fix_file", "desc_file", "reported_by", "location", "external_uid", "source_url")}
    for dest in unsupported[a.cmd]:
        if getattr(a, dest, None):
            die(f"`--{dest.replace('_', '-')}` has no hosted equivalent in remote mode", EXIT_USAGE)
    sessions = getattr(a, "session_ids", None) or []
    if len(sessions) > 1:
        die("remote mode accepts at most one --session", EXIT_USAGE)
    claimed = getattr(a, "addressed_by", None) or getattr(a, "author", None)
    if claimed:
        who = remote_call("linear_whoami", {})["structured"]
        got = str(who.get("authenticated_seat") or who.get("seat") or "")
        if not got or got.lower() != str(claimed).lower():
            shown = _remote_visible(got)[:40] if got else "none reported"
            die(f"--by {claimed} does not match the seat the hosted server reports for this bearer ({shown}); "
                "remote mode never acts as another seat", EXIT_USAGE)
    if a.cmd == "claim":
        args = {"id": a.id}
        if a.comment:
            args["comment"] = a.comment
        tool = "linear_claim"
    elif a.cmd == "comment":
        if not a.text:
            die("remote comment needs --text", EXIT_USAGE)
        args, tool = {"id": a.id, "body": a.text}, "linear_comment"
    elif a.cmd == "status":
        args, tool = {"id": a.id, "status": a.value}, "linear_status"
        if a.of:
            args["of"] = a.of
    else:
        args, tool = {"title": a.title, "app": a.app, "kind": a.source_kind}, "linear_file"
        for key, val in (("severity", a.severity), ("env", a.env), ("description", a.desc),
                         ("label", a.labels)):
            if val:
                args[key] = val
    if sessions:
        args["session"] = sessions[0]
    return remote_call(tool, args, write=True)


def remote_main(a) -> int:
    if a.cmd not in REMOTE_VERBS:
        die(f"`{a.cmd}` is not available in remote mode (SIMPLE_BOARD_REMOTE=1 supports only "
            f"{', '.join(REMOTE_VERBS)}); it is not run directly either.  Unset SIMPLE_BOARD_REMOTE for the "
            "direct path", EXIT_USAGE)
    if a.cmd == "whoami":
        out = remote_call("linear_whoami", {})
    elif a.cmd in REMOTE_WRITE_VERBS:
        out = remote_write(a)
        print(_remote_visible(out["text"]) if out["text"] else json.dumps(out["structured"], indent=2))
        return 0
    elif a.cmd == "show":
        args: dict = {"id": a.id}
        if a.comment_limit is not None:
            args["comment_limit"] = a.comment_limit
        out = remote_call("linear_show", args)
    else:
        args = {}
        for dest, name in REMOTE_LIST_FLAGS.items():
            val = getattr(a, dest, None)
            if val in (None, [], ""):
                continue
            if name is None:
                die(f"`--{dest.replace('_', '-')}` has no hosted equivalent in remote mode (the hosted linear_list "
                    "ignores it)", EXIT_USAGE)
            if name == "limit":
                try:
                    val = int(val)
                except ValueError:
                    die("--limit must be a number", EXIT_USAGE)
            args[name] = val
        for unsupported in ("app", "search", "mine"):
            if getattr(a, unsupported, None):
                die(f"`--{unsupported}` has no hosted equivalent in remote mode", EXIT_USAGE)
        out = remote_call("linear_list", args)
    if a.cmd in ("show", "list"):
        if a.__dict__.get("json"):
            print(json.dumps({"structured": out["structured"], "text": out["text"]}, indent=2))
        else:
            print(_remote_visible(out["text"]) if out["text"] else json.dumps(out["structured"], indent=2))
        return 0
    out = out["structured"]
    if a.cmd == "whoami" and not a.__dict__.get("json"):
        shown = [k for k in ("seat", "authenticated_seat", "app", "viewer_id", "workspace", "transport") if out.get(k)]
        for k in shown:
            print(f"{k}: {_remote_visible(str(out[k]))}")
        if shown:
            return 0
    print(json.dumps(out, indent=2))
    return 0


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if remote_selected() and (env("BOARD_BACKEND") or "linear").lower() == "mac-collab":
        die("SIMPLE_BOARD_REMOTE=1 and BOARD_BACKEND=mac-collab are both set; remote mode never runs the old "
            "board CLI.  Unset one.", EXIT_USAGE)
    if (env("BOARD_BACKEND") or "linear").lower() == "mac-collab":
        linear_only = argv[0] if argv[:1] and argv[0] in LINEAR_ONLY_VERBS else \
            next((f for f in (t.split("=", 1)[0] for t in argv) if f in LINEAR_ONLY_FLAGS), None)
        if linear_only:
            die(f"`{linear_only}` is Linear only:  BOARD_BACKEND=mac-collab runs the old board CLI, which has "
                "no such flag or verb.  Unset BOARD_BACKEND to use it.", EXIT_USAGE)
        # The rollback backend runs the old CLI, which has no bearer-verified identity:  it never gets a write
        # through this entry point, so no environment variable can route a write around the bearer.
        if any(a in WRITE_VERBS for a in argv[:1]):
            die(f"`{argv[0]}` is a write, and BOARD_BACKEND=mac-collab runs the old board CLI, which cannot prove "
                "a seat from a bearer.  Writes only run as the bearer-verified seat:  unset BOARD_BACKEND.", EXIT_AUTH)
        old = Path(env("BOARD_MAC_COLLAB_CLI") or (Path.home() / "apps" / "_retired" / "mac-collab-20261019" / "board")).expanduser()
        if not old.is_file():
            die(f"BOARD_BACKEND=mac-collab, but the archived old board CLI is not at {old} "
                "(set BOARD_MAC_COLLAB_CLI to the frozen archive)")
        sys.stdout.flush()
        os.execv(sys.executable, [sys.executable, str(old), *argv])
    a = build_parser().parse_args(argv)
    if remote_selected():
        return remote_main(a)
    # Catalog-only verbs read no credential and send nothing.
    if a.cmd == "commands":
        return cmd_commands(a)
    if a.cmd == "mcp" and a.mcp_cmd in ("list", "show"):
        return cmd_mcp(None, None, a, "")
    writes = a.cmd in WRITE_VERBS or parity_is_write(a)
    seat = current_seat(required=writes)
    for flag, val in (("--by", getattr(a, "reported_by", None)), ("--by", getattr(a, "addressed_by", None)),
                      ("--by", getattr(a, "author", None))):
        if val is not None:
            check_by(val, seat, flag)
    prepare_inputs(a)
    if a.cmd == "run":
        prepare_run(a)
    elif a.cmd == "api":
        prepare_api(a)
    elif a.cmd == "mcp":
        prepare_mcp(a)
    token_url = endpoint("LINEAR_BOARD_TOKEN_URL", TOKEN_URL)
    api_url = endpoint("LINEAR_BOARD_API_URL", GRAPHQL_URL)
    auth = Auth(token_url, resolve_identity(seat))
    L = Linear(auth, api_url)
    try:
        if writes:
            check_write_identity(L, auth)
        if a.cmd == "whoami":
            return cmd_whoami(L, auth, seat)
        if a.cmd == "list":
            return cmd_list(L, a)
        if a.cmd == "stats":
            return cmd_stats(L)
        if a.cmd == "run":
            return cmd_run(L, auth, a, seat)
        if a.cmd == "api":
            return cmd_api(L, auth, a, seat)
        if a.cmd == "mcp":
            return cmd_mcp(L, auth, a, seat)
        ids = IdIndex()
        if a.cmd == "show":
            return cmd_show(L, ids, a)
        if a.cmd == "file":
            return cmd_file(L, a, seat)
        if a.cmd == "claim":
            return cmd_claim(L, ids, a, seat)
        if a.cmd == "status":
            return cmd_status(L, ids, a, seat)
        if a.cmd == "comment":
            return cmd_comment(L, ids, a, seat)
        if a.cmd == "label":
            return cmd_label(L, ids, a, seat)
    except GqlError as e:
        die(f"Linear error: {gql_summary(e)}")
    return EXIT_ERROR


if __name__ == "__main__":
    raise SystemExit(main())
