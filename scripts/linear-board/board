# copy of the GROK row's `aliasPattern` in fleet-apps.json, because this script imports no package;
# test_board.py keeps the two equal.
GROK_ALIAS_PATTERN = r"^grok[^a-z0-9]*build[^a-z0-9]*$"
GROK_ALIAS_RE = re.compile(GROK_ALIAS_PATTERN, re.IGNORECASE | re.ASCII)


def norm_seat(s: str | None) -> str:
    """The seat tag a value stands for, upper-cased.  Every GROK-BUILD spelling is GROK, so AGENT_SEAT,
    --by and --mine all resolve to the one seat that signs GROK."""
    v = (s or "").strip().strip("@[]<>`'\" ")
    return "GROK" if GROK_ALIAS_RE.match(v) else SEAT_TAG_ALIASES.get(v.upper(), v.upper())


def hyphenate(h32: str) -> str:
    return f"{h32[:8]}-{h32[8:12]}-{h32[12:16]}-{h32[16:20]}-{h32[20:]}"


def short_id(uid: str) -> str:
    return (uid or "").replace("-", "")[:8]


def det_uuid(kind: str, key: str) -> str:
    """Deterministic, v4-shaped UUID, so a repeat create is idempotent."""
    h = hashlib.sha256(f"linear-board:v1:{kind}:{key}".encode("utf-8")).digest()[:16]
    return str(uuid.UUID(bytes=h, version=4))


def parse_iso(s: str | None) -> dt.datetime | None:
    if not s:
        return None
    try:
        return dt.datetime.fromisoformat(s.replace("Z", "+00:00"))
    except ValueError:
        return None


def central(when, with_day: bool = True) -> str:
    """Owner clock: Central, 12-hour, am or pm, no zone name."""
    if isinstance(when, (int, float)):
        d = dt.datetime.fromtimestamp(when, dt.timezone.utc)
    else:
        d = parse_iso(when)
        if d is None:
            return str(when or "")
    if CENTRAL is not None:
        d = d.astimezone(CENTRAL)
    hour = d.hour % 12 or 12
    ampm = "am" if d.hour < 12 else "pm"
    day = f"{d.strftime('%a')}, " if with_day else ""
    return f"{day}{d.strftime('%b')} {d.day}, {hour}:{d.minute:02d}{ampm}"


def auto_sessions(explicit: list[str] | None) -> list[str] | None:
    if explicit:
        return explicit
    v = env(SESSION_ENV_VAR)
    return [v] if v else None


def session_tail(sessions: list[str] | None) -> str:
    return f"  (sessions: {', '.join(sessions)})" if sessions else ""


def endpoint(name: str, default: str) -> str:
    """The production URL, or a loopback test mock.  Nothing else, so the
    app tokens and client secrets can only ever go to Linear."""
    v = env(name)
    if not v:
        return default
    if LOOPBACK_RE.fullmatch(v):
        return v
    die(f"{name} may only point at http://127.0.0.1:<port>/... (a test mock); refusing {v!r}", EXIT_USAGE)


def cache_dir() -> Path:
    p = Path(env("LINEAR_BOARD_CACHE_DIR") or (Path.home() / ".cache" / "linear-board")).expanduser()
    p.mkdir(parents=True, exist_ok=True, mode=0o700)
    return p


def read_json_file(path: Path):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return None


def write_json_file(path: Path, obj) -> None:
    tmp = path.with_suffix(path.suffix + f".{os.getpid()}.tmp")
    tmp.write_text(json.dumps(obj))
    os.replace(tmp, path)


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    """Refuse every redirect, so the Authorization header never follows a 3xx."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise urllib.error.HTTPError(req.full_url, code, f"redirect refused (HTTP {code})", headers, fp)


def opener():
    # ProxyHandler({}) ignores HTTP(S)_PROXY from the environment.
    return urllib.request.build_opener(urllib.request.ProxyHandler({}), _NoRedirect())


# ----------------------------------------------------------------- seat

def current_seat(required: bool = True) -> str:
    """The seat in AGENT_SEAT.  The four write verbs require it, because every
    write is signed with it and the CLI never guesses.  Reads (list, show,
    stats, whoami) do not: they write nothing, and AGENT_SEAT is unset in plain
    shells, in `zsh -lic`, and under the listener's `env -i`."""
    seat = norm_seat(os.environ.get("AGENT_SEAT"))
    if not seat:
        if not required:
            return ""
        die("AGENT_SEAT is not set.  The board CLI writes as the seat in AGENT_SEAT and refuses to "
            "guess it; export AGENT_SEAT=<your seat tag> (AGENT-SYNC Identity Rules).  Reads "
            "(list, show, stats, whoami) work without it.", EXIT_USAGE)
    if not re.fullmatch(r"[A-Z][A-Z0-9-]{0,31}", seat):
        die(f"AGENT_SEAT={seat!r} is not a seat tag", EXIT_USAGE)
    return seat


def check_by(by: str | None, seat: str, flag: str = "--by") -> str:
    if by is None:
        return seat
    if norm_seat(by) != seat:
        die(f"{flag} {by} does not match AGENT_SEAT={seat}.  --by is never the source of identity; "
            "run as that seat or drop the flag.", EXIT_USAGE)
    return seat


def seat_tag(seat: str, sessions: list[str] | None) -> str:
    s8 = (sessions[0].replace("-", "")[:8]) if sessions else ""
    return f"[{seat}·{s8}]" if s8 else f"[{seat}]"


