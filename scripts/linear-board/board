def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog=prog_name(), description="Fleet work board (Linear backend)."
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    lp = sub.add_parser("list", help="list/filter items")
    lp.add_argument("--app")
    lp.add_argument("--team", help="only this team's items, by key (AFC, FL, CC ...)")
    lp.add_argument("--env", choices=("mac", "cloud", "Mac", "Cloud"), help="only items with this Env label")
    lp.add_argument("--status")
    lp.add_argument("--severity")
    lp.add_argument("--kind", dest="source_kind")
    lp.add_argument("--search")
    lp.add_argument("--mine", help="only items claimed by this seat (claimed:<TAG> label)")
    lp.add_argument("--label", dest="labels", action="append", metavar="NAME",
                    help=f"only items with this flat label ({', '.join(FLAT_LABELS)});  repeat to require several")
    lp.add_argument("--limit", default="60")
    lp.add_argument("--json", action="store_true")

    sp = sub.add_parser("show", help="one item + comments")
    sp.add_argument("id")
    sp.add_argument("--json", action="store_true")
    sp.add_argument("--comment-limit", dest="comment_limit", type=int, metavar="N",
                    help="show only the first N comments (oldest first);  resolution still reads them all")

    fp = sub.add_parser("file", help="file a new finding/issue")
    fp.add_argument("--title", required=True)
    fp.add_argument("--app", default=DEFAULT_APP)
    fp.add_argument("--severity")
    desc_g = fp.add_mutually_exclusive_group()
