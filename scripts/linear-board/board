# ----------------------------------------------------------------- small helpers

def prog_name() -> str:
    """The name this CLI was invoked as (simple-board), so every error line names it."""
    name = os.path.basename(sys.argv[0]) if sys.argv and sys.argv[0] else ""
    return name or "simple-board"


def credential_preview(secret: str) -> str:
    """A credential's safe preview:  the first eight and the last four characters.

    A refused credential has to be identifiable without ever being written out in
    full, and a short value is not a preview at all, so one under twenty-four
    characters shows its single leading character and nothing else."""
    text = str(secret or "")
    if not text:
        return ""
    if len(text) < 24:
        return text[:1] + "\u2026"
    return text[:8] + "\u2026" + text[-4:]


def credential_vars(where: str) -> str:
    """The names of the credential variables a credential came from, comma separated.

    The board's own message names them, so the structured field and the prose
    cannot disagree.  A name is a name:  no value ever comes out of here."""
    return ",".join(dict.fromkeys(CREDENTIAL_VAR.findall(where or "")))


def request_id(headers: dict, errors: list | None = None) -> str:
    """The request id the response carries, if it carries one.

    It is what Linear's support asks for, and it is not a secret.  An empty string
    means the response carried none:  the field is then left off rather than
    invented."""
    for key in REQUEST_ID_HEADERS:
        value = str((headers or {}).get(key) or "")
        if REQUEST_ID_VALUE.match(value):
            return value
    for err in errors or []:
        ext = (err.get("extensions") or {}) if isinstance(err, dict) else {}
        value = str(ext.get("requestId") or ext.get("request_id") or "")
        if REQUEST_ID_VALUE.match(value):
            return value
    return ""


def error_fields(error: Exception, credential: str = "", where: str = "") -> dict:
    """The allow-listed fields of a failure:  a stable error name, the status code,
    the request id, the masked credential and the names of the credential variables.

    Nothing else.  The provider's own text never comes out of an error, because a
    GraphQL error body or a transport error can carry a credential or PII, and this
    line reaches a job log and a Linear comment."""
    fields = {"error_type": type(error).__name__}
    status = getattr(error, "status", None)
    if not isinstance(status, int):
        status = getattr(error, "code", None)
    if isinstance(status, int) and 100 <= status <= 599:
        fields["http"] = str(status)
    rid = request_id(getattr(error, "headers", None) or {}, getattr(error, "errors", None))
    if rid:
        fields["request_id"] = rid
    if credential:
        fields["credential"] = credential
    if where:
        fields["credential_field"] = credential_vars(where)
    return fields


def die(msg: str, code: int = EXIT_ERROR, **fields: str) -> "NoReturn":  # noqa: F821
    """Stop with an error line.

    `fields` are allow-listed key=value pairs for a caller downstream that has to
    read this error without trusting its prose:  that caller parses the named field
    and never the sentence around it.  Only a value that is already safe to print
    goes here, so a credential arrives as its masked preview and never as itself."""
    line = f"{prog_name()}: {msg}"
    if fields:
        line += "  " + " ".join("%s=%s" % (k, v) for k, v in fields.items())
    print(line, file=sys.stderr)
    raise SystemExit(code)


def warn(msg: str) -> None:
    print(f"{prog_name()}: warning: {msg}", file=sys.stderr)


def env(name: str, default: str | None = None) -> str | None:
    v = os.environ.get(name, "").strip()
    return v if v else default


def env_float(name: str, default: float) -> float:
    try:
        return float(env(name, str(default)))
    except ValueError:
        die(f"{name} must be a number", EXIT_USAGE)


def slugify(s: str | None) -> str:
    return re.sub(r"[^a-z0-9]+", "-", (s or "").lower()).strip("-")


# Any spelling of GROK followed by BUILD is an alias for the seat GROK (owner 2026-10-10).  A one-line
# copy of the GROK row's `aliasPattern` in fleet-apps.json, because this script imports no package;
# test_board.py keeps the two equal.
GROK_ALIAS_PATTERN = r"^grok[^a-z0-9]*build[^a-z0-9]*$"
GROK_ALIAS_RE = re.compile(GROK_ALIAS_PATTERN, re.IGNORECASE | re.ASCII)


def norm_seat(s: str | None) -> str:
    """The seat tag a value stands for, upper-cased.  Every GROK-BUILD spelling is GROK, so
    --by and --mine all resolve to the one seat that signs GROK."""
    v = (s or "").strip().strip("@[]<>`'\" ")
    upper = v.upper()
    if GROK_ALIAS_RE.match(v):
        return "GROK"
    if upper in RETIRED_SEAT_TAGS:
        return upper
    return SEAT_ALIASES.get(upper, SEAT_TAG_ALIASES.get(upper, upper))


def hyphenate(h32: str) -> str:
    return f"{h32[:8]}-{h32[8:12]}-{h32[12:16]}-{h32[16:20]}-{h32[20:]}"


def short_id(uid: str) -> str:
    return (uid or "").replace("-", "")[:8]


def det_uuid(kind: str, key: str) -> str:
    """Deterministic, v4-shaped UUID, so a repeat create is idempotent."""
    h = hashlib.sha256(f"linear-board:v1:{kind}:{key}".encode("utf-8")).digest()[:16]
    return str(uuid.UUID(bytes=h, version=4))


def parse_iso(s: str | None) -> dt.datetime | None:
    if not s:
        return None
    try:
        return dt.datetime.fromisoformat(s.replace("Z", "+00:00"))
    except ValueError:
        return None


def central(when, with_day: bool = True) -> str:
    """Owner clock: Central, 12-hour, am or pm, no zone name."""
    if isinstance(when, (int, float)):
        d = dt.datetime.fromtimestamp(when, dt.timezone.utc)
    else:
        d = parse_iso(when)
        if d is None:
            return str(when or "")
    if CENTRAL is not None:
        d = d.astimezone(CENTRAL)
    hour = d.hour % 12 or 12
    ampm = "am" if d.hour < 12 else "pm"
    day = f"{d.strftime('%a')}, " if with_day else ""
    return f"{day}{d.strftime('%b')} {d.day}, {hour}:{d.minute:02d}{ampm}"


def session_exempt(seat: str) -> bool:
    """True for a seat with one thread with the owner (a Grok bot, MA, JET, WISE, ECHO), which has no session
    id to pass.  Decided from the resolved (verified) seat, never from a flag."""
    seat = norm_seat(seat)
    return seat in SESSION_EXEMPT_SEATS or any(fnmatch.fnmatchcase(seat, pat) for pat in SESSION_EXEMPT_PATTERNS)


def session_refusal(seat: str) -> str:
    own = SESSION_ENV_BY_SEAT.get(seat)
    where = (f"a {seat} session sets {' or '.join(own)};  it is empty here" if own else
             f"{seat} has no session variable of its own;  use the id your app shows for this chat")
    return (f"no session id.  Board writes record the session they come from, so a headless resume can find "
            f"this seat's session for the topic.  Pass --session <id>, or export {SESSION_GENERIC_ENV}=<id> "
            f"({where}).  Grok bots, MA, JET, WISE and ECHO have one thread with the owner and need none.")


def auto_sessions(explicit: list[str] | None, seat: str | None = None, required: bool = False) -> list[str] | None:
    """The session ids to record:  --session values, else AGENT_SESSION, else the seat's own platform variable
    (a seat with none listed tries every platform variable).  With `required`, a seat that is not exempt and has
    no id exits 2 before anything is written.  An id that is not a plain token exits 2 as well."""
    seat = norm_seat(seat) if seat else ""
    found = [x.strip() for x in (explicit or []) if x and x.strip()]
    if not found:
        names = [SESSION_GENERIC_ENV] + list(SESSION_ENV_BY_SEAT.get(seat) or SESSION_FALLBACK_ENV)
        for name in names:
            v = (env(name) or "").strip()
            if v:
                found = [v]
                break
    for sid in found:
        if not SESSION_ID_RE.fullmatch(sid):
            die(f"session id {sid[:40]!r} is not valid:  use 4 to 128 letters, digits, . _ : - starting with "
                "a letter or digit", EXIT_USAGE)
    if not found and required and not session_exempt(seat):
        die(session_refusal(seat), EXIT_USAGE)
    return found or None


def session_tail(sessions: list[str] | None) -> str:
    return f"  (sessions: {', '.join(sessions)})" if sessions else ""


def endpoint(name: str, default: str) -> str:
    """The production URL, or a loopback test mock.  Nothing else, so the
    app tokens and client secrets can only ever go to Linear."""
    v = env(name)
    if not v:
        return default
    if LOOPBACK_RE.fullmatch(v):
        return v
    die(f"{name} may only point at http://127.0.0.1:<port>/... (a test mock); refusing {v!r}", EXIT_USAGE)


def cache_dir() -> Path:
    p = Path(env("LINEAR_BOARD_CACHE_DIR") or (Path.home() / ".cache" / "linear-board")).expanduser()
    p.mkdir(parents=True, exist_ok=True, mode=0o700)
    return p


def read_json_file(path: Path):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return None


def write_json_file(path: Path, obj) -> None:
    tmp = path.with_suffix(path.suffix + f".{os.getpid()}.tmp")
    tmp.write_text(json.dumps(obj))
    os.replace(tmp, path)


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    """Refuse every redirect, so the Authorization header never follows a 3xx."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        raise urllib.error.HTTPError(req.full_url, code, f"redirect refused (HTTP {code})", headers, fp)


def opener():
    # ProxyHandler({}) ignores HTTP(S)_PROXY from the environment.
    return urllib.request.build_opener(urllib.request.ProxyHandler({}), _NoRedirect())


# ----------------------------------------------------------------- Infisical (AFC-348)
# Infisical is where every seat's Linear client pair lives (AI Fleet Coordinator, prod, /linear), and where
# one shared copy of each seat's minted token is kept (LINEAR_<SEAT>_CACHE_TOKEN), so the Mac, this
# server and any other host stop minting a token each.  The local cache stays as the fast copy.

INFISICAL_PROJECT_SLUG = "ai-fleet-coordinator"  # looked up by slug:  no project id in public source
INFISICAL_LINEAR_PATH = "/linear"


class Infisical:
    """AI Fleet Coordinator prod /linear through the INFISICAL_AUTOMATION machine identity.

    The identity comes from the environment (INFISICAL_AUTOMATION_CLIENT_ID / _SECRET), else an
    INFISICAL_TOKEN already in the environment, else `fleet-secrets get` (OPS-818), which on the Mac
    reads Fleet-OPS through its Keychain login.  Off (every read answers "", every write False) without
    any of them, with LINEAR_BOARD_INFISICAL=0, or after the first failed call, so a host with no
    identity, or an Infisical outage, skips the shared token copy and the old /linear folder instead of failing.  Values are
    never printed;  messages name keys only."""

    _instance: "Infisical | None" = None

    def __init__(self) -> None:
        self.api = (env("LINEAR_BOARD_INFISICAL_API") or "https://app.infisical.com").rstrip("/")
        self.cid = env("INFISICAL_AUTOMATION_CLIENT_ID") or ""
        self.sec = env("INFISICAL_AUTOMATION_CLIENT_SECRET") or ""
        self._token = env("INFISICAL_TOKEN") or ""
        self.enabled = env("LINEAR_BOARD_INFISICAL", "1") != "0"
        self._looked = bool(self._token or (self.cid and self.sec))
        self._project = ""
        self._secrets: dict[str, str] | None = None

    @classmethod
    def get(cls) -> "Infisical":
        if cls._instance is None:
            cls._instance = cls()
        return cls._instance

    def _call(self, method: str, path: str, body: dict | None = None, auth: bool = True) -> dict | None:
        """One request, or None when it failed (and Infisical is then off for this run)."""
        headers = {"Content-Type": "application/json", "User-Agent": USER_AGENT}
        if auth:
            headers["Authorization"] = f"Bearer {self._token}"
        req = urllib.request.Request(self.api + path, method=method, headers=headers,
                                     data=json.dumps(body).encode() if body is not None else None)
        try:
            with opener().open(req, timeout=env_float("LINEAR_BOARD_TIMEOUT", 60)) as r:
                raw = r.read()
                return json.loads(raw) if raw else {}
        except urllib.error.HTTPError as e:
            if e.code == 404 and method != "GET":
                return {"_status": 404}
            self._off(f"HTTP {e.code} on {path.split('?')[0]}")
        except (urllib.error.URLError, http.client.HTTPException, OSError, ValueError) as e:
            self._off(type(e).__name__)
        return None

    def _off(self, why: str) -> None:
        if self.enabled:
            warn(f"Infisical is unavailable ({why});  the shared token copy and the old /linear folder are skipped for this run")
        self.enabled = False

    def _fleet_secrets(self, name: str) -> str:
        """One Fleet-OPS secret through `fleet-secrets get` (OPS-818), or "" when it is not installed or fails."""
        binary = env("LINEAR_BOARD_FLEET_SECRETS") or shutil.which("fleet-secrets") or str(
            Path.home() / ".local" / "bin" / "fleet-secrets")
        if not os.access(binary, os.X_OK):
            return ""
        try:
            proc = subprocess.run([binary, "get", name], capture_output=True, text=True, timeout=60, check=False)
        except (OSError, subprocess.SubprocessError):
            return ""
        return proc.stdout.strip() if proc.returncode == 0 else ""

    def _identity(self) -> bool:
        """Whether an identity (or a token) is available, looking it up through fleet-secrets once."""
        if not self._looked:
            self._looked = True
            self.cid = self._fleet_secrets("INFISICAL_AUTOMATION_CLIENT_ID")
            self.sec = self._fleet_secrets("INFISICAL_AUTOMATION_CLIENT_SECRET") if self.cid else ""
        return bool(self._token or (self.cid and self.sec))

    def _ready(self, need_project: bool = False) -> bool:
        """Logged in, and (for a write) the project id resolved.  Reads name the project by slug."""
        if not self.enabled:
            return False
        if not self._identity():
            self.enabled = False
            return False
        if not self._token:
            js = self._call("POST", "/api/v1/auth/universal-auth/login",
                            {"clientId": self.cid, "clientSecret": self.sec}, auth=False)
            self._token = (js or {}).get("accessToken") or ""
            if not self._token:
                self._off("login returned no token")
                return False
        if need_project and not self._project:
            js = self._call("GET", f"/api/v1/projects/slug/{INFISICAL_PROJECT_SLUG}")
            self._project = ((js or {}).get("project") or js or {}).get("id") or ""
            if not self._project:
                self._off(f"no project with slug {INFISICAL_PROJECT_SLUG}")
                return False
        return True

    def _where(self) -> dict:
        return {"workspaceId": self._project, "environment": "prod", "secretPath": INFISICAL_LINEAR_PATH}

    def value(self, name: str) -> str:
        """One /linear secret, read with the whole folder once per run;  "" when absent or off."""
        if self._secrets is None:
            self._secrets = {}
            if self._ready():
                query = {"workspaceSlug": INFISICAL_PROJECT_SLUG, "environment": "prod", "secretPath": INFISICAL_LINEAR_PATH}
                js = self._call("GET", "/api/v3/secrets/raw?" + urllib.parse.urlencode(query))
                for item in (js or {}).get("secrets") or []:
                    if item.get("secretKey"):
                        self._secrets[item["secretKey"]] = str(item.get("secretValue") or "").strip()
        return self._secrets.get(name, "")

    def put(self, name: str, value: str) -> bool:
        """Create or update one /linear secret.  False (with a warning) when it could not be written."""
        if not self._ready(need_project=True):
            return False
        body = dict(self._where(), secretValue=value, type="shared")
        js = self._call("PATCH", f"/api/v3/secrets/raw/{urllib.parse.quote(name)}", body)
        if js is not None and js.get("_status") == 404:
            js = self._call("POST", f"/api/v3/secrets/raw/{urllib.parse.quote(name)}", body)
        if js is None or js.get("_status"):
            return False
        if self._secrets is not None:
            self._secrets[name] = value
        return True


INFISICAL_WHERE = "Infisical AI Fleet Coordinator prod /linear"


# ----------------------------------------------------------------- bearer identity
#
# A run may prove its seat with an admin-minted bearer instead of the AGENT_SEAT
# environment picker (owner direction 2026-10-26: the bearer identifies the agent, on
# the server and the Mac alike).  A trusted launcher binds the run to a non-secret
# credential LOCATOR (SIMPLE_BOARD_BEARER_LOCATOR, "FOLDER:KEY_NAME"); the locator
# says where the credential lives and is never an identity claim.  The bearer bytes
# are read through `fleet-secrets get`, only their SHA-256 leaves the process (inside
# an HMAC-signed body to the ST-MCP verify route, the same gr-bearer-verify/1
# contract git-relay uses), and the seat comes ONLY from the route's own answer.
# Every failure refuses with EXIT_AUTH:  no environment fallback, no picker.

BEARER_LOCATOR_ENV = "SIMPLE_BOARD_BEARER_LOCATOR"
# The verify endpoint is a fixed trusted origin, never from the environment:  the caller
# controls its own environment, and a caller-chosen endpoint would let the caller choose
# the answer - the very identity picker the bearer removes.
BEARER_VERIFY_URL = "https://agents.simplewithus.com/internal/gr-bearer-verify"
BEARER_VERIFY_CONTRACT = "gr-bearer-verify/1"
BEARER_SIGNATURE_HEADER = "X-Agent-Sync-Signature"
BEARER_VERIFY_KEY_NAME = "GR_BEARER_VERIFY_KEY"
BEARER_VERIFY_KEY_FOLDER = "/tools"
BEARER_MAX_RESPONSE = 4096
BEARER_TIMEOUT_S = 10
# The admin-minted bearer families, mirroring git-relay/git_relay/shared_bearer.py:
# gbb_<role>_<43 base64url> names GB-<ROLE>;  sbt_<seat>_<43> names its KNOWN_SEATS
# seat (hyphen preserved).  New families join both resolvers together.
BEARER_TOKEN_RES = (
    re.compile(r"^gbb_([a-z][a-z0-9]{1,19})_([A-Za-z0-9_-]{43})\Z"),
    re.compile(r"^sbt_([a-z][a-z0-9-]{1,19})_([A-Za-z0-9_-]{43})\Z"),
)
# FOLDER:KEY_NAME - a location, not a value.  One or more plain path segments:  no
# dots (so no "." or ".."), no empty segments, no trailing slash, depth capped.
BEARER_LOCATOR_RE = re.compile(
    r"(/[A-Za-z0-9_-]{1,64}(?:/[A-Za-z0-9_-]{1,64}){0,7}):([A-Z][A-Z0-9_]{0,63})\Z")
BEARER_REASON_RE = re.compile(r"[a-z_]{1,40}\Z")


def parse_bearer_identity(token: str) -> str | None:
    """The identity a bearer NAMES.  This is a claim, never proof:  only the
    verify route's answer authenticates it, so nothing privileged may be
    selected from this parse alone."""
    m = BEARER_TOKEN_RES[0].match(token)
    if m:
        return "GB-" + m.group(1).upper()
    m = BEARER_TOKEN_RES[1].match(token)
    if m:
        return m.group(1).upper()
    return None


def fleet_folder_secret(name: str, folder: str) -> str:
    """One secret from an explicit Fleet-OPS folder through `fleet-secrets get`, or ""
    when the tool is absent, the key is absent, or the call fails.  The value is
    never printed, logged, passed on a command line, or written to disk."""
    binary = fleet_secrets_bin()
    if not binary:
        return ""
    try:
        proc = subprocess.run([binary, "get", name, "--path", folder], capture_output=True,
                              text=True, timeout=60, check=False, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        return ""
    return proc.stdout.strip() if proc.returncode == 0 else ""


def _verify_reason(payload: bytes) -> str:
    """The route's fixed reason code, or "" - only a safe allow-listed token, never body prose."""
    try:
        answer = json.loads(payload)
    except ValueError:
        return ""
    if not isinstance(answer, dict):
        return ""
    reason = str(answer.get("reason") or "")
    return reason if BEARER_REASON_RE.fullmatch(reason) else ""


def _bearer_transport(url: str, headers: dict, body: bytes, timeout: int) -> bytes:
    """POST the signed verify body and return the answer bytes.  Raises HTTPError for an
    HTTP refusal, URLError/OSError when unreachable;  the caller maps both to EXIT_AUTH."""
    req = urllib.request.Request(url, data=body, method="POST", headers=headers)
    with opener().open(req, timeout=timeout) as resp:
        return resp.read(BEARER_MAX_RESPONSE + 1)


# Import-only test seam:  tests inject a fake transport after importing the module
# (mirroring SharedBearerVerifier's injectable transport).  The CLI binary has no
# environment override for it or for BEARER_VERIFY_URL.
BEARER_TRANSPORT = None


def bearer_verified_seat() -> str:
    """The seat PROVEN by the bearer at SIMPLE_BOARD_BEARER_LOCATOR, or die(EXIT_AUTH).

    Order is load-bearing:  the bearer is verified against the ST-MCP SeatGate
    before anything else in this run learns the seat, so no unverified value can
    select a seat's Linear app, sign a write, or pick an allowed set."""
    locator = env(BEARER_LOCATOR_ENV) or ""
    m = BEARER_LOCATOR_RE.fullmatch(locator)
    if not m:
        die(f"{BEARER_LOCATOR_ENV} must name a non-secret FOLDER:KEY_NAME location", EXIT_AUTH)
    folder, key_name = m.group(1), m.group(2)
    token = fleet_folder_secret(key_name, folder)
    if not token:
        die("no seat bearer is readable at its locator; refusing to act without a verified identity", EXIT_AUTH)
    claimed = parse_bearer_identity(token)
    if claimed is None:
        die("the value at the bearer locator is not an admin-minted bearer", EXIT_AUTH)
    key = fleet_folder_secret(BEARER_VERIFY_KEY_NAME, BEARER_VERIFY_KEY_FOLDER)
    if len(key) < 32:
        die("bearer verification is not configured on this host", EXIT_AUTH)
    digest = hashlib.sha256(token.encode()).hexdigest()
    body = json.dumps({"contract": BEARER_VERIFY_CONTRACT, "identity": claimed,
                       "hash": digest, "sent_at": int(time.time())},
                      separators=(",", ":")).encode()
    signature = hmac.new(key.encode(), body, hashlib.sha256).hexdigest()
    transport = BEARER_TRANSPORT or _bearer_transport
    try:
        payload = transport(BEARER_VERIFY_URL, {
            "Content-Type": "application/json",
            "User-Agent": "simple-board/1.0 (+fleet)",
            BEARER_SIGNATURE_HEADER: signature}, body, BEARER_TIMEOUT_S)
    except urllib.error.HTTPError as e:
        try:
            payload = e.read(BEARER_MAX_RESPONSE + 1)
        except OSError:
            payload = b""
        reason = _verify_reason(payload) or "http_%d" % (e.code or 0)
        die(f"bearer verification refused ({reason})", EXIT_AUTH)
    except (urllib.error.URLError, http.client.HTTPException, OSError, ValueError):
        die("bearer verification is unreachable; refusing to act without a verified identity", EXIT_AUTH)
    if len(payload) > BEARER_MAX_RESPONSE:
        die("bearer verification answer was oversized", EXIT_AUTH)
    reason = _verify_reason(payload)
    def _no_constant(name):  # NaN / Infinity / -Infinity are not JSON;  never let one reach a comparison
        raise ValueError(name)
    try:
        answer = json.loads(payload, parse_constant=_no_constant)
    except ValueError:
        die("bearer verification answer was not JSON", EXIT_AUTH)
    if not isinstance(answer, dict) or answer.get("ok") is not True:
        die(f"bearer verification refused ({reason or 'bad_answer'})", EXIT_AUTH)
    # The answer must name the identity asked about:  a route answering for a
    # different identity is a bug or an attack, not auth (mirrors shared_bearer.py).
    if answer.get("identity") != claimed:
        die("bearer verification answered for a different identity", EXIT_AUTH)
    expires = answer.get("expires_at")
    if (isinstance(expires, bool) or not isinstance(expires, (int, float))
            or not math.isfinite(expires) or expires <= time.time() * 1000):
        die("the seat bearer is expired or carries no valid expiry", EXIT_AUTH)
    seat = answer["identity"]
    if not re.fullmatch(r"[A-Z][A-Z0-9-]{0,31}", seat):
        die("bearer verification answered an invalid seat tag", EXIT_AUTH)
    # The verifier names canonical seat tags (KNOWN_SEATS / GB-<ROLE>).  A verified identity is used
    # exactly as answered, never re-mapped:  an alias spelling here would merge two identities.
    if norm_seat(seat) != seat:
        die("bearer verification answered a non-canonical seat tag", EXIT_AUTH)
    return seat


# ----------------------------------------------------------------- seat

def current_seat(required: bool = True) -> str:
    """The seat this run acts as, proven by the admin-minted bearer at
    SIMPLE_BOARD_BEARER_LOCATOR (owner direction 2026-10-26:  the bearer
    identifies the agent;  there is no identity picker).  AGENT_SEAT is never
    consulted.  The five write verbs require a verified seat, because every
    write is signed with it and the CLI never guesses;  with no locator they
    refuse with EXIT_AUTH.  Reads (list, show, stats, whoami) run without one:
    they write nothing, and a locator is absent in plain shells, in `zsh -lic`,
    and under the listener's `env -i`."""
    if env(BEARER_LOCATOR_ENV):
        # The verified route answer is the only seat source, so a stale
        # environment cannot widen or redirect what the bearer proves.
        return bearer_verified_seat()
    if not required:
        return ""
    die(f"no verified seat:  {BEARER_LOCATOR_ENV} is not set.  The CLI writes only as a "
        "bearer-verified seat and never takes an identity from the environment;  the trusted "
        "launcher binds the run's bearer locator.  Reads (list, show, stats, whoami) work "
        "without one.", EXIT_AUTH)


def check_by(by: str | None, seat: str, flag: str = "--by") -> str:
    if by is None:
        return seat
    if norm_seat(by) != seat:
        die(f"{flag} {by} does not match the verified seat {seat}.  --by is never the source of "
            "identity;  run as that seat or drop the flag.", EXIT_USAGE)
    return seat


def seat_tag(seat: str, sessions: list[str] | None) -> str:
    s8 = (sessions[0].replace("-", "")[:8]) if sessions else ""
    return f"[{seat}·{s8}]" if s8 else f"[{seat}]"


# ----------------------------------------------------------------- input files and flat labels

def read_private_file(path: str, flag: str) -> bytes:
    """The bytes of a file a seat handed over so its text stays out of argv:  a regular file owned by
    the caller with mode exactly 0600 or 0400, at most INPUT_MAX_BYTES.  The checks run on the open
    descriptor (O_NOFOLLOW refuses a symlink, O_NONBLOCK keeps a FIFO from hanging), so the file cannot
    be swapped between the check and the read.  Anything else exits 2.  The text is never echoed."""
    flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | getattr(os, "O_CLOEXEC", 0)
    try:
        fd = os.open(path, flags)
    except OSError as e:
        if e.errno == errno.ELOOP:
            die(f"{flag} {path}: is a symbolic link;  pass the real file", EXIT_USAGE)
        die(f"{flag} {path}: cannot open it ({e.strerror or type(e).__name__})", EXIT_USAGE)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            die(f"{flag} {path}: not a regular file", EXIT_USAGE)
        if st.st_uid != os.geteuid():
            die(f"{flag} {path}: not owned by you", EXIT_USAGE)
        mode = stat.S_IMODE(st.st_mode)
        if mode not in (0o600, 0o400):
            die(f"{flag} {path}: mode {mode:04o} is not 0600 or 0400, so others may read or change it;  "
                f"run chmod 600 on it first", EXIT_USAGE)
        if st.st_size > INPUT_MAX_BYTES:
            die(f"{flag} {path}: more than {INPUT_MAX_BYTES // 1024} KB", EXIT_USAGE)
        data = b""
        while len(data) <= INPUT_MAX_BYTES:
            chunk = os.read(fd, INPUT_MAX_BYTES + 1 - len(data))
            if not chunk:
                break
            data += chunk
        return data
    finally:
        os.close(fd)


def read_text_input(src: str, flag: str) -> str:
    """Text for --desc-file, --fix-file or --text-file:  the private file at `src`, or standard input
    for `-`.  At most INPUT_MAX_BYTES of strict UTF-8, else exit 2."""
    if src == "-":
        data = sys.stdin.buffer.read(INPUT_MAX_BYTES + 1)
        where = "standard input"
    else:
        data = read_private_file(src, flag)
        where = src
    if len(data) > INPUT_MAX_BYTES:
        die(f"{flag} {where}: more than {INPUT_MAX_BYTES // 1024} KB", EXIT_USAGE)
    try:
        return data.decode("utf-8")
    except UnicodeDecodeError:
        die(f"{flag} {where}: not valid UTF-8", EXIT_USAGE)


def flat_label(raw: str | None, flag: str = "--label") -> str:
    """The canonical name of an allowed flat label, or exit 2 saying why it is refused.  Matching ignores
    case and surrounding spaces, so Needs-Owner is needs-owner and never a second label."""
    name = (raw or "").strip()
    low = name.lower()
    if low in FLAT_LABELS:
        return low
    if low.startswith(CLAIM_PREFIX):
        why = "a claimed:* label is a claim;  `board claim` writes it"
    elif low.startswith(SEAT_PREFIX):
        why = "a seat:* label is attribution;  `board claim` and `board file` write it"
    elif low.split("/", 1)[0] in ("kind", "severity", "env") or low in ("kind", "severity", "env"):
        why = "Kind, Severity and Env are single-select groups;  use --kind, --severity or --env"
    elif low in KINDS:
        why = "that is a Kind;  use --kind"
    elif low.upper() in SEVERITIES:
        why = "that is a Severity;  use --severity"
    elif low in ENVS:
        why = "that is an Env;  use --env"
    else:
        why = "it is not one of the flat labels this CLI may set"
    die(f"{flag} {raw!r}: {why}.  Allowed:  {', '.join(FLAT_LABELS)}", EXIT_USAGE)


def flat_labels(raws: list[str] | None, flag: str = "--label") -> list[str]:
    """Validated, de-duplicated flat label names in the order given."""
    out: list[str] = []
    for raw in raws or []:
        name = flat_label(raw, flag)
        if name not in out:
            out.append(name)
    return out


def prepare_inputs(a) -> None:
    """Validate flags and read every --*-file before any credential is read or request is sent, so a bad
    input exits 2 having touched nothing.  Runs after the writes-off gate:  a gated write never reads a
    file (or standard input)."""
    if a.cmd in ("file", "list"):
        a.labels = flat_labels(a.labels)
    if a.cmd == "label":
        a.label_name = flat_label(a.label_name, "NAME")
    files = []
    if a.cmd == "file":
        files = [("--desc-file", a.desc_file, "desc"), ("--fix-file", a.fix_file, "fix")]
    elif a.cmd == "comment":
        files = [("--text-file", a.text_file, "text")]
    files = [f for f in files if f[1] is not None]
    if sum(1 for f in files if f[1] == "-") > 1:
        die("only one of --desc-file and --fix-file can read standard input (-)", EXIT_USAGE)
    for flag, src, attr in files:
        text = read_text_input(src, flag)
        if a.cmd == "comment" and not text.strip():
            die(f"{flag} {'standard input' if src == '-' else src}: the comment text is empty", EXIT_USAGE)
        setattr(a, attr, text)


# ----------------------------------------------------------------- credentials and token

FLEET_OPS_LINEAR_PATH = "/linear"
FLEET_OPS_WHERE = "Infisical Fleet-OPS prod /linear"


def fleet_secrets_bin() -> str | None:
    """The fleet-secrets binary, or None when this host has none (a cloud runtime)."""
    binary = env("LINEAR_BOARD_FLEET_SECRETS") or shutil.which("fleet-secrets") or str(
        Path.home() / ".local" / "bin" / "fleet-secrets")
    return binary if os.access(binary, os.X_OK) else None


def fleet_ops_secret(name: str) -> str:
    """One Fleet-OPS /linear secret through `fleet-secrets get` (AFC-359), or "" when the tool is absent, the
    key is absent, or the call fails.  The value is never printed or logged."""
    binary = fleet_secrets_bin()
    if not binary:
        return ""
    try:
        proc = subprocess.run([binary, "get", name, "--path", FLEET_OPS_LINEAR_PATH], capture_output=True,
                              text=True, timeout=60, check=False, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        return ""
    return proc.stdout.strip() if proc.returncode == 0 else ""


AFC_PROJECT = INFISICAL_PROJECT_SLUG  # the `fleet-secrets get --project` selector for the same project
AFC_WHERE = INFISICAL_WHERE  # where those credentials live, whichever loader reads them


def fleet_project_secret(name: str, folder: str, project: str) -> str:
    """One secret from one named project folder through `fleet-secrets get NAME --path FOLDER --project PROJECT`,
    or "" when the tool is absent, the key is absent, or the call fails.  The value is never printed, logged,
    passed on a command line, or written to disk."""
    binary = fleet_secrets_bin()
    if not binary:
        return ""
    try:
        proc = subprocess.run([binary, "get", name, "--path", folder, "--project", project], capture_output=True,
                              text=True, timeout=60, check=False, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        return ""
    return proc.stdout.strip() if proc.returncode == 0 else ""


def fleet_afc_secret(name: str) -> str:
    """One AI Fleet Coordinator prod /linear secret through `fleet-secrets get` (AFC-348), or "" when the tool is
    absent, the key is absent, or the call fails.  The value is never printed or logged."""
    return fleet_project_secret(name, INFISICAL_LINEAR_PATH, AFC_PROJECT)


def fleet_ops_set(name: str, value: str) -> bool:
    """Write one Fleet-OPS /linear secret with `fleet-secrets set`.  The value goes on standard input, never
    in an argument.  False when the tool is absent or the write failed."""
    binary = fleet_secrets_bin()
    if not binary:
        return False
    try:
        proc = subprocess.run([binary, "set", name, "--path", FLEET_OPS_LINEAR_PATH], input=value, text=True,
                              capture_output=True, timeout=60, check=False)
    except (OSError, subprocess.SubprocessError):
        return False
    return proc.returncode == 0


ENV_PAIR = "environment (LINEAR_CLIENT_ID, LINEAR_CLIENT_SECRET)"


def seat_env_key(seat: str) -> str:
    """The seat as it appears in variable names:  GROK-WEB is GROK_WEB."""
    return seat.replace("-", "_")


def fleet_app_name() -> str:
    return env("LINEAR_FLEET_APP_NAME", "Fleet")


class Identity:
    """The Linear app a run acts as, where its credentials came from (`where`
    is a path or variable names, never a value), the Infisical secret that
    holds its minted token, and the viewer names Linear may answer with for it.

    kind "seat":   the seat's own app, from the environment (LINEAR_<SEAT>_CLIENT_ID)
                   or from Infisical (<SEAT>_LINEAR_CLIENT_ID or LINEAR_<SEAT>_CLIENT_ID).
    kind "fleet":  the shared Fleet app, from the environment (LINEAR_FLEET_CLIENT_ID)
                   or from Infisical (FLEET_LINEAR_CLIENT_ID or LINEAR_FLEET_CLIENT_ID).
    kind "env":    LINEAR_CLIENT_ID and LINEAR_CLIENT_SECRET, a cloud runtime's
                   pair, which may hold the seat's app or Fleet."""

    def __init__(self, kind: str, seat: str, cid: str, sec: str, where: str, blob: str,
                 accept: tuple, label: str, shared: str = "", slug: str = "Fleet", prefetched: str | None = None):
        self.kind, self.seat, self.cid, self.sec = kind, seat, cid, sec
        self.where, self.blob, self.accept, self.label = where, blob, accept, label
        # blob:  the Fleet-OPS /linear secret that holds this app's minted token (CACHE_<SEAT>, CACHE_FLEET),
        # or "" for the environment's generic pair, which may be either app, so it has no shared token.
        # shared:  the old AI Fleet Coordinator name (LINEAR_<SEAT>_CACHE_TOKEN), used only on a host with no
        # fleet-secrets (a server or cloud runtime) that has an INFISICAL_AUTOMATION identity.
        self.shared = shared
        self.slug = slug  # names the app's idempotency file
        self.prefetched = prefetched  # the token blob read together with the client pair, if it was there


def resolve_identity(seat: str = "") -> Identity:
    """Which Linear app this run acts as.  Only OAuth client credentials of a
    fleet app are read:  a personal or admin API key never is, from any file or
    variable, so the CLI cannot act as Jay.  No credential file is read
    (AFC-359).  The process environment is consulted first for every pair, and
    a stored value is a fallback:  the first that applies wins.

    1. LINEAR_CLIENT_ID and LINEAR_CLIENT_SECRET in the environment (a cloud
       runtime's pair).  They may hold the seat's app or Fleet, so they have
       no shared token:  one is minted per run.
    2. With a verified seat in SEAT_APP_NAMES:  LINEAR_<SEAT>_CLIENT_ID and
       LINEAR_<SEAT>_CLIENT_SECRET from the environment;  then
       <SEAT>_LINEAR_CLIENT_ID and <SEAT>_LINEAR_CLIENT_SECRET from Infisical
       Fleet-OPS prod /linear (`fleet-secrets get`), read together with that
       app's token blob CACHE_<SEAT>;  then LINEAR_<SEAT>_CLIENT_ID and
       _SECRET from Infisical AI Fleet Coordinator prod /linear, through
       `fleet-secrets get` with that project.
    3. The shared Fleet app (every read without a verified seat, and a seat with
       no app yet):  LINEAR_FLEET_CLIENT_ID and LINEAR_FLEET_CLIENT_SECRET from
       the environment;  then FLEET_LINEAR_CLIENT_ID and
       FLEET_LINEAR_CLIENT_SECRET plus CACHE_FLEET from Fleet-OPS /linear;
       then LINEAR_FLEET_CLIENT_ID and _SECRET from the AI Fleet Coordinator
       prod /linear folder.

    A seat with an app of its own never falls back to the shared Fleet app:
    the fleet pair is read in the fleet branch, after the seat's own."""
    fleet = fleet_app_name()
    app = SEAT_APP_NAMES.get(seat, "") if seat else ""
    app_names = seat_app_names(seat)
    cid_e = os.environ.get("LINEAR_CLIENT_ID", "").strip()
    sec_e = os.environ.get("LINEAR_CLIENT_SECRET", "").strip()
    if cid_e and sec_e:
        return Identity("env", seat, cid_e, sec_e, ENV_PAIR, "",
                        tuple(n for n in (*app_names, fleet) if n), "LINEAR_CLIENT_ID app")

    def read_app(prefix: str, blob: str) -> tuple:
        """(client id, client secret, token blob or None), each through its own `fleet-secrets get NAME`.  Nothing
        dumps the secret store's environment or parses KEY=value lines, so no other value is ever held."""
        names = [f"{prefix}_LINEAR_CLIENT_ID", f"{prefix}_LINEAR_CLIENT_SECRET", blob]
        got = {n: v for n in names if (v := fleet_ops_secret(n))}
        return got.get(names[0], ""), got.get(names[1], ""), got.get(blob)

    def read_afc(prefix: str) -> tuple:
        """(client id, client secret) from the AI Fleet Coordinator prod /linear folder, through
        `fleet-secrets get NAME --path /linear --project ai-fleet-coordinator`:  the approved
        loader, never a direct Infisical call (AFC-348, AFC-359)."""
        return (fleet_afc_secret(f"LINEAR_{prefix}_CLIENT_ID"),
                fleet_afc_secret(f"LINEAR_{prefix}_CLIENT_SECRET"))

    k = seat_env_key(seat)
    if app:
        shared = f"LINEAR_{k}_CACHE_TOKEN"
        # the environment first:  an operator's exported pair beats the stored one
        cid_s = os.environ.get(f"LINEAR_{k}_CLIENT_ID", "").strip()
        sec_s = os.environ.get(f"LINEAR_{k}_CLIENT_SECRET", "").strip()
        if cid_s and sec_s:
            return Identity("seat", seat, cid_s, sec_s,
                            f"environment (LINEAR_{k}_CLIENT_ID, LINEAR_{k}_CLIENT_SECRET)",
                            f"CACHE_{k}", app_names, f"{app} seat app", shared, seat)
        # then the seat's own pair in Fleet-OPS prod /linear, with that app's token blob
        cid_o, sec_o, blob_o = read_app(k, f"CACHE_{k}")
        if cid_o and sec_o:
            return Identity("seat", seat, cid_o, sec_o,
                            f"{FLEET_OPS_WHERE} ({k}_LINEAR_CLIENT_ID, {k}_LINEAR_CLIENT_SECRET)",
                            f"CACHE_{k}", app_names, f"{app} seat app", shared, seat, blob_o or "")
        # then the seat's own pair in the AI Fleet Coordinator prod /linear folder
        cid_i, sec_i = read_afc(k)
        if cid_i and sec_i:
            return Identity("seat", seat, cid_i, sec_i,
                            f"{AFC_WHERE} (LINEAR_{k}_CLIENT_ID, LINEAR_{k}_CLIENT_SECRET)",
                            f"CACHE_{k}", app_names, f"{app} seat app", shared, seat)
    # the shared Fleet app:  the environment first, then Fleet-OPS prod /linear, then the AFC folder
    cid_f = os.environ.get("LINEAR_FLEET_CLIENT_ID", "").strip()
    sec_f = os.environ.get("LINEAR_FLEET_CLIENT_SECRET", "").strip()
    if cid_f and sec_f:
        return Identity("fleet", seat, cid_f, sec_f,
                        "environment (LINEAR_FLEET_CLIENT_ID, LINEAR_FLEET_CLIENT_SECRET)",
                        "CACHE_FLEET", (fleet,), f"shared {fleet} app", "LINEAR_FLEET_CACHE_TOKEN", "Fleet")
    cid_o, sec_o, blob_o = read_app("FLEET", "CACHE_FLEET")
    if cid_o and sec_o:
        return Identity("fleet", seat, cid_o, sec_o, f"{FLEET_OPS_WHERE} (FLEET_LINEAR_CLIENT_ID, FLEET_LINEAR_CLIENT_SECRET)",
                        "CACHE_FLEET", (fleet,), f"shared {fleet} app", "LINEAR_FLEET_CACHE_TOKEN", "Fleet", blob_o or "")
    cid_i, sec_i = read_afc("FLEET")
    if cid_i and sec_i:
        return Identity("fleet", seat, cid_i, sec_i, f"{AFC_WHERE} (LINEAR_FLEET_CLIENT_ID, LINEAR_FLEET_CLIENT_SECRET)",
                        "CACHE_FLEET", (fleet,), f"shared {fleet} app", "LINEAR_FLEET_CACHE_TOKEN", "Fleet")
    seat_part = (f", and {seat} has no app credentials of its own ({k}_LINEAR_CLIENT_ID and {k}_LINEAR_CLIENT_SECRET "
                 f"in Infisical Fleet-OPS {FLEET_OPS_LINEAR_PATH}, or LINEAR_{k}_CLIENT_ID and LINEAR_{k}_CLIENT_SECRET "
                 "in the environment or in Infisical AI Fleet Coordinator /linear)") if app else ""
    # The variables the message names, in the order it names them:  the structured
    # field is what a caller downstream reads, and it cannot disagree with the prose.
    missing = ["FLEET_LINEAR_CLIENT_ID", "FLEET_LINEAR_CLIENT_SECRET",
               "LINEAR_FLEET_CLIENT_ID", "LINEAR_FLEET_CLIENT_SECRET",
               "LINEAR_CLIENT_ID", "LINEAR_CLIENT_SECRET"]
    if app:
        missing += [f"{k}_LINEAR_CLIENT_ID", f"{k}_LINEAR_CLIENT_SECRET",
                    f"LINEAR_{k}_CLIENT_ID", f"LINEAR_{k}_CLIENT_SECRET"]
    die(f"no Fleet credentials: FLEET_LINEAR_CLIENT_ID and FLEET_LINEAR_CLIENT_SECRET are missing from Infisical "
        f"Fleet-OPS {FLEET_OPS_LINEAR_PATH} (`fleet-secrets get`), LINEAR_FLEET_CLIENT_ID and LINEAR_FLEET_CLIENT_SECRET "
        f"are not set in the environment or in Infisical AI Fleet Coordinator {FLEET_OPS_LINEAR_PATH}, and LINEAR_CLIENT_ID "
        f"and LINEAR_CLIENT_SECRET are not set{seat_part}.  Check `fleet-secrets doctor`.", EXIT_NO_CREDS,
        credential_field=",".join(missing))


def _read_cache(fd: int) -> dict:
    os.lseek(fd, 0, os.SEEK_SET)
    raw = b""
    while True:
        chunk = os.read(fd, 65536)
        if not chunk:
            break
        raw += chunk
    try:
        cache = json.loads(raw) if raw.strip() else {}
    except ValueError:
        cache = {}
    return cache if isinstance(cache, dict) else {}


def _write_cache(fd: int, cache: dict) -> None:
    os.lseek(fd, 0, os.SEEK_SET)
    os.ftruncate(fd, 0)
    os.write(fd, json.dumps(cache).encode())
    os.fsync(fd)


class Auth:
    """The token of one identity.  It lives in Infisical Fleet-OPS /linear, one secret per app
    (CACHE_<SEAT>, CACHE_FLEET), read on every run and written back after a mint, so no token
    ever sits on disk (AFC-359) and every host and process shares one.  Mints at most once per
    24 hours per app (design section 2).  The token is never printed."""

    def __init__(self, token_url: str, ident: Identity | None = None):
        self.token_url = token_url
        # None:  resolved with no seat at the first request, so a caller that
        # names none (relabel_claims.py) acts as the shared Fleet app.
        self.ident = ident
        self.token: str | None = None
        self.info: dict = {}
        self.where = ""
        self._used_prefetch = False
        self._read_at = 0.0

    def identity(self) -> Identity:
        if self.ident is None:
            self.ident = resolve_identity("")
        return self.ident

    @property
    def label(self) -> str:
        return self.ident.label if self.ident else f"shared {fleet_app_name()} app"

    @staticmethod
    def _fingerprint(cid: str, sec: str) -> str:
        return hashlib.sha256(f"linear-board:creds:{cid}:{sec}".encode()).hexdigest()[:16]

    @staticmethod
    def _parse(raw) -> dict:
        try:
            blob = json.loads(raw) if raw else {}
        except ValueError:
            blob = {}
        return blob if isinstance(blob, dict) else {}

    def _has_store(self, ident: Identity) -> bool:
        """Whether this app's token has a shared home:  Fleet-OPS through fleet-secrets, or, on a host
        with no fleet-secrets, the old AI Fleet Coordinator folder through an INFISICAL_AUTOMATION identity."""
        if ident.blob and fleet_secrets_bin():
            return True
        return bool(ident.shared and Infisical.get().enabled and Infisical.get()._identity())

    def _read_blob(self, ident: Identity) -> dict:
        self._read_at = time.time()
        if ident.blob and fleet_secrets_bin():
            return self._parse(fleet_ops_secret(ident.blob))
        if ident.shared:
            return self._parse(Infisical.get().value(ident.shared))
        return {}

    def _write_blob(self, ident: Identity, blob: dict) -> None:
        """Save the blob in Infisical.  A failed write only warns (names only);  the token is used for
        this run and never written anywhere else."""
        if not self._has_store(ident):
            return
        text = json.dumps(blob)
        if ident.blob and fleet_secrets_bin():
            ok, where = fleet_ops_set(ident.blob, text), f"{FLEET_OPS_WHERE} {ident.blob}"
        else:
            row = {k: blob[k] for k in ("access_token", "token_type", "scope", "minted_at", "expires_at", "cred_fp",
                                        "viewer") if k in blob}
            row["minted_by"] = os.uname().nodename
            ok, where = Infisical.get().put(ident.shared, json.dumps(row)), f"{INFISICAL_WHERE} {ident.shared}"
        if not ok:
            warn(f"could not save the new {ident.label} token in Infisical ({where});  using it for this run only")

    @staticmethod
    def _usable(blob: dict, fp: str, failed: str | None, now: float) -> bool:
        tok = blob.get("access_token")
        return bool(tok and blob.get("cred_fp") == fp and tok != failed
                    and float(blob.get("expires_at") or 0) - now > 3600)

    def get(self, failed: str | None = None) -> str:
        if self.token and self.token != failed:
            return self.token
        ident = self.identity()
        self.where = ident.where
        fp = self._fingerprint(ident.cid, ident.sec)
        now = time.time()
        if ident.prefetched is not None and not self._used_prefetch and failed is None:
            self._used_prefetch = True
            self._read_at = now
            blob = self._parse(ident.prefetched)
        else:
            blob = self._read_blob(ident)
        if not self._usable(blob, fp, failed, now) and (failed or now - self._read_at > 5):
            blob = self._read_blob(ident)  # another process may have just refreshed it
        tok = blob.get("access_token")
        minted = float(blob.get("minted_at") or 0)
        if self._usable(blob, fp, failed, now):
            if now - minted < REMINT_AFTER:
                self.token, self.info = tok, blob
                return tok
            # Day 28 of a 30-day token:  mint the next one now, while this one still works,
            # so a Linear outage on the last day cannot leave the seat without a token.
            # A failed early mint keeps the stored token.
            try:
                return self._store(ident, fp, now)
            except (SystemExit, Exception) as e:
                warn(f"re-minting the {ident.label} token early failed ({type(e).__name__});  using the stored one, "
                     f"which expires {central(float(blob.get('expires_at') or 0))}")
                self.token, self.info = tok, blob
                return tok
        if blob.get("cred_fp") == fp and now - minted < 86400 and env("LINEAR_BOARD_REMINT") != "1":
            why = f"Linear refused the stored {ident.label} token" if tok and tok == failed else \
                  f"the stored {ident.label} token is unusable"
            die(f"{why}, and it was minted {central(minted)}, under 24 hours ago.  Not minting "
                "again (design section 2: at most one mint a day per app).  If the app was rotated, "
                "update its credentials in Infisical; to force one mint, rerun with LINEAR_BOARD_REMINT=1.",
                EXIT_AUTH, credential=credential_preview(tok),
                credential_field=credential_vars(ident.where))
        return self._store(ident, fp, now)

    def _store(self, ident: Identity, fp: str, now: float) -> str:
        """Mint, save the blob in Infisical, and use the new token."""
        new = self._mint(ident)
        blob = {
            "access_token": new["access_token"],
            "token_type": new.get("token_type") or "Bearer",
            "scope": new.get("scope") or SCOPE,
            "minted_at": now,
            "expires_at": now + float(new.get("expires_in") or 30 * 86400),
            "cred_fp": fp,
        }
        self.token, self.info = blob["access_token"], blob
        self._write_blob(ident, blob)
        return self.token

    def remember_viewer(self, viewer: dict, org: dict) -> None:
        """Keep who Linear says the current token belongs to in that token's blob.  A mint writes a
        fresh blob, so the record never outlives its token, and the write check costs one viewer
        request per mint rather than one per write."""
        if not self.token:
            return
        record = {"name": viewer.get("name"), "app": bool(viewer.get("app")), "workspace": org.get("urlKey")}
        if self.info.get("viewer") == record:
            return
        self.info = dict(self.info, viewer=record)
        self._write_blob(self.identity(), self.info)

    def viewer(self, L: "Linear") -> dict:
        """{name, app, workspace} for the current token:  from its cache entry,
        or one viewer request that is then kept there."""
        self.get()
        v = self.info.get("viewer")
        if isinstance(v, dict) and v.get("name"):
            return v
        try:
            d = L.call(Q_WHOAMI)
        except GqlError as e:
            # The sentence says what failed and nothing of Linear's own text:  the
            # codes, the status and the request id come back as fields of their own.
            die(f"cannot confirm which Linear app the credentials in {self.where} belong to: {gql_summary(e)}", EXIT_AUTH,
                **error_fields(e, credential_preview(self.token or ""), self.identity().where))
        vw, org = d.get("viewer") or {}, d.get("organization") or {}
        self.remember_viewer(vw, org)
        return {"name": vw.get("name"), "app": bool(vw.get("app")), "workspace": org.get("urlKey")}

    def _mint(self, ident: Identity) -> dict:
        body = urllib.parse.urlencode({
            "grant_type": "client_credentials", "client_id": ident.cid, "client_secret": ident.sec,
            "scope": SCOPE,
        }).encode()
        req = urllib.request.Request(self.token_url, data=body, method="POST", headers={
            "Content-Type": "application/x-www-form-urlencoded", "User-Agent": USER_AGENT})
        timeout = env_float("LINEAR_BOARD_TIMEOUT", 60)
        try:
            with opener().open(req, timeout=timeout) as r:
                js = json.loads(r.read() or b"{}")
        except urllib.error.HTTPError as e:
            # The error body is Linear's own text and can carry anything, so it is
            # not read:  the status and the request id come back as fields instead.
            die(f"minting the {ident.label} token failed", EXIT_AUTH,
                **error_fields(e, credential_preview(ident.sec), ident.where))
        except (urllib.error.URLError, http.client.HTTPException, OSError, ValueError) as e:
            die(f"cannot reach Linear to mint the {ident.label} token ({type(e).__name__})", EXIT_ERROR)
        if not isinstance(js, dict) or not js.get("access_token"):
            die(f"minting the {ident.label} token failed: Linear answered without an access token", EXIT_AUTH,
                credential=credential_preview(ident.sec),
                credential_field=credential_vars(ident.where))
        return js


def write_identity_problem(ident: Identity, v: dict) -> str:
    """Why this identity may not write, from what Linear says its viewer is;
    empty when it may."""
    name = v.get("name")
    want = " or ".join(repr(n) for n in ident.accept)
    if not v.get("app"):
        why = f"Linear says the credentials in {ident.where} belong to a person ({name!r}), not an app"
    elif not app_name_ok(name, ident.accept, ident.seat):
        why = f"Linear says the credentials in {ident.where} belong to the {name!r} app, not {want}"
    elif v.get("workspace") != WORKSPACE_URL_KEY:
        why = f"the credentials in {ident.where} act in workspace {v.get('workspace')!r}, not {WORKSPACE_URL_KEY!r}"
    else:
        return ""
    if ident.kind == "seat":
        fix = (f"They look swapped with another seat's.  Put the {' or '.join(ident.accept)} app's client credentials "
               f"there, or move them aside so {ident.seat} writes as the shared {fleet_app_name()} app.  "
               "Set LINEAR_CLIENT_ID and LINEAR_CLIENT_SECRET to that app's pair, or unset them.")
    else:
        fix = ("Set LINEAR_CLIENT_ID and LINEAR_CLIENT_SECRET to this seat's app or the shared "
               f"{fleet_app_name()} app, or unset them.")
    return f"{why}.  {fix}"


def check_write_identity(L: "Linear", auth: Auth) -> None:
    """Before a write, a seat app (or the environment's pair) must be the app
    it claims to be:  swapped credentials would sign one seat's words as
    another's.  Reads skip this.  The shared Fleet app is not checked here,
    as before."""
    ident = auth.identity()
    if ident.kind == "fleet":
        return
    problem = write_identity_problem(ident, auth.viewer(L))
    if problem:
        # The fix names LINEAR_CLIENT_ID and LINEAR_CLIENT_SECRET, and the field
        # names the same two:  a caller downstream reads the field, never the prose.
        die(f"refusing to write as {ident.seat}: {problem}  Reads still work.", EXIT_NO_CREDS,
            credential_field="LINEAR_CLIENT_ID,LINEAR_CLIENT_SECRET")


# ----------------------------------------------------------------- GraphQL client

class GqlError(Exception):
    def __init__(self, errors: list, data=None, status: int | None = None,
                 headers: dict | None = None, request_id: str | None = None):
        self.errors = [e for e in (errors or []) if isinstance(e, dict)] or [{"message": "unknown error"}]
        self.data = data
        # The response the error came from:  its status, its headers and the request
        # id they carry are what Linear's support asks for.
        self.status = status
        self.headers = headers or {}
        self.request_id = request_id
        super().__init__("; ".join((e.get("message") or "error")[:300] for e in self.errors))

    @property
    def code(self) -> str | None:
        for e in self.errors:
            ext = e.get("extensions") or {}
            if ext.get("code") or ext.get("type"):
                return str(ext.get("code") or ext.get("type"))
        return None

    def not_found(self) -> bool:
        for e in self.errors:
            code = str((e.get("extensions") or {}).get("code") or "").upper()
            if code in ("NOT_FOUND", "ENTITY_NOT_FOUND") or \
                    re.search(r"not found|could not find|does not exist", e.get("message") or "", re.I):
                return True
        return False


def gql_summary(e: BaseException) -> str:
    """Allow-listed fields from an external API error for logs:  error name, HTTP status,
    the GraphQL codes and the request id.  Never the response body, headers, or credentials.

    Linear's error body is third-party text:  it can carry a credential, a person's words or a
    prompt.  Every message the CLI prints reaches stderr and a job log keeps it, so only the
    machine-readable codes are quoted and the prose is dropped.  The codes are enough to tell a
    rate limit from a refused scope from a validation failure.
    """
    codes = set()
    for err in (getattr(e, "errors", None) or []):
        if not isinstance(err, dict):
            continue
        code = str((err.get("extensions") or {}).get("code") or "").strip()
        if code:
            codes.add(code)
    code = ", ".join(sorted(codes)) if codes else getattr(e, "code", None)
    return (f"error={type(e).__name__} status={getattr(e, 'status', None)} "
            f"code={code} request_id={getattr(e, 'request_id', None)}")


def _err_code(e: dict) -> str:
    ext = e.get("extensions") or {}
    return str(ext.get("code") or ext.get("type") or "").upper().replace(" ", "_")


def _is_ratelimit(e: dict) -> bool:
    return _err_code(e) == "RATELIMITED" or "rate limit" in (e.get("message") or "").lower()


def _is_auth_error(e: dict) -> bool:
    return _err_code(e) in ("AUTHENTICATION_ERROR", "UNAUTHENTICATED")


class Linear:
    def __init__(self, auth: Auth, url: str):
        self.auth = auth
        self.url = url
        self.opener = opener()
        self.timeout = env_float("LINEAR_BOARD_TIMEOUT", 60)
        self.base_delay = env_float("LINEAR_BOARD_BACKOFF_BASE", 2.0)
        self.max_wait = env_float("LINEAR_BOARD_MAX_WAIT", 90.0)
        self.requests = 0
        # Mutations of the running verb that already landed, so a give-up part
        # way through a multi-step verb says what was applied instead of
        # "not applied".  `rerun` is the advice that goes with them.
        self.landed: list[str] = []
        self.rerun = "Rerunning the same command is safe and finishes the rest."

    def partial(self) -> str:
        if not self.landed:
            return ""
        return ("  The command stopped part way.  Already applied: " + "; ".join(self.landed) + ".  "
                + self.rerun)

    def fail(self, msg: str, code: int = EXIT_ERROR) -> "NoReturn":  # noqa: F821
        """die(), naming any mutation of this verb that already landed."""
        die(msg + self.partial(), code)

    def _post(self, body: bytes, token: str):
        req = urllib.request.Request(self.url, data=body, method="POST", headers={
            "Content-Type": "application/json", "Authorization": f"Bearer {token}",
            "User-Agent": USER_AGENT})
        self.requests += 1
        try:
            with self.opener.open(req, timeout=self.timeout) as r:
                raw = r.read()
                return r.status, (json.loads(raw) if raw else {}), {k.lower(): v for k, v in r.headers.items()}
        except urllib.error.HTTPError as e:
            if 300 <= e.code < 400:
                die(f"Linear answered with a redirect (HTTP {e.code}); refusing to follow it")
            raw = e.read() or b""
            try:
                js = json.loads(raw)
            except ValueError:
                js = {}
            return e.code, (js if isinstance(js, dict) else {}), {k.lower(): v for k, v in (e.headers or {}).items()}

    @staticmethod
    def _reset_at(hdrs: dict) -> float | None:
        stamps = []
        for h in ("x-ratelimit-requests-reset", "x-ratelimit-complexity-reset",
                  "x-ratelimit-endpoint-requests-reset"):
            v = hdrs.get(h)
            if v and v.isdigit():
                stamps.append(int(v) / 1000.0)
        ra = hdrs.get("retry-after")
        if ra and re.fullmatch(r"\d+(\.\d+)?", ra):
            stamps.append(time.time() + float(ra))
        return max(stamps) if stamps else None

    def call(self, query: str, variables: dict | None = None) -> dict:
        """Data of one GraphQL operation.  Raises GqlError on GraphQL errors.
        Retries Linear's rate limit (HTTP 400 RATELIMITED, or 429), 5xx and
        transport errors with backoff, never past LINEAR_BOARD_MAX_WAIT."""
        body = json.dumps({"query": query, "variables": variables or {}}).encode()
        deadline = time.time() + self.max_wait
        delay = self.base_delay
        token = self.auth.get()
        reminted = False
        for _ in range(12):
            try:
                status, js, hdrs = self._post(body, token)
            except (urllib.error.URLError, http.client.HTTPException, OSError) as e:
                if time.time() + delay > deadline:
                    self.fail(f"no usable response from Linear ({type(e).__name__}); the last request was not "
                              "confirmed.  Raise LINEAR_BOARD_TIMEOUT or LINEAR_BOARD_MAX_WAIT on a loaded host.")
                time.sleep(delay)
                delay = min(delay * 2, 30)
                continue
            errs = js.get("errors") or []
            if status == 429 or any(_is_ratelimit(e) for e in errs):
                reset = self._reset_at(hdrs)
                wait = max((reset - time.time()) if reset else 0, delay)
                if time.time() + wait > deadline:
                    when = central(reset) if reset else "within the hour"
                    die(f"Linear rate limit: the {self.auth.label}'s budget resets {when}."
                        + (self.partial() or "  This request was not applied; rerun it after the reset."),
                        EXIT_RATE_LIMIT)
                time.sleep(wait)
                delay = min(delay * 2, 30)
                continue
            if status == 401 or any(_is_auth_error(e) for e in errs):
                if reminted:
                    fields = {"credential": credential_preview(self.auth.token or ""),
                              "credential_field": credential_vars(self.auth.identity().where)}
                    if status >= 400:
                        fields["http"] = str(status)
                    die(f"Linear refused a freshly minted {self.auth.label} token; check the app in Linear's API settings",
                        EXIT_AUTH, **fields)
                token = self.auth.get(failed=token)
                reminted = True
                continue
            if status == 403:
                die(f"Linear answered 403: the {self.auth.label} may not do this (scope or team access)", EXIT_AUTH,
                    credential=credential_preview(self.auth.token or ""),
                    credential_field=credential_vars(self.auth.identity().where), http="403")
            if status >= 500:
                if time.time() + delay > deadline:
                    self.fail(f"Linear answered HTTP {status} until LINEAR_BOARD_MAX_WAIT ran out")
                time.sleep(delay)
                delay = min(delay * 2, 30)
                continue
            data = js.get("data")
            if errs or data is None:
                rid = hdrs.get("x-request-id") or hdrs.get("request-id") \
                    or hdrs.get("x-linear-request-id") or hdrs.get("cf-ray")
                raise GqlError(errs or [{"message": f"HTTP {status} with no data"}], data,
                               status=status, headers=hdrs, request_id=rid)
            return data
        self.fail("gave up after repeated retries against Linear")

    def paginate(self, query: str, variables: dict, path: tuple, page: int, limit: int | None = None):
        """Yield nodes of the connection at `path`, following endCursor."""
        after = None
        got = 0
        while True:
            data = self.call(query, dict(variables, first=page, after=after))
            conn = data
            for k in path:
                conn = (conn or {}).get(k)
            if not conn:
                return
            for n in conn.get("nodes") or []:
                yield n
                got += 1
                if limit is not None and got >= limit:
                    return
            info = conn.get("pageInfo") or {}
            if not info.get("hasNextPage") or not info.get("endCursor"):
                return
            after = info["endCursor"]


