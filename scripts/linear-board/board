# ----------------------------------------------------------------- workspace ids (non-secret cache)

def label_key(node: dict) -> str:
    parent = (node.get("parent") or {}).get("name")
    return f"{parent}/{node['name']}" if parent else node["name"]


def parse_linear_users(raw: list) -> dict:
    """Active workspace users by name from a BoardUsers listing.  Raises
    ValueError with a precise message on the first malformed record:  a
    non-object, an empty id or name, or a non-boolean active flag.  A
    deactivated user owns nothing and skips silently (the normal case, never
    read downstream), and two active users sharing one name collapse to
    nobody, so a claim can never assign the wrong one by pagination order."""
    users: dict = {}
    for u in raw:
        if not isinstance(u, dict):
            raise ValueError("Linear user response must contain user objects")  # noqa: TRY004
        uid, name, active = u.get("id"), u.get("name"), u.get("active")
        if active is False:
            continue
        if not isinstance(uid, str) or not uid.strip():
            raise ValueError("Linear user response has an invalid id")
        if not isinstance(name, str) or not name.strip():
            raise ValueError("Linear user response has an invalid name")
        if not isinstance(active, bool):
            raise ValueError("Linear user response has an invalid active flag")  # noqa: TRY004
        if name in users and users[name] != uid:
            users[name] = None
        else:
            users.setdefault(name, uid)
    return users


class Workspace:
    """Team, workflow-state and label ids, cached for a day in the
    non-secret cache dir so each verb spends its requests on the work."""

    TTL = 86400

    def __init__(self, L: Linear):
        self.L = L
        self.teams: dict = {}
        self.labels: dict = {}
        # Workspace-level labels with no team and no parent group, by lower-case name:  the only place a
        # flat label (needs-owner and the rest) is looked up.  A team-scoped label of the same name can
        # only be put on that team's issues, so it never counts.
        self.flat: dict = {}
        # Active workspace users by name, so a claim can mirror itself onto the
        # seat's own Linear user (the smart ownership pattern).  A seat with no
        # matching user is not an error:  the claim label is still the record.
        self.users: dict = {}
        self.fresh = False
        self._load()

    def _path(self) -> Path:
        return cache_dir() / "workspace.json"

    def _load(self, refresh: bool = False) -> None:
        d = None if refresh else read_json_file(self._path())
        # A cache written before flat labels existed has no "flat" key, and one
        # written before seat users existed has no "users" key:  either is stale,
        # read Linear once.
        if d and d.get("api") == self.L.url and time.time() - float(d.get("at") or 0) < self.TTL \
                and "flat" in d and "users" in d:
            self.teams, self.labels, self.flat = d.get("teams") or {}, d.get("labels") or {}, d.get("flat") or {}
            self.users = d.get("users") or {}
            return
        teams = {}
        for t in self.L.paginate(Q_TEAMS, {}, ("teams",), 50):
            teams[t["key"]] = {"id": t["id"], "name": t["name"],
                               "states": {s["name"]: s["id"] for s in (t.get("states") or {}).get("nodes") or []}}
        workspace_labels: dict = {}
        team_labels: dict = {}
        flat: dict = {}
        for lb in self.L.paginate(Q_LABELS, {}, ("issueLabels",), 250):
            (team_labels if lb.get("team") else workspace_labels).setdefault(label_key(lb), lb["id"])
            if not lb.get("team") and not lb.get("parent") and not lb.get("isGroup"):
                flat.setdefault(str(lb["name"]).lower(), lb["id"])
        labels = dict(team_labels, **workspace_labels)  # a workspace label wins over a team label
        users: dict = {}
        if env("LINEAR_BOARD_OWNER") == "1":
            # Ownership is the only consumer of the users map, so the listing is
            # gated on its flag:  with the flag off no board command can fail on
            # this optional query.
            users = self._fetch_users()
        self.teams, self.labels, self.flat, self.users, self.fresh = teams, labels, flat, users, True
        write_json_file(self._path(), {"api": self.L.url, "at": time.time(), "teams": teams, "labels": labels,
                                       "flat": flat, "users": users})

    def _fetch_users(self) -> dict:
        """The active workspace users by name.  When Linear refuses the
        listing, or lists a malformed record, ownership degrades to nothing
        (the claim label stays the record) instead of aborting the verb:
        one bad record must not abort every claim."""
        try:
            raw = list(self.L.paginate(Q_USERS, {}, ("users",), 250))
        except GqlError as e:
            warn(f"Linear would not list the workspace users; ownership stays off: "
                 f"{gql_summary(e)}")
            return {}
        try:
            return parse_linear_users(raw)
        except ValueError as e:
            warn(f"Linear listed user record(s) with an unexpected shape; ownership stays off: {e}")
            return {}

    def _refresh_users(self) -> None:
        """Re-read only the users listing after a user miss, so a seat with no
        Linear user (or a refused listing) does not repay teams and labels on
        every command.  A refused listing is retried per command:  one small
        query, and a transient refusal heals itself."""
        if env("LINEAR_BOARD_OWNER") == "1":
            self.users = self._fetch_users()
            d = read_json_file(self._path()) or {}
            if d.get("api") == self.L.url:
                d["users"] = self.users
                write_json_file(self._path(), d)

    def team(self, key: str) -> dict:
        if key not in self.teams and not self.fresh:
            self._load(refresh=True)
        if key not in self.teams:
            die(f"Linear has no team {key} visible to the {self.L.auth.label} (teams must be public)")
        return self.teams[key]

    def state_id(self, team_key: str, name: str) -> str:
        t = self.team(team_key)
        if name not in t["states"] and not self.fresh:
            self._load(refresh=True)
            t = self.team(team_key)
        if name not in t["states"]:
            die(f"team {team_key} has no workflow state {name!r}")
        return t["states"][name]

    def label_id(self, key: str, create: bool = False) -> str | None:
        if key not in self.labels and not self.fresh:
            self._load(refresh=True)
        if key in self.labels:
            return self.labels[key]
        if not create:
            return None
        group = key.split(":", 1)[0]
        lid = det_uuid("label", key)
        try:
            self.L.call(M_LABEL, {"input": {"id": lid, "name": key, "color": LABEL_COLORS.get(group, "#6b7280")}})
        except GqlError as e:
            self._load(refresh=True)
            if key in self.labels:
                return self.labels[key]
            die(f"could not create label {key!r}: {gql_summary(e)}")
        self.labels[key] = lid
        d = read_json_file(self._path()) or {}
        if d.get("api") == self.L.url:
            d.setdefault("labels", {})[key] = lid
            write_json_file(self._path(), d)
        return lid

    def flat_label_id(self, name: str) -> str:
        """The id of the flat workspace label `name` (one of FLAT_LABELS, already validated).  Looked up
        at workspace level;  when Linear has none, created once as a flat workspace label (no team, no
        parent group) under a fixed id and cached, so every later run, and a racing one, finds it."""
        if name not in self.flat and not self.fresh:
            self._load(refresh=True)
        if name in self.flat:
            return self.flat[name]
        lid = det_uuid("label", name)
        try:
            self.L.call(M_LABEL, {"input": {"id": lid, "name": name,
                                            "color": FLAT_LABEL_COLORS.get(name, "#6b7280")}})
        except GqlError as e:
            self._load(refresh=True)
            if name in self.flat:
                return self.flat[name]
            die(f"could not create label {name!r}: {gql_summary(e)}")
        self.flat[name] = lid
        self.labels.setdefault(name, lid)
        d = read_json_file(self._path()) or {}
        if d.get("api") == self.L.url:
            d.setdefault("flat", {})[name] = lid
            d.setdefault("labels", {}).setdefault(name, lid)
            write_json_file(self._path(), d)
        return lid

    def user_id(self, seat: str) -> str | None:
        """The Linear user id for `seat`, or None when the workspace has no
        active user by that name.  Ownership is an enhancement on top of the
        claim label, never its replacement:  a seat that has no user of its own
        keeps working exactly as before, so this returns None instead of dying."""
        found = self._match_user(seat)
        if found is not None or self.fresh:
            return found
        self._refresh_users()
        return self._match_user(seat)

    def _match_user(self, seat: str) -> str | None:
        """The cached user for `seat`:  an exact name first, else the
        case-insensitive match only when it names exactly one user.  An
        ambiguous seat (two users sharing a name, or two names differing only
        in case) owns nothing, so a claim can never assign the wrong user by
        pagination order."""
        if seat in self.users:
            return self.users[seat]
        lowered = seat.strip().lower()
        uids = set()
        for name, uid in self.users.items():
            if name.strip().lower() == lowered:
                if uid is None:
                    return None  # one of the matches is itself ambiguous
                uids.add(uid)
        return uids.pop() if len(uids) == 1 else None


# ----------------------------------------------------------------- ids

class IdIndex:
    """board-ids.txt: one imported board id per line, plus the Linear UUID
    after a tab when the import merged that row into another issue.  Seen ids
    (issues this host listed or showed) extend it, so a prefix printed by
    `list` resolves even for issues created after the import."""

    def __init__(self):
        self.targets: dict[str, str] = {}
        path = Path(env("LINEAR_BOARD_IDS") or (Path(__file__).resolve().parent / "board-ids.txt"))
        self._read(path)
        self._read(cache_dir() / "seen-ids.tsv")

    def _read(self, path: Path) -> None:
        try:
            text = path.read_text()
        except OSError:
            return
        for line in text.splitlines():
            parts = line.strip().split("\t")
            if not parts or not parts[0] or parts[0].startswith("#"):
                continue
            b = parts[0].replace("-", "").lower()
            if not re.fullmatch(r"[0-9a-f]{32}", b):
                continue
            lin = parts[1].replace("-", "").lower() if len(parts) > 1 and parts[1] else b
            if not re.fullmatch(r"[0-9a-f]{32}", lin):
                continue
            self.targets.setdefault(b, hyphenate(lin))
            self.targets.setdefault(lin, hyphenate(lin))

    def resolve(self, raw: str) -> str:
        """The key for issue(id:): a Linear UUID or an identifier."""
        s = (raw or "").strip()
        if IDENT_RE.match(s):
            return s.upper()
        h = s.lower().replace("-", "")
        if not HEX_RE.match(h or "x"):
            die(f"{raw!r} is not a board id, a hex prefix of one, or an identifier like AFC-123", EXIT_USAGE)
        if len(h) == 32:
            return self.targets.get(h) or hyphenate(h)
        if len(h) < 8:
            die(f"id prefix {raw!r} is too short; use 8 or more hex characters or the identifier", EXIT_USAGE)
        hits = sorted({v for k, v in self.targets.items() if k.startswith(h)})
        if len(hits) == 1:
            return hits[0]
        if len(hits) > 1:
            shown = ", ".join(x.replace("-", "") for x in hits[:5])
            die(f"id prefix {raw!r} is ambiguous ({len(hits)} issues: {shown}); give more characters", EXIT_USAGE)
        die(f"no imported board id starts with {raw!r}.  Issues created in Linear have no board id: use the "
            "identifier `board list` prints (AFC-123) or the full id.", EXIT_ERROR)


def remember(issues: list[dict]) -> None:
    """Record ids this host has shown, bounded to the newest 5,000."""
    if not issues:
        return
    path = cache_dir() / "seen-ids.tsv"
    try:
        with open(path, "a") as f:
            for n in issues:
                if n.get("id"):
                    f.write(f"{n['id']}\t{n['id']}\t{n.get('identifier') or ''}\n")
        lines = path.read_text().splitlines()
        if len(lines) > 6000:
            write_tail = "\n".join(lines[-5000:]) + "\n"
            tmp = path.with_suffix(f".{os.getpid()}.tmp")
            tmp.write_text(write_tail)
            os.replace(tmp, path)
    except OSError:
        pass


def fetch_issue(L: Linear, key: str, raw: str) -> dict:
    try:
        d = L.call(Q_ISSUE, {"id": key})
    except GqlError as e:
        if e.not_found():
            die(f"no issue {raw}", EXIT_ERROR)
        raise
    if not d.get("issue"):
        die(f"no issue {raw}", EXIT_ERROR)
    return d["issue"]


# ----------------------------------------------------------------- mapping issues to board rows

def labels_of(n: dict) -> list[str]:
    return [label_key(x) for x in ((n.get("labels") or {}).get("nodes") or [])]


def group_value(n: dict, group: str) -> str | None:
    for k in labels_of(n):
        if k.startswith(group + "/"):
            return k.split("/", 1)[1]
    return None


def seats_of(n: dict) -> list[str]:
    """Attribution only:  seats that reported or touched the issue.  Never a claim."""
    return [k[len(SEAT_PREFIX):] for k in labels_of(n) if k.startswith(SEAT_PREFIX)]


def claim_markers(n: dict) -> list[str]:
    """The seats holding a `claimed:<SEAT>` label, the only claim record `list`
    and `--mine` can see (they fetch no description or comments)."""
    return sorted(k[len(CLAIM_PREFIX):] for k in labels_of(n) if k.startswith(CLAIM_PREFIX))


def roster_seat(raw: str | None) -> str | None:
    """One raw attribution token from an imported footer -> roster tag or None
    (the importer's lm_common.normalize_seat, live claim)."""
    s = re.sub(r"\(.*?\)", "", str(raw or ""))
    s = s.strip().strip("@[]<>`'\" \t").split("·")[0].strip()
    if not s:
        return None
    s = re.split(r"\s+", s)[0].strip("@[]<>`'\"").upper()
    s = SEAT_ALIASES.get(s, s)
    if s in BF_ROLES:
        s = "BF-" + s
    if s in CLUTCH_LINEAGE:
        return "CLUTCH"
    return s if s in SEAT_ROSTER else None


def footer_claimants(description: str | None) -> list[str]:
    """Seats named on an "addressed by" line of an imported issue's provenance
    footer, normalized as the importer did.  Only the footer is read, never
    the body."""
    out: list[str] = []
    for m in FOOTER_ADDRESSED_RE.finditer(split_description(description)["footer"]):
        for part in re.split(r"[,/&+;]| and ", m.group(1)):
            seat = roster_seat(part)
            if seat and seat not in out:
                out.append(seat)
    return out


def holders_of(n: dict) -> list[str]:
    """Who holds the claim on `n`.  The claimed:<SEAT> labels when there are
    any (the CLI writes them, one holder at a time).  Otherwise, for an In
    Progress issue whose description is loaded, the imported footer's
    "addressed by" seats, which is how the board recorded claims.  seat:<SEAT>
    labels are never read as a claim."""
    marks = claim_markers(n)
    if marks:
        return marks
    if (n.get("state") or {}).get("name") == "In Progress":
        return footer_claimants(n.get("description"))
    return []


def severity_of(n: dict) -> str | None:
    """Linear priority is the source (the UI edits it); the Severity label
    only tells P3 from P4, which share priority Low."""
    p = n.get("priority") or 0
    if p == 4:
        return "P4" if group_value(n, "Severity") == "P4" else "P3"
    return {1: "P0", 2: "P1", 3: "P2"}.get(p)


def status_of(n: dict) -> str:
    name = (n.get("state") or {}).get("name") or ""
    return STATE_TO_STATUS.get(name) or name.lower().replace(" ", "_").replace("'", "")


def app_of(n: dict) -> str:
    for k in labels_of(n):
        if k.startswith("app:"):
            return k.split(":", 1)[1]
    return (n.get("team") or {}).get("key") or ""


def row_dict(n: dict) -> dict:
    seats = seats_of(n)
    return {
        "id": n.get("id"), "identifier": n.get("identifier"), "url": n.get("url"),
        "title": n.get("title"), "severity": severity_of(n), "status": status_of(n),
        "state": (n.get("state") or {}).get("name"), "app": app_of(n),
        "team": (n.get("team") or {}).get("key"), "source_kind": group_value(n, "Kind"),
        "env": group_value(n, "Env"), "addressed_by": ",".join(claim_markers(n)) or None,
        "seats": seats, "labels": labels_of(n), "priority": n.get("priority"),
        "created_at": n.get("createdAt"), "updated_at": n.get("updatedAt"),
    }


def fmt_row(r: dict) -> str:
    sev = r.get("severity") or "--"
    who = r.get("addressed_by") or ""
    where = r.get("env") or ""
    line = f"{short_id(r['id'])}  {sev:<3} {r.get('status', ''):<12} {r.get('app', '')}  {r.get('identifier') or ''}"
    tail = " ".join(x for x in (f"@{who}" if who else "", where) if x)
    title = (r.get("title") or "").replace("\n", " ")
    if len(title) > 88:
        title = title[:85] + "..."
    return f"{line.rstrip()}\n     {title}" + (f"\n     {tail}" if tail else "")


def md_unescape(s: str) -> str:
    out, pos = [], 0
    for m in CODE_SPAN_RE.finditer(s):
        out.append(MD_ESCAPE_RE.sub(r"\1", s[pos:m.start()]))
        out.append(m.group(0))
        pos = m.end()
    out.append(MD_ESCAPE_RE.sub(r"\1", s[pos:]))
    return "".join(out)


def split_description(desc: str | None) -> dict:
    body = md_unescape((desc or "").replace("\r\n", "\n"))
    out = {"description": "", "recommended_fix": "", "footer": "", "reported_by": None}
    i = body.rfind("\n---\n")
    if i >= 0:
        out["footer"] = HTML_COMMENT_RE.sub("\n", body[i + 5:]).strip()
        body = body[:i]
    m = re.search(r"(?m)^#{1,3} Recommended fix\s*$", body)
    if m:
        out["recommended_fix"] = body[m.end():].strip()
        body = body[:m.start()]
    body = body.strip()
    tm = TAG_RE.match(body)
    if tm:
        out["reported_by"] = tm.group(1)
        first, _, rest = body.partition("\n")
        body = rest.strip()
    if re.fullmatch(r"[_*]No description[^\n]*[_*]", body):
        body = ""
    out["description"] = body
    if not out["reported_by"]:
        rm = re.search(r"[Rr]eported by ([^,\n]+)", out["footer"])
        if rm:
            out["reported_by"] = rm.group(1).strip()
    return out


def parse_comment(c: dict) -> dict:
    body = md_unescape((c.get("body") or "").replace("\r\n", "\n"))
    author = ((c.get("user") or {}).get("name")) or "unknown"
    where = ""
    sessions = ""
    tm = TAG_RE.match(body)
    mm = MIGRATED_COMMENT_RE.match(body)
    if tm:
        author = tm.group(1)
        body = body[tm.end():]
        lines = body.rstrip().split("\n")
        while lines and (not lines[-1].strip() or re.match(r"^(Where|Sessions): ", lines[-1])):
            k, _, v = lines.pop().partition(": ")
            if not v:
                continue
            if k == "Where":
                where = v.strip()
            else:
                sessions = v.strip()
        body = "\n".join(lines).strip()
    elif mm:
        author = mm.group(1)
        where = mm.group(3) or ""
        body = body[mm.end():]
    body = HTML_COMMENT_RE.sub("\n", body).strip()
    # `author` is the name a reader shows and the seat a tag line claims;  anyone who can write a comment can type a
    # tag line, so a consumer that has to know WHO wrote it (the needs-owner notifier, for the owner's reply) reads
    # `author_id` and `author_app`, which are Linear's own account fields and never come from the text.
    user = c.get("user") or {}
    author_id = user.get("id") if isinstance(user.get("id"), str) and user.get("id") else None
    author_app = user.get("app") if isinstance(user.get("app"), bool) else None
    return {"id": c.get("id"), "author": author, "text": body, "where": where,
            "sessions": sessions, "created_at": c.get("createdAt"), "author_id": author_id, "author_app": author_app}


def resolution_of(comments: list[dict]) -> str:
    for c in reversed(comments):
        t = c["text"]
        m = re.match(r"^Resolution(?: \([^)]*\))?: ?(.*)$", t, re.S)
        if m:
            return m.group(1).strip()
        if c["author"].startswith("Resolution"):
            return t
    return ""


def location_of(comments: list[dict], footer: str) -> str:
    for c in reversed(comments):
        if c["text"].startswith("CLAIMED") and c["where"]:
            return c["where"]
    m = re.search(r"[Ll]ocation:? ([^\n]+)", footer or "")
    return m.group(1).strip() if m else ""


def all_comments(L: Linear, issue_id: str) -> list[dict]:
    nodes = list(L.paginate(Q_COMMENTS, {"id": issue_id}, ("issue", "comments"), 100))
    nodes.sort(key=lambda c: c.get("createdAt") or "")
    return [parse_comment(c) for c in nodes]


# ----------------------------------------------------------------- routing and filters

def route_app(app: str | None) -> tuple[str, str | None]:
    """(team key, fallback slug).  Team keys and board slugs both work."""
    a = (app or DEFAULT_APP).strip()
    # C is the Clutch app acronym and live Linear team key (owner 2026-10-23, AFC-333).
    # CLUTCH and CK are legacy aliases.  All spellings route to the same team.
    if a.upper() in {"CLUTCH", "CK", "C"}:
        return "C", None
    if a.upper() in TEAM_KEYS:
        return a.upper(), None
    t = BOARD_SLUG_TEAM.get(a.lower()) or BOARD_SLUG_TEAM.get(slugify(a))
    if t:
        return t, None
    return FALLBACK_TEAM, slugify(a) or "unknown"


def and_filter(parts: list[dict]) -> dict:
    parts = [p for p in parts if p]
    if not parts:
        return {}
    return parts[0] if len(parts) == 1 else {"and": parts}


def label_cond(name: str, group: str | None = None, names: list[str] | None = None) -> dict:
    cond: dict = {"name": {"in": names}} if names else {"name": {"eq": name}}
    if group:
        cond["parent"] = {"name": {"eq": group}}
    return {"labels": {"some": cond}}


def split_csv(v: str | None) -> list[str]:
    return [x.strip() for x in (v or "").split(",") if x.strip()]


def list_filter(a) -> tuple[list[dict], list[str] | None]:
    parts: list[dict] = []
    if a.app:
        team, fslug = route_app(a.app)
        parts.append({"team": {"key": {"eq": team}}})
        if fslug:
            parts.append(label_cond(f"app:{fslug}"))
    if getattr(a, "team", None):
        key = a.team.strip().upper()
        if not re.fullmatch(r"[A-Z][A-Z0-9]{0,19}", key):
            die(f"--team {a.team!r} is not a team key", EXIT_USAGE)
        parts.append({"team": {"key": {"eq": key}}})
    if getattr(a, "env", None):
        parts.append(label_cond(ENVS[a.env.lower()], "Env"))
    if a.status:
        states: list[str] = []
        for s in split_csv(a.status.lower()):
            if s not in LIST_STATUS_STATES:
                die(f"unknown status {s!r}; use {', '.join(STATUS_WORDS)}", EXIT_USAGE)
            states += [x for x in LIST_STATUS_STATES[s] if x not in states]
        parts.append({"state": {"name": {"in": states}}})
    sevs = None
    if a.severity:
        sevs = [s.upper() for s in split_csv(a.severity)]
        bad = [s for s in sevs if s not in SEVERITIES]
        if bad:
            die(f"unknown severity {', '.join(bad)}; use P0 to P4", EXIT_USAGE)
    if a.source_kind:
        kinds = split_csv(a.source_kind)
        parts.append(label_cond("", "Kind", kinds))
    if a.search:
        parts.append({"title": {"containsIgnoreCase": a.search}})
    if a.mine:
        canonical = norm_seat(a.mine)
        labels = [f"{CLAIM_PREFIX}{canonical}"]
        # Legacy spellings (claimed:INSTINCT) resolve to the canonical tag.
        labels += sorted(f"{CLAIM_PREFIX}{a}" for a, t in SEAT_TAG_ALIASES.items()
                         if t == canonical and a != canonical)
        parts.append(label_cond(labels[0]) if len(labels) == 1 else label_cond("", names=labels))
    for name in a.labels or []:
        parts.append(label_cond(name))    # every --label must be on the issue
    return parts, sevs


# ----------------------------------------------------------------- verbs

def cmd_list(L: Linear, a) -> int:
    try:
        limit = max(1, min(int(a.limit), 2000))
    except ValueError:
        die("--limit must be a number", EXIT_USAGE)
    parts, sevs = list_filter(a)
    prios = [p for p in PRIORITY_ORDER if not sevs or p in {SEV_PRIORITY[s] for s in sevs}]
    rows: list[dict] = []
    more = False
    for p in prios:
        filt = and_filter(parts + [{"priority": {"eq": p}}])
        need = limit - len(rows) + 1
        for n in L.paginate(Q_LIST, {"filter": filt}, ("issues",), min(50, max(need, 10))):
            if sevs and severity_of(n) not in sevs:
                continue
            if len(rows) >= limit:
                more = True
                break
            rows.append(n)
        if more:
            break
    sev_rank = {s: i for i, s in enumerate(SEVERITIES)}
    rows.sort(key=lambda n: n.get("createdAt") or "", reverse=True)
    rows.sort(key=lambda n: sev_rank.get(severity_of(n) or "", 5))
    remember(rows)
    out = [row_dict(n) for n in rows]
    if a.json:
        print(json.dumps(out, indent=2))
        return 0
    total = str(len(out))
    if more:
        total = count_matching(L, parts, prios, sevs)
    print(f"{len(out)} shown of {total} matching\n")
    for r in out:
        print(fmt_row(r))
        print()
    unmarked = sum(1 for r in out if r["state"] == "In Progress" and not r["addressed_by"] and r["seats"])
    if unmarked:
        warn(f"{unmarked} In Progress row(s) above have no claim marker, so no claimant is shown.  Imported "
             "claims get a claimed:<SEAT> label in the cutover relabel (README); `board show <id>` reads the "
             "claimant from the import footer meanwhile.")
    return 0


def count_matching(L: Linear, parts: list[dict], prios: list[int], sevs: list[str] | None) -> str:
    """Bounded count (the shared app has one request budget for the fleet):
    exact up to LINEAR_BOARD_COUNT_CAP, then 'N+'."""
    cap = int(env_float("LINEAR_BOARD_COUNT_CAP", 1000))
    filt = and_filter(parts + ([{"priority": {"in": prios}}] if sevs else []))
    exact_by_priority = not sevs or ("P3" in sevs) == ("P4" in sevs)
    n = 0
    if exact_by_priority:
        it = L.paginate(Q_COUNT, {"filter": filt}, ("issues",), 250)
    else:
        it = (x for x in L.paginate(Q_LIST, {"filter": filt}, ("issues",), 50) if severity_of(x) in sevs)
    for _ in it:
        n += 1
        if n >= cap:
            return f"{cap}+"
    return str(n)


def cmd_show(L: Linear, ids: IdIndex, a) -> int:
    n = fetch_issue(L, ids.resolve(a.id), a.id)
    remember([n])
    comments = all_comments(L, n["id"])
    parts = split_description(n.get("description"))
    r = row_dict(n)
    r["addressed_by"] = ",".join(holders_of(n)) or None
    r.update({
        "description": parts["description"], "recommended_fix": parts["recommended_fix"],
        "resolution": resolution_of(comments), "reported_by": parts["reported_by"],
        "location": location_of(comments, parts["footer"]), "provenance": parts["footer"],
        "attachments": [x.get("url") for x in (n.get("attachments") or {}).get("nodes") or []],
        "relations": ([{"type": x["type"], "issue": (x.get("relatedIssue") or {}).get("identifier"),
                        "direction": "outgoing"} for x in (n.get("relations") or {}).get("nodes") or []]
                      + [{"type": x["type"], "issue": (x.get("issue") or {}).get("identifier"),
                          "direction": "incoming"} for x in (n.get("inverseRelations") or {}).get("nodes") or []]),
        "comments": comments,
    })
    limit = getattr(a, "comment_limit", None)
    if limit is not None and len(comments) > limit:
        # Resolution and location above still read every comment;  only the list shown is capped (oldest first,
        # like the hosted linear_show's comments(first: N)).
        r["comments"] = comments[:limit]
        r["comments_total"] = len(comments)
    if a.json:
        print(json.dumps(r, indent=2))
        return 0
    print(f"{r['severity'] or '--'}  {r['status']}  {r['app']}  ({r['source_kind']})")
    print(r["title"])
    print()
    for label, key in (("Description", "description"), ("Fix", "recommended_fix"), ("Resolution", "resolution")):
        if r.get(key):
            print(f"--- {label} ---")
            print(r[key])
            print()
    print("--- meta ---")
    meta = [("identifier", r["identifier"]), ("url", r["url"]), ("team", r["team"]), ("state", r["state"]),
            ("reported_by", r["reported_by"]), ("addressed_by", r["addressed_by"]), ("env", r["env"]),
            ("location", r["location"]), ("source_url", ", ".join(r["attachments"])),
            ("created_at", central(r["created_at"]) if r["created_at"] else ""),
            ("updated_at", central(r["updated_at"]) if r["updated_at"] else ""),
            ("labels", ", ".join(r["labels"]))]
    for k, v in meta:
        if v:
            print(f"  {k}: {v}")
    for rel in r["relations"]:
        if rel["type"] == "duplicate":
            words = "duplicate of" if rel["direction"] == "outgoing" else "duplicated by"
        else:
            words = f"{rel['type']} ({rel['direction']})"
        print(f"  {words}: {rel['issue']}")
    if r["provenance"]:
        print("  provenance:")
        for line in r["provenance"].splitlines():
            if line.strip():
                print(f"    {line.rstrip()}")
    shown = r["comments"]  # the capped list when --comment-limit applied, so the text agrees with the JSON
    if shown:
        print("\n--- comments ---")
        if len(shown) < len(comments):
            print(f"  (showing {len(shown)} of {len(comments)} comments)")
        for c in shown:
            where = f" ({c['where']})" if c["where"] else ""
            stamp = central(c["created_at"], with_day=False) if c["created_at"] else ""
            print(f"  [{stamp}] {c['author']}{where}: {c['text']}")
    return 0


def norm_env(v: str | None) -> str | None:
    if not v:
        return None
    e = ENVS.get(v.strip().lower())
    if not e:
        die(f"--env must be Mac or cloud, not {v!r}", EXIT_USAGE)
    return e


def uid_url(app_key: str, uid: str) -> str:
    if re.match(r"^https?://", uid):
        return uid
    return f"https://board.jays.services/uid/{urllib.parse.quote(app_key, safe='')}/{urllib.parse.quote(uid, safe='')}"


def find_existing(L: Linear, iid: str, team: str, uid: str, url: str) -> dict | None:
    """The issue a repeat `file --uid` must return: its derived id, an
    attachment with the uid URL, or an imported footer naming the uid."""
    try:
        d = L.call(Q_ISSUE, {"id": iid})
        if d.get("issue"):
            return d["issue"]
    except GqlError as e:
        if not e.not_found():
            raise
    for node in L.paginate(Q_UID_ATTACHMENT, {"url": url}, ("attachmentsForURL",), 25):
        iss = node.get("issue") or {}
        if (iss.get("team") or {}).get("key") == team:
            return fetch_issue(L, iss["id"], iss.get("identifier") or iss["id"])
    filt = {"and": [{"team": {"key": {"eq": team}}},
                    {"description": {"contains": f"External uid: `{uid}`"}}]}
    for n in L.paginate(Q_LIST, {"filter": filt}, ("issues",), 5, limit=1):
        return n
    return None


def cmd_file(L: Linear, a, seat: str) -> int:
    by = check_by(a.reported_by, seat)
    sessions = auto_sessions(a.session_ids, seat, required=True)
    team, fslug = route_app(a.app)
    app_display = fslug or team
    sev = (a.severity or "").upper() or None
    if sev and sev not in SEVERITIES:
        die("--severity must be P0 to P4", EXIT_USAGE)
    kind = a.source_kind or "agent-report"
    if kind not in KINDS:
        hint = "  fleet-report is a label, not a kind:  use --label fleet-report." if kind == "fleet-report" else ""
        die(f"--kind must be one of {', '.join(KINDS)}.{hint}", EXIT_USAGE)
    env_label = norm_env(a.env)
    title = a.title.strip()
    if not title:
        die("--title is empty", EXIT_USAGE)
    ws = Workspace(L)
    key_app = f"{team}:{fslug or ''}"
    iid = det_uuid("issue", f"{key_app}:{a.external_uid}") if a.external_uid else str(uuid.uuid4())
    url_for_uid = uid_url(app_display, a.external_uid) if a.external_uid else None
    if a.external_uid:
        found = find_existing(L, iid, team, a.external_uid, url_for_uid)
        if found:
            remember([found])
            r = row_dict(found)
            print(f"filed {found['id']}  ({r['severity'] or '--'} {r['app']})  {found.get('identifier') or ''}"
                  f"  (already filed; unchanged)")
            return 0
    lines = [f"{seat_tag(by, sessions)} Filed with the board CLI.", ""]
    full_title = title
    if len(title) > 250:
        title = title[:247] + "..."
        lines += [f"**{full_title}**", ""]
    lines.append((a.desc or "").strip() or "_No description given._")
    if (a.fix or "").strip():
        lines += ["", "## Recommended fix", "", a.fix.strip()]
    foot = ["", "---", "", "**Filed with the board CLI**", "", f"- Reported by {by}",
            f"- App: `{(a.app or DEFAULT_APP).strip()}` (team {team})", f"- Kind: {kind}"]
    if sessions:
        foot.append(f"- Sessions: {', '.join(sessions)}")
    if env_label or a.location:
        foot.append("- " + ", ".join(x for x in (f"Env {env_label}" if env_label else "",
                                                  f"location {a.location}" if a.location else "") if x))
    if a.external_uid:
        foot.append(f"- External uid: `{a.external_uid}`")
    if a.source_url:
        foot.append(f"- Source URL: {a.source_url}")
    foot += ["", f"<!-- board-cli: app={app_display} kind={kind} -->"]
    label_ids = [ws.label_id(f"Kind/{kind}")]
    if sev:
        label_ids.append(ws.label_id(f"Severity/{sev}"))
    if env_label:
        label_ids.append(ws.label_id(f"Env/{env_label}"))
    if fslug:
        label_ids.append(ws.label_id(f"app:{fslug}", create=True))
    # Flat labels are resolved here, after the repeat-uid return above, so a repeat creates nothing.
    label_ids += [ws.flat_label_id(name) for name in a.labels or []]
    inp = {
        "id": iid, "teamId": ws.team(team)["id"], "title": title,
        "description": "\n".join(lines + foot), "stateId": ws.state_id(team, "Todo"),
        "labelIds": [x for x in label_ids if x],
    }
    if sev:
        inp["priority"] = SEV_PRIORITY[sev]
    try:
        d = L.call(M_CREATE, {"input": inp})
        issue = (d.get("issueCreate") or {}).get("issue")
    except GqlError as e:
        issue = None
        try:
            issue = L.call(Q_ISSUE, {"id": iid}).get("issue")
        except GqlError:
            pass
        if not issue:
            die(f"Linear refused the new issue: {gql_summary(e)}")
    if not issue:
        issue = fetch_issue(L, iid, iid)
    remember([issue])
    # Say what was filed before the attachments, so a rate limit that stops the
    # attach step cannot leave the caller without the id (and refiling it).
    print(f"filed {issue['id']}  ({sev or '--'} {app_display}){session_tail(sessions)}  {issue.get('identifier') or ''}",
          flush=True)
    L.landed.append(f"filed {issue.get('identifier') or issue['id']} ({issue['id']})")
    L.rerun = "The issue exists; do not file it again.  Only its attachments are missing."
    for url, label in ((url_for_uid, f"board uid {a.external_uid}"), (a.source_url, "Source")):
        if not url:
            continue
        try:
            L.call(M_ATTACH, {"input": {"issueId": issue["id"], "url": url, "title": label}})
        except GqlError as e:
            warn(f"filed, but attaching {url} failed ({gql_summary(e)}); the footer still carries it")
    return 0


def comment_id(issue_id: str, seat: str, verb: str, body: str, sessions: list[str] | None) -> str:
    """Fixed id for a comment, from the issue, seat, verb, text and session (the
    Central day when there is none), so rerunning a verb that stopped part way
    cannot post it twice, while the same words next week still post."""
    when = ",".join(sessions) if sessions else dt.datetime.now(CENTRAL or dt.timezone.utc).strftime("%Y-%m-%d")
    digest = hashlib.sha256(body.encode("utf-8")).hexdigest()
    return det_uuid("comment", f"{issue_id}:{seat}:{verb}:{digest}:{when}")


def post_comment(L: Linear, n: dict, body: str, seat: str, verb: str, sessions: list[str] | None) -> bool:
    """Post `body` on issue `n` under a fixed id.  True when posted, False when
    this exact comment is already there (an earlier run of the same command)."""
    cid = comment_id(n["id"], seat, verb, body, sessions)
    try:
        L.call(M_COMMENT, {"input": {"id": cid, "issueId": n["id"], "body": body}})
    except GqlError as e:
        try:
            if L.call(Q_COMMENT_ONE, {"id": cid}).get("comment"):
                warn(f"the same {verb} comment from {seat} is already on {n['identifier']} (an earlier run "
                     "of this command); not posting it again")
                return False
        except GqlError:
            pass
        L.fail(f"Linear refused the comment: {gql_summary(e)}")
    return True


def comment_body(seat: str, sessions: list[str] | None, text: str, where: str | None = None,
                 env_label: str | None = None) -> str:
    body = f"{seat_tag(seat, sessions)} {text.strip()}"
    loc = ", ".join(x for x in (env_label, where) if x)
    extra = []
    if loc:
        extra.append(f"Where: {loc}")
    if sessions:
        extra.append(f"Sessions: {', '.join(sessions)}")
    return body + "".join("\n\n" + x for x in extra)


def _update_with_best_effort_owner(L: Linear, issue_id: str, inp: dict, *, retry_noun: str,
                                   owner: str | None = None) -> bool:
    """One issueUpdate where assigneeId is optional.  Ownership is an enhancement on the
    labels and the state change, never their replacement:  a refused assignee write must not
    lose the mandatory part.  On GqlError with assigneeId in the input, drop it, retry once
    without the owner field at all, and warn with allow-listed fields.  True when the owner
    was dropped and the write landed;  a GqlError means the mandatory write itself failed."""
    try:
        L.call(M_UPDATE, {"id": issue_id, "input": inp})
        return False
    except GqlError as e:
        if "assigneeId" not in inp:
            raise
        if owner:
            warn(f"Linear refused the assignee {owner}; retrying {retry_noun} without an owner: "
                 f"{gql_summary(e)}")
        else:
            warn(f"Linear refused the assignee clear; retrying {retry_noun} without it: "
                 f"{gql_summary(e)}")
        del inp["assigneeId"]
        if not inp:
            return True
        L.call(M_UPDATE, {"id": issue_id, "input": inp})
        return True


def cmd_claim(L: Linear, ids: IdIndex, a, seat: str) -> int:
    by = check_by(a.addressed_by, seat)
    sessions = auto_sessions(a.session_ids, seat, required=True)
    if a.steal and not (a.reason or "").strip():
        die("--steal needs --reason \"why you are taking it\"", EXIT_USAGE)
    env_label = norm_env(a.env)
    n = fetch_issue(L, ids.resolve(a.id), a.id)
    team = n["team"]["key"]
    # Who holds it: claimed:<SEAT> labels, else (In Progress) the import footer.
    # seat:<SEAT> labels are attribution (reporters carry them too), never a claim.
    holders = [s for s in holders_of(n) if norm_seat(s) != by]  # claimed:INSTINCT is WISE's own claim
    in_progress = (n.get("state") or {}).get("name") == "In Progress"
    stolen = []
    if in_progress and holders:
        if not a.steal:
            die(f"{short_id(n['id'])} ({n['identifier']}) is In Progress, claimed by {', '.join(holders)}.  "
                "Ask that seat, or take it with --steal --reason \"...\".", EXIT_CLAIM_HELD)
        stolen = holders
    ws = Workspace(L)
    current = {label_key(x): x["id"] for x in (n.get("labels") or {}).get("nodes") or []}
    # One holder: add this seat's marker, drop every other seat's.  Attribution
    # (seat:) labels are only ever added, so a claim or a steal never erases
    # who reported or worked the issue.
    added = [ws.label_id(f"{CLAIM_PREFIX}{by}", create=True), ws.label_id(f"{SEAT_PREFIX}{by}", create=True)]
    removed = [lid for k, lid in current.items() if k.startswith(CLAIM_PREFIX) and k != f"{CLAIM_PREFIX}{by}"]
    if "stale-claim" in current:
        removed.append(current["stale-claim"])
    if env_label:
        added.append(ws.label_id(f"Env/{env_label}"))
        removed += [lid for k, lid in current.items() if k.startswith("Env/") and k != f"Env/{env_label}"]
    inp = {"stateId": ws.state_id(team, "In Progress"),
           "addedLabelIds": [x for x in added if x and x not in current.values()],
           "removedLabelIds": removed}
    # Smart ownership:  mirror the claim onto the seat's own Linear user, so the
    # board's assignee column agrees with the claim label.  Same write, and only
    # when the workspace really has that seat.  Off by default:  the design keeps
    # the seat in the label and the tag line, and Linear identity fields wait on
    # pilot gates 2 and 4 (README, "Not built yet"), so LINEAR_BOARD_OWNER=1 opts in.
    owner = ws.user_id(by) if env("LINEAR_BOARD_OWNER") == "1" else None
    if owner:
        inp["assigneeId"] = owner
    elif stolen and env("LINEAR_BOARD_OWNER") == "1":
        # A steal by a seat with no Linear user still moves the claim, so the
        # old owner's assignee goes with it instead of lingering stale.
        inp["assigneeId"] = None
    try:
        refused_owner = _update_with_best_effort_owner(
            L, n["id"], inp, retry_noun="the claim", owner=owner)
        if refused_owner:
            owner = None
    except GqlError as e:
        L.fail(f"Linear refused the claim: {gql_summary(e)}")
    landed = f"{n['identifier']} is In Progress with {by}'s claim label"
    owner_note = ""
    if env("LINEAR_BOARD_OWNER") == "1":
        if owner:
            landed += f" and assignee {by}"
            owner_note = f"assignee {by}"
        elif refused_owner:
            landed += " (Linear refused the assignee; the label holds the claim)"
            owner_note = "Linear refused the assignee; the label holds the claim"
        else:
            landed += " (no Linear user for the seat)"
            owner_note = "no Linear user for the seat"
    L.landed.append(landed)
    text = "CLAIMED"
    if stolen:
        text += f" from {', '.join(stolen)}: {a.reason.strip()}"
    if (getattr(a, "comment", None) or "").strip():
        text += f"\n\n{a.comment.strip()}"
    post_comment(L, n, comment_body(by, sessions, text, a.location, env_label), by, "claim", sessions)
    remember([n])
    print(f"claimed {short_id(n['id'])} by {by} -> in_progress{session_tail(sessions)}  {n['identifier']}"
          + (f"  ({owner_note})" if owner_note else ""))
    return 0


_REF = (r"([A-Za-z]{2,4}-\d+|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|[0-9a-f]{32})")
DUP_PHRASE_RE = re.compile(r"(?i)\bdup(?:e|licate)?\b(?:\s+(?:of|with))?\s*[:#]?\s*`?" + _REF + r"`?(?![\w-])")
LONE_REF_RE = re.compile(r"(?i)^\s*`?" + _REF + r"`?\s*$")
TEAM_IDENT_RE = re.compile(r"(?i)^([A-Za-z]{2,4})-\d+$")


def _canon_ref(tok: str) -> str | None:
    m = TEAM_IDENT_RE.match(tok)
    if m:
        return tok.upper() if m.group(1).upper() in TEAM_KEYS else None
    return tok.lower()


def duplicate_target(resolution: str | None) -> str | None:
    """The canonical issue a `status duplicate` names in --resolution, when it
    names exactly one.  Only after a "dup of" / "duplicate of" phrase, or when
    the whole text is one id: a stray 8-hex word (a commit sha) is never taken."""
    text = (resolution or "").strip()
    if not text:
        return None
    toks = [m.group(1) for m in DUP_PHRASE_RE.finditer(text)]
    lone = LONE_REF_RE.match(text)
    if lone:
        toks.append(lone.group(1))
    found = {c for c in (_canon_ref(t) for t in toks) if c}
    return next(iter(found)) if len(found) == 1 else None


def closing_label_ids(n: dict) -> list[str]:
    """Ids of the labels on `n` that closing it removes (needs-owner, ask-capture), none for the rest."""
    return [x["id"] for x in (n.get("labels") or {}).get("nodes") or [] if label_key(x) in CLOSING_REMOVES]


def cmd_status(L: Linear, ids: IdIndex, a, seat: str) -> int:
    by = check_by(a.addressed_by, seat)
    sessions = auto_sessions(a.session_ids, seat, required=True)
    value = a.value.strip().lower()
    if value not in STATUS_WORDS:
        die(f"unknown status {a.value!r}; use {', '.join(STATUS_WORDS)}", EXIT_USAGE)
    if a.of and value != "duplicate":
        die("--of only goes with status duplicate", EXIT_USAGE)
    of = a.of
    if value == "duplicate" and not of:
        of = duplicate_target(a.resolution)
        if not of:
            die("status duplicate needs --of <id of the issue it duplicates>: Linear only makes a Duplicate "
                "through a relation to a canonical issue (the mac-collab board took a bare `duplicate`).  Name "
                "it with --of, or write `dup of <id>` as the --resolution.  If the original is unknown, use "
                "`status wontfix --resolution \"duplicate, original unknown\"`.", EXIT_USAGE)
        warn(f"taking --of {of} from the --resolution text")
    n = fetch_issue(L, ids.resolve(a.id), a.id)
    if value == "duplicate":
        canon = fetch_issue(L, ids.resolve(of), of)
        if canon["id"] == n["id"]:
            die("an issue cannot duplicate itself", EXIT_USAGE)
        # Linear refuses a direct move to Duplicate; the relation moves it.
        rid = det_uuid("relation", f"duplicate:{n['id']}:{canon['id']}")
        try:
            L.call(M_RELATE, {"input": {"id": rid, "type": "duplicate", "issueId": n["id"],
                                        "relatedIssueId": canon["id"]}})
        except GqlError as e:
            back = fetch_issue(L, n["id"], a.id)
            if not any(x.get("type") == "duplicate" and (x.get("relatedIssue") or {}).get("id") == canon["id"]
                       for x in (back.get("relations") or {}).get("nodes") or []):
                die(f"Linear refused the duplicate relation: {gql_summary(e)}")
        L.landed.append(f"{n['identifier']} marked a duplicate of {canon['identifier']}")
        state = (fetch_issue(L, n["id"], a.id).get("state") or {}).get("name")
        if state != "Duplicate":
            time.sleep(env_float("LINEAR_BOARD_DUP_WAIT", 3))
            state = (fetch_issue(L, n["id"], a.id).get("state") or {}).get("name")
        drop = closing_label_ids(n)
        # The relation path skips the CLOSING_STATUSES branch below, so "clear
        # on Done" is repeated here, with the same claimed-only guard:  a
        # duplicate of an unclaimed issue keeps its human assignee.
        dup_inp = {"removedLabelIds": drop} if drop else {}
        dup_claimed = any(label_key(x).startswith(CLAIM_PREFIX)
                          for x in (n.get("labels") or {}).get("nodes") or [])
        if dup_claimed and env("LINEAR_BOARD_OWNER") == "1":
            dup_inp["assigneeId"] = None
        if dup_inp:
            try:
                refused_clear = _update_with_best_effort_owner(
                    L, n["id"], dup_inp, retry_noun="the duplicate cleanup")
            except GqlError as e:
                L.fail(f"Linear refused the duplicate cleanup update: {gql_summary(e)}")
            if drop:
                L.landed.append(f"{n['identifier']} lost needs-owner and ask-capture")
            if dup_claimed and env("LINEAR_BOARD_OWNER") == "1" and not refused_clear:
                L.landed.append(f"{n['identifier']} cleared its assignee")
        text = f"Duplicate of {canon['identifier']}"
        if a.resolution:
            text = f"Resolution (duplicate of {canon['identifier']}): {a.resolution.strip()}"
        post_comment(L, n, comment_body(by, sessions, text), by, "status", sessions)
        if state != "Duplicate":
            warn(f"the duplicate relation to {canon['identifier']} exists, but Linear left "
                 f"{n['identifier']} in {state}.  It was not forced: Linear refuses a direct move to Duplicate.")
            print(f"{short_id(n['id'])} -> {STATE_TO_STATUS.get(state, state)}{session_tail(sessions)}  "
                  f"{n['identifier']}")
            return 0
        print(f"{short_id(n['id'])} -> duplicate{session_tail(sessions)}  {n['identifier']}")
        return 0
    ws = Workspace(L)
    state_name = STATUS_TO_STATE[value]
    inp = {"stateId": ws.state_id(n["team"]["key"], state_name)}
    if value in ("open", "backlog"):
        # Todo means unclaimed (design section 3): releasing drops the claim
        # marker so a later move back to In Progress cannot inherit it.
        released = [x["id"] for x in (n.get("labels") or {}).get("nodes") or []
                    if label_key(x).startswith(CLAIM_PREFIX)]
        if released:
            inp["removedLabelIds"] = released
        # Releasing a claim releases the owner with it, whenever ownership is
        # mirrored at all (LINEAR_BOARD_OWNER=1;  see `claim`).  Only when a
        # claim marker was actually released:  an unclaimed issue keeps its
        # human assignee.
        if released and env("LINEAR_BOARD_OWNER") == "1":
            inp["assigneeId"] = None
    elif value in CLOSING_STATUSES:
        # Closed:  the question was answered or the ask handled, so it stops waiting on the owner.
        drop = closing_label_ids(n)
        if drop:
            inp["removedLabelIds"] = drop
        # "Clear on Done":  a closed claim owns nothing.  Only when the issue
        # carries a claim marker, like the release path:  closing an unclaimed
        # issue keeps its human assignee.
        claimed = any(label_key(x).startswith(CLAIM_PREFIX)
                      for x in (n.get("labels") or {}).get("nodes") or [])
        if claimed and env("LINEAR_BOARD_OWNER") == "1":
            inp["assigneeId"] = None
    try:
        _update_with_best_effort_owner(L, n["id"], inp, retry_noun="the status change")
    except GqlError as e:
        L.fail(f"Linear refused the status change: {gql_summary(e)}")
    L.landed.append(f"{n['identifier']} moved to {state_name}")
    if a.resolution:
        text = f"Resolution ({value}): {a.resolution.strip()}"
    else:
        text = f"Status: {value}"
    post_comment(L, n, comment_body(by, sessions, text), by, "status", sessions)
    print(f"{short_id(n['id'])} -> {value}{session_tail(sessions)}  {n['identifier']}")
    return 0


def cmd_comment(L: Linear, ids: IdIndex, a, seat: str) -> int:
    by = check_by(a.author, seat)
    sessions = auto_sessions(a.session_ids, seat, required=True)
    if not a.text.strip():
        die("--text is empty", EXIT_USAGE)
    env_label = norm_env(a.env)
    n = fetch_issue(L, ids.resolve(a.id), a.id)
    post_comment(L, n, comment_body(by, sessions, a.text, a.location, env_label), by, "comment", sessions)
    print(f"commented on {short_id(n['id'])} as {by}{session_tail(sessions)}  {n['identifier']}")
    return 0


def cmd_label(L: Linear, ids: IdIndex, a, seat: str) -> int:
    """`label add|remove <id> NAME`:  one flat workspace label (FLAT_LABELS) on or off an issue, with
    addedLabelIds or removedLabelIds only (labelIds would replace every label).  `add` finds or creates
    the label;  `remove` never creates one, and removing what is not there changes nothing."""
    check_by(a.addressed_by, seat)
    name = a.label_name
    n = fetch_issue(L, ids.resolve(a.id), a.id)
    have = [x["id"] for x in (n.get("labels") or {}).get("nodes") or [] if label_key(x) == name]
    short = short_id(n["id"])
    if a.action == "add":
        if have:
            print(f"{short} already has {name}  (unchanged)  {n['identifier']}")
            return 0
        inp = {"addedLabelIds": [Workspace(L).flat_label_id(name)]}
    else:
        if not have:
            print(f"{short} does not have {name}  (unchanged)  {n['identifier']}")
            return 0
        inp = {"removedLabelIds": have}
    try:
        L.call(M_UPDATE, {"id": n["id"], "input": inp})
    except GqlError as e:
        die(f"Linear refused the label change: {gql_summary(e)}")
    remember([n])
    if a.action == "add":
        print(f"labeled {short} +{name}  {n['identifier']}")
    else:
        print(f"unlabeled {short} -{name}  {n['identifier']}")
    return 0


def cmd_stats(L: Linear) -> int:
    """Live counts, cached for LINEAR_BOARD_STATS_TTL seconds (default 600).
    The design's counts snapshot (section 5) replaces this when it exists."""
    path = cache_dir() / "stats.json"
    ttl = env_float("LINEAR_BOARD_STATS_TTL", 600)
    c = read_json_file(path)
    if not (c and c.get("api") == L.url and time.time() - float(c.get("at") or 0) < ttl):
        teams = list(L.paginate(Q_TEAMS, {}, ("teams",), 50))
        total = sum(int(t.get("issueCount") or 0) for t in teams)
        apps = sorted(t["key"] for t in teams if int(t.get("issueCount") or 0) > 0)
        open_f = {"state": {"name": {"in": list(OPEN_STATES)}}}

        def count(f: dict) -> int:
            return sum(1 for _ in L.paginate(Q_COUNT, {"filter": f}, ("issues",), 250))

        st = {
            "total": total,
            "open": count(open_f),
            "p0p1_open": count({"and": [open_f, {"priority": {"in": [1, 2]}}]}),
            "done": count({"state": {"name": {"in": list(DONE_STATES)}}}),
            "by_kind": {k: count({"and": [open_f, label_cond(k, "Kind")]}) for k in KINDS},
            "apps": apps,
        }
        c = {"api": L.url, "at": time.time(), "stats": st}
        write_json_file(path, c)
    d = c["stats"]
    print(f"total {d['total']}   open {d['open']}   P0/P1 open {d['p0p1_open']}   done {d['done']}")
    print("  open items by kind:")
    for k, v in sorted(d.get("by_kind", {}).items()):
        print(f"  {k:<16} {v}")
    print("  apps: " + ", ".join(d.get("apps", [])))
    return 0


def cmd_whoami(L: Linear, auth: Auth, seat: str) -> int:
    try:
        d = L.call(Q_WHOAMI)
    except GqlError as e:
        # The sentence says what failed and nothing of Linear's own text:  the
        # codes, the status and the request id come back as fields of their own.
        die(f"whoami failed: {gql_summary(e)}", EXIT_AUTH,
            **error_fields(e, credential_preview(auth.token or ""), auth.identity().where))
    v = d.get("viewer") or {}
    org = d.get("organization") or {}
    auth.remember_viewer(v, org)
    ident = auth.identity()
    fleet = fleet_app_name()
    app = SEAT_APP_NAMES.get(seat, "")
    name = v.get("name")
    writes = "enabled (the bearer-verified seat is the gate)" if seat else "disabled (no bearer-verified seat: the write verbs refuse)"
    info = auth.info or {}
    if ident.kind == "seat":
        identity = f"{name or app} (the {seat} seat's own Linear app)"
    elif ident.kind == "env" and app and app_name_ok(name, seat_app_names(seat), seat):
        identity = f"{name} (the {seat} seat's own Linear app, from the environment)"
    elif ident.kind == "env" and name != fleet:
        identity = f"unconfirmed (the environment's pair should be {' or '.join(map(repr, ident.accept))})"
    else:
        identity = (f"{fleet} (the shared app{', from the environment' if ident.kind == 'env' else ''}"
                    f"{f'; fallback for {seat}' if seat else ''})")
    print(f"seat:        {seat} (bearer-verified)" if seat else
          "seat:        (no bearer: reads run without an identity, the four write verbs refuse)")
    print(f"identity:    {identity}")
    print(f"backend:     linear ({L.url})")
    print(f"writes:      {writes}")
    print(f"viewer:      {name} ({'app user' if v.get('app') else 'NOT an app user'})  id {v.get('id')}")
    print(f"workspace:   {org.get('name')} ({org.get('urlKey')})")
    print(f"credentials: {auth.where}")
    if info.get("minted_at"):
        print(f"token:       minted {central(info['minted_at'])}, expires {central(info.get('expires_at') or 0)}")
    if ident.blob and fleet_secrets_bin():
        print(f"token store: {FLEET_OPS_WHERE} {ident.blob} (no token on disk)")
    elif ident.shared and Infisical.get().enabled and Infisical.get()._identity():
        print(f"token store: {INFISICAL_WHERE} {ident.shared} (no token on disk)")
    else:
        print("token store: none on this host;  a token is minted for each run and kept nowhere")
    if seat and name == fleet and ident.kind == "env":
        print(f"notice:      the environment's LINEAR_CLIENT_ID and LINEAR_CLIENT_SECRET are the shared {fleet} "
              f"app's, not an app of {seat}'s own; writes still work and carry the {seat} tag.")
    elif seat and name == fleet and ident.kind == "fleet":
        where = (f"no {seat_env_key(seat)}_LINEAR_CLIENT_ID in the environment, in Fleet-OPS {FLEET_OPS_LINEAR_PATH}, "
                 f"or in AI Fleet Coordinator {INFISICAL_LINEAR_PATH}") if app else "none in the seat table"
        print(f"notice:      {seat} has no Linear app yet ({where}), so it uses the shared {fleet} app; "
              f"writes still work and carry the {seat} tag.")
    problems = []
    if not v.get("app"):
        problems.append(f"the viewer is a person, not the {' or '.join(ident.accept)} app; refusing to act as a human")
    elif not app_name_ok(name, ident.accept, ident.seat):
        if ident.kind == "seat":
            problems.append(f"the viewer is {name!r}, not the {' or '.join(map(repr, ident.accept))} app:  the credentials in {ident.where} "
                            f"look swapped, so writes refuse (exit {EXIT_NO_CREDS}) until they are fixed; "
                            "reads still work")
        else:
            problems.append(f"the viewer is {name!r}, not the {' or '.join(map(repr, ident.accept))} app")
    if org.get("urlKey") != WORKSPACE_URL_KEY:
        problems.append(f"the workspace is {org.get('urlKey')!r}, not {WORKSPACE_URL_KEY!r}")
    for p in problems:
        print(f"{prog_name()}: {p}", file=sys.stderr)
    return EXIT_AUTH if problems else 0


# ----------------------------------------------------------------- Agent-Sync parity:  catalogs
# The hosted ST-MCP server (scripts/agent-sync-mcp) serves Linear as 175 named commands,
# general linear_schema/linear_query/linear_mutation tools and 11 proxied official Linear MCP tools.
# `board commands`, `board run`, `board api` and `board mcp` give a seat the same tools from a shell.
# The catalogs are JSON exported from the server's own JavaScript, never retyped here:
# scripts/agent-sync-mcp/scripts/export-linear-catalog.mjs writes catalog/*.json, and
# test/linear-catalog-parity.test.mjs fails CI when the committed JSON is stale.

CATALOG_DIR = Path(__file__).resolve().parent / "catalog"
REGENERATE_CATALOG = "cd scripts/agent-sync-mcp && node scripts/export-linear-catalog.mjs"
_CATALOGS: dict = {}


def load_catalog(name: str) -> dict:
    """One of catalog/*.json, read once per run."""
    if name not in _CATALOGS:
        path = CATALOG_DIR / name
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except FileNotFoundError:
            die(f"the Agent-Sync catalog {path} is missing.  It ships next to board;  in a checkout, "
                f"regenerate it with:  {REGENERATE_CATALOG}")
        except (OSError, ValueError) as e:
            die(f"cannot read the Agent-Sync catalog {path} ({type(e).__name__})")
        if not isinstance(data, dict):
            die(f"the Agent-Sync catalog {path} is not a JSON object")
        _CATALOGS[name] = data
    return _CATALOGS[name]


def named_commands() -> list:
    return load_catalog("named-commands.json")["commands"]


def named_command(raw: str) -> dict:
    """A named command by its served name (linear_get_issue) or without the prefix (get_issue)."""
    by = {c["name"]: c for c in named_commands()}
    name = raw if raw in by else f"linear_{raw}"
    if name not in by:
        die(f"no named Linear command {raw!r};  `board commands --search WORD` lists them", EXIT_USAGE)
    return by[name]


def official_catalog() -> dict:
    return load_catalog("official-mcp-tools.json")


def official_tool(raw: str) -> dict:
    by = {t["name"]: t for t in official_catalog()["tools"]}
    by.update({t["upstream_name"]: t for t in official_catalog()["tools"]})
    if raw not in by:
        die(f"no official Linear MCP tool {raw!r};  `board mcp list` lists them", EXIT_USAGE)
    return by[raw]


class ParityError(Exception):
    """A refusal with the hosted server's own wording (its ToolError invalid_argument)."""


# ----------------------------------------------------------------- JSON Schema subset (contract.js schemaProblem)

SAFE_NAME_RE = re.compile(r"^[A-Za-z0-9_]{1,40}$")


def _is_number(v) -> bool:
    return isinstance(v, (int, float)) and not isinstance(v, bool) and v == v and v not in (float("inf"), float("-inf"))


def _type_ok(t: str, v) -> bool:
    if t == "object":
        return isinstance(v, dict)
    if t == "array":
        return isinstance(v, list)
    if t == "string":
        return isinstance(v, str)
    if t == "integer":
        return _is_number(v) and float(v).is_integer()
    if t == "number":
        return _is_number(v)
    if t == "boolean":
        return isinstance(v, bool)
    if t == "null":
        return v is None
    return False


def _js_num(n) -> str:
    return str(int(n)) if isinstance(n, float) and n.is_integer() else str(n)


def _label(where: str, name: str) -> str:
    return f"argument '{name}'" if where == "arguments" else f"{where}.{name}"


def schema_problem(schema: dict, value, where: str = "arguments"):
    """The hosted server's argument check, message for message;  None when the value passes."""
    types = schema.get("type")
    if types is not None:
        allowed = types if isinstance(types, list) else [types]
        if not any(_type_ok(t, value) for t in allowed):
            return f"{where} must be of type {' or '.join(allowed)}"
    if "enum" in schema and not any(value == e and type(value) is type(e) for e in schema["enum"]):
        return f"{where} must be one of {', '.join(json.dumps(e) for e in schema['enum'])}"
    if isinstance(value, str):
        if "minLength" in schema and len(value) < schema["minLength"]:
            return f"{where} must be at least {schema['minLength']} characters"
        if "maxLength" in schema and len(value) > schema["maxLength"]:
            return f"{where} must be at most {schema['maxLength']} characters"
        if "pattern" in schema and not re.search(schema["pattern"], value):
            return f"{where} must match {schema['pattern']}"
    if _is_number(value):
        if "minimum" in schema and value < schema["minimum"]:
            return f"{where} must be at least {_js_num(schema['minimum'])}"
        if "maximum" in schema and value > schema["maximum"]:
            return f"{where} must be at most {_js_num(schema['maximum'])}"
    if isinstance(value, list):
        if "minItems" in schema and len(value) < schema["minItems"]:
            return f"{where} must have at least {schema['minItems']} items"
        if "maxItems" in schema and len(value) > schema["maxItems"]:
            return f"{where} must have at most {schema['maxItems']} items"
        if isinstance(schema.get("items"), dict):
            for i, item in enumerate(value):
                problem = schema_problem(schema["items"], item, f"{where}[{i}]")
                if problem:
                    return problem
    if isinstance(value, dict):
        props = schema.get("properties") or {}
        for name in schema.get("required") or []:
            if name not in value:
                return f"{_label(where, name)} is required"
        if schema.get("additionalProperties") is False:
            for name in value:
                if name not in props:
                    shown = f"'{name}'" if SAFE_NAME_RE.match(name) else "(name not shown)"
                    takes = ", ".join(sorted(props)) or "no arguments"
                    return f"unknown argument {shown}; this tool takes {takes}"
        for name, sub in props.items():
            if name in value:
                problem = schema_problem(sub, value[name], _label(where, name))
                if problem:
                    return problem
    return None


def with_defaults(schema: dict, args: dict) -> dict:
    """`args` plus each missing property's schema default (contract.js withDefaults)."""
    out = dict(args)
    for name, sub in (schema.get("properties") or {}).items():
        if name not in out and "default" in sub:
            out[name] = json.loads(json.dumps(sub["default"]))
    return out


# ----------------------------------------------------------------- GraphQL guards (linear-graphql.js)
# A small lexer and parser for executable GraphQL documents, enough to apply the hosted server's
# guards:  one operation, depth 16, 500 expanded fields, protected mutation roots, and each root's
# resolved arguments.  Parse errors all read "GraphQL document is invalid.", as the server's do.

GQL_DOCUMENT_LIMIT = 24000
GQL_VARIABLES_LIMIT = 24000
GQL_MAX_DEPTH = 16
GQL_MAX_FIELDS = 500
GQL_MAX_TOKENS = 8000
# Protected categories anywhere in a mutation root's name (linear-graphql.js BLOCKED_MUTATION_ROOT).
BLOCKED_MUTATION_ROOT = re.compile(r"(?:apiKey|oauth|application|integration|sso|scim|organization|user|teamMembership"
                                   r"|authentication|webhook|workspace|role|permission|session|accessToken)", re.I)
BATCH_MUTATION_ROOT = re.compile(r"(?:Batch|Bulk)", re.I)
_GQL_NAME = re.compile(r"[_A-Za-z][_0-9A-Za-z]*")
_GQL_NUMBER = re.compile(r"-?(?:0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?")
_GQL_SDL = frozenset(("schema", "scalar", "type", "interface", "union", "enum", "input", "directive", "extend"))
_MISSING = object()


class GqlSyntax(Exception):
    pass


def _gql_invalid(message: str) -> "NoReturn":  # noqa: F821
    raise ParityError(message)


def _block_string_value(raw: str) -> str:
    lines = re.split(r"\r\n|\n|\r", raw)

    def indent(line):
        return len(line) - len(line.lstrip(" \t"))
    common, first, last = None, None, -1
    for i, line in enumerate(lines):
        n = indent(line)
        if n == len(line):
            continue
        first = i if first is None else first
        last = i
        if i != 0 and (common is None or n < common):
            common = n
    common = common or 0
    lines = [line if i == 0 else line[common:] for i, line in enumerate(lines)]
    return "\n".join(lines[(first or 0):last + 1])


def gql_tokens(src: str, max_tokens: int) -> list:
    """(kind, value, start, end) tokens.  kind is P (punctuator), N (name), I (int), F (float), S (string)."""
    out = []
    i, n = 0, len(src)
    while i < n:
        c = src[i]
        if c in " \t\n\r,﻿":
            i += 1
            continue
        if c == "#":
            while i < n and src[i] not in "\n\r":
                i += 1
            continue
        start = i
        if src.startswith("...", i):
            out.append(("P", "...", start, i + 3))
            i += 3
        elif c in "!$&()[]{}:=@|":
            out.append(("P", c, start, i + 1))
            i += 1
        elif c == "_" or c.isascii() and c.isalpha():
            m = _GQL_NAME.match(src, i)
            out.append(("N", m.group(0), start, m.end()))
            i = m.end()
        elif c == "-" or c in "0123456789":
            m = _GQL_NUMBER.match(src, i)
            if not m:
                raise GqlSyntax("number")
            j = m.end()
            if j < n and (src[j] in "._" or src[j].isascii() and src[j].isalnum()):
                raise GqlSyntax("number")
            out.append(("F" if m.group(1) or m.group(2) else "I", m.group(0), start, j))
            i = j
        elif src.startswith('"""', i):
            j = i + 3
            raw = []
            while True:
                if j >= n:
                    raise GqlSyntax("block string")
                if src.startswith('"""', j):
                    break
                if src.startswith('\\"""', j):
                    raw.append('"""')
                    j += 4
                    continue
                ch = src[j]
                if ch < " " and ch not in "\t\n\r":
                    raise GqlSyntax("control character")
                raw.append(ch)
                j += 1
            out.append(("S", _block_string_value("".join(raw)), start, j + 3))
            i = j + 3
        elif c == '"':
            j = i + 1
            val = []
            while True:
                if j >= n or src[j] in "\n\r":
                    raise GqlSyntax("string")
                ch = src[j]
                if ch == '"':
                    break
                if ch < " " and ch != "\t":
                    raise GqlSyntax("control character")
                if ch == "\\":
                    esc = src[j + 1:j + 2]
                    simple = {'"': '"', "\\": "\\", "/": "/", "b": "\b", "f": "\f", "n": "\n", "r": "\r", "t": "\t"}
                    if esc in simple:
                        val.append(simple[esc])
                        j += 2
                        continue
                    if esc != "u":
                        raise GqlSyntax("escape")
                    if src[j + 2:j + 3] == "{":
                        end = src.find("}", j + 3)
                        hexs = src[j + 3:end] if end != -1 else ""
                        if not re.fullmatch(r"[0-9A-Fa-f]{1,6}", hexs) or int(hexs, 16) > 0x10FFFF or \
                                0xD800 <= int(hexs, 16) <= 0xDFFF:
                            raise GqlSyntax("escape")
                        val.append(chr(int(hexs, 16)))
                        j = end + 1
                        continue
                    hexs = src[j + 2:j + 6]
                    if not re.fullmatch(r"[0-9A-Fa-f]{4}", hexs):
                        raise GqlSyntax("escape")
                    cp = int(hexs, 16)
                    j += 6
                    if 0xD800 <= cp <= 0xDBFF:
                        low = src[j:j + 6]
                        if re.fullmatch(r"\\u[dD][c-fC-F][0-9A-Fa-f]{2}", low):
                            cp = 0x10000 + ((cp - 0xD800) << 10) + (int(low[2:], 16) - 0xDC00)
                            j += 6
                        else:
                            raise GqlSyntax("escape")
                    elif 0xDC00 <= cp <= 0xDFFF:
                        raise GqlSyntax("escape")
                    val.append(chr(cp))
                    continue
                val.append(ch)
                j += 1
            out.append(("S", "".join(val), start, j + 1))
            i = j + 1
        else:
            raise GqlSyntax("character")
        if len(out) > max_tokens:
            raise GqlSyntax("tokens")
    return out


class _GqlParser:
    """Recursive descent over gql_tokens() for executable documents.  Nodes are dicts."""

    def __init__(self, tokens: list):
        self.t = tokens
        self.i = 0

    def peek(self, kind=None, value=None, ahead=0):
        if self.i + ahead >= len(self.t):
            return False
        k, v = self.t[self.i + ahead][:2]
        return (kind is None or k == kind) and (value is None or v == value)

    def take(self, kind, value=None):
        if not self.peek(kind, value):
            raise GqlSyntax(f"expected {value or kind}")
        tok = self.t[self.i]
        self.i += 1
        return tok

    def name(self) -> str:
        return self.take("N")[1]

    def document(self) -> list:
        if not self.t:
            raise GqlSyntax("empty document")
        defs = []
        while self.i < len(self.t):
            defs.append(self.definition())
        return defs

    def definition(self) -> dict:
        if self.peek("P", "{"):
            return {"kind": "Operation", "op": "query", "name": None, "vars": [], "sel": self.selection_set()}
        if self.peek("N", "fragment"):
            self.i += 1
            name = self.name()
            if name == "on":
                raise GqlSyntax("fragment name")
            self.take("N", "on")
            self.name()
            self.directives(const=False)
            return {"kind": "Fragment", "name": name, "sel": self.selection_set()}
        if self.peek("N") and self.t[self.i][1] in ("query", "mutation", "subscription"):
            op = self.name()
            name = self.name() if self.peek("N") else None
            var_defs = []
            if self.peek("P", "("):
                self.i += 1
                while True:
                    self.take("P", "$")
                    vname = self.name()
                    self.take("P", ":")
                    vtype = self.type_ref()
                    default = None
                    if self.peek("P", "="):
                        self.i += 1
                        default = self.value(const=True)
                    self.directives(const=True)
                    var_defs.append({"name": vname, "type": vtype, "default": default})
                    if self.peek("P", ")"):
                        self.i += 1
                        break
            self.directives(const=False)
            return {"kind": "Operation", "op": op, "name": name, "vars": var_defs, "sel": self.selection_set()}
        if (self.peek("N") and self.t[self.i][1] in _GQL_SDL) or \
                (self.peek("S") and self.peek("N", ahead=1) and self.t[self.i + 1][1] in _GQL_SDL):
            raise ParityError("GraphQL documents may contain only an operation and fragment definitions.")
        raise GqlSyntax("definition")

    def type_ref(self) -> str:
        if self.peek("P", "["):
            self.i += 1
            inner = self.type_ref()
            self.take("P", "]")
            text = f"[{inner}]"
        else:
            text = self.name()
        if self.peek("P", "!"):
            self.i += 1
            text += "!"
        return text

    def directives(self, const: bool) -> None:
        while self.peek("P", "@"):
            self.i += 1
            self.name()
            if self.peek("P", "("):
                self.arguments(const)

    def arguments(self, const: bool) -> list:
        self.take("P", "(")
        args = []
        while True:
            name = self.name()
            self.take("P", ":")
            args.append((name, self.value(const)))
            if self.peek("P", ")"):
                self.i += 1
                return args

    def selection_set(self) -> list:
        self.take("P", "{")
        sel = []
        while True:
            sel.append(self.selection())
            if self.peek("P", "}"):
                self.i += 1
                return sel

    def selection(self) -> dict:
        if self.peek("P", "..."):
            self.i += 1
            if self.peek("N") and not self.peek("N", "on"):
                name = self.name()
                self.directives(const=False)
                return {"kind": "FragmentSpread", "name": name}
            if self.peek("N", "on"):
                self.i += 1
                self.name()
            self.directives(const=False)
            return {"kind": "InlineFragment", "sel": self.selection_set()}
        alias = None
        name = self.name()
        if self.peek("P", ":"):
            self.i += 1
            alias, name = name, self.name()
        args = self.arguments(const=False) if self.peek("P", "(") else []
        self.directives(const=False)
        sel = self.selection_set() if self.peek("P", "{") else None
        return {"kind": "Field", "name": name, "alias": alias, "args": args, "sel": sel}

    def value(self, const: bool) -> dict:
        if self.i >= len(self.t):
            raise GqlSyntax("value")
        kind, val, start, end = self.t[self.i]
        if kind == "P" and val == "$" and not const:
            self.i += 1
            return {"kind": "Variable", "name": self.name()}
        if kind == "P" and val == "[":
            self.i += 1
            values = []
            while not self.peek("P", "]"):
                values.append(self.value(const))
            self.i += 1
            return {"kind": "List", "values": values}
        if kind == "P" and val == "{":
            self.i += 1
            fields = []
            while not self.peek("P", "}"):
                fname = self.name()
                self.take("P", ":")
                fields.append((fname, self.value(const)))
            self.i += 1
            return {"kind": "Object", "fields": fields}
        self.i += 1
        if kind == "I":
            return {"kind": "Int", "value": val}
        if kind == "F":
            return {"kind": "Float", "value": val}
        if kind == "S":
            return {"kind": "String", "value": val, "start": start, "end": end}
        if kind == "N":
            if val in ("true", "false"):
                return {"kind": "Boolean", "value": val == "true"}
            if val == "null":
                return {"kind": "Null"}
            return {"kind": "Enum", "value": val}
        raise GqlSyntax("value")


def gql_parse(src: str, max_tokens: int = GQL_MAX_TOKENS) -> list:
    try:
        return _GqlParser(gql_tokens(src, max_tokens)).document()
    except GqlSyntax:
        raise ParityError("GraphQL document is invalid.") from None


def gql_value(node: dict, variables: dict):
    """graphql-js valueFromASTUntyped:  a value node with variables substituted (_MISSING when unset)."""
    k = node["kind"]
    if k == "Null":
        return None
    if k == "Int":
        return int(node["value"])
    if k == "Float":
        return float(node["value"])
    if k in ("String", "Enum", "Boolean"):
        return node["value"]
    if k == "List":
        return [None if v is _MISSING else v for v in (gql_value(x, variables) for x in node["values"])]
    if k == "Object":
        out = {}
        for name, child in node["fields"]:
            v = gql_value(child, variables)
            if v is not _MISSING:
                out[name] = v
        return out
    if k == "Variable":
        return variables.get(node["name"], _MISSING)
    return _MISSING


def _copy_variables(variables) -> dict:
    try:
        encoded = json.dumps(variables, separators=(",", ":"), ensure_ascii=False, allow_nan=False)
    except (TypeError, ValueError):
        _gql_invalid("variables must be JSON data.")
    if len(encoded) > GQL_VARIABLES_LIMIT:
        _gql_invalid("variables exceed the 24000-character limit.")
    copied = json.loads(encoded)
    if not isinstance(copied, dict):
        _gql_invalid("variables must be a JSON object.")

    def check(value, depth):
        if depth > GQL_MAX_DEPTH:
            _gql_invalid("variables exceed the maximum nesting depth of 16.")
        for child in (value.values() if isinstance(value, dict) else value if isinstance(value, list) else ()):
            check(child, depth + 1)
    check(copied, 0)
    return copied


def prepare_graphql(document, variables=None, expected: str = "query") -> dict:
    """Port of linear-graphql.js prepareGraphql:  parse and bound one operation before it reaches Linear.
    Returns the parsed operation, its root fields, the copied variables (defaults applied) and, for a
    mutation, the root field's resolved arguments.  Raises ParityError with the server's message."""
    if not isinstance(document, str):
        _gql_invalid("GraphQL document must be a string.")
    if len(document) > GQL_DOCUMENT_LIMIT:
        _gql_invalid("GraphQL document exceeds the 24000-character limit.")
    if expected not in ("query", "mutation"):
        _gql_invalid("operation must be query or mutation.")
    copied = _copy_variables({} if variables is None else variables)
    defs = gql_parse(document)
    operations = []
    fragments: dict = {}
    for d in defs:
        if d["kind"] == "Operation":
            operations.append(d)
        else:
            if d["name"] in fragments:
                _gql_invalid("GraphQL fragment names must be unique.")
            fragments[d["name"]] = d
    if len(operations) != 1:
        _gql_invalid("GraphQL document must contain exactly one operation.")
    op = operations[0]
    if op["op"] != expected:
        _gql_invalid(f"GraphQL document must be a {expected}.")
    for vd in op["vars"]:
        if vd["name"] not in copied and vd["default"] is not None:
            v = gql_value(vd["default"], copied)
            if v is not _MISSING:
                copied[vd["name"]] = v
    # Fragment graph:  no cycles, no unknown spreads (validateFragmentGraph).
    state: dict = {}

    def scan(sel, visit):
        for s in sel:
            if s["kind"] == "FragmentSpread":
                visit(s["name"])
            elif s.get("sel"):
                scan(s["sel"], visit)

    def visit(name):
        mark = state.get(name)
        if mark == "visiting":
            _gql_invalid("GraphQL fragment cycles are not allowed.")
        if mark == "done":
            return
        if name not in fragments:
            _gql_invalid("GraphQL document contains an unknown fragment spread.")
        state[name] = "visiting"
        scan(fragments[name]["sel"], visit)
        state[name] = "done"
    for name in list(fragments):
        visit(name)

    def check_ref(name):
        if name not in fragments:
            _gql_invalid("GraphQL document contains an unknown fragment spread.")
    scan(op["sel"], check_ref)
    # Depth and expanded field count (expandAndCount).
    count = [0]
    roots: list = []

    def walk(sel, depth, at_root=False):
        if depth > GQL_MAX_DEPTH:
            _gql_invalid("GraphQL selection depth exceeds 16.")
        for s in sel:
            if s["kind"] == "Field":
                count[0] += 1
                if count[0] > GQL_MAX_FIELDS:
                    _gql_invalid("GraphQL document exceeds 500 expanded fields.")
                if at_root:
                    roots.append(s)
                if s["sel"]:
                    walk(s["sel"], depth + 1)
            elif s["kind"] == "InlineFragment":
                walk(s["sel"], depth, at_root)
            else:
                walk(fragments[s["name"]]["sel"], depth, at_root)
    walk(op["sel"], 1, True)
    out = {"operation": op, "name": op["name"], "roots": roots, "variables": copied, "document": document}
    if expected == "mutation":
        if len(roots) != 1:
            _gql_invalid("GraphQL mutations must contain exactly one root field.")
        root = roots[0]["name"]
        if BLOCKED_MUTATION_ROOT.search(root):
            _gql_invalid("This Linear mutation root is protected.")
        if BATCH_MUTATION_ROOT.search(root):
            _gql_invalid("Batch and bulk mutation roots are not allowed.")
        args = {}
        for name, node in roots[0]["args"]:
            v = gql_value(node, copied)
            if v is not _MISSING:
                args[name] = v
        out["args"] = args
    return out


# ----------------------------------------------------------------- public inputs (linear-public-inputs.js)

def assert_public_inputs(command: dict, values: dict) -> dict:
    """Reject restricted or unknown fields in catalog-typed inputs before they reach Linear."""
    catalog = load_catalog("public-inputs.json")
    public, internal = catalog["public"], catalog["internal"]
    specs = {a["name"]: a for a in command.get("args") or []}
    pending = [(spec["type"], values[name], 0) for name, spec in specs.items()
               if isinstance(spec.get("type"), str) and name in values]
    visited = 0
    while pending:
        typ, value, depth = pending.pop()
        visited += 1
        if visited > 1000 or depth > 16:
            raise ParityError("Linear input exceeds the validation limit.")
        if value is None:
            continue
        typ = typ[:-1] if typ.endswith("!") else typ
        if typ.startswith("[") and typ.endswith("]"):
            if not isinstance(value, list):
                pending.append((typ[1:-1], value, depth + 1))   # GraphQL coerces one value to a list
                continue
            if visited + len(pending) + len(value) > 1000:
                raise ParityError("Linear input exceeds the validation limit.")
            pending.extend((typ[1:-1], item, depth + 1) for item in value)
            continue
        name = re.sub(r"[!\[\]]", "", typ)
        fields = public.get(name)
        if fields is None:
            continue            # scalars, enums and JSON leaves are opaque values
        if not isinstance(value, dict):
            raise ParityError("Linear input has an invalid object value.")
        hidden = internal.get(name) or []
        for field, child in value.items():
            if field in hidden:
                raise ParityError(f"Linear input contains a restricted field ({name}.{field}).")
            if field not in fields:
                raise ParityError("Linear input contains an unknown field.")
            pending.append((fields[field], child, depth + 1))
        if visited + len(pending) > 1000:
            raise ParityError("Linear input exceeds the validation limit.")
    return values


# ----------------------------------------------------------------- named commands (linear-named.js)

def selected_fields(value: str) -> str:
    """A selection override may hold only response fields:  it cannot close its braces and append roots."""
    try:
        defs = _GqlParser(gql_tokens(f"fragment NamedSelection on NamedResource {{ {value} }}", 4000)).document()
    except (GqlSyntax, ParityError):
        raise ParityError("selection must contain only GraphQL response fields.") from None
    if len(defs) != 1 or defs[0]["kind"] != "Fragment" or defs[0]["name"] != "NamedSelection":
        raise ParityError("selection must contain only GraphQL response fields.")
    return value


def build_named_operation(entry: dict, args: dict) -> tuple[str, dict]:
    """The document and variables the hosted server builds for a named command:  only the supplied
    arguments, in catalog order, under `query|mutation AgentSyncNamed`."""
    variants = entry.get("variants")
    command = (variants["update"] if "id" in args else variants["create"]) if variants else entry
    if variants:
        own = {a["name"] for a in command["args"]}
        for a in entry["args"]:
            if a["name"] in args and a["name"] not in own:
                raise ParityError(f"{a['name']} is not supported for this save operation.  Use the matching "
                                  "create or update command.")
    variables: dict = {}
    definitions, parameters = [], []
    for a in command["args"]:
        key = a["name"]
        if key not in args:
            continue
        variables[key] = args[key]
        typ = f"{a['type']}!" if a.get("required") and not a["type"].endswith("!") else a["type"]
        definitions.append(f"${key}: {typ}")
        parameters.append(f"{key}: ${key}")
    assert_public_inputs(command, variables)
    fields = args.get("selection") or command.get("selection")
    op = "mutation" if entry["kind"] == "write" else "query"
    doc = (f"{op} AgentSyncNamed{'(' + ', '.join(definitions) + ')' if definitions else ''} {{ {command['root']}"
           f"{'(' + ', '.join(parameters) + ')' if parameters else ''}"
           f"{' { ' + selected_fields(fields) + ' }' if fields else ''} }}")
    return doc, variables


def coerce_arg(entry: dict, key: str, raw: str):
    """--arg k=v:  the value read by the argument's declared JSON type, so an id stays a string."""
    props = entry["input_schema"].get("properties") or {}
    typ = (props.get(key) or {}).get("type")
    if typ == "string":
        return raw
    if typ == "integer":
        try:
            return int(raw)
        except ValueError:
            die(f"--arg {key}: {raw!r} is not an integer", EXIT_USAGE)
    if typ == "boolean":
        if raw.lower() in ("true", "false"):
            return raw.lower() == "true"
        die(f"--arg {key}: use true or false", EXIT_USAGE)
    try:
        return json.loads(raw)
    except ValueError:
        if typ in ("object", "array"):
            die(f"--arg {key}: the value must be JSON", EXIT_USAGE)
        return raw


# ----------------------------------------------------------------- inputs from flags

def read_flag_text(raw: str, flag: str) -> str:
    """A flag value, or `@PATH` (a regular file of at most 64 KB of UTF-8), or `-` for standard input."""
    if raw == "-":
        return read_text_input("-", flag)
    if not raw.startswith("@"):
        return raw
    path = raw[1:]
    try:
        st = os.stat(path)
    except OSError as e:
        die(f"{flag} {path}: cannot open it ({e.strerror or type(e).__name__})", EXIT_USAGE)
    if not stat.S_ISREG(st.st_mode):
        die(f"{flag} {path}: not a regular file", EXIT_USAGE)
    if st.st_size > INPUT_MAX_BYTES:
        die(f"{flag} {path}: more than {INPUT_MAX_BYTES // 1024} KB", EXIT_USAGE)
    try:
        return Path(path).read_bytes()[:INPUT_MAX_BYTES + 1].decode("utf-8")
    except UnicodeDecodeError:
        die(f"{flag} {path}: not valid UTF-8", EXIT_USAGE)
    except OSError as e:
        die(f"{flag} {path}: cannot read it ({type(e).__name__})", EXIT_USAGE)


def read_flag_json(raw: str | None, flag: str, default=None):
    if raw is None:
        return default
    text = read_flag_text(raw, flag)
    try:
        return json.loads(text)
    except ValueError:
        die(f"{flag}: not valid JSON", EXIT_USAGE)


# ----------------------------------------------------------------- write protections (linear-api.js)

PROTECTED_LABEL_RE = re.compile(r"^(?:claimed:|seat:|stale-claim$)", re.I)
SECRET_FIELD_RE = re.compile(r"secret|token|password|credential|authorization|cookie|api_?key", re.I)
AUTHOR_FIELD_RE = re.compile(r"^(?:creatorId|authorId|actorId|createdById|createAsUser)$", re.I)
LABEL_ADMIN_OK = ("issueLabelCreate", "issueLabelUpdate", "issueLabelDelete", "issueLabelArchive",
                  "issueLabelUnarchive", "issueLabelRetire", "issueLabelRestore")
Q_LABEL_ONE = "query AgentSyncLabel($id: String!) { issueLabel(id: $id) { id name } }"


def protect_labels(L: "Linear", prepared: dict) -> None:
    """Fleet claim, seat and stale-claim labels change only through `board claim`;  a mutation never
    names an author (the app credential fixes it)."""
    name = prepared["roots"][0]["name"]
    args = prepared["args"]
    issue_mutation = bool(re.match(r"issue", name, re.I))
    label_mutation = bool(re.match(r"issueLabel", name, re.I))
    if label_mutation and name not in LABEL_ADMIN_OK:
        raise ParityError("This label administration operation requires a dedicated fleet-aware tool.")
    if label_mutation and args.get("replaceTeamLabels") is True:
        raise ParityError("Replacing team labels can alter protected fleet ownership labels.  Update ordinary "
                          "labels individually.")
    ids: list = []
    replaces = [False]

    def walk(value):
        if not isinstance(value, dict):
            if isinstance(value, list):
                for child in value:
                    walk(child)
            return
        for key, child in value.items():
            if AUTHOR_FIELD_RE.match(key):
                raise ParityError("Linear author identity is fixed by this seat's app credential.")
            if issue_mutation and re.fullmatch(r"(?:added|removed)?labelIds?", key, re.I):
                if key == "labelIds":
                    replaces[0] = True
                for lid in (child if isinstance(child, list) else [child]):
                    if not isinstance(lid, str):
                        raise ParityError("Label identifiers must be strings.")
                    if lid not in ids:
                        ids.append(lid)
            elif isinstance(child, (dict, list)):
                walk(child)
    walk(args)
    if label_mutation:
        new_name = (args.get("input") or {}).get("name") if isinstance(args.get("input"), dict) else None
        if isinstance(new_name, str) and PROTECTED_LABEL_RE.match(new_name.strip()):
            raise ParityError("Fleet claim and seat labels are managed by `board claim`.")
        if isinstance(args.get("id"), str) and args["id"] not in ids:
            ids.append(args["id"])
    if len(ids) > 50:
        raise ParityError("At most 50 label identifiers may be checked per mutation.")
    for lid in ids:
        try:
            hit = L.call(Q_LABEL_ONE, {"id": lid}).get("issueLabel")
        except GqlError as e:
            if e.not_found():
                raise ParityError("A supplied label does not exist.") from None
            raise
        if not hit:
            raise ParityError("A supplied label does not exist.")
        if PROTECTED_LABEL_RE.match(hit.get("name") or ""):
            raise ParityError("Fleet claim and seat-label edits must use `board claim`.")
    if name == "issueUpdate" and replaces[0]:
        if not isinstance(args.get("id"), str):
            raise ParityError("issueUpdate requires an issue id.")
        issue = L.call(Q_ISSUE, {"id": args["id"]}).get("issue") or {}
        if any(PROTECTED_LABEL_RE.match(x.get("name") or "") for x in (issue.get("labels") or {}).get("nodes") or []):
            raise ParityError("Replacing labels would alter a fleet claim.  Use addedLabelIds/removedLabelIds for "
                              "ordinary labels, or `board claim` for ownership.")


def tag_inputs(prepared: dict, tag) -> str:
    """The seat tag line on every body and description a mutation's `input` writes, as the hosted
    tagInputs does:  in the variables it references, and in string literals spliced in place.
    Returns the document to send."""
    variables = prepared["variables"]
    tagged: set = set()
    splices: list = []

    def tag_object(value):
        if isinstance(value, list):
            return [tag_object(x) for x in value]
        if not isinstance(value, dict):
            return value
        return {k: (tag(v) if k in ("body", "description") and isinstance(v, str) else tag_object(v))
                for k, v in value.items()}

    def transform(node):
        k = node["kind"]
        if k == "Variable":
            name = node["name"]
            if name in variables and name not in tagged:
                variables[name] = tag_object(variables[name])
                tagged.add(name)
        elif k == "Object":
            for fname, child in node["fields"]:
                if fname in ("body", "description"):
                    if child["kind"] == "String":
                        splices.append((child["start"], child["end"], json.dumps(tag(child["value"]))))
                    elif child["kind"] == "Variable":
                        vname = child["name"]
                        if isinstance(variables.get(vname), str) and vname not in tagged:
                            variables[vname] = tag(variables[vname])
                            tagged.add(vname)
                else:
                    transform(child)
        elif k == "List":
            for child in node["values"]:
                transform(child)
    for name, node in prepared["roots"][0]["args"]:
        if name == "input":
            transform(node)
    doc = prepared["document"]
    for start, end, text in sorted(splices, reverse=True):
        doc = doc[:start] + text + doc[end:]
    return doc


def clean_data(data, depth: int = 0):
    """Secret-looking fields redacted, as the hosted cleanData does."""
    if depth > 32:
        raise ParityError("Linear response nesting exceeds the response limit.  Select fewer nested fields.")
    if isinstance(data, list):
        return [clean_data(x, depth + 1) for x in data]
    if isinstance(data, dict):
        return {k: ("[redacted secret]" if SECRET_FIELD_RE.search(k) else clean_data(v, depth + 1))
                for k, v in data.items()}
    return data


# ----------------------------------------------------------------- idempotency records
# A mutation through `board run`, `board api mutation` or a write `board mcp call` needs
# --idempotency-key.  Its record lives in the non-secret cache directory, one file per app (0600, flock), keyed by the
# seat and the key:  a retry with the same key and the same request returns the first result without
# sending it again;  the same key for a different request is refused;  an outcome that is not known
# (a timeout, a 5xx, a dropped connection) is never replayed automatically for 24 hours.

IDEM_TTL_S = 86400
IDEM_PENDING_FRESH_S = 30
IDEM_DATA_MAX_BYTES = 8192
IDEM_KEY_RE = re.compile(r"^[A-Za-z0-9_.:-]{1,100}$")


def stable_json(obj) -> str:
    return json.dumps(obj, sort_keys=True, separators=(",", ":"), ensure_ascii=False)


class IdemStore:
    def __init__(self, auth: "Auth", seat: str, key: str):
        # Receipts for --idempotency-key.  Not secrets (hashes and a clipped response):  one file per app
        # under the non-secret cache directory.
        self.path = cache_dir() / f"{auth.identity().slug}.linear-api.json"
        self.ref = hashlib.sha256(f"linear-api:{seat}:{key}".encode()).hexdigest()

    def _edit(self, fn):
        self.path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        fd = os.open(self.path, os.O_RDWR | os.O_CREAT, 0o600)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX)
            os.fchmod(fd, 0o600)
            rows = _read_cache(fd)
            now = time.time()
            rows = {k: v for k, v in rows.items() if isinstance(v, dict) and float(v.get("expires") or 0) > now}
            result = fn(rows, now)
            _write_cache(fd, rows)
            return result
        finally:
            try:
                fcntl.flock(fd, fcntl.LOCK_UN)
            finally:
                os.close(fd)

    def begin(self, request_sha: str, operation: str) -> tuple[str, dict | None]:
        def fn(rows, now):
            row = rows.get(self.ref)
            if row:
                if row.get("request_sha") != request_sha:
                    return "conflict", row
                if row.get("state") == "sent":
                    return "duplicate", row
                if row.get("state") == "pending" and now - float(row.get("claimed_at") or 0) < IDEM_PENDING_FRESH_S:
                    return "busy", row
                if row.get("state") == "pending":
                    row["state"] = "unknown"
                return "unknown", row
            rows[self.ref] = {"request_sha": request_sha, "operation": operation, "state": "pending",
                              "claimed_at": now, "expires": now + IDEM_TTL_S}
            return "send", None
        return self._edit(fn)

    def finish(self, data) -> None:
        receipt = data if len(json.dumps(data).encode()) <= IDEM_DATA_MAX_BYTES else \
            {"mutation_completed": True, "response_omitted": "Too large to keep;  inspect the resource with a query."}

        def fn(rows, now):
            if self.ref in rows:
                rows[self.ref].update(state="sent", data=receipt)
        self._edit(fn)

    def unknown(self) -> None:
        def fn(rows, now):
            if self.ref in rows:
                rows[self.ref]["state"] = "unknown"
        self._edit(fn)

    def drop(self) -> None:
        self._edit(lambda rows, now: rows.pop(self.ref, None))


def idem_begin(store: IdemStore, request_sha: str, operation: str):
    """'send', or the first result of an earlier identical request;  dies on a conflict or an unknown outcome."""
    verdict, row = store.begin(request_sha, operation)
    if verdict == "conflict":
        die("this idempotency key belongs to a different request.  Choose a new key for a new intended change.",
            EXIT_USAGE)
    if verdict == "busy":
        die("this request is already in flight under the same idempotency key.  Retry with the same key in a "
            "minute.", EXIT_RATE_LIMIT)
    if verdict == "unknown":
        die("the earlier request under this idempotency key has an unknown outcome:  it may have reached "
            "Linear.  Check Linear before making another change;  this key will not be replayed automatically "
            "for 24 hours.")
    return verdict, (row or {}).get("data")


class SendFailed(Exception):
    """A single-shot write failed.  `definitive` when Linear certainly did not apply it."""

    def __init__(self, message: str, definitive: bool, code: int = EXIT_ERROR):
        super().__init__(message)
        self.definitive, self.code = definitive, code


# Linear rejects these before executing anything, so the write certainly did not happen.
PRE_EXECUTION_CODES = ("GRAPHQL_PARSE_FAILED", "GRAPHQL_VALIDATION_FAILED")


def linear_send_once(L: "Linear", query: str, variables: dict) -> dict:
    """One POST of a mutation, never retried:  a retry of a write whose outcome is unknown could apply it
    twice.  Raises SendFailed."""
    token = L.auth.get()
    body = json.dumps({"query": query, "variables": variables}).encode()
    try:
        status, js, hdrs = L._post(body, token)
    except (urllib.error.URLError, http.client.HTTPException, OSError) as e:
        raise SendFailed(f"no usable response from Linear ({type(e).__name__})", False) from None
    errs = [e for e in (js.get("errors") or []) if isinstance(e, dict)]
    if status == 429 or any(_is_ratelimit(e) for e in errs):
        raise SendFailed(f"Linear rate limit:  the {L.auth.label}'s budget is spent.  Not applied;  retry with the "
                         "same key after the reset.", True, EXIT_RATE_LIMIT)
    if status == 401 or any(_is_auth_error(e) for e in errs):
        raise SendFailed(f"Linear refused the {L.auth.label} token.  Not applied.", True, EXIT_AUTH)
    if status == 403:
        raise SendFailed(f"Linear answered 403:  the {L.auth.label} may not do this.  Not applied.", True, EXIT_AUTH)
    if status >= 500:
        raise SendFailed(f"Linear answered HTTP {status}", False)
    data = js.get("data")
    if errs or data is None:
        rid = hdrs.get("x-request-id") or hdrs.get("request-id") \
            or hdrs.get("x-linear-request-id") or hdrs.get("cf-ray")
        e = GqlError(errs or [{"message": f"HTTP {status} with no data"}], data,
                     status=status, headers=hdrs, request_id=rid)
        definitive = bool(errs) and all(_err_code(x) in PRE_EXECUTION_CODES for x in errs)
        raise SendFailed(f"Linear error: {gql_summary(e)}", definitive)
    return data


def guarded_write(store: IdemStore, request_sha: str, operation: str, send, describe):
    """Run `send` under an idempotency record.  Returns (data, duplicate)."""
    verdict, cached = idem_begin(store, request_sha, operation)
    if verdict == "duplicate":
        return cached, True
    try:
        data = send()
    except SendFailed as e:
        if e.definitive:
            store.drop()
            die(str(e), e.code)
        store.unknown()
        # `SendFailed` carries its own sanitized message and its mapped code; it is not a
        # `GqlError`, so re-summarizing it here threw both away and left "no error code".
        die(f"{e}.  The {describe} may have reached Linear: check its result before using another idempotency "
            "key.  This key will not be replayed automatically for 24 hours.", e.code)
    except BaseException:
        store.unknown()
        raise
    store.finish(data)
    return data, False


# ----------------------------------------------------------------- official Linear MCP client (linear-mcp-client.js)

LINEAR_MCP_URL = "https://mcp.linear.app/mcp"
MCP_MAX_RESPONSE_BYTES = 8 * 1024 * 1024
MCP_MAX_INPUT_BYTES = 64 * 1024
MCP_ACCEPT = "application/json, text/event-stream"
MCP_LOOPBACK_RE = re.compile(r"http://127\.0\.0\.1:\d{1,5}(/[A-Za-z0-9._/-]*)?")


class McpError(Exception):
    def __init__(self, kind: str, phase: str, status: int | None = None, uncertain: bool = False):
        super().__init__(f"Linear MCP {kind} during {phase}" + (f" (HTTP {status})" if status else ""))
        self.kind, self.phase, self.status, self.uncertain = kind, phase, status, uncertain


def mcp_url() -> str:
    """The official server, or a loopback test mock.  Nothing else, so the app token only goes to Linear."""
    v = env("LINEAR_BOARD_MCP_URL")
    if not v:
        return LINEAR_MCP_URL
    if MCP_LOOPBACK_RE.fullmatch(v):
        return v
    die(f"LINEAR_BOARD_MCP_URL may only point at http://127.0.0.1:<port>/... (a test mock); refusing {v!r}",
        EXIT_USAGE)


def _mcp_status_kind(status: int) -> str:
    return {401: "unauthorized", 403: "forbidden", 429: "rate_limited"}.get(status) or \
        ("redirect" if 300 <= status < 400 else "status")


def _mcp_messages(resp, content_type: str, want_id, phase: str, uncertain: bool) -> dict:
    """The JSON-RPC response with id `want_id`, from a JSON body or an SSE stream (read until it arrives)."""
    if "text/event-stream" in (content_type or "").lower():
        size = 0
        data_lines: list = []

        def dispatch():
            payload = "\n".join(data_lines)
            data_lines.clear()
            if not payload or payload == "[DONE]":
                return None
            try:
                msg = json.loads(payload)
            except ValueError:
                return None     # a non-JSON event is ignored, as the hosted client does
            ok = isinstance(msg, dict) and msg.get("jsonrpc") == "2.0" and msg.get("id") == want_id
            return msg if ok else None
        while True:
            line = resp.readline(MCP_MAX_RESPONSE_BYTES + 1)
            size += len(line)
            if size > MCP_MAX_RESPONSE_BYTES:
                raise McpError("too_large", phase, uncertain=uncertain)
            if not line:
                msg = dispatch()
                if msg:
                    return msg
                raise McpError("protocol", phase, uncertain=uncertain)
            text = line.decode("utf-8", "replace").rstrip("\r\n")
            if not text:
                msg = dispatch()        # a blank line ends an event;  stop at the one that answers us
                if msg:
                    return msg
            elif text.startswith("data:"):
                data_lines.append(text[6:] if text.startswith("data: ") else text[5:])
    raw = resp.read(MCP_MAX_RESPONSE_BYTES + 1)
    if len(raw) > MCP_MAX_RESPONSE_BYTES:
        raise McpError("too_large", phase, uncertain=uncertain)
    try:
        msg = json.loads(raw)
    except ValueError:
        raise McpError("protocol", phase, uncertain=uncertain) from None
    if isinstance(msg, dict) and msg.get("jsonrpc") == "2.0" and msg.get("id") == want_id:
        return msg
    raise McpError("protocol", phase, uncertain=uncertain)


def mcp_post(url: str, token: str, body: dict, *, phase: str, write: bool, rpc_id=None,
             protocol_version: str | None = None, session_id: str | None = None):
    """POST one JSON-RPC message.  Returns (result or None for a notification, response headers)."""
    headers = {"Authorization": f"Bearer {token}", "Content-Type": "application/json", "Accept": MCP_ACCEPT,
               "User-Agent": USER_AGENT}
    if protocol_version:
        headers["MCP-Protocol-Version"] = protocol_version
    if session_id:
        headers["Mcp-Session-Id"] = session_id
    req = urllib.request.Request(url, data=json.dumps(body).encode(), method="POST", headers=headers)
    in_call = phase == "tools/call" and write
    timeout = env_float("LINEAR_BOARD_TIMEOUT", 60)
    try:
        resp = opener().open(req, timeout=timeout)
    except urllib.error.HTTPError as e:
        raise McpError(_mcp_status_kind(e.code), phase, e.code, in_call and e.code not in (401, 403, 429)) from None
    except (urllib.error.URLError, http.client.HTTPException, OSError) as e:
        kind = "timeout" if "timed out" in str(e).lower() else "network"
        raise McpError(kind, phase, uncertain=in_call) from None
    with resp:
        hdrs = {k.lower(): v for k, v in resp.headers.items()}
        if rpc_id is None:
            if resp.status not in (200, 202, 204):
                raise McpError(_mcp_status_kind(resp.status), phase, resp.status)
            return None, hdrs
        declared = hdrs.get("content-length")
        if declared and declared.isdigit() and int(declared) > MCP_MAX_RESPONSE_BYTES:
            raise McpError("too_large", phase, uncertain=in_call)
        try:
            msg = _mcp_messages(resp, hdrs.get("content-type", ""), rpc_id, phase, in_call)
        except (http.client.HTTPException, OSError):
            raise McpError("network", phase, uncertain=in_call) from None
    if isinstance(msg.get("error"), dict):
        data = msg["error"].get("data") if isinstance(msg["error"].get("data"), dict) else {}
        status = data.get("status") if isinstance(data.get("status"), int) else None
        raise McpError(_mcp_status_kind(status) if status else "upstream_error", phase, status, phase == "tools/call")
    if not isinstance(msg.get("result"), dict):
        raise McpError("protocol", phase, uncertain=phase == "tools/call")
    return msg["result"], hdrs


def call_official_linear(token: str, upstream: str, args: dict, write: bool) -> dict:
    """initialize, notifications/initialized, then tools/call, over Streamable HTTP."""
    url = mcp_url()
    init, hdrs = mcp_post(url, token, {
        "jsonrpc": "2.0", "id": 1, "method": "initialize",
        "params": {"protocolVersion": official_catalog().get("protocol_version") or "2025-03-26", "capabilities": {},
                   "clientInfo": {"name": "swu-board-cli", "version": "1"}}}, phase="initialize", write=write, rpc_id=1)
    version = init.get("protocolVersion")
    if not isinstance(version, str) or not version or len(version) > 100:
        raise McpError("protocol", "initialize")
    session = hdrs.get("mcp-session-id") or ""
    if len(session) > 200 or re.search(r"[\x00-\x1f\x7f]", session):
        raise McpError("protocol", "initialize")
    mcp_post(url, token, {"jsonrpc": "2.0", "method": "notifications/initialized"}, phase="initialized", write=write,
             protocol_version=version, session_id=session or None)
    result, _ = mcp_post(url, token, {"jsonrpc": "2.0", "id": 2, "method": "tools/call",
                                      "params": {"name": upstream, "arguments": args}},
                         phase="tools/call", write=write, rpc_id=2, protocol_version=version,
                         session_id=session or None)
    content = result.get("content")
    if not isinstance(content, list) or any(not isinstance(x, dict) or not isinstance(x.get("type"), str)
                                            for x in content) \
            or ("isError" in result and not isinstance(result["isError"], bool)) \
            or ("structuredContent" in result and not isinstance(result["structuredContent"], dict)):
        raise McpError("protocol", "tools/call", uncertain=True)
    return result


def validate_mcp_input(tool: dict, args: dict) -> None:
    """linear-mcp.js validateInput plus its per-tool rules."""
    pending = [(args, 0)]
    count = 0
    while pending:
        value, depth = pending.pop()
        count += 1
        if count > 1000 or depth > 16:
            raise ParityError("Linear MCP input exceeds the validation limit.")
        if isinstance(value, dict):
            pending.extend((v, depth + 1) for v in value.values())
        elif isinstance(value, list):
            pending.extend((v, depth + 1) for v in value)
    schema = tool["input_schema"]
    problem = schema_problem(schema, args)
    if problem:
        raise ParityError(problem)

    def check(rule, item):
        if rule.get("anyOf"):
            match = next((c for c in rule["anyOf"] if not schema_problem(c, item)), None)
            if match is None:
                raise ParityError("A Linear MCP input does not match any supported variant.")
            check(match, item)
        if isinstance(item, list) and isinstance(rule.get("items"), dict):
            for child in item:
                check(rule["items"], child)
        elif isinstance(item, dict):
            for key, child in item.items():
                if isinstance((rule.get("properties") or {}).get(key), dict):
                    check(rule["properties"][key], child)
    check(schema, args)
    if len(json.dumps(args, separators=(",", ":"), ensure_ascii=False).encode()) > MCP_MAX_INPUT_BYTES:
        raise ParityError("Linear MCP input exceeds 64 KiB.")
    native = {k: v for k, v in args.items() if k not in official_catalog().get("local_fields", ())}
    up = tool["upstream_name"]
    if up == "delete_diff_comment" and bool(native.get("commentId")) == bool(native.get("draftId")):
        raise ParityError("Supply exactly one commentId or draftId.")
    if up == "submit_diff_review" and native.get("decision") != "approved" and not str(native.get("body") or "").strip():
        raise ParityError("A review requesting changes or commenting requires a body.")
    if up == "update_diff" and not any(k != "urlOrId" for k in native):
        raise ParityError("Supply at least one diff update.")


# ----------------------------------------------------------------- the parity verbs

def parity_fail(e: ParityError) -> "NoReturn":  # noqa: F821
    die(str(e), EXIT_USAGE)


def output_limited(obj, max_chars: int, write: bool = False) -> None:
    if len(json.dumps(obj, separators=(",", ":"), ensure_ascii=False)) > max_chars:
        tail = "  The mutation has already completed;  keep its idempotency key." if write else ""
        die(f"the Linear response exceeds --max-chars {max_chars}.  Use pagination or select fewer fields." + tail)


def cmd_commands(a) -> int:
    """`board commands`:  the named Linear commands the hosted server serves."""
    rows = named_commands()
    if a.action == "show":
        if not a.name:
            die("`board commands show NAME` needs a command name", EXIT_USAGE)
        c = named_command(a.name)
        if a.json:
            print(json.dumps(c, indent=2, ensure_ascii=False))
            return 0
        print(f"{c['name']}  ({c['kind']}{', destructive' if c.get('destructive') else ''})  {c['title']}")
        print(c["description"])
        print(f"\nroot:  {c['root']}")
        print("args:")
        for arg in c["args"]:
            bits = [arg["type"], "required" if arg.get("required") else "optional"]
            if "default" in arg:
                bits.append(f"default {json.dumps(arg['default'])}")
            desc = f"  {arg['description']}" if arg.get("description") else ""
            print(f"  {arg['name']}:  {', '.join(bits)}{desc}")
        if not c["args"]:
            print("  (none)")
        if c.get("variants"):
            print(f"\nwithout id:  {c['variants']['create']['name']};  with id:  {c['variants']['update']['name']}")
        print(f"\ndefault selection:  {c.get('selection') or '(none)'}")
        if c["kind"] == "write":
            print("\nwrites need a bearer-verified seat and --idempotency-key")
        return 0
    if a.action is not None or a.name:
        die("usage:  board commands [--search WORD] [--kind read|write] [--json]  |  board commands show NAME",
            EXIT_USAGE)
    word = (a.search or "").lower()
    rows = [c for c in rows if (not a.kind or c["kind"] == a.kind)
            and (not word or word in f"{c['name']} {c['title']} {c['description']} {c['root']}".lower())]
    if a.json:
        print(json.dumps([{k: c[k] for k in ("name", "kind", "title", "root", "destructive")} for c in rows],
                         indent=2))
        return 0
    for c in rows:
        print(f"{c['name']:<44} {c['kind']:<5} {c['root']:<32} {c['title']}")
    print(f"\n{len(rows)} command(s).  `board commands show NAME` for arguments;  `board run NAME` to call one.")
    return 0


def prepare_run(a) -> None:
    """Validate `board run` completely before any credential is read:  the catalog entry, the arguments
    against the served input schema, the public-input allowlist and the built document."""
    entry = named_command(a.name)
    args = read_flag_json(a.args_json, "--args-json", {})
    if not isinstance(args, dict):
        die("--args-json must be a JSON object", EXIT_USAGE)
    for pair in a.arg or []:
        if "=" not in pair:
            die(f"--arg {pair!r}: use KEY=VALUE", EXIT_USAGE)
        key, raw = pair.split("=", 1)
        args[key.strip()] = coerce_arg(entry, key.strip(), raw)
    if a.selection is not None:
        args["selection"] = a.selection
    if a.max_chars is not None:
        args["max_chars"] = a.max_chars
    if entry["kind"] == "write":
        if not a.idempotency_key:
            die(f"{entry['name']} is a write:  pass --idempotency-key KEY (letters, digits, _.:-), unique to "
                "this intended change", EXIT_USAGE)
        args["idempotency_key"] = a.idempotency_key
    elif a.idempotency_key:
        die(f"{entry['name']} is a read;  --idempotency-key is only for writes", EXIT_USAGE)
    problem = schema_problem(entry["input_schema"], args)
    if problem:
        die(problem, EXIT_USAGE)
    args = with_defaults(entry["input_schema"], args)
    try:
        doc, variables = build_named_operation(entry, args)
        prepared = prepare_graphql(doc, variables, "mutation" if entry["kind"] == "write" else "query")
    except ParityError as e:
        parity_fail(e)
    a.entry, a.prepared, a.max_chars = entry, prepared, args.get("max_chars", 24000)


def prepare_api(a) -> None:
    if a.api_cmd == "schema":
        if not re.fullmatch(r"[_A-Za-z][_0-9A-Za-z]{0,99}", a.type_name):
            die("TYPE must be a GraphQL type name", EXIT_USAGE)
        if not 1 <= a.limit <= 100 or not 0 <= a.offset <= 100000:
            die("--limit takes 1 to 100 and --offset 0 to 100000", EXIT_USAGE)
        return
    doc = read_flag_text(a.document, "DOCUMENT")
    variables = read_flag_json(a.vars, "--vars", {})
    if not 1000 <= a.max_chars <= 64000:
        die("--max-chars takes 1000 to 64000", EXIT_USAGE)
    if a.api_cmd == "mutation" and not (a.idempotency_key and IDEM_KEY_RE.match(a.idempotency_key)):
        die("`board api mutation` needs --idempotency-key KEY (1 to 100 of letters, digits, _.:-), unique to this "
            "intended change", EXIT_USAGE)
    try:
        a.prepared = prepare_graphql(doc, variables, a.api_cmd)
    except ParityError as e:
        parity_fail(e)


def prepare_mcp(a) -> None:
    if a.mcp_cmd != "call":
        return
    tool = official_tool(a.tool)
    args = read_flag_json(a.args_json, "--args-json", {})
    if not isinstance(args, dict):
        die("--args-json must be a JSON object", EXIT_USAGE)
    if a.max_chars is not None:
        args["max_chars"] = a.max_chars
    if tool["kind"] == "write":
        if not a.idempotency_key:
            die(f"{tool['name']} is a write:  pass --idempotency-key KEY, unique to this intended change", EXIT_USAGE)
        args["idempotency_key"] = a.idempotency_key
    elif a.idempotency_key:
        die(f"{tool['name']} is a read;  --idempotency-key is only for writes", EXIT_USAGE)
    try:
        validate_mcp_input(tool, args)
    except ParityError as e:
        parity_fail(e)
    args = with_defaults(tool["input_schema"], args)
    a.tool_spec, a.max_chars = tool, args.get("max_chars", 24000)
    a.native = {k: v for k, v in args.items() if k not in official_catalog().get("local_fields", ())}


def parity_is_write(a) -> bool:
    if a.cmd == "run":
        return named_command(a.name)["kind"] == "write"
    if a.cmd == "api":
        return a.api_cmd == "mutation"
    if a.cmd == "mcp":
        return a.mcp_cmd == "call" and official_tool(a.tool)["kind"] == "write"
    return False


def parity_tagger(seat: str, a):
    sessions = auto_sessions(getattr(a, "session_ids", None), seat)
    return lambda text: f"{seat_tag(seat, sessions)} {text}"


def run_mutation(L: "Linear", auth: "Auth", seat: str, a, prepared: dict, label: str):
    """The hosted apiMutation:  label protection, seat tags, then one idempotent send."""
    try:
        protect_labels(L, prepared)
    except ParityError as e:
        parity_fail(e)
    doc = tag_inputs(prepared, parity_tagger(seat, a))
    variables = prepared["variables"]
    digest = hashlib.sha256(stable_json({"query": doc, "variables": variables}).encode()).hexdigest()
    store = IdemStore(auth, seat, a.idempotency_key)
    data, duplicate = guarded_write(store, digest, prepared["roots"][0]["name"],
                                    lambda: clean_data(linear_send_once(L, doc, variables)), label)
    return data, duplicate


def print_api_result(a, data, duplicate: bool, operation: str, name: str) -> int:
    if duplicate:
        warn("this idempotency key already completed this exact request;  showing the first result, not "
             "sending it again")
    if a.json:
        print(json.dumps({"command": name, "operation": operation, "duplicate": duplicate, "data": data}, indent=2,
                         ensure_ascii=False))
    else:
        print(json.dumps(data, indent=2, ensure_ascii=False))
    return 0


def cmd_run(L: "Linear", auth: "Auth", a, seat: str) -> int:
    entry, prepared = a.entry, a.prepared
    if entry["kind"] == "write":
        data, duplicate = run_mutation(L, auth, seat, a, prepared, f"`board run {entry['name']}`")
        output_limited(data, a.max_chars, write=True)
        return print_api_result(a, data, duplicate, "mutation", entry["name"])
    data = clean_data(L.call(prepared["document"], prepared["variables"]))
    output_limited(data, a.max_chars)
    return print_api_result(a, data, False, "query", entry["name"])


def _type_text(t: dict | None) -> str:
    if not t:
        return "?"
    if t.get("kind") == "NON_NULL":
        return _type_text(t.get("ofType")) + "!"
    if t.get("kind") == "LIST":
        return f"[{_type_text(t.get('ofType'))}]"
    return t.get("name") or "?"


def _type_ref(depth: int) -> str:
    return "kind name" + (f" ofType {{ {_type_ref(depth - 1)} }}" if depth else "")


Q_SCHEMA_TYPE = f"""query AgentSyncSchema($name: String!) {{
  __type(name: $name) {{
    name kind description
    fields(includeDeprecated: true) {{
      name description isDeprecated deprecationReason
      args {{ name description defaultValue type {{ {_type_ref(7)} }} }}
      type {{ {_type_ref(7)} }}
    }}
    inputFields {{ name description defaultValue type {{ {_type_ref(7)} }} }}
    enumValues(includeDeprecated: true) {{ name description isDeprecated deprecationReason }}
    possibleTypes {{ name kind }}
    interfaces {{ name kind }}
  }}
}}"""


def cmd_api(L: "Linear", auth: "Auth", a, seat: str) -> int:
    if a.api_cmd == "schema":
        t = L.call(Q_SCHEMA_TYPE, {"name": a.type_name}).get("__type")
        if not t:
            die(f"Linear has no type named {a.type_name!r}", EXIT_USAGE)
        kind = "fields" if t.get("fields") else "inputFields" if t.get("inputFields") else "enumValues"
        word = (a.field or "").lower()
        rows = [f for f in (t.get(kind) or []) if not word or word in (f.get("name") or "").lower()]
        page = rows[a.offset:a.offset + a.limit]
        nxt = a.offset + a.limit if a.offset + a.limit < len(rows) else None
        if a.json:
            print(json.dumps(clean_data({"name": t["name"], "kind": t["kind"], "description": t.get("description"),
                                         "total": len(rows), "offset": a.offset, "next_offset": nxt, kind: page,
                                         "interfaces": t.get("interfaces"), "possibleTypes": t.get("possibleTypes")}),
                             indent=2, ensure_ascii=False))
            return 0
        print(f"{t['name']}  ({t['kind']})  {len(rows)} {kind}" + (f" matching {a.field!r}" if word else ""))
        if t.get("description"):
            print(t["description"])
        print()
        for f in page:
            dep = "  (deprecated)" if f.get("isDeprecated") else ""
            if kind == "enumValues":
                print(f"  {f['name']}{dep}")
                continue
            args = ", ".join(f"{x['name']}: {_type_text(x.get('type'))}" for x in f.get("args") or [])
            print(f"  {f['name']}{'(' + args + ')' if args else ''}: {_type_text(f.get('type'))}{dep}")
        if nxt is not None:
            print(f"\nmore:  --offset {nxt}")
        return 0
    if a.api_cmd == "query":
        data = clean_data(L.call(a.prepared["document"], a.prepared["variables"]))
        output_limited(data, a.max_chars)
        return print_api_result(a, data, False, "query", "linear_query")
    data, duplicate = run_mutation(L, auth, seat, a, a.prepared, "`board api mutation`")
    output_limited(data, a.max_chars, write=True)
    return print_api_result(a, data, duplicate, "mutation", "linear_mutation")


def mcp_texts(result: dict) -> tuple[list, list]:
    texts, images = [], []
    for block in result.get("content") or []:
        if block.get("type") == "text" and isinstance(block.get("text"), str):
            texts.append(block["text"])
        elif block.get("type") == "image":
            images.append({"mimeType": block.get("mimeType"), "bytes": len(str(block.get("data") or "")) * 3 // 4})
        else:
            texts.append("[Unsupported remote content omitted.]")
    return texts, images


def cmd_mcp(L: "Linear", auth: "Auth", a, seat: str) -> int:
    cat = official_catalog()
    if a.mcp_cmd == "list":
        if a.json:
            print(json.dumps(cat["tools"], indent=2, ensure_ascii=False))
            return 0
        for t in cat["tools"]:
            print(f"{t['name']:<34} {t['kind']:<5} {t['title']}")
        print(f"\n{len(cat['tools'])} tool(s), proxied to {cat['url']} with this seat's Linear app token.  "
              "`board mcp show TOOL` for arguments.")
        return 0
    if a.mcp_cmd == "show":
        t = official_tool(a.tool)
        if a.json:
            print(json.dumps(t, indent=2, ensure_ascii=False))
            return 0
        print(f"{t['name']}  ({t['kind']})  {t['title']}")
        print(t["description"])
        req = set(t["input_schema"].get("required") or [])
        print("\nargs:")
        for name, prop in sorted((t["input_schema"].get("properties") or {}).items()):
            typ = prop.get("type") or "/".join(str(x.get("type")) for x in prop.get("anyOf") or []) or "any"
            print(f"  {name}:  {typ}, {'required' if name in req else 'optional'}"
                  + (f"  {prop['description']}" if prop.get("description") else ""))
        return 0
    tool, native = a.tool_spec, a.native
    write = tool["kind"] == "write"
    if write:
        tag = parity_tagger(seat, a)
        for field in ("body", "description"):
            if isinstance(native.get(field), str) and native[field]:
                native[field] = tag(native[field])

    def send():
        try:
            result = call_official_linear(auth.get(), tool["upstream_name"], native, write)
        except McpError as e:
            code = EXIT_RATE_LIMIT if e.kind == "rate_limited" else EXIT_AUTH if e.kind in ("unauthorized", "forbidden") \
                else EXIT_ERROR
            raise SendFailed(str(e), not e.uncertain, code) from None
        if result.get("isError"):
            texts, _ = mcp_texts(result)
            reason = (texts[0] if texts else "Linear's official MCP refused the operation.")[:300]
            raise SendFailed(f"Linear MCP refused:  {reason}", not write)
        return result

    if write:
        digest = hashlib.sha256(stable_json({"upstream": tool["upstream_name"], "arguments": native}).encode()).hexdigest()
        store = IdemStore(auth, seat, a.idempotency_key)

        def send_receipt():
            result = send()
            texts, _ = mcp_texts(result)
            return {"texts": texts}
        result, duplicate = guarded_write(store, digest, f"mcp:{tool['upstream_name']}", send_receipt,
                                          f"`board mcp call {tool['name']}`")
        if duplicate:
            warn("this idempotency key already completed this exact call;  showing the first result, not sending "
                 "it again")
        result = {"content": [{"type": "text", "text": t} for t in (result or {}).get("texts") or []]}
    else:
        try:
            result = send()
        except SendFailed as e:
            die(str(e), e.code)
    texts, images = mcp_texts(result)
    # The hosted check is JSON.stringify(texts).length:  compact, non-ASCII kept as is.
    if len(json.dumps(texts, ensure_ascii=False, separators=(",", ":"))) > a.max_chars:
        die(f"the Linear MCP response exceeds --max-chars {a.max_chars}.  Narrow the request"
            + (";  the call has already completed, so keep its idempotency key." if write else "."))
    if a.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
        return 0
    print("\n\n".join(texts))
    for im in images:
        print(f"[image {im['mimeType']}, about {im['bytes']} bytes;  --json returns its data]")
    return 0


