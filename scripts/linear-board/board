def seat_app_names(seat: str) -> tuple:
    """The display names a seat's Linear app may carry, the primary one first; empty for a seat with no app."""
    app = SEAT_APP_NAMES.get(seat, "") if seat else ""
    return (app, *SEAT_APP_ALIASES.get(seat, ())) if app else ()


def app_name_ok(name, accepted, seat: str = "") -> bool:
    """Whether a viewer name is one of the accepted display names or the seat tag, ignoring case."""
    ok = {n.casefold() for n in accepted}
    if seat:
        ok.add(seat.casefold())
    return isinstance(name, str) and name.casefold() in ok
