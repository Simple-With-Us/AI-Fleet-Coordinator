  }
}"""
Q_WHOAMI = """query BoardWhoami {
  viewer { id name displayName email app }
  organization { name urlKey }
}"""
Q_UID_ATTACHMENT = """query BoardUidAttachment($url: String!, $first: Int!, $after: String) {
  attachmentsForURL(url: $url, first: $first, after: $after) {
    pageInfo { hasNextPage endCursor }
    nodes { issue { id identifier team { key } } }
  }
}"""
Q_COMMENT_ONE = """query BoardCommentOne($id: String!) { comment(id: $id) { id } }"""
M_CREATE = """mutation BoardFile($input: IssueCreateInput!) {
  issueCreate(input: $input) { success issue { ...BoardIssue } }
}""" + F_ISSUE
M_UPDATE = """mutation BoardUpdate($id: String!, $input: IssueUpdateInput!) {
  issueUpdate(id: $id, input: $input) { success issue { ...BoardIssue } }
}""" + F_ISSUE
M_COMMENT = """mutation BoardComment($input: CommentCreateInput!) {
