#!/usr/bin/env python3
"""A fake `lane` tool:  logs the call and prints $FF_SCENARIO's {"lane": <report>}."""
import json
import os
import sys

log = os.environ.get("FF_LOG")
if log:
    with open(log, "a") as fh:
        fh.write(json.dumps(["lane"] + sys.argv[1:]) + "\n")
print(json.dumps(json.load(open(os.environ["FF_SCENARIO"]))["lane"]))
