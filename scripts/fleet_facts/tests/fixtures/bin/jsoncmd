#!/usr/bin/env python3
"""A fake JSON-printing command:  prints $FF_SCENARIO's {"cmds": {<this program's name>: <document>}} and logs the call."""
import json
import os
import sys

log = os.environ.get("FF_LOG")
if log:
    with open(log, "a") as fh:
        fh.write(json.dumps([os.path.basename(sys.argv[0])] + sys.argv[1:]) + "\n")
print(json.dumps(json.load(open(os.environ["FF_SCENARIO"]))["cmds"][os.path.basename(sys.argv[0])]))
