#!/bin/sh
# mac-facts-publish:  the launcher the LaunchAgent com.jay.mac-facts-publish runs every 3 hours.
#
# It is a launcher of its own, and not the fleet-facts link, so a Removable Volumes grant can be scoped to
# this one file (live step L15;  check it from launchd's own context, because macOS judges the running image and
# this launcher hands over to python with exec).  install.sh puts it beside the stable copy of fleet-facts and
# does nothing more:  it does not load a LaunchAgent.  The publisher it runs is `fleet-facts publish-mac`
# (scripts/fleet_facts/publish.py, open-loops unit F7).
D=$(cd "$(dirname "$0")" && pwd -P)
PY=/opt/homebrew/bin/python3
[ -x "$PY" ] || PY=$(command -v python3) || { echo "mac-facts-publish: no python3" >&2; exit 3; }
exec "$PY" -I "$D/fleet-facts" publish-mac "$@"
