#!/bin/sh
# Fleet build shim:  notices, and in block mode stops, build output pointed into system temp (AFC-618, rule class temp-build).
# Link it as xcodebuild, swift, cargo, npm, pnpm, yarn or bun in a PATH folder ahead of the real tools;  the name it is run as
# is the tool it stands for.  Every build passes here, so the rules are:  no Python unless the command could write into temp,
# and any failure runs the real tool.  Decisions live in fleet_lanes/build_shim.py.  This file is POSIX sh.
#
# Mode file ~/.config/fleet/lane-guard-mode:  detect (the default) logs only;  `block` or `block temp-build` refuses.
# Kill switch:  FLEET_LANE_GUARD=off.

_fleet_tool=${0##*/}

_fleet_fail_open() {
  _fleet_log=${FLEET_LANE_GUARD_STATE_DIR:-${HOME:-/tmp}/.local/state/fleet}/lane-guard-events.jsonl
  if [ -n "${FLEET_LANES_TEST_RUN:-}" ]; then
    _fleet_acct=$(/usr/bin/id -un 2>/dev/null) && eval "_fleet_acct=~$_fleet_acct"
    if [ "$(cd -P "${_fleet_log%/*}" 2>/dev/null && pwd -P)" = "$(cd -P "$_fleet_acct/.local/state/fleet" 2>/dev/null && pwd -P)" ]; then return 0; fi
  fi
  /bin/mkdir -p "${_fleet_log%/*}" 2>/dev/null
  _fleet_at=$(/bin/date -u +%Y-%m-%dT%H:%M:%S+00:00 2>/dev/null)
  { printf '{"action":"fail-open","at":"%s","detail":"%s","via":"build-shim"}\n' "$_fleet_at" "$1" >>"$_fleet_log"; } 2>/dev/null
}

# Whether $1 names a temp folder, by the spellings the guard calls temp.
_fleet_in_temp() {
  case $1 in
    /tmp|/tmp/*|/private/tmp|/private/tmp/*|/var/tmp/*|/private/var/tmp/*|/var/folders/*|/private/var/folders/*|/dev/shm/*) return 0 ;;
  esac
  if [ -n "${TMPDIR:-}" ]; then
    case $1 in "${TMPDIR%/}"|"${TMPDIR%/}"/*) return 0 ;; esac
  fi
  return 1
}

# Recursion guard:  a copy of this shim finding another copy runs nothing but the first real tool it can find.
case ${FLEET_BUILD_SHIM_DEPTH:-} in
  xxxxxxxx*) echo "$_fleet_tool: the fleet build shim is looping;  check PATH" >&2; exit 127 ;;
esac
FLEET_BUILD_SHIM_DEPTH=x${FLEET_BUILD_SHIM_DEPTH:-}
export FLEET_BUILD_SHIM_DEPTH

# The real tool is the next one on PATH that is not a shim.
_fleet_real=
_fleet_ifs=$IFS
IFS=:
set -f
for _fleet_d in $PATH; do
  _fleet_c=${_fleet_d:-.}/$_fleet_tool
  if [ -x "$_fleet_c" ] && [ ! -d "$_fleet_c" ] && [ ! "$_fleet_c" -ef "$0" ]; then
    case $_fleet_d in
      */lane-tools/shims|*/fleet_lanes/shims) continue ;;
    esac
    _fleet_real=$_fleet_c
    break
  fi
done
set +f
IFS=$_fleet_ifs
if [ -z "$_fleet_real" ]; then
  echo "$_fleet_tool: the fleet build shim found no real $_fleet_tool on PATH" >&2
  exit 127
fi

case ${FLEET_LANE_GUARD:-} in
  off|OFF|Off|0|false|FALSE|False|no|NO|No|disabled|DISABLED|Disabled) exec "$_fleet_real" "$@" ;;
esac

# The fast path:  nothing here names temp, so nothing can be judged.  An argument counts whole or after its `=`.
_fleet_slow=
if _fleet_in_temp "$PWD" || _fleet_in_temp "${CARGO_TARGET_DIR:-}"; then
  _fleet_slow=1
else
  for _fleet_a in "$@"; do
    if _fleet_in_temp "$_fleet_a" || _fleet_in_temp "${_fleet_a#*=}"; then
      _fleet_slow=1
      break
    fi
  done
fi
[ -n "$_fleet_slow" ] || exec "$_fleet_real" "$@"

_fleet_self=$0
while [ -h "$_fleet_self" ]; do
  _fleet_l=$(readlink "$_fleet_self") || break
  case $_fleet_l in
    /*) _fleet_self=$_fleet_l ;;
    *) _fleet_self=${_fleet_self%/*}/$_fleet_l ;;
  esac
done
_fleet_dir=${_fleet_self%/*}
_fleet_mod=
for _fleet_c in "$_fleet_dir/../fleet_lanes/build_shim.py" "$_fleet_dir/../build_shim.py"; do
  if [ -f "$_fleet_c" ]; then
    _fleet_mod=$_fleet_c
    break
  fi
done
_fleet_py=
for _fleet_c in "${FLEET_GIT_SHIM_PYTHON:-}" /usr/bin/python3 /usr/local/bin/python3 /opt/homebrew/bin/python3; do
  if [ -n "$_fleet_c" ] && [ -x "$_fleet_c" ]; then
    _fleet_py=$_fleet_c
    break
  fi
done
if [ -z "$_fleet_mod" ] || [ -z "$_fleet_py" ]; then
  _fleet_fail_open "no python or module"
  exec "$_fleet_real" "$@"
fi
# Python gets none of the caller's streams;  a deny reason comes back through a file.  Python keeps its own three second limit.
_fleet_note=$(/usr/bin/mktemp 2>/dev/null)
FLEET_BUILD_SHIM_DENY_NOTE=$_fleet_note "$_fleet_py" -I "$_fleet_mod" "$_fleet_tool" "$@" </dev/null >/dev/null 2>&1
_fleet_rc=$?
if [ $_fleet_rc -eq 77 ]; then
  if [ -s "$_fleet_note" ]; then
    /bin/cat "$_fleet_note" >&2
  else
    echo "error: Blocked by the fleet build guard, which could not say why;  see lane-guard-events.jsonl." >&2
  fi
  /bin/rm -f "$_fleet_note" 2>/dev/null
  exit 1
fi
/bin/rm -f "$_fleet_note" 2>/dev/null
[ $_fleet_rc -eq 0 ] || _fleet_fail_open "python exited $_fleet_rc"
exec "$_fleet_real" "$@"
