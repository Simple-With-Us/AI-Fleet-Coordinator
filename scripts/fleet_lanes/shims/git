#!/bin/sh
{ _fleet_shellopts=${SHELLOPTS-}; set +aemuvx; } 2>/dev/null
# That line comes first and hides itself.  /bin/sh can be bash, and bash takes these from an exported SHELLOPTS:  errexit would end this
# script at the first command that fails on purpose, before git starts, and xtrace or verbose would print this script on git's stderr.
#
# Fleet git shim: stops a misplaced fleet checkout before git creates it (AFC-618).  Installed by
# fleet_lanes.install_tools;  linked from a PATH folder as `git`.  Every process that finds git on PATH passes through
# here, so the rules are:  no Python unless the command can make a checkout, and any failure runs the real git.  A fetch only
# reaches Python when the temp rule could apply to it:  in a temp folder, or with --git-dir, --work-tree or GIT_DIR naming
# another repo.  A -C that names a temp folder counts too.  A -c never does, except before a word that may be an alias.
#
# Mode file ~/.config/fleet/lane-guard-mode:  off, detect (the default), or block with rule classes.
# Kill switch:  FLEET_LANE_GUARD=off.  Decisions live in fleet_lanes/git_shim.py.  This file is POSIX sh.

# git gets back the options it inherited, because a hook or a shell-script subcommand reads them.  Bash keeps an inherited SHELLOPTS
# exported and up to date, and running as sh adds `posix`, which that shell would otherwise hand to a #!/bin/bash hook.  With no
# options set the value is bash's default, and that is the usual case, so the shell can tell with no fork.  dash leaves it alone.
_fleet_keep=
if [ -n "${BASH_VERSION:-}" ] && [ "$_fleet_shellopts" != braceexpand:hashall:interactive-comments:posix ]; then
  _fleet_keep=$_fleet_shellopts
  case :$_fleet_keep: in
    *:posix:*) _fleet_keep=${_fleet_keep%%:posix*}${_fleet_keep#*:posix} ;;
  esac
  # allexport has already exported what bash sets as sh, and a child bash that inherits POSIXLY_CORRECT complains about it on stderr.
  case :$_fleet_keep: in
    *:allexport:*) unset POSIXLY_CORRECT _fleet_shellopts ;;
  esac
fi

_fleet_exec() {
  _fleet_x=$1
  shift
  if [ -n "$_fleet_keep" ] && [ -x /usr/bin/env ]; then
    exec /usr/bin/env "SHELLOPTS=$_fleet_keep" "$_fleet_x" "$@"
  fi
  exec "$_fleet_x" "$@"
}

# Leave a trace for the watcher.  Only ever called when something has already gone wrong, so `date` costs nothing that matters.
_fleet_fail_open() {
  _fleet_log=${FLEET_LANE_GUARD_STATE_DIR:-${HOME:-/tmp}/.local/state/fleet}/lane-guard-events.jsonl
  # A test run must not reach the real log (placement.writes_real_log_in_a_test), and this shell cannot be fooled by a HOME it was given.
  if [ -n "${FLEET_LANES_TEST_RUN:-}" ]; then
    _fleet_acct=$(/usr/bin/id -un 2>/dev/null) && eval "_fleet_acct=~$_fleet_acct"
    [ "$_fleet_log" = "$_fleet_acct/.local/state/fleet/lane-guard-events.jsonl" ] && return 0
  fi
  /bin/mkdir -p "${_fleet_log%/*}" 2>/dev/null
  _fleet_at=$(/bin/date -u +%Y-%m-%dT%H:%M:%S+00:00 2>/dev/null)
  { printf '{"action":"fail-open","at":"%s","detail":"%s","via":"shim"}\n' "$_fleet_at" "$1" >>"$_fleet_log"; } 2>/dev/null
}

# Whether $1 is in a temp folder, by the same spellings the guard calls temp.
_fleet_in_temp() {
  case $1 in
    /tmp/*|/private/tmp/*|/var/tmp/*|/private/var/tmp/*|/var/folders/*|/private/var/folders/*|/dev/shm/*) return 0 ;;
  esac
  case ${TMPDIR:-/nonexistent-tmpdir} in
    */) case $1 in "$TMPDIR"*) return 0 ;; esac ;;
    *) case $1 in "$TMPDIR"/*) return 0 ;; esac ;;
  esac
  return 1
}

# The value of alias.$1, as this command would see it.
_fleet_alias() {
  if [ -n "$_fleet_cset" ]; then
    "$_fleet_real" -C "$_fleet_cdir" config --get "alias.$1" 2>/dev/null
  else
    "$_fleet_real" config --get "alias.$1" 2>/dev/null
  fi
}

_fleet_cap_fallback() {
  for _fleet_c in /usr/bin/git /bin/git /opt/homebrew/bin/git /usr/local/bin/git; do
    if [ -x "$_fleet_c" ] && [ ! "$_fleet_c" -ef "$0" ]; then
      _fleet_exec "$_fleet_c" "$@"
    fi
  done
  echo "git: the fleet shim found no real git" >&2
  exit 127
}

# Recursion guard.  A shim copy finding another copy, or an alias calling git, passes here again.  At the cap, skip all
# checks and run a fixed git, so no chain of copies can loop.
_fleet_depth=${FLEET_GIT_SHIM_DEPTH:-}
case $_fleet_depth in
  xxxxxxxxxxxxxxxx*) _fleet_cap_fallback "$@" ;;
esac
FLEET_GIT_SHIM_DEPTH=x$_fleet_depth
export FLEET_GIT_SHIM_DEPTH

# The real git is the next one on this process's own PATH, every time.  An inherited answer is never trusted:  a wrapper after this
# shim strips itself from PATH and calls git, and git on an inherited path would send that call back to the wrapper.  The value is
# exported only for git_shim.py.
_fleet_real=
_fleet_ifs=$IFS
IFS=:
set -f
for _fleet_d in $PATH; do
  _fleet_c=${_fleet_d:-.}/git
  if [ -x "$_fleet_c" ] && [ ! -d "$_fleet_c" ] && [ ! "$_fleet_c" -ef "$0" ]; then
    case $_fleet_d in
      */lane-tools/shims|*/fleet_lanes/shims) continue ;;
    esac
    _fleet_real=$_fleet_c
    break
  fi
done
set +f
IFS=$_fleet_ifs
[ -n "$_fleet_real" ] || _fleet_cap_fallback "$@"
FLEET_GIT_SHIM_REAL=$_fleet_real
export FLEET_GIT_SHIM_REAL

case ${FLEET_LANE_GUARD:-} in
  off|OFF|Off|0|false|FALSE|False|no|NO|No|disabled|DISABLED|Disabled) _fleet_exec "$_fleet_real" "$@" ;;
esac

# The fast path.  Walk the global options to the subcommand, with no change to "$@".
_fleet_skip=
_fleet_opts=    # an option that can change what an alias means, so only Python can read one
_fleet_where=   # an option that moves the repo somewhere the shell cannot judge
_fleet_cset=    # one plain -C, which the shell can follow
_fleet_cdir=
_fleet_slow=
_fleet_word=
_fleet_sub=
for _fleet_a in "$@"; do
  if [ -n "$_fleet_skip" ]; then
    if [ "$_fleet_skip" = c ]; then
      case $_fleet_a in
        [Aa][Ll][Ii][Aa][Ss].*) _fleet_slow=1 ;;
      esac
    elif [ "$_fleet_skip" = C ]; then
      if [ -n "$_fleet_cset" ]; then
        _fleet_opts=1
        _fleet_where=1
      fi
      _fleet_cset=1
      _fleet_cdir=$_fleet_a
    fi
    _fleet_skip=
    continue
  fi
  case $_fleet_a in
    -c) _fleet_skip=c; _fleet_opts=1 ;;
    --config-env|--config-env=*) _fleet_slow=1; [ "$_fleet_a" = --config-env ] && _fleet_skip=o ;;
    -C) _fleet_skip=C ;;
    --git-dir|--work-tree) _fleet_skip=o; _fleet_opts=1; _fleet_where=1 ;;
    --namespace|--super-prefix|--exec-path|--attr-source|--shallow-file) _fleet_skip=o; _fleet_opts=1 ;;
    -*) case $_fleet_a in --git-dir=*|--work-tree=*) _fleet_opts=1; _fleet_where=1 ;; esac ;;
    *)
      case $_fleet_word in
        worktree|remote)
          _fleet_sub=$_fleet_a
          break
          ;;
      esac
      _fleet_word=$_fleet_a
      case $_fleet_a in
        worktree|remote) ;;
        *) break ;;
      esac
      ;;
  esac
done

if [ -z "$_fleet_slow" ]; then
  case $_fleet_word in
    clone|archive|checkout-index) _fleet_slow=1 ;;
    fetch|pull|remote)
      # The guard's init-and-fetch rule, which only ever fires in temp.  Anywhere else this stays out of Python.  Of the remote
      # verbs only `add` can fetch, and polling `git -C path remote -v` is common.
      if [ "$_fleet_word" = remote ] && [ "$_fleet_sub" != add ]; then
        _fleet_exec "$_fleet_real" "$@"
      fi
      if [ -n "$_fleet_where" ] || [ -n "${GIT_DIR:-}" ]; then
        _fleet_slow=1
      else
        _fleet_at=$PWD
        if [ -n "$_fleet_cset" ]; then
          case $_fleet_cdir in
            /*) _fleet_at=$_fleet_cdir ;;
            *) _fleet_at=$PWD/$_fleet_cdir ;;
          esac
        fi
        case /$_fleet_at/ in
          */../*) _fleet_slow=1 ;;  # the guard folds these, and the shell does not
          *) if _fleet_in_temp "$_fleet_at/"; then _fleet_slow=1; fi ;;
        esac
      fi
      [ -n "$_fleet_slow" ] || _fleet_exec "$_fleet_real" "$@"
      ;;
    worktree)
      # Only add and move choose a destination, and `worktree list` is common enough to stay out of Python.
      case $_fleet_sub in
        list|prune|remove|lock|unlock|repair) _fleet_exec "$_fleet_real" "$@" ;;
        *) _fleet_slow=1 ;;
      esac
      ;;
    '') _fleet_exec "$_fleet_real" "$@" ;;
    # A builtin cannot be aliased, so these never make a checkout.  Only real builtins belong here:  an alias wins over an external
    # command, so `ls`, `gui`, `lfs`, `submodule` and the like go through the alias walk below.
    status|diff|log|add|commit|push|rev-parse|config|ls-files|show|branch|checkout|switch|merge|rebase|\
    reset|restore|stash|tag|init|rm|mv|cat-file|for-each-ref|show-ref|symbolic-ref|rev-list|merge-base|blame|\
    grep|gc|apply|cherry-pick|revert|am|describe|shortlog|ls-remote|ls-tree|diff-tree|diff-index|diff-files|\
    update-index|update-ref|hash-object|read-tree|write-tree|commit-tree|check-ignore|check-attr|check-ref-format|\
    name-rev|clean|sparse-checkout|version|help|count-objects|verify-pack|pack-objects|index-pack|\
    unpack-objects|upload-pack|receive-pack|fsck|prune|repack|bisect|format-patch|var|mktree|\
    difftool|notes|reflog|cherry|credential|maintenance|range-diff|rerere|\
    fast-import|fast-export|bundle|pack-refs|interpret-trailers|merge-file|merge-tree|\
    annotate|multi-pack-index|commit-graph|get-tar-commit-id|stripspace|column|mailinfo|\
    send-pack|fetch-pack|verify-commit|verify-tag|show-branch|replace)
      _fleet_exec "$_fleet_real" "$@" ;;
    *)
      # Perhaps an alias.  A plain -C is followed here like any other folder.  A -c can change the answer through an include, and
      # --git-dir needs the same spelling git gives it, so Python asks.  Python starts only for a chain that names a checkout command.
      if [ -n "$_fleet_opts" ]; then
        _fleet_slow=1
      else
        _fleet_w=$_fleet_word
        _fleet_end=
        for _fleet_n in 1 2 3 4 5 6 7 8; do
          _fleet_v=$(_fleet_alias "$_fleet_w")
          _fleet_rc=$?
          if [ $_fleet_rc -eq 1 ]; then
            _fleet_end=1  # git says there is no such alias
            break
          elif [ $_fleet_rc -ne 0 ]; then
            _fleet_slow=1  # git could not read its config, so Python and then git itself report that
            break
          fi
          case $_fleet_v in
            *clone*|*worktree*|*archive*|*checkout-index*) _fleet_slow=1; break ;;
            '!'*git*) _fleet_slow=1; break ;;
            '!'*) _fleet_end=1; break ;;
          esac
          # Only a plain first word can be followed here.  An option, a quote, a tab or anything else unusual goes to Python, whose
          # parser reads it as git does.
          _fleet_w=${_fleet_v%% *}
          case $_fleet_w in
            ''|-*|*[!A-Za-z0-9._-]*) _fleet_slow=1; break ;;
          esac
        done
        # A chain longer than this walk goes to Python, never through.
        [ -n "$_fleet_end" ] || _fleet_slow=1
        [ -n "$_fleet_slow" ] || _fleet_exec "$_fleet_real" "$@"
      fi
      ;;
  esac
fi

# The slow path.  Only exit 77 blocks; a missing Python, a crash or anything else runs the real git.
_fleet_self=$0
while [ -h "$_fleet_self" ]; do
  _fleet_l=$(readlink "$_fleet_self") || break
  case $_fleet_l in
    /*) _fleet_self=$_fleet_l ;;
    *) _fleet_self=${_fleet_self%/*}/$_fleet_l ;;
  esac
done
_fleet_dir=${_fleet_self%/*}
_fleet_mod=
for _fleet_c in "$_fleet_dir/../fleet_lanes/git_shim.py" "$_fleet_dir/../git_shim.py"; do
  if [ -f "$_fleet_c" ]; then
    _fleet_mod=$_fleet_c
    break
  fi
done
_fleet_py=
for _fleet_c in "${FLEET_GIT_SHIM_PYTHON:-}" /usr/bin/python3 /usr/local/bin/python3 /opt/homebrew/bin/python3; do
  if [ -n "$_fleet_c" ] && [ -x "$_fleet_c" ]; then
    _fleet_py=$_fleet_c
    break
  fi
done
if [ -z "$_fleet_mod" ] || [ -z "$_fleet_py" ]; then
  _fleet_fail_open "no python or module"
  _fleet_exec "$_fleet_real" "$@"
fi
# Python keeps its own three second limit, but only once main() runs.  This one covers an interpreter that stalls before that.  It
# runs in the background because POSIX sh has no timeout, with its own file descriptors so nothing can hold a caller's pipe open.
# A sleep that could not run answers non-zero and kills nothing.  Callers parse git's output, and a broken interpreter talks (a loader
# error, a traceback), so Python gets none of the caller's streams.  A deny reason comes back through a file, and is printed here.
_fleet_note=$(/usr/bin/mktemp 2>/dev/null)
FLEET_GIT_SHIM_DENY_NOTE=$_fleet_note "$_fleet_py" -I "$_fleet_mod" "$@" </dev/null >/dev/null 2>&1 &
_fleet_pid=$!
(
  exec </dev/null >/dev/null 2>&1
  /bin/sleep 4 &
  _fleet_timer=$!
  trap 'kill "$_fleet_timer"; exit 0' TERM
  if wait "$_fleet_timer"; then
    kill -9 "$_fleet_pid"
  fi
) &
_fleet_watch=$!
wait "$_fleet_pid" 2>/dev/null
_fleet_rc=$?
kill "$_fleet_watch" 2>/dev/null
if [ $_fleet_rc -eq 77 ]; then
  if [ -s "$_fleet_note" ]; then
    /bin/cat "$_fleet_note" >&2
  else
    echo "fatal: Blocked by the fleet lane guard, which could not say why;  see lane-guard-events.jsonl." >&2
  fi
  /bin/rm -f "$_fleet_note" 2>/dev/null
  exit 128
fi
/bin/rm -f "$_fleet_note" 2>/dev/null
# main() exits 0 even when it crashes, so anything else means it never ran, and with no stderr only this says so.
if [ $_fleet_rc -gt 128 ]; then
  _fleet_fail_open "no answer from python"
elif [ $_fleet_rc -ne 0 ]; then
  _fleet_fail_open "python exited $_fleet_rc"
fi
_fleet_exec "$_fleet_real" "$@"
