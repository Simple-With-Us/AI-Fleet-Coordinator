[Unit]
Description=Move the fleet CLI tools to AI-Fleet-Coordinator origin/main (fleet-cli-git-update.py)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jay
Group=jay
Environment=HOME=/home/jay
ExecStart=/usr/bin/python3 -I /home/jay/.local/share/fleet-cli/repo/scripts/fleet-cli-git-update.py update --home /home/jay
TimeoutStartSec=600
