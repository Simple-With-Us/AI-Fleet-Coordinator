# Copy to /etc/fleet/rag-collection-health.env and keep mode 0600.
# The job stays off while FLEET_RAG_COLLECTION_HEALTH is anything other than 1.
# This file holds paths.  It never holds a token value.
# A drop-in must set User= and Group= to the account named by HOME.
# FLEET_CODE_ROOT and FLEET_APPS_ROOT come from /etc/fleet/lanes.conf.
FLEET_RAG_COLLECTION_HEALTH=0
HOME=/home/jay
FLEET_RAG_CHECKOUT=/home/jay/apps/AI-Fleet-Coordinator
# Use the existing authorized own recall bootstrap binding; no path is discovered.
# If that binding uses a protected current store, explicitly name it before enabling.
# FLEET_RECALL_INFISICAL_TOKEN_FILE=
# Optional.  Default is $HOME/apps/fleet-rag/state/ingest-state.json
# FLEET_RAG_INGEST_STATE=/home/jay/apps/fleet-rag/state/ingest-state.json
# Optional.  Default is $HOME/.local/state/fleet-rag-collection-health
# FLEET_RAG_COLLECTION_HEALTH_DIR=/home/jay/.local/state/fleet-rag-collection-health
