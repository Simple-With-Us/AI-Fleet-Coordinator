# A user unit for the login whose home carries the VM's harness folders and
# checkouts, because the report reads them from its own HOME.
# As that user:  copy it and fleet-vm-status.timer to ~/.config/systemd/user/, run
# `loginctl enable-linger <that user>`, then
# `systemctl --user daemon-reload && systemctl --user enable --now fleet-vm-status.timer`.
# Linger is required:  without it the user manager, and this timer, stop when the user's
# last session closes, and the report ages past Muster's 45-minute window.
# The report lands in ~/.local/state/fleet-tools/vm-status.json (0600).  The host label,
# the seats and the code root come from FLEET_VM_HOST_LABEL, FLEET_VM_SEATS and
# FLEET_VM_CODE_ROOT in the optional environment file;  extra arguments go in
# FLEET_VM_STATUS_ARGS.
[Unit]
Description=Write the fleet VM status report (fleet-vm-status.py)

[Service]
Type=oneshot
EnvironmentFile=-%h/.config/fleet-tools/vm-status.env
ExecStart=/usr/bin/python3 -I %h/.local/share/fleet-cli/repo/scripts/fleet-vm-status.py $FLEET_VM_STATUS_ARGS
TimeoutStartSec=300
Nice=10
