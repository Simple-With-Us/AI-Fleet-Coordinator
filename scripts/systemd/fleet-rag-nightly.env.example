# Copy to /etc/fleet/rag-nightly.env and keep mode 0600.
# The job stays off while FLEET_RAG_NIGHTLY is anything other than 1.
# This file holds paths.  It never holds a token value.
# A drop-in must set User= and Group= to the account named by HOME.
# FLEET_CODE_ROOT and FLEET_APPS_ROOT come from /etc/fleet/lanes.conf.
FLEET_RAG_NIGHTLY=0
HOME=/home/jay
FLEET_RAG_CHECKOUT=/home/jay/apps/AI-Fleet-Coordinator
# Live mirror directory (the parent is what the Mac push calls remote_root).
FLEET_RAG_MIRROR=/home/jay/fleet-rag-mirror/current
# The file already on the server (AFC-677).  It holds FLEET_RECALL_INFISICAL_TOKEN=...
FLEET_RECALL_INFISICAL_TOKEN_FILE=/home/jay/.secrets/fleet-recall-infisical.env
FLEET_RAG_LINEAR_INFISICAL_TOKEN_FILE=/home/jay/.config/fleet-rag/linear.token
# The Linear token is for AI Fleet Coordinator prod /linear.  Set its project id here, or leave it
# to ~/.simple-tools/ai-fleet-coordinator-project-id.  The id is not committed.
# FLEET_RAG_LINEAR_INFISICAL_PROJECT=
# Optional alert bot.  Leave these commented until the token file and project id exist.
# FLEET_RAG_ZULIP_INFISICAL_TOKEN_FILE=/home/jay/.config/fleet-rag/zulip.token
# FLEET_RAG_ZULIP_INFISICAL_PROJECT=
# FLEET_RAG_ZULIP_INFISICAL_PATH=/fleet-rag-nightly
