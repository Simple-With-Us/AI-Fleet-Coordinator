# Template.  The roots come from the host's environment file, which sets FLEET_CODE_ROOT, FLEET_APPS_ROOT and
# FLEET_LANES_ROOT.  See scripts/fleet_lanes/README.md, "Placement watcher".  The volume path is private inventory, so it
# stays in that file and never in this repository.
[Unit]
Description=Report misplaced fleet checkouts.  Never moves or deletes.
After=network-online.target

[Service]
Type=oneshot
User=jay
Group=jay
EnvironmentFile=/etc/fleet/lanes.conf
# Sets SIMPLE_BOARD_BEARER_FILE (the absolute path of the seat's private bearer file), FLEET_APPS_JSON,
# SIMPLE_BOARD_TOOLS_TOKEN_FILE with SIMPLE_BOARD_TOOLS_PROJECT_ID (the bearer verify key's scoped token
# and its Fleet-OPS project), and LINEAR_BOARD_INFISICAL_READ_TOKEN_FILE with
# LINEAR_BOARD_INFISICAL_PROJECT_ID (the Linear credential folder read).  The board refuses to write
# without them:  no verify token is exit 6, no Linear pair is exit 4, and the watcher then files
# nothing and says so in its status file.
EnvironmentFile=/etc/fleet/placement-watch.conf
Environment=HOME=/home/jay
Environment=AGENT_SEAT=CLAUDE
Environment=LINEAR_BOARD_WRITES=1
Environment=PATH=/home/jay/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -I ${FLEET_APPS_ROOT}/lane-tools/fleet_lanes/placement_watch.py --apply --verify-hooks --seat CLAUDE
Nice=10
