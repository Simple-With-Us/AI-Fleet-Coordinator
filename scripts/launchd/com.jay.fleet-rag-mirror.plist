<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jay.fleet-rag-mirror</string>
  <!-- Template.  mirror_install.py fills the placeholders and writes the
       LaunchAgent.  The committed file is not a loaded job.
       01:30 on the Mac's own clock, which is Central, so the trees land before
       the server ingest at 02:30.  A missed calendar run happens once at wake.
       RunAtLoad is false: bootstrapping must not push by itself.  The push
       also no-ops while the config says enabled false. -->
  <key>ProgramArguments</key>
  <array>
    <string>@PYTHON@</string>
    <string>-I</string>
    <string>@MIRROR@</string>
    <string>push</string>
    <string>--config</string>
    <string>@CONFIG@</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>1</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Standard</string>
  <key>Nice</key>
  <integer>5</integer>
  <key>LowPriorityIO</key>
  <true/>
  <key>StandardOutPath</key>
  <string>@LOG@</string>
  <key>StandardErrorPath</key>
  <string>@LOG@</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>@HOME@</string>
    <key>PATH</key>
    <string>@HOME@/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
