<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jay.grok-idle-unload</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/jay/apps/grok-acp-runtime/grok-idle-unload.py</string>
  </array>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/jay/Library/Logs/grok-idle-unload.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jay/Library/Logs/grok-idle-unload.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/jay/.local/bin</string>
    <!-- Thresholds live in grok-idle-unload.py (4h chats, 30 minute zero-turn
         stubs).  Do not pin GROK_IDLE_UNLOAD_HOURS here: a pinned 12 kept the
         old threshold alive after the code default dropped.  launchctl kickstart
         does not re-read this file; bootout and bootstrap to apply a change. -->
  </dict>
</dict>
</plist>
