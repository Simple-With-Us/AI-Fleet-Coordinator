<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jay.grok-idle-unload</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/jay/apps/grok-acp-runtime/grok-idle-unload.py</string>
  </array>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <true/>
  <!-- Not ProcessType Background and not LowPriorityIO: the background scheduling
       class starved this job when the Mac was most in need of it.  At load average
       ~300 a four second dry run took over 100 seconds under `taskpolicy -b`, and a
       launchd run sat for nine minutes without finishing.  The job is small and
       runs once an hour; it exists to free memory, so it must not wait behind it. -->
  <key>ProcessType</key>
  <string>Standard</string>
  <key>StandardOutPath</key>
  <string>/Users/jay/Library/Logs/grok-idle-unload.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jay/Library/Logs/grok-idle-unload.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/jay/.local/bin</string>
    <!-- Thresholds live in grok-idle-unload.py (4h chats, 30 minute zero-turn
         stubs).  Do not pin GROK_IDLE_UNLOAD_HOURS here: a pinned 12 kept the
         old threshold alive after the code default dropped.  launchctl kickstart
         does not re-read this file; bootout and bootstrap to apply a change. -->
  </dict>
</dict>
</plist>
