<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jay.botfleet-server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/jay/apps/botfleet-server-start.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/jay/apps/botfleet-server</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>/Users/jay/Library/Logs/botfleet/server.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jay/Library/Logs/botfleet/server.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>BOTFLEET_FLEET_SEAT_PROMPTS</key>
    <string>1</string>
    <key>HOME</key>
    <string>/Users/jay</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/jay/.grok/bin:/Users/jay/.local/bin</string>
  </dict>
</dict>
</plist>
