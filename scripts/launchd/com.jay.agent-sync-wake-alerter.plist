<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.jay.agent-sync-wake-alerter:  every 60 seconds, poll the HOSTED agent-sync
  listener's signed read API for new wake events and pop one macOS banner per
  event (adapters.osascript_argv; bodies never reach a banner).  This is the
  thin Mac client for the listener-on-Hetzner cutover:  it holds no Zulip key,
  no Infisical access and no listener state.

  Secrets stay out of this plist:  the wrapper sources
  ~/.secrets/agent-sync/wake-alerter.env (mode 0600) which must define
  AGENT_SYNC_SEAT, AGENT_SYNC_LISTENER_URL and <CODE>_ROUTINE_KEY.
  Install:  cp this file to ~/Library/LaunchAgents/ and
            launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.jay.agent-sync-wake-alerter.plist
  Stop:     launchctl bootout gui/$(id -u)/com.jay.agent-sync-wake-alerter
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jay.agent-sync-wake-alerter</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>. "$HOME/.secrets/agent-sync/wake-alerter.env" &amp;&amp; exec /usr/bin/python3 -I -m agent_sync.wake_alerter</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/jay/apps/lanes/_managed/fleet/agent-sync-runtime/scripts</string>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>/Users/jay/.local/state/agent-sync/wake-alerter.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jay/.local/state/agent-sync/wake-alerter.log</string>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
