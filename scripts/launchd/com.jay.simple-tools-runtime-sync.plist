<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/jay</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>Label</key>
	<string>com.jay.simple-tools-runtime-sync</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/jay/apps/simple-tools-runtime-sync.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/jay/apps/logs/agent-sync-runtime-sync.launchd.err.log</string>
	<key>StandardOutPath</key>
	<string>/Users/jay/apps/logs/agent-sync-runtime-sync.launchd.out.log</string>
	<key>StartInterval</key>
	<integer>120</integer>
</dict>
</plist>
