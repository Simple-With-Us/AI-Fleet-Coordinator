<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jay.mac-facts-publish</string>
  <!-- Publishes the Mac's open-loops facts (open-loops unit F7, Linear AFC-285).  Scheduled, not always-on:  idle
       between runs is correct, and mac-process-watch.sh only keeps it loaded.  Each run gathers the lane doctor
       report, the C1 status, the backup health and the needs-owner list, signs them (HMAC-SHA256, the key
       FLEET_FACTS_SIGNING_KEY comes from Infisical through K1 and is never cached) and writes
       gb/mac-facts.json (no paths, quotes cut to 80 characters) and gb/full-list.md (and, only when the Infisical knob
       FLEET_FACTS_PUBLISH_FULL_COPY is on, the path-bearing mac-facts.json) to the PRIVATE repository
       Simple-With-Us/fleet-loops-data through sha-aware `gh api` PUTs (no clone, never forced).  Before any write the
       run refuses unless the repository is private with no webhook, no deploy key and no app that can read it.
       A missing key, a failed gate or a secret-shaped string means nothing is published.
       It runs the dedicated launcher that scripts/fleet_facts/install.sh (apply mode) puts at
       ~/apps/fleet-facts/mac-facts-publish, so a Removable Volumes grant (live step L15) can be scoped to that one
       file.  macOS judges the image that actually runs, and the launcher hands over to python with exec, so check
       what launchd itself can read (not Terminal) after the grant.
       Python 3.11 or newer is required, so the launcher names Homebrew's python3 and not Apple's 3.9.
       Load it with:  launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.jay.mac-facts-publish.plist -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/jay/apps/fleet-facts/mac-facts-publish</string>
  </array>
  <!-- 12:30, 3:30, 6:30 and 9:30, am and pm (the Mac's own clock, Central).  A calendar job that was missed while the
       Mac slept runs once when it wakes.  Not RunAtLoad:  bootstrapping must not publish anything by itself.  A second
       copy cannot overlap (the run holds a lock and exits), a run ends itself at 20 minutes, and it skips itself when
       load1 is over 250 (the files already published stay, and the status file marks them stale). -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>0</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <!-- Standard, not Background:  the background class starves jobs on this Mac under load (see
       com.jay.grok-idle-unload).  Nice and LowPriorityIO yield to interactive work without the starvation. -->
  <key>ProcessType</key>
  <string>Standard</string>
  <key>Nice</key>
  <integer>5</integer>
  <key>LowPriorityIO</key>
  <true/>
  <!-- The log holds ids, counts and reason words only:  never fact text and never the key.  One start line and one result
       line per run, plus a line per file;  nothing is rotated, so a year is a few megabytes. -->
  <key>StandardOutPath</key>
  <string>/Users/jay/Library/Logs/mac-facts-publish.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jay/Library/Logs/mac-facts-publish.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- The tools it runs (gh, infisical, open-loops, board, simple-chat, lane) live in ~/.local/bin and /opt/homebrew/bin. -->
    <key>PATH</key>
    <string>/Users/jay/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/jay</string>
    <!-- The seat the full list's Zulip reads run as (open-loops gather reads claimants' topic posts through simple-chat).
         Only CLAUDE runs this job, and AGENT_LAUNCHER is deliberately not set. -->
    <key>AGENT_SEAT</key>
    <string>CLAUDE</string>
  </dict>
</dict>
</plist>
