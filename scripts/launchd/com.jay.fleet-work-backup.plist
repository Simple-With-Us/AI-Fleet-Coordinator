<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jay.fleet-work-backup</string>
  <!-- Backs up the fleet work GitHub does not hold (unpushed commits, stashes, uncommitted work,
       and non-git files under ~/apps) to restic on Backblaze B2.  Scheduled, not always-on.
       Two things to know before loading it:
       1. Privacy (TCC).  A LaunchAgent cannot read /Volumes/External (removable-volume privacy), and
          the lanes are symlinks onto that disk.  Grant the interpreter below Removable Volumes (or
          Full Disk Access) in System Settings > Privacy and Security, or the run is partial and logs
          warn=removable-volumes-denied with the executable to grant.  What macOS checks is the
          running image, not the launcher:  Apple's python3 runs
          .../Python3.framework/Versions/3.9/Resources/Python.app/Contents/MacOS/Python, Homebrew's
          python3.14 runs .../Python.framework/Versions/3.14/Resources/Python.app/Contents/MacOS/Python.
          Run 'python3 fleet_work_backup.py image' to print it.  Apple's interpreter is the default
          because it is Apple-signed, so a grant survives updates;  Homebrew's is ad-hoc signed and
          loses the grant on every brew upgrade.  (install.py with its interpreter option set to
          /opt/homebrew/bin/python3 switches it.)  Check what a launchd job itself can read, not Terminal,
          with the launchd flag of:  python3 fleet_work_backup.py check-access
       2. The script is standard library only and runs on Python 3.9 and later. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/jay/apps/fleet-work-backup/fleet_work_backup.py</string>
    <string>run</string>
  </array>
  <!-- Every 3 hours.  Not RunAtLoad:  bootstrapping must not start a backup by itself.  A second
       copy cannot overlap (the script holds a lock and exits), and a run skips itself when load1
       is over 60 or memory pressure is critical (or swap is full while pressure is at warning). -->
  <key>StartInterval</key>
  <integer>10800</integer>
  <key>RunAtLoad</key>
  <false/>
  <!-- Standard, not Background:  the background class starves jobs on this Mac under load (see
       com.jay.grok-idle-unload and com.jay.sim-idle-reaper).  Nice and LowPriorityIO are the mild
       knobs:  they yield the CPU and the disk to interactive work without the starvation. -->
  <key>ProcessType</key>
  <string>Standard</string>
  <key>Nice</key>
  <integer>5</integer>
  <key>LowPriorityIO</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/jay/Library/Logs/fleet-work-backup.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jay/Library/Logs/fleet-work-backup.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/jay</string>
    <!-- Missed-backup alert (after 8 runs in a row with no complete snapshot, then at most once a day).
         The owner ruled that he gets a DM and that the two Plumber seats are told to investigate and fix
         it without asking him (Jay, Oct 10, 2026).  ALERT_TO puts an @-mention of BF-Plumber and
         GB-Plumber on the topic post, ALERT_DM_OWNER also sends the same alert to Jay as a Zulip DM from
         the CLAUDE bot, and ALERT_NOTE is the standing instruction appended to the topic post (not the
         DM).  The all-clear message DMs Jay and posts to the topic without a mention.  BotFleet caps
         peer wakes, so the DM is the delivery that always arrives. -->
    <key>FLEET_WORK_BACKUP_ALERT_TO</key>
    <string>BF-PLUMBER,GB-PLUMBER</string>
    <key>FLEET_WORK_BACKUP_ALERT_DM_OWNER</key>
    <string>1</string>
    <key>FLEET_WORK_BACKUP_ALERT_NOTE</key>
    <string>Owner standing instruction (Jay, Oct 10, 2026):  BF-Plumber and GB-Plumber, please investigate and fix this backup without asking him.  Both of you are alerted:  the first to reply "taking it" in this topic owns the fix, and the other reviews it.</string>
    <!-- Keep two runtime session stores in the backup:  the Grok ACP session history
         (grok-acp-runtime/acp-home/sessions) and the mined fleet-rag chat logs (fleet-rag/mined/chat).
         NO_DEFAULT_PATH_SKIPS turns off all three built-in path skips, and EXTRA_SKIP_DIRS puts the
         third, acp-home/memtrace, back by directory name (it is the only directory called memtrace
         under ~/apps and ~/Code).  Every file still goes through the name filter and the secret gate,
         files over 200 MB stay skipped, and *.log files and directories named logs stay skipped. -->
    <key>FLEET_WORK_BACKUP_NO_DEFAULT_PATH_SKIPS</key>
    <string>1</string>
    <key>FLEET_WORK_BACKUP_EXTRA_SKIP_DIRS</key>
    <string>memtrace</string>
  </dict>
</dict>
</plist>
