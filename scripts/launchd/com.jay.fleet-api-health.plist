<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.jay.fleet-api-health (Muster, AFC-398):  every 15 minutes, write the Socratic Trade
  and Congress.Trade operational health that Muster reads,
  ~/.local/state/fleet-tools/api-health.json (0600, atomic).  It runs the managed runtime's
  copy of fleet-api-health.py, so it moves with main, under /usr/bin/python3 -I
  (Python 3.9 on macOS).  The collector is read only:  it GETs the two apps' own health
  routes (the only two URLs it may fetch), holds no credential, and changes nothing else.
  A failed fetch still writes the file, with the app's state "unknown" and a fixed error
  code, and exits 1.
  Install:  cp this file to ~/Library/LaunchAgents/ and
            launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.jay.fleet-api-health.plist
  Stop:     launchctl bootout gui/$(id -u)/com.jay.fleet-api-health
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jay.fleet-api-health</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-I</string>
    <string>/Users/jay/apps/lanes/_managed/fleet/simple-tools-runtime/scripts/fleet-api-health.py</string>
    <string>--write</string>
    <string>/Users/jay/.local/state/fleet-tools/api-health.json</string>
  </array>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/jay/apps/logs/fleet-api-health.launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jay/apps/logs/fleet-api-health.launchd.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/jay/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>/Users/jay</string>
  </dict>
</dict>
</plist>
