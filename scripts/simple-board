#!/usr/bin/env python3
"""simple-board: the fleet work board CLI, backed by Linear.

The implementation is scripts/linear-board/board.  This entry point runs it under the name it is
installed as, so every help line, usage error and catalog reference says `simple-board`.

This part must stay valid Python 3.9."""
import os
import sys

if sys.version_info < (3, 11):
    for candidate in ("/opt/homebrew/bin/python3", "/usr/local/bin/python3"):
        if os.access(candidate, os.X_OK) and os.path.realpath(candidate) != os.path.realpath(sys.executable):
            os.execv(candidate, [candidate, os.path.realpath(__file__)] + sys.argv[1:])
    sys.stderr.write("simple-board: Python 3.11 or newer is required (found %d.%d)\n" % sys.version_info[:2])
    sys.exit(1)

# argv[0] decides every prog string the board prints, so hand it the name we were invoked as.
BOARD = os.path.join(os.path.dirname(os.path.realpath(__file__)), "linear-board", "board")
if not os.path.isfile(BOARD):
    sys.stderr.write("simple-board: %s is missing\n" % BOARD)
    sys.exit(1)

# --- seat remote defaults (host helper, optional) ---
_SEAT_HELPER_ANCHOR = "/"


def _seat_defaults(command):
    """Run the host's seat helper when the host has installed one.  The helper picks the declared seat's own
    hosted route and holds no credential.  ABSENT (a missing path component or file) is the optional case:  do
    nothing, the tool behaves as before, whatever the parent modes.  PRESENT but not trustworthy, or failing for any reason other than its
    own SystemExit, is a refusal (exit 3):  a broken or swapped helper never degrades to an un-routed run.
    Trust is checked on file descriptors:  the directory chain is walked from the anchor with no symlink
    followed (each directory owned by root or this user and closed to group/other write), the file is opened
    O_NOFOLLOW|O_NONBLOCK from its parent fd, must be a regular single-link file owned by this user and closed
    to group/other write, and the code that runs is exactly the bytes read from that open descriptor."""
    import errno
    import pwd
    import stat

    uid = os.getuid()
    try:
        folder = os.path.join(pwd.getpwuid(uid).pw_dir, ".config", "fleet-cli")
    except KeyError:
        return
    anchor = os.path.normpath(_SEAT_HELPER_ANCHOR)
    folder = os.path.normpath(folder)
    prefix = anchor if anchor.endswith("/") else anchor + "/"
    if folder != anchor and not folder.startswith(prefix):
        return
    parts = [p for p in folder[len(anchor):].split("/") if p]
    name = "seat-remote-defaults.py"
    fds = []
    code = None
    try:
        try:
            flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
            current = os.open(anchor, flags)
            fds.append(current)
            chain = [current]
            for part in parts:
                current = os.open(part, flags, dir_fd=current)
                fds.append(current)
                chain.append(current)
            fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK, dir_fd=current)
            fds.append(fd)
        except OSError as exc:
            if exc.errno == errno.ENOENT:
                return
            raise
        # The helper is PRESENT:  only now do the parent directories and the file have to be trustworthy.
        for directory in chain:
            info = os.fstat(directory)
            if info.st_uid not in (0, uid) or info.st_mode & 0o022:
                raise PermissionError
        info = os.fstat(fd)
        if (
            not stat.S_ISREG(info.st_mode)
            or info.st_uid != uid
            or info.st_mode & 0o022
            or info.st_nlink != 1
            or not 0 < info.st_size <= 262144
        ):
            raise PermissionError
        data = b""
        while len(data) <= 262144:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            data += chunk
        if len(data) != info.st_size:
            raise PermissionError
        path = os.path.join(folder, name)
        code = compile(data, path, "exec")
    except Exception:
        sys.stderr.write("fleet-cli: the seat helper could not be trusted\n")
        raise SystemExit(3) from None
    finally:
        for fd in fds:
            try:
                os.close(fd)
            except OSError:
                pass
    try:
        exec(code, {"__name__": "__seat_helper__", "__file__": path, "fleet_command": command})
    except SystemExit:
        raise
    except Exception:
        sys.stderr.write("fleet-cli: the seat helper failed\n")
        raise SystemExit(3) from None


# --- end seat remote defaults ---

_seat_defaults("simple-board")
sys.argv[0] = os.path.abspath(__file__)
with open(BOARD, "rb") as handle:
    code = compile(handle.read(), BOARD, "exec")
exec(code, {"__name__": "__main__", "__file__": BOARD})