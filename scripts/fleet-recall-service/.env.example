# fleet-recall-service local dev template.  Copy to .env and fill in secrets.
# Never commit real values.  The real source of truth is Infisical
# (see INFISICAL.md at the repo root); these env entries are the local-dev
# fallback used when no Infisical machine identity is configured.
QDRANT_URL=http://100.69.77.26:6333
QDRANT_API_KEY=
QDRANT_FLEET_COLLECTION=fleet-agents
TEI_URL=http://100.69.77.26:8081
TEI_API_KEY=
QDRANT_READONLY_API_KEY=
TEI_EMBED_MODEL=BAAI/bge-m3
RECALL_API_TOKEN=
RECALL_ADMIN_TOKEN=
RECALL_SOCKET_TIMEOUT=15
SETTINGS_REFRESH_SECONDS=300
HOST=127.0.0.1
PORT=8080
INFISICAL_ENVIRONMENT=prod
