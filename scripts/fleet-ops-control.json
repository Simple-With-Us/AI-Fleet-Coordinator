    "resourcePolicy": true,
    "units": [
      {"unit": "fleet-server-status.timer", "scope": "user", "actions": ["start", "stop", "restart"], "role": "reporting", "stopConsequence": "Stopping this stops the server's report, so Muster goes out of date within 45 minutes and every Redeploy is refused."},
      {"unit": "fleet-cli-git-update.timer", "scope": "system", "actions": ["start", "stop", "restart"], "role": "updater", "stopConsequence": "Stopping this ends the hourly safety net that keeps the fleet tools on the server current."}
