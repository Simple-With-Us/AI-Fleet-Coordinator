#!/usr/bin/env bash
# recall-tunnel -- open, check, and close an SSH tunnel that forwards this Mac's Tailscale-only
# Qdrant (6333), TEI embed (8081), and TEI rerank (8082) ports over SSH to the Hetzner box, for
# when Tailscale itself is down on this Mac (logged out, a captive/corporate network, whatever)
# but SSH to the box still works.  This is the operator override
# fleet_rag/public_fallback.py's local_override_active() / require_direct_path() look for: once
# QDRANT_URL and TEI_URL point at the tunnel, `recall` tries the direct path first regardless of
# what `tailscale status` says.  See docs/RAG-FLEET-INFRA.md "Operational notes".
#
# Usage:
#   recall-tunnel up      open the tunnel (idempotent), health-check each forwarded port, and
#                         start the background supervisor (RECALL_TUNNEL_SUPERVISE=0 to skip it)
#   recall-tunnel status  ssh -O check: is the control master still alive, plus the supervisor
#   recall-tunnel down    stop the supervisor, then ssh -O exit: close the tunnel
#   recall-tunnel env     print export lines for QDRANT_URL / TEI_URL / TEI_RERANK_URL /
#                         RECALL_HTTP_RETRIES / RECALL_HTTP_BACKOFF_MAX -- nothing else on
#                         stdout, so `eval "$(recall-tunnel env)"` is safe
#
# The tunnel forwards:
#   127.0.0.1:16333 -> 100.69.77.26:6333   (Qdrant)
#   127.0.0.1:18081 -> 100.69.77.26:8081   (TEI embed)
#   127.0.0.1:18082 -> 100.69.77.26:8082   (TEI rerank)
#
# `up` retries the SSH connect: on this network a transparent TCP proxy makes a dead port
# "succeed" fast while ping RTT runs 330-680ms, and about half of fresh SSH attempts fail
# with "Connection timed out during banner exchange" or "Connection closed by <ip> port 22"
# (the box's sshd journal shows those attempts never arrive, so retrying is not a fail2ban /
# PerSourcePenalties risk).  RECALL_TUNNEL_ATTEMPTS (default 5) bounds the attempts;
# RECALL_TUNNEL_RETRY_SLEEP (default 60s) is the gap between them.  Every failed attempt is
# logged to stderr; `up` exits non-zero only after the last attempt fails, and stays
# idempotent throughout via master_alive().  ServerAliveInterval=15 / ServerAliveCountMax=8
# tolerate about 2 minutes of a stalled link before ssh itself gives up on a connection that
# WAS established (the same proxy can stall an established session, not just new connects).
#
# `up` also starts a small background supervisor (RECALL_TUNNEL_SUPERVISE=0 disables it): it
# polls master_alive every RECALL_TUNNEL_SUPERVISE_INTERVAL seconds (default 10) and reruns the
# same retried SSH open if the master has died, so a long-running caller (the nightly ingest
# routine) keeps a live tunnel without babysitting it by hand.  `down` stops the supervisor
# before closing the master; `status` reports whether the supervisor is running.  Its pid lives
# in "$SOCK.supervisor.pid", its stop signal in "$SOCK.supervisor.stop", and its log in
# "$SOCK.supervisor.log".
#
# start_supervisor() serializes concurrent callers (e.g. the nightly routine's `up` overlapping
# a manual one) with a portable mkdir-based lock ("$SOCK.supervisor.pid.lock" -- macOS has no
# `flock` binary), so only one supervisor is ever started for a given pid file.  As a second,
# independent layer, the supervisor loop itself exits within one poll interval if the pid file
# ever stops naming its own pid -- an orphan left by any other path never polls forever.
#
# No secrets here: SSH auth is the box's own key-based access (the "coolify" ~/.ssh/config
# alias), and QDRANT_URL / TEI_URL carry no credential -- Qdrant/TEI auth, if any, still comes
# from the usual environment / fleet-secrets / Infisical path via fleet_rag.core.load_config().
set -euo pipefail

HOST="coolify"
SOCK="${FLEET_RAG_HOME:-$HOME/apps/fleet-rag}/state/tunnel.sock"
SUP_PID_FILE="${SOCK}.supervisor.pid"
SUP_STOP_FILE="${SOCK}.supervisor.stop"
SUP_LOG="${SOCK}.supervisor.log"
SUP_LOCK_DIR="${SUP_PID_FILE}.lock"   # mkdir-based lock serializing start_supervisor()

usage() {
  sed -n '2,38p' "$0"
}

master_alive() {
  ssh -S "$SOCK" -O check "$HOST" >/dev/null 2>&1
}

check_port() {
  local label="$1" url="$2"
  if curl -fsS -m 5 -o /dev/null "$url"; then
    printf 'OK    %-10s %s\n' "$label" "$url"
  else
    printf 'FAIL  %-10s %s\n' "$label" "$url"
  fi
}

report_up() {
  check_port qdrant     "http://127.0.0.1:16333/healthz"
  check_port tei-embed  "http://127.0.0.1:18081/health"
  check_port tei-rerank "http://127.0.0.1:18082/health"
}

# The retried SSH open, factored out of cmd_up so the supervisor can reuse it: returns 0/1,
# never calls `exit` (a supervisor loop iteration that fails must keep looping, not die).
open_tunnel() {
  if master_alive; then
    return 0
  fi
  local attempts="${RECALL_TUNNEL_ATTEMPTS:-5}" retry_sleep="${RECALL_TUNNEL_RETRY_SLEEP:-60}" attempt
  for ((attempt = 1; attempt <= attempts; attempt++)); do
    if ssh -f -N -M -S "$SOCK" -o ExitOnForwardFailure=yes -o ConnectTimeout=60 \
         -o ServerAliveInterval=15 -o ServerAliveCountMax=8 -o BatchMode=yes \
         -L 16333:100.69.77.26:6333 -L 18081:100.69.77.26:8081 -L 18082:100.69.77.26:8082 "$HOST" \
       || master_alive; then
      return 0
    fi
    echo "recall-tunnel: attempt $attempt/$attempts failed to open the SSH tunnel to $HOST" >&2
    if (( attempt < attempts )); then
      echo "recall-tunnel: retrying in ${retry_sleep}s ($((attempts - attempt)) attempt(s) left)" >&2
      sleep "$retry_sleep"
    fi
  done
  echo "recall-tunnel: giving up after $attempts attempt(s) -- SSH to $HOST did not succeed" >&2
  return 1
}

# --------------------------------------------------------------------------- supervisor

supervisor_running() {
  [[ -f "$SUP_PID_FILE" ]] || return 1
  local pid; pid="$(cat "$SUP_PID_FILE" 2>/dev/null)"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

# mkdir is atomic on every POSIX filesystem, so it doubles as a lock: the first caller to
# succeed holds it, everyone else spins.  A lock directory left behind by a start_supervisor
# that crashed before releasing it (or was killed mid-critical-section) is cleaned up once it
# looks stale -- its recorded pid is dead, or it is simply older than 60s -- so a wedged lock
# can never block `up` forever.
acquire_supervisor_lock() {
  local waited=0
  while ! mkdir "$SUP_LOCK_DIR" 2>/dev/null; do
    local lock_pid=""
    [[ -f "$SUP_LOCK_DIR/pid" ]] && lock_pid="$(cat "$SUP_LOCK_DIR/pid" 2>/dev/null)"
    if [[ -z "$lock_pid" ]] || ! kill -0 "$lock_pid" 2>/dev/null; then
      rm -rf "$SUP_LOCK_DIR"   # holder is dead (or never finished writing its pid): stale
      continue
    fi
    local mtime now
    mtime="$(stat -f %m "$SUP_LOCK_DIR" 2>/dev/null || stat -c %Y "$SUP_LOCK_DIR" 2>/dev/null || echo 0)"
    now="$(date +%s)"
    if (( now - mtime > 60 )); then
      rm -rf "$SUP_LOCK_DIR"   # holder alive but wedged well past a sane critical-section time
      continue
    fi
    sleep 0.2
    waited=$((waited + 1))
    if (( waited > 300 )); then   # ~60s hard cap: never block start_supervisor forever
      rm -rf "$SUP_LOCK_DIR"
    fi
  done
  echo "$$" > "$SUP_LOCK_DIR/pid"
}

release_supervisor_lock() {
  rm -rf "$SUP_LOCK_DIR"
}

# Serialized by acquire/release_supervisor_lock: without the lock, two concurrent `recall-tunnel
# up` calls (e.g. the nightly routine overlapping a manual `up`) could both see
# supervisor_running() == false, both background a supervisor below, and the second write to
# SUP_PID_FILE clobbers the first -- orphaning it (stop_supervisor only ever looks at the
# current pid file, so it never gets told to stop).  With the lock, the second caller blocks
# until the first has written the pid file and released, then supervisor_running() correctly
# reports "already running" and it returns without starting a second one.
start_supervisor() {
  acquire_supervisor_lock
  if supervisor_running; then
    release_supervisor_lock
    return 0
  fi
  rm -f "$SUP_STOP_FILE"
  nohup bash "$0" __supervise__ >>"$SUP_LOG" 2>&1 &
  disown
  echo "$!" > "$SUP_PID_FILE"
  release_supervisor_lock
}

stop_supervisor() {
  [[ -f "$SUP_PID_FILE" ]] || return 0
  local pid; pid="$(cat "$SUP_PID_FILE" 2>/dev/null)"
  : > "$SUP_STOP_FILE"           # belt-and-suspenders: a loop between iterations self-cleans too
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true   # SIGTERM: don't wait up to 10s for the poll to notice
    local waited=0
    while kill -0 "$pid" 2>/dev/null && (( waited < 20 )); do
      sleep 0.1
      waited=$((waited + 1))
    done
    if kill -0 "$pid" 2>/dev/null; then
      kill -9 "$pid" 2>/dev/null || true   # bounded 2s grace period, then force it
    fi
  fi
  rm -f "$SUP_PID_FILE" "$SUP_STOP_FILE"
}

# Internal subcommand (`recall-tunnel __supervise__`), started by start_supervisor via `nohup
# bash "$0" __supervise__ &` -- never invoked directly.
cmd_supervise_loop() {
  # $$ (not a $(...) command substitution, which would itself fork a transient subshell and
  # make BASHPID report *that* subshell's pid instead) is this process's own OS pid.
  # cmd_supervise_loop always runs as a freshly exec'd `bash "$0" __supervise__` process (see
  # start_supervisor below), never a `(...)` subshell of its caller, so plain $$ is exact here
  # even on macOS's bash 3.2, which has no BASHPID at all.
  local self="$$"
  local interval="${RECALL_TUNNEL_SUPERVISE_INTERVAL:-10}"
  # Belt-and-suspenders against the pid-file race the lock in start_supervisor already closes:
  # only touch SUP_PID_FILE/SUP_STOP_FILE when the file still names this process.  If some
  # other path (a future bug, manual surgery, ...) ever lets two supervisors start for the same
  # pid file, the loser here recognizes it does not own the file and exits instead of deleting
  # state that belongs to the survivor.
  owns_pid_file() {
    [[ "$(cat "$SUP_PID_FILE" 2>/dev/null)" == "$self" ]]
  }
  trap 'owns_pid_file && rm -f "$SUP_PID_FILE"; exit 0' TERM INT

  # start_supervisor() writes $! (this process's own pid -- nohup execs rather than forks, so
  # it is the same pid as $self above) to SUP_PID_FILE right after backgrounding us, but
  # backgrounding gives no ordering guarantee that the write lands before we are scheduled.
  # Wait briefly for it to appear rather than treating a not-yet-written file as "orphaned".
  local waited=0
  while [[ ! -s "$SUP_PID_FILE" ]] && (( waited < 50 )); do
    sleep 0.1
    waited=$((waited + 1))
  done

  while true; do
    if [[ -f "$SUP_STOP_FILE" ]]; then
      owns_pid_file && rm -f "$SUP_PID_FILE"
      rm -f "$SUP_STOP_FILE"
      exit 0
    fi
    if ! owns_pid_file; then
      # A concurrent start_supervisor overwrote the pid file with a newer supervisor's pid
      # (should not happen past the lock in start_supervisor, but this is the second,
      # independent layer): this process is an orphan.  Exit within one poll interval instead
      # of polling forever, and do not touch the file -- it belongs to the survivor.
      echo "recall-tunnel: supervisor: pid file no longer names this process ($self), exiting" >&2
      exit 0
    fi
    if ! master_alive; then
      echo "recall-tunnel: supervisor: tunnel is down, reopening" >&2
      open_tunnel || echo "recall-tunnel: supervisor: reopen failed, will retry in ${interval}s" >&2
    fi
    sleep "$interval"
  done
}

# --------------------------------------------------------------------------- commands

cmd_up() {
  mkdir -p "$(dirname "$SOCK")"
  local already_up=0
  master_alive && already_up=1
  if open_tunnel; then
    if (( already_up )); then echo "tunnel already up ($SOCK)"; else echo "tunnel opened ($SOCK)"; fi
    report_up
  else
    exit 1
  fi
  if [[ "${RECALL_TUNNEL_SUPERVISE:-1}" != "0" ]]; then
    start_supervisor
  fi
}

cmd_status() {
  local rc=0
  if master_alive; then
    echo "up ($SOCK)"
  else
    echo "down"
    rc=1
  fi
  if supervisor_running; then
    echo "supervisor: running (pid $(cat "$SUP_PID_FILE" 2>/dev/null))"
  else
    echo "supervisor: not running"
  fi
  return "$rc"
}

cmd_down() {
  stop_supervisor
  if ssh -S "$SOCK" -O exit "$HOST" 2>&1; then
    echo "tunnel closed"
  else
    echo "no tunnel running ($SOCK)"
  fi
}

cmd_env() {
  cat <<'EOF'
export QDRANT_URL=http://127.0.0.1:16333
export TEI_URL=http://127.0.0.1:18081
export TEI_RERANK_URL=http://127.0.0.1:18082
export RECALL_HTTP_RETRIES=8
export RECALL_HTTP_BACKOFF_MAX=60
EOF
}

case "${1:-}" in
  up) cmd_up ;;
  status) cmd_status ;;
  down) cmd_down ;;
  env) cmd_env ;;
  __supervise__) cmd_supervise_loop ;;
  -h|--help) usage ;;
  *) usage; exit 2 ;;
esac
