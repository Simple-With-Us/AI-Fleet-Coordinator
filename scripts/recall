#!/usr/bin/env python3
"""recall -- search and grow the fleet-agents knowledge corpus.

Credentials are read from the environment, then Infisical via a machine identity in the
environment, then `fleet-secrets` when it is installed.  Values are never printed.  Reads use the read-only Qdrant key when it is
available; only `contribute` needs the write key.

Run your own corpus: set QDRANT_URL, QDRANT_API_KEY, TEI_URL, TEI_API_KEY and
QDRANT_FLEET_COLLECTION in the environment and no Infisical account or credentials file
is needed.  See docs/RAG-FLEET-INFRA.md "Run your own".

Usage:
  recall "query text" [--limit 5] [--category X] [--app X] [--source X] [--seat X]
                      [--since-days N] [--per-doc N] [--no-rerank] [--no-lessons] [--full] [--json]
  recall stats [--json]
  recall contribute "text" --category lesson [--app fleet] [--seat CLAUDE] [--title T] [--url U]
                    [--force]
  recall contribute --file PATH --category lesson ...      (PATH may be - for stdin)
  recall contribute - --category lesson ...                (text on stdin)
  recall digest [--days 7] [--app X] [--json]
  recall eval [--k 5] [--threshold 0.6] [--per-doc N] [--no-rerank] [--no-lessons] [--compare]
              [--json]
  recall doctor [--json]
  recall doctor --platforms [--box] [--json]
  recall ingest [--all | --source board,doc,...] [--dry-run] [--limit N] [--since 7d] [--prune]

The first argument is treated as a search query unless some argument (before any "--") is
one of: search, stats, contribute, digest, eval, doctor, ingest.

Search returns one hit per document (--per-doc 1..3 keeps the best N chunks of each), boosts
agent lessons into the fusion (--no-lessons for raw document research) and reranks the
candidates with the cross-encoder when TEI_RERANK_URL / TEI_RERANK_API_KEY are configured
(--no-rerank keeps the fused order).  The mode line says which engaged ("hybrid+rerank"); a
reranked hit prints rerank= and fused= next to its score.  `recall eval --compare` scores the
golden set with lessons / rerank each on and off and prints the deltas.

Contribute refuses a near-duplicate: when an existing agent contribution scores >= 0.92
cosine against the candidate it prints "similar lesson already exists: <doc_id> (score S)"
and exits 1; pass --force to store it anyway.  `recall digest` lists the contributions of the
last N days grouped by app then category (the weekly Oracle routine and the owner's note).
`recall doctor --platforms` prints a parity table (MCP registration per platform, skill copies,
hooks, seat-mcp routes, BotFleet routines, ingest freshness; --box adds the Hetzner health
rows over ssh) and exits 1 when any row is FAIL.

Contribute text that might contain a credential (a log excerpt, a command line, a config
snippet) should go through --file PATH or stdin (-), never as a shell argument: an argument
lands in shell history and in the agent transcript before the scrub runs.  Secrets are
scrubbed either way and the scrub kinds are reported; text that still looks like a secret is
refused.

Examples:
  recall "how do I avoid leaking credentials"
  recall "pm2 dump poisoned" --source doc --since-days 90
  recall contribute "pm2 start does not re-read env from the ecosystem file; use --update-env." \\
         --category lesson --app fleet
  recall contribute --file /path/to/lesson.md --category runbook --title "pm2 env cache"
  pbpaste | recall contribute - --category lesson
  recall stats

Exit codes: 0 ok, 1 no hits / duplicate lesson / eval below threshold / platform FAIL,
2 usage or credential error.
"""

from __future__ import annotations

import argparse
import datetime
import functools
import http.client
import json
import os
import re
import shutil
import socket
import ssl
import sys
import time
import urllib.error
import urllib.request
import zoneinfo

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from fleet_rag import __version__  # noqa: E402
from fleet_rag import contribute_guard, core, doctor, public_fallback, recall_api  # noqa: E402
from fleet_rag.core import FleetRagError  # noqa: E402

SUBCOMMANDS = ("search", "stats", "contribute", "digest", "eval", "doctor", "ingest")
EXCERPT = 300
_CT = zoneinfo.ZoneInfo("America/Chicago")


def _date(ms: int | None) -> str:
    if not ms:
        return "-"
    return datetime.datetime.fromtimestamp(int(ms) / 1000, _CT).strftime("%Y-%m-%d")


def fmt_hit(i: int, h: dict, full: bool) -> str:
    tags = "/".join(x for x in (h.get("source"), h.get("app"), h.get("category")) if x) or "-"
    seat = f"  seat {h['seat']}" if h.get("seat") else ""
    head = f"#{i}  {h['score']:.4f}"
    if h.get("rerank_score") is not None:
        head += f"  rerank={h['rerank_score']:.4f} fused={h.get('fused_score', 0.0):.4f}"
    head += f"  {tags}{seat}  {_date(h.get('created_at'))}"
    label = h.get("title") or h.get("heading") or ""
    if len(label) > 88:
        label = label[:85] + "..."
    ident = f"     {h.get('doc_id') or '-'}"
    if h.get("chunk_index"):
        ident += f" #{h['chunk_index']}"
    if label:
        ident += f"  {label}"
    lines = [head, ident]
    if h.get("url"):
        lines.append(f"     {h['url']}")
    text = h.get("text", "")
    if not full and len(text) > EXCERPT:
        text = text[:EXCERPT].rstrip() + "..."
    lines.extend("     " + ln for ln in text.splitlines())
    return "\n".join(lines)


def cmd_search(a: argparse.Namespace) -> int:
    kwargs = dict(
        limit=a.limit,
        category=a.category,
        app=a.app,
        source=a.source,
        seat=a.seat,
        since_days=a.since_days,
        per_doc=a.per_doc,
        prefer_lessons=a.prefer_lessons,
        rerank=a.rerank,
    )
    res = public_fallback.call_with_fallback(
        "recall_search",
        {**kwargs, "query": a.query},
        lambda: recall_api.recall_search(a.query, **kwargs),
    )
    if a.json:
        print(json.dumps(res, indent=2))
        return 0 if res["hits"] else 1
    if not res["hits"]:
        print("no hits")
        return 1
    print(f"{len(res['hits'])} hits  ({res['mode']})\n")
    for i, h in enumerate(res["hits"], 1):
        print(fmt_hit(i, h, a.full))
        print()
    return 0


def cmd_stats(a: argparse.Namespace) -> int:
    res = public_fallback.call_with_fallback("recall_stats", {}, recall_api.recall_stats)
    if a.json:
        print(json.dumps(res, indent=2))
        return 0
    print(f"collection : {res['collection']}")
    print(f"status     : {res['status']}")
    print(f"points     : {res['points']}")
    print(f"embedder   : {'healthy' if res['embedder_healthy'] else 'UNREACHABLE'}")
    if "searches_7d" in res:
        seat_summary = (
            ", ".join(f"{s}: {c}" for s, c in list(res.get("searches_by_seat_7d", {}).items())[:4])
            or "none"
        )
        print(f"searches 7d: {res['searches_7d']} ({seat_summary})")
    print("by source  :")
    for k, v in res["by_source"].items():
        print(f"  {k:<20} {v:>7}")
    print("by app     :")
    if not res["by_app"]:
        print("  (none)")
    for k, v in res["by_app"].items():
        print(f"  {k:<20} {v:>7}")
    return 0


def contribute_text(text: str | None, file: str | None, stdin=None) -> str:
    """Resolve the contribution body from the positional text, --file PATH, or stdin (-)."""
    stdin = stdin or sys.stdin
    if file is not None and text not in (None, "-"):
        raise FleetRagError(
            "give the text either as an argument, as --file PATH, or as - (stdin), not two of them"
        )
    if file is not None:
        if file == "-":
            return stdin.read()
        try:
            with open(file, encoding="utf-8") as fh:
                return fh.read()
        except OSError as e:
            raise FleetRagError(
                f"cannot read --file {file}: {e.strerror or type(e).__name__}"
            ) from None
    if text == "-":
        return stdin.read()
    if text is None:
        raise FleetRagError("contribute needs text: an argument, --file PATH, or - for stdin")
    return text


def check_duplicate(text: str) -> dict:
    """Run the near-duplicate guard against the live (or fake) backend; read key is enough."""
    cfg = recall_api.get_config(need_write=False)
    return contribute_guard.near_duplicate(cfg, recall_api.Qdrant(cfg), text)


def cmd_contribute(a: argparse.Namespace) -> int:
    text = contribute_text(a.text, a.file)
    if not text.strip():
        raise FleetRagError("contribute needs non-empty text")
    kwargs = dict(text=text, category=a.category, app=a.app, seat=a.seat, title=a.title, url=a.url)
    guard = None
    in_range = recall_api.CONTRIB_MIN <= len(text.strip()) <= recall_api.CONTRIB_MAX
    if (
        not a.force and in_range and public_fallback.guard_may_run()
    ):  # out-of-range: let recall_contribute report it
        try:
            guard = check_duplicate(text)
        except FleetRagError as e:
            if not public_fallback.is_connection_error(e):
                raise
            guard = None  # Tailscale flaked mid-check: skip the guard, let contribute proceed
        if guard is not None and guard["duplicate"]:
            if a.json:
                print(
                    json.dumps(
                        {
                            "status": "duplicate",
                            "existing": guard["existing"],
                            "threshold": guard["threshold"],
                            "message": contribute_guard.duplicate_message(guard["existing"]),
                        },
                        indent=2,
                    )
                )
            else:
                print(contribute_guard.duplicate_message(guard["existing"]), file=sys.stderr)
            return 1
    res = public_fallback.call_with_fallback(
        "recall_contribute", kwargs, lambda: recall_api.recall_contribute(**kwargs)
    )
    if guard and guard["candidates"]:
        res["nearest"] = guard["candidates"][0]
    if a.json:
        print(json.dumps(res, indent=2))
        return 0
    print(f"stored {res['doc_id']}  ({res['status']})")
    print(f"id      : {res['id']}")
    if res["scrubbed"]:
        print(f"scrubbed: {', '.join(res['scrubbed'])}")
    if guard and guard["candidates"]:
        top = guard["candidates"][0]
        print(f"nearest : {top['doc_id'] or top['id']} (score {top['score']:.2f})")
    return 0


def cmd_digest(a: argparse.Namespace) -> int:
    cfg = recall_api.get_config(need_write=False)
    include_searches = getattr(a, "searches", False)
    d = doctor.contribution_digest(
        recall_api.Qdrant(cfg), days=a.days, app=a.app, include_searches=include_searches
    )
    if a.json:
        print(json.dumps(d, indent=2))
    else:
        print(doctor.format_digest(d))
    return 0


def cmd_eval(a: argparse.Namespace) -> int:
    from fleet_rag import eval as ev

    public_fallback.require_direct_path("eval")
    golden = a.golden or ev.GOLDEN
    # per_doc is not one of the A/B axes, so it is bound onto the search callable and applies to
    # every configuration; --no-rerank / --no-lessons are the axes and go through search_kwargs.
    search = functools.partial(recall_api.recall_search, per_doc=a.per_doc)
    if a.compare:
        res = ev.run_compare(a.k, golden, search=search)
        print(json.dumps(res, indent=2) if a.json else ev.render_compare(res))
        return 0 if res["runs"]["both"]["recall_at_k"] >= a.threshold else 1
    kwargs: dict = {}
    if not a.prefer_lessons:
        kwargs["prefer_lessons"] = False
    if not a.rerank:
        kwargs["rerank"] = False
    res = ev.run_eval(a.k, golden, search=search, search_kwargs=kwargs or None)
    print(json.dumps(res, indent=2) if a.json else ev.render(res))
    return 0 if res["recall_at_k"] >= a.threshold else 1


def cmd_ingest(a: argparse.Namespace) -> int:
    from fleet_rag import ingest as ing

    public_fallback.require_direct_path("ingest")
    argv: list[str] = []
    if a.fix_seeds:
        argv.append("--fix-seeds")
    elif a.source:
        argv += ["--source", a.source]
    else:
        argv.append("--all")
    if a.dry_run:
        argv.append("--dry-run")
    if a.limit:
        argv += ["--limit", str(a.limit)]
    if a.since:
        argv += ["--since", a.since]
    if a.no_heartbeat:
        argv.append("--no-heartbeat")
    if a.prune:
        argv.append("--prune")
    if a.lock_timeout is not None:
        #  The operator override the docs promise.  It was documented on the ingest CLI but
        #  never exposed here, so `recall ingest --lock-timeout 0` died in argparse with
        #  exit 2 on the very CLI the nightly and the sheet sync invoke (Kody review, PR #800).
        argv += ["--lock-timeout", str(a.lock_timeout)]
    return ing.main(argv)


def cmd_doctor(a: argparse.Namespace) -> int:
    if a.platforms:
        blocked = (
            not public_fallback.using_fake_backend()
            and not public_fallback.local_override_active()
            and public_fallback.direct_path_blocked(public_fallback.tailscale_status_text())
        )
        rep = doctor.platforms_report(box=a.box, direct_path_blocked=blocked)
        if a.json:
            print(json.dumps(rep, indent=2))
        else:
            print(doctor.format_platforms(rep))
        return 0 if rep["ok"] else 1
    if a.box:
        raise FleetRagError("--box only applies with --platforms")
    public_fallback.require_direct_path("doctor")
    rep: dict = {
        "version": __version__,
        "env_keys": [k for k in core.ALL_KEYS if os.environ.get(k)],
        "fleet_secrets": core._fleet_secrets_bin() is not None,
        "gitleaks": bool(shutil.which("gitleaks")),
    }
    ok = True
    try:
        cfg = recall_api.load_config(need_write=False)
        rep["keys_found"] = [k for k in core.ALL_KEYS if k in cfg]
        rep["key_mode"] = recall_api.key_mode(cfg)
        rep["write_key"] = bool(cfg.get("QDRANT_API_KEY"))
        rep["embedder_healthy"] = core.embedder_healthy(cfg)
        q = recall_api.Qdrant(cfg)
        rep["qdrant_healthz"] = q.healthz()
        try:
            info = q.info()
            rep["collection"] = q.collection
            rep["collection_status"] = info.get("status", "?")
            rep["points"] = info.get("points_count", 0)
        except FleetRagError as e:
            rep["collection"] = q.collection
            rep["collection_status"] = f"ERROR {e}"
            ok = False
        ok = ok and rep["embedder_healthy"] and rep["qdrant_healthz"]
    except FleetRagError as e:
        rep["credentials_error"] = str(e)
        ok = False
    rep["ok"] = ok
    if a.json:
        print(json.dumps(rep, indent=2))
        return 0 if ok else 2

    def yn(v: object) -> str:
        return "yes" if v else "NO"

    print(f"recall {rep['version']}")
    print(f"env keys        : {', '.join(rep['env_keys']) or '(none)'}")
    print(f"fleet-secrets   : {yn(rep['fleet_secrets'])}  (Mac credential source)")
    if "credentials_error" in rep:
        print(f"credentials     : ERROR {rep['credentials_error']}")
    else:
        print(f"keys found      : {', '.join(rep['keys_found'])}")
        print(f"key mode        : {rep['key_mode']}  (write key present: {yn(rep['write_key'])})")
        print(f"embedder        : {'healthy' if rep['embedder_healthy'] else 'UNREACHABLE'}")
        print(f"qdrant healthz  : {yn(rep['qdrant_healthz'])}")
        print(
            f"collection      : {rep.get('collection')}  {rep.get('collection_status')}"
            f"  points={rep.get('points', '?')}"
        )
    print(f"gitleaks        : {yn(rep['gitleaks'])}")
    print(f"overall         : {'ok' if ok else 'PROBLEMS'}")
    return 0 if ok else 2


def build_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(
        prog="recall", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    sub = ap.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser(
        "search", help="hybrid search (default when the first arg is not a subcommand)"
    )
    s.add_argument("query")
    s.add_argument("--limit", type=int, default=5)
    s.add_argument("--category")
    s.add_argument("--app")
    s.add_argument("--source")
    s.add_argument("--seat")
    s.add_argument("--since-days", dest="since_days", type=int)
    s.add_argument(
        "--per-doc",
        dest="per_doc",
        type=int,
        default=1,
        help=f"best N chunks per document, 1..{recall_api.PER_DOC_MAX} (default 1)",
    )
    s.add_argument(
        "--no-rerank",
        dest="rerank",
        action="store_false",
        help="keep the fused order even when the cross-encoder is configured",
    )
    s.add_argument(
        "--no-lessons",
        dest="prefer_lessons",
        action="store_false",
        help="do not boost agent lessons into the fusion (raw document research)",
    )
    s.add_argument("--full", action="store_true", help="print whole chunks, not 300-char excerpts")
    s.add_argument("--json", action="store_true")

    st = sub.add_parser("stats", help="collection status and counts by source / app")
    st.add_argument("--json", action="store_true")

    c = sub.add_parser(
        "contribute", help="store a reusable lesson / preference / fact (needs write key)"
    )
    c.add_argument(
        "text",
        nargs="?",
        help="the text, or - to read it from stdin (prefer --file / - for anything "
        "that might contain a credential)",
    )
    c.add_argument(
        "--file",
        help="read the text from PATH (- for stdin); safest for log excerpts, "
        "command lines, or config snippets that might hold a credential",
    )
    c.add_argument("--category", required=True, choices=recall_api.CONTRIB_CATEGORIES)
    c.add_argument("--app", default="fleet")
    c.add_argument("--seat", default=os.environ.get("AGENT_SEAT"))
    c.add_argument("--title")
    c.add_argument("--url")
    c.add_argument(
        "--force",
        action="store_true",
        help="store even when a near-duplicate agent contribution exists (score >= 0.92)",
    )
    c.add_argument("--json", action="store_true")

    dg = sub.add_parser(
        "digest", help="agent contributions of the last N days, by app then category"
    )
    dg.add_argument("--days", type=int, default=7)
    dg.add_argument("--app")
    dg.add_argument(
        "--searches",
        action="store_true",
        help="include search telemetry and search-to-contribute ratios",
    )
    dg.add_argument("--json", action="store_true")

    e = sub.add_parser("eval", help="score golden.jsonl: Recall@1, Recall@k, MRR")
    e.add_argument("--k", type=int, default=5)
    e.add_argument("--threshold", type=float, default=0.6)
    e.add_argument("--golden")
    e.add_argument(
        "--per-doc",
        dest="per_doc",
        type=int,
        default=1,
        help=f"best N chunks per document for every query, 1..{recall_api.PER_DOC_MAX}",
    )
    e.add_argument("--no-rerank", dest="rerank", action="store_false", help="rerank=False")
    e.add_argument(
        "--no-lessons", dest="prefer_lessons", action="store_false", help="prefer_lessons=False"
    )
    e.add_argument(
        "--compare",
        action="store_true",
        help="score lessons / rerank each on and off and print the deltas vs both-off "
        "(--no-rerank / --no-lessons are ignored; every configuration runs)",
    )
    e.add_argument("--json", action="store_true")

    d = sub.add_parser("doctor", help="credentials (names only), embedder, qdrant, key mode")
    d.add_argument(
        "--platforms",
        action="store_true",
        help="parity table: MCP registration, skills, hooks, seat-mcp, BotFleet routines, "
        "ingest freshness (exit 1 on any FAIL)",
    )
    d.add_argument(
        "--box", action="store_true", help="with --platforms: add the Hetzner health rows via ssh"
    )
    d.add_argument("--json", action="store_true")

    ingp = sub.add_parser("ingest", help="run the full source pipeline (needs write key)")
    ingp.add_argument(
        "--all", action="store_true", help="every source (default when --source is omitted)"
    )
    ingp.add_argument(
        "--source", help="comma-separated subset: board,effort-log,doc,skill,memory,apple-note"
    )
    ingp.add_argument("--fix-seeds", dest="fix_seeds", action="store_true")
    ingp.add_argument("--dry-run", dest="dry_run", action="store_true")
    ingp.add_argument("--limit", type=int)
    ingp.add_argument("--since")
    ingp.add_argument("--prune", action="store_true")
    ingp.add_argument("--no-heartbeat", dest="no_heartbeat", action="store_true")
    ingp.add_argument(
        "--lock-timeout",
        dest="lock_timeout",
        type=float,
        help="wait up to SECONDS for the shared ingest lock (0 fails at once)",
    )
    return ap


# ---------------------------------------------------------------- remote read transport (opt-in)
#
# SIMPLE_RECALL_REMOTE=1 sends `search` and `stats` to the hosted ST-MCP endpoint with the bot's own bearer
# (SIMPLE_TOOLS_BEARER, process environment only).  The hosted server serves Recall from ONE shared backend
# credential set, so this proves which bot asked, not a per-bot Recall credential.  The endpoint is the fixed
# constant below (no override), nothing here reads a Recall, Qdrant, Infisical or Access credential, and a
# failure never falls back to the direct or public route.  Every other verb, and every search flag with no
# hosted equivalent, is refused.  Output is the hosted tool's text (fenced as untrusted) and structured result,
# not this CLI's formatted lines.  The hosted bearer holds every hosted tool of its seat; this mode only ever
# calls recall_search and recall_stats, which is a client choice and not a server restriction.
REMOTE_MCP_URL = "https://agents.simplewithus.com/mcp"
REMOTE_BEARER_ENV = "SIMPLE_TOOLS_BEARER"
REMOTE_BEARER_RE = re.compile(r"[A-Za-z0-9_\-]{20,200}")
REMOTE_TIMEOUT_S = 40


def remote_selected() -> bool:
    return os.environ.get("SIMPLE_RECALL_REMOTE", "").strip() == "1"


REMOTE_MAX_BYTES = 4_000_000
REMOTE_MAX_DEPTH = 64
REMOTE_MAX_NODES = 100_000
# The error codes the hosted server can return (the ToolError codes in scripts/agent-sync-mcp/src);  a test keeps
# this list in step with that source.  Anything else, including a code that merely looks safe, prints as "error".
_REMOTE_CODES = frozenset(
    (
        "invalid_argument",
        "unavailable",
        "upstream_error",
        "not_authorized",
        "rate_limited",
        "not_configured",
        "outcome_unknown",
        "paused",
        "linear_error",
        "internal",
        "response_too_large",
        "refused_secret",
        "not_found",
        "channel_not_allowed",
        "claim_held",
        "zulip_error",
        "writes_disabled",
        "unknown_tool",
        "session_required",
        "relay_refused",
        "identity_required",
        "identity_not_allowed",
        "forbidden",
        "fleetlink_seat_disabled",
        "fleetlink_refused",
        "dm_not_allowed",
        "budget_exhausted",
    )
)
_REMOTE_CONTROL_RE = re.compile(r"[\x00-\x08\x0b-\x1f\x7f-\x9f]")
_REMOTE_UNKNOWN = "; the write may or may not have been applied, check before sending it again"


def _remote_visible(text: str) -> str:
    """Hosted text with control characters (other than newline and tab) shown as \\xNN, so it cannot drive the terminal."""
    return _REMOTE_CONTROL_RE.sub(lambda m: "\\x%02x" % ord(m.group()), text)


class _TransportError(Exception):
    """The request did not produce an HTTP answer.  `sent` is False only when it provably never left
    (name lookup, refused connection, certificate check);  every other stage is treated as sent."""

    def __init__(self, sent: bool, reason: str = "") -> None:
        super().__init__(reason)
        self.sent = sent
        self.reason = reason


def _remote_post(url: str, headers: dict, body: bytes, timeout: float) -> tuple[int, str, bytes]:
    """The one network call of the remote transport:  (status, content type, body).  Tests replace this.
    Redirects are never followed (the Authorization header must not leave the fixed origin), the body is
    read under one total deadline and one byte cap."""
    deadline = time.monotonic() + timeout
    op = urllib.request.build_opener(urllib.request.ProxyHandler({}), _RemoteNoRedirect())
    req = urllib.request.Request(url, data=body, method="POST", headers=headers)
    try:
        with op.open(req, timeout=timeout) as r:
            chunks, total = [], 0
            sock = getattr(getattr(getattr(r, "fp", None), "raw", None), "_sock", None)
            if sock is None:
                # Without the socket the remaining budget cannot be applied to each read, so a stalled body could
                # outlast the deadline:  fail closed rather than read unbounded.
                raise _TransportError(True, "transport")
            while True:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise _TransportError(True, "deadline")
                sock.settimeout(remaining)
                chunk = r.read1(65536)
                if time.monotonic() > deadline:
                    raise _TransportError(True, "deadline")
                if not chunk:
                    break
                total += len(chunk)
                if total > REMOTE_MAX_BYTES:
                    raise _TransportError(True, "too large")
                chunks.append(chunk)
            return r.status, r.headers.get("Content-Type", ""), b"".join(chunks)
    except urllib.error.HTTPError as exc:
        exc.close()
        return exc.code, "", b""
    except urllib.error.URLError as exc:
        unsent = isinstance(
            exc.reason, (socket.gaierror, ConnectionRefusedError, ssl.SSLCertVerificationError)
        )
        raise _TransportError(not unsent, "unreachable") from None
    except _TransportError:
        raise
    except (http.client.HTTPException, OSError, ValueError):
        raise _TransportError(True, "transport") from None


class _RemoteNoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        return None


def _remote_depth_ok(text: str) -> bool:
    depth = 0
    in_string = escaped = False
    for ch in text:
        if in_string:
            if escaped:
                escaped = False
            elif ch == "\\":
                escaped = True
            elif ch == '"':
                in_string = False
        elif ch == '"':
            in_string = True
        elif ch in "[{":
            depth += 1
            if depth > REMOTE_MAX_DEPTH:
                return False
        elif ch in "]}":
            depth -= 1
    return True


def _remote_nodes_ok(value) -> bool:
    stack, count = [value], 0
    while stack:
        item = stack.pop()
        count += 1
        if count > REMOTE_MAX_NODES:
            return False
        if isinstance(item, dict):
            stack.extend(item.values())
        elif isinstance(item, list):
            stack.extend(item)
    return True


def _remote_events(ctype: str, raw: bytes) -> list[str]:
    """The JSON texts of one answer:  the body itself, or each Server-Sent Event (its `data:` lines joined by a
    newline, as the SSE format defines, comments and other fields ignored)."""
    text = raw.decode("utf-8", "replace")
    if "text/event-stream" not in ctype.lower():
        return [text]
    events, current = [], []
    for line in text.replace("\r\n", "\n").replace("\r", "\n").split("\n"):
        if line == "":
            if current:
                events.append("\n".join(current))
                current = []
        elif line.startswith("data:"):
            value = line[5:]
            current.append(value[1:] if value.startswith(" ") else value)
    if current:
        events.append("\n".join(current))
    return events


def _remote_code(value) -> str:
    """A server error code, only when it is one of the codes the hosted server defines;  anything else is "error"."""
    return value if isinstance(value, str) and value in _REMOTE_CODES else "error"


def _remote_error_object(result: dict, sc) -> dict:
    """The hosted server's error object.  The server answers a tool error with isError and NO structuredContent: the
    object (code, retry_after_s, ...) is in `_meta["agent-sync/error"]` and, as JSON, in the first text part that is a JSON object.  A
    structuredContent that carries a code still wins.  Only the code and the retry-after are ever shown, and
    the code only when it is allow-listed, so nothing the server wrote is copied."""
    if isinstance(sc, dict) and "code" in sc:
        return sc
    meta = result.get("_meta")
    cand = meta.get("agent-sync/error") if isinstance(meta, dict) else None
    if not isinstance(cand, dict):
        cand = None
        for part in result.get("content") or []:
            if isinstance(part, dict) and isinstance(part.get("text"), str):
                try:
                    obj = json.loads(part["text"])
                except (ValueError, RecursionError):
                    continue
                if isinstance(obj, dict):
                    cand = obj
                    break
    return cand if isinstance(cand, dict) else (sc if isinstance(sc, dict) else {})


def _remote_answer(ctype: str, raw: bytes, tool: str, write: bool):
    """The tools/call result of one answer, or (None, message).  Returns (result, "") on success.  Only an
    allow-listed code and a bounded retry-after leave this function:  the server's own message text is
    untrusted and can echo the caller's input, so it is never copied into an error."""
    unknown = _REMOTE_UNKNOWN if write else ""
    msg = None
    for text in _remote_events(ctype, raw):
        if not _remote_depth_ok(text):
            return None, "the hosted endpoint sent an answer that nests too deeply" + unknown
        try:
            candidate = json.loads(text)
        except (ValueError, RecursionError):
            continue
        if (
            isinstance(candidate, dict)
            and candidate.get("jsonrpc") == "2.0"
            and type(candidate.get("id")) is int
            and candidate["id"] == 1
            and ("result" in candidate) != ("error" in candidate)
        ):
            msg = candidate
            break
    if msg is None:
        return None, "the hosted endpoint sent no readable answer to the call" + unknown
    if not _remote_nodes_ok(msg):
        return None, "the hosted endpoint sent an oversized answer" + unknown
    if "error" in msg:
        err = msg["error"]
        code = _remote_code(err.get("code")) if isinstance(err, dict) else "error"
        return None, "the hosted endpoint refused the call" + (
            "" if code == "error" else f" ({code})"
        )
    result = msg.get("result")
    if not isinstance(result, dict):
        return None, "the hosted endpoint sent no result" + unknown
    content = result.get("content")
    sc = result.get("structuredContent")
    if (
        (content is not None and not isinstance(content, list))
        or any(
            not isinstance(p, dict) or ("text" in p and not isinstance(p["text"], str))
            for p in content or []
        )
        or (sc is not None and not isinstance(sc, dict))
        or not isinstance(result.get("isError", False), bool)
    ):
        return None, "the hosted endpoint sent a result in an unexpected shape" + unknown
    if result.get("isError"):
        eo = _remote_error_object(result, sc)
        code = _remote_code(eo.get("code"))
        retry = eo.get("retry_after_s", eo.get("retry_after"))
        after = (
            f", retry after {int(-(-retry // 1))}s"
            if isinstance(retry, (int, float))
            and not isinstance(retry, bool)
            and 0 <= retry <= 86400
            else ""
        )
        note = _REMOTE_UNKNOWN if write and code == "outcome_unknown" else ""
        return None, f"{tool} failed on the hosted server: {code}{after}{note}"
    return result, ""


def _remote_failure(exc: "_TransportError", write: bool) -> str:
    if write and exc.sent:
        return (
            "the hosted endpoint did not answer"
            + _REMOTE_UNKNOWN
            + " (no direct fallback in remote mode)"
        )
    return "the hosted endpoint could not be reached (no direct fallback in remote mode)"


def _remote_status_message(status: int, write: bool) -> str:
    if status in (401, 403):
        return "the hosted endpoint refused this bearer (not valid, expired, paused or not accepted for MCP)"
    return f"the hosted endpoint answered HTTP {status}" + (
        _REMOTE_UNKNOWN if write and (status >= 500 or status == 408) else ""
    )


def _remote_scan_arguments(scanner, arguments, bearer: str) -> str | None:
    """The first argument field the fleet secret scanner flags, as `secret_scan:<field>` (the field name only,
    never the text or any part of it), or None.  Every string at any depth is checked, and the bearer itself
    always matches."""
    stack = [("", arguments)]
    while stack:
        path, value = stack.pop()
        if isinstance(value, str):
            if scanner.scan(value, known=[bearer]) is not None:
                return "secret_scan:" + (path or "arguments")
        elif isinstance(value, dict):
            stack.extend((f"{path}.{k}" if path else str(k), v) for k, v in value.items())
        elif isinstance(value, (list, tuple)):
            stack.extend((f"{path}[{i}]", v) for i, v in enumerate(value))
    return None


def _remote_scanner():
    """The fleet's secret scanner (scripts/agent_sync/secretscan.py, standard library only), loaded by path.  If it
    cannot be loaded nothing is sent:  remote mode has no unscanned route."""
    import importlib.util

    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "agent_sync", "secretscan.py")
    try:
        spec = importlib.util.spec_from_file_location("_remote_secretscan", path)
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        return module
    except (OSError, ImportError, AttributeError, SyntaxError):
        raise FleetRagError(
            "the secret scanner is not available, so nothing was sent (remote mode has no "
            "unscanned route)"
        ) from None


def remote_call(tool: str, arguments: dict, write: bool = False) -> dict:
    bearer = os.environ.get(REMOTE_BEARER_ENV, "").strip()
    if not bearer:
        raise FleetRagError(
            f"remote mode needs this bot's own bearer in {REMOTE_BEARER_ENV}; there is no fallback "
            "to direct or public credentials"
        )
    if not REMOTE_BEARER_RE.fullmatch(bearer):
        raise FleetRagError(
            f"{REMOTE_BEARER_ENV} is not a bearer token (unexpected characters or length)"
        )
    hit = _remote_scan_arguments(_remote_scanner(), arguments, bearer)
    if hit:
        raise FleetRagError(f"refused before sending: {hit}")
    body = json.dumps(
        {
            "jsonrpc": "2.0",
            "id": 1,
            "method": "tools/call",
            "params": {"name": tool, "arguments": arguments},
        }
    ).encode()
    try:
        status, ctype, raw = _remote_post(
            REMOTE_MCP_URL,
            {
                "Content-Type": "application/json",
                "Accept": "application/json, text/event-stream",
                "MCP-Protocol-Version": "2025-06-18",
                "Authorization": "Bearer " + bearer,
                "User-Agent": "recall-remote/1",
            },
            body,
            REMOTE_TIMEOUT_S,
        )
    except _TransportError as exc:
        raise FleetRagError(_remote_failure(exc, write)) from None
    if status != 200:
        raise FleetRagError(_remote_status_message(status, write))
    result, problem = _remote_answer(ctype, raw, tool, write)
    if problem:
        raise FleetRagError(problem)
    return result


_ARGV: list[str] = []


def remote_main(a: argparse.Namespace) -> int:
    if a.cmd not in ("search", "stats", "contribute"):
        raise FleetRagError(
            f"`{a.cmd}` is not available in remote mode (SIMPLE_RECALL_REMOTE=1 supports only "
            "search, stats and contribute); it is not run directly either"
        )
    if a.cmd == "contribute":
        # A write: its own switch, the hosted recall_contribute tool only, and never a seat of the caller's choosing
        # (the hosted server attributes the lesson to the bearer's seat).  The near-duplicate guard is local and
        # has no hosted equivalent, so --force is refused rather than ignored.
        if os.environ.get("SIMPLE_RECALL_REMOTE_WRITES") != "1":
            raise FleetRagError(
                "contribute is a write:  set SIMPLE_RECALL_REMOTE_WRITES=1 as well as "
                "SIMPLE_RECALL_REMOTE=1 (it is not sent directly instead)"
            )
        if a.force or any(x == "--seat" or x.startswith("--seat=") for x in _ARGV):
            raise FleetRagError(
                "--force and --seat have no meaning in remote mode (no local duplicate guard; "
                "the hosted server attributes the lesson to this bearer's seat)"
            )
        args = {"text": contribute_text(a.text, a.file), "category": a.category, "app": a.app}
        if a.title:
            args["title"] = a.title
        if a.url:
            args["url"] = a.url
        result = remote_call("recall_contribute", args, write=True)
    elif a.cmd == "stats":
        result = remote_call("recall_stats", {})
    else:
        unsupported = [
            flag
            for flag, bad in (
                ("--source", a.source),
                ("--seat", a.seat),
                ("--since-days", a.since_days),
                ("--per-doc", a.per_doc != 1),
                ("--no-rerank", not a.rerank),
                ("--no-lessons", not a.prefer_lessons),
                ("--full", a.full),
            )
            if bad
        ]
        if unsupported:
            raise FleetRagError(f"{', '.join(unsupported)} has no hosted equivalent in remote mode")
        args = {"query": a.query, "limit": a.limit}
        if a.app:
            args["app"] = a.app
        if a.category:
            args["category"] = a.category
        result = remote_call("recall_search", args)
    if a.json:
        print(
            json.dumps(
                {"structured": result.get("structuredContent"), "content": result.get("content")},
                indent=2,
            )
        )
        return 0
    printed = False
    for part in result.get("content") or []:
        if isinstance(part, dict) and isinstance(part.get("text"), str):
            print(_remote_visible(part["text"]))
            printed = True
    if not printed:
        print(json.dumps(result.get("structuredContent"), indent=2))
    return 0


def normalize_argv(argv: list[str]) -> list[str]:
    """Implicit search: prepend "search" unless some argument before "--" is a subcommand.

    `recall "pm2 dump poisoned" --since-days 90` becomes a search; `recall stats --json`,
    `recall --json stats`, and `recall contribute - --category lesson` are left alone.  A help
    flag anywhere before "--" is also left alone so `recall --help` shows the top-level usage.
    """
    argv = list(argv)
    if not argv:
        return argv
    head = argv[: argv.index("--")] if "--" in argv else argv
    if any(x in SUBCOMMANDS or x in ("-h", "--help") for x in head):
        return argv
    return ["search"] + argv


def main(argv: list[str] | None = None) -> int:
    argv = normalize_argv(list(sys.argv[1:] if argv is None else argv))
    global _ARGV
    _ARGV = argv
    ap = build_parser()
    try:
        a = ap.parse_args(argv)
    except SystemExit as e:
        return 0 if e.code == 0 else 2
    if remote_selected():
        try:
            return remote_main(a)
        except FleetRagError as e:
            print(f"recall: {e}", file=sys.stderr)
            return 2
    handler = {
        "search": cmd_search,
        "stats": cmd_stats,
        "contribute": cmd_contribute,
        "digest": cmd_digest,
        "eval": cmd_eval,
        "doctor": cmd_doctor,
        "ingest": cmd_ingest,
    }[a.cmd]
    try:
        return handler(a)
    except FleetRagError as e:
        print(f"recall: {e}", file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        return 130


# --- seat remote defaults (host helper, optional) ---
_SEAT_HELPER_ANCHOR = "/"


def _seat_defaults(command):
    """Run the host's seat helper when the host has installed one.  The helper picks the declared seat's own
    hosted route and holds no credential.  ABSENT (a missing path component or file) is the optional case:  do
    nothing, the tool behaves as before, whatever the parent modes.  PRESENT but not trustworthy, or failing for any reason other than its
    own SystemExit, is a refusal (exit 3):  a broken or swapped helper never degrades to an un-routed run.
    Trust is checked on file descriptors:  the directory chain is walked from the anchor with no symlink
    followed (each directory owned by root or this user and closed to group/other write), the file is opened
    O_NOFOLLOW|O_NONBLOCK from its parent fd, must be a regular single-link file owned by this user and closed
    to group/other write, and the code that runs is exactly the bytes read from that open descriptor."""
    import errno
    import pwd
    import stat

    uid = os.getuid()
    try:
        folder = os.path.join(pwd.getpwuid(uid).pw_dir, ".config", "fleet-cli")
    except KeyError:
        return
    anchor = os.path.normpath(_SEAT_HELPER_ANCHOR)
    folder = os.path.normpath(folder)
    prefix = anchor if anchor.endswith("/") else anchor + "/"
    if folder != anchor and not folder.startswith(prefix):
        return
    parts = [p for p in folder[len(anchor):].split("/") if p]
    name = "seat-remote-defaults.py"
    fds = []
    code = None
    try:
        try:
            flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
            current = os.open(anchor, flags)
            fds.append(current)
            chain = [current]
            for part in parts:
                current = os.open(part, flags, dir_fd=current)
                fds.append(current)
                chain.append(current)
            fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK, dir_fd=current)
            fds.append(fd)
        except OSError as exc:
            if exc.errno == errno.ENOENT:
                return
            raise
        # The helper is PRESENT:  only now do the parent directories and the file have to be trustworthy.
        for directory in chain:
            info = os.fstat(directory)
            if info.st_uid not in (0, uid) or info.st_mode & 0o022:
                raise PermissionError
        info = os.fstat(fd)
        if (
            not stat.S_ISREG(info.st_mode)
            or info.st_uid != uid
            or info.st_mode & 0o022
            or info.st_nlink != 1
            or not 0 < info.st_size <= 262144
        ):
            raise PermissionError
        data = b""
        while len(data) <= 262144:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            data += chunk
        if len(data) != info.st_size:
            raise PermissionError
        path = os.path.join(folder, name)
        code = compile(data, path, "exec")
    except Exception:
        sys.stderr.write("fleet-cli: the seat helper could not be trusted\n")
        raise SystemExit(3) from None
    finally:
        for fd in fds:
            try:
                os.close(fd)
            except OSError:
                pass
    try:
        exec(code, {"__name__": "__seat_helper__", "__file__": path, "fleet_command": command})
    except SystemExit:
        raise
    except Exception:
        sys.stderr.write("fleet-cli: the seat helper failed\n")
        raise SystemExit(3) from None


# --- end seat remote defaults ---


if __name__ == "__main__":
    _seat_defaults("recall")
    sys.exit(main())
