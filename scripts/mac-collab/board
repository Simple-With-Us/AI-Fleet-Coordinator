#!/usr/bin/env python3
"""board -- fleet findings board CLI (mac-collab).

The one command every agent uses to file, claim, resolve, and discuss work.
Reads MAC_COLLAB_TOKEN itself from ~/.secrets/mac-collab.env (or the env var),
so the token NEVER appears on a command line, in a process list, or in a
transcript.  That is deliberate: it means this command can be allowlisted once
and used without permission prompts or secret-redaction gymnastics.

Usage:
  board list [--app A] [--status S,S] [--severity P0,P1] [--kind K] [--mine WHO]
             [--search TEXT] [--limit N] [--json]
  board show <id>
  board file --title T [--app A] [--severity P0..P4] [--desc D] [--fix F]
             [--by WHO] [--where LOC] [--env Mac|cloud] [--kind K] [--uid U]
  board claim <id> --by WHO [--where LOC] [--env Mac|cloud]
  board status <id> <open|in_progress|completed|deployed|addressed|wontfix|duplicate>
               [--by WHO] [--resolution TEXT]
  board comment <id> --by WHO --text TEXT [--where LOC] [--env Mac|cloud]
  board stats

Examples:
  board list --status open,in_progress --severity P0,P1
  board file --title "Scout drops Senate rows on 502" --app congress-trade \\
             --severity P1 --by GROK-BOT --env cloud
  board claim 3f2a... --by CLAUDE --env Mac --where "~/apps/trading-claude @ claude/fix"
  board comment 3f2a... --by MONET --text "Verified the fix on main." --env Mac
"""
from __future__ import annotations

import argparse
import http.client
import json
import os
import re
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

BASE = os.environ.get("MAC_COLLAB_URL", "http://127.0.0.1:8792")
SECRETS = Path.home() / ".secrets" / "mac-collab.env"

# The board server is single-process Python on a Mac that routinely runs a dozen
# agent lanes building and testing at once.  At load average ~290 (2026-08-20) a
# /findings/stats call took longer than the old hard-coded 15s, so every board
# command died with a raw socket traceback that read like "the board is down"
# when the service was actually fine, just slow.  60s absorbs that; raise
# MAC_COLLAB_TIMEOUT if the box is worse.
TIMEOUT = float(os.environ.get("MAC_COLLAB_TIMEOUT", "60"))


# Any spelling of GROK followed by BUILD signs as GROK (owner 2026-10-10).  A one-line copy of the GROK
# row's `aliasPattern` in fleet-apps.json, because this script is standalone and imports no package;
# scripts/mac-collab/test_seat_alias.py keeps the copy equal.  Every other value is left exactly as typed.
GROK_ALIAS_PATTERN = r"^grok[^a-z0-9]*build[^a-z0-9]*$"
GROK_ALIAS_RE = re.compile(GROK_ALIAS_PATTERN, re.IGNORECASE | re.ASCII)


def canonical_seat(value: str | None) -> str | None:
    """GROK for any GROK-BUILD spelling, otherwise the value unchanged.  Applied to what is WRITTEN (--by).
    `--mine` is a filter and is left as typed, so rows the server stored under GROK-BUILD before the alias
    stay findable with `--mine GROK-BUILD`."""
    if isinstance(value, str) and GROK_ALIAS_RE.match(value.strip()):
        return "GROK"
    return value


AUTH_FAIL_HINT = (
    "Auth rejected.  If MAC_COLLAB_TOKEN was rotated:\n"
    "  1. Unset MAC_COLLAB_TOKEN in this process — file ~/.secrets/mac-collab.env "
    "is canonical (mtime shown below).\n"
    "  2. Restart mac-collab if it still has the old token in process env: "
    "pm2 restart mac-collab --update-env\n"
    "  3. Long-running agents that exported the token at session start need a new shell."
)


def _file_token() -> str:
    if not SECRETS.is_file():
        return ""
    for line in SECRETS.read_text().splitlines():
        s = line.strip()
        if s.startswith("export "):
            s = s[7:]
        if s.startswith("MAC_COLLAB_TOKEN="):
            return s.split("=", 1)[1].strip().strip('"').strip("'")
    return ""


def token() -> str:
    # File wins so a rotation of ~/.secrets/mac-collab.env is visible to the
    # next `board` invocation without restarting this shell.  Env is the
    # fallback for cloud seats that have no file.
    file_tok = _file_token()
    if file_tok:
        return file_tok
    tok = os.environ.get("MAC_COLLAB_TOKEN", "").strip()
    if tok:
        return tok
    sys.exit("board: MAC_COLLAB_TOKEN not found (env or ~/.secrets/mac-collab.env)")


def _secrets_mtime_label() -> str:
    try:
        if SECRETS.is_file():
            return str(int(SECRETS.stat().st_mtime))
    except OSError:
        pass
    return "missing"


def call(method: str, path: str, payload: dict | None = None):
    data = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(
        BASE + path, data=data, method=method,
        headers={"Authorization": "Bearer " + token(), "Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
            return json.loads(r.read().decode())
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8", "replace")[:400]
        extra = ""
        if e.code == 401:
            extra = (
                f"\n{AUTH_FAIL_HINT}\n"
                f"  secrets file mtime={_secrets_mtime_label()}  "
                f"env_set={'yes' if os.environ.get('MAC_COLLAB_TOKEN', '').strip() else 'no'}"
            )
        sys.exit(f"board: HTTP {e.code} on {method} {path}\n{body}{extra}")
    except urllib.error.URLError as e:
        sys.exit(f"board: cannot reach {BASE} ({e.reason}). Is pm2 mac-collab up?")
    # A read timeout raises bare TimeoutError and a mid-response close raises
    # http.client.RemoteDisconnected -- NEITHER is a URLError, so both used to
    # escape as a 20-line traceback.  URLError is itself an OSError subclass, so
    # this broader catch must stay below it.
    except (http.client.HTTPException, OSError) as e:
        sys.exit(
            f"board: no usable response from {BASE} after {TIMEOUT:.0f}s "
            f"({type(e).__name__} on {method} {path}).\n"
            f"  The server is probably up but starved, not down -- check `uptime` first;\n"
            f"  a loaded Mac stretches board calls well past the default.\n"
            f"  Wait longer with MAC_COLLAB_TIMEOUT=180, or check `pm2 logs mac-collab`."
        )


SEV_ORDER = {"P0": 0, "P1": 1, "P2": 2, "P3": 3, "P4": 4}


def fmt_row(f: dict) -> str:
    sev = f.get("severity") or "--"
    who = f.get("addressed_by") or ""
    where = " ".join(x for x in (f.get("env"), f.get("location")) if x)
    bits = [f"{f['id'][:8]}  {sev:<3} {f.get('status',''):<12} {f.get('app','')}"]
    line = "  ".join(b for b in bits if b)
    tail = " ".join(x for x in (f"@{who}" if who else "", where) if x)
    title = (f.get("title") or "").replace("\n", " ")
    if len(title) > 88:
        title = title[:85] + "..."
    return f"{line}\n     {title}" + (f"\n     {tail}" if tail else "")


def main() -> int:
    p = argparse.ArgumentParser(prog="board", add_help=True,
                                description="Fleet findings board (mac-collab).")
    sub = p.add_subparsers(dest="cmd", required=True)

    lp = sub.add_parser("list", help="list/filter items")
    lp.add_argument("--app"); lp.add_argument("--status"); lp.add_argument("--severity")
    lp.add_argument("--kind", dest="source_kind"); lp.add_argument("--search")
    lp.add_argument("--mine", help="only items whose addressed_by matches this seat")
    lp.add_argument("--limit", default="60"); lp.add_argument("--json", action="store_true")

    sp = sub.add_parser("show", help="one item + comments"); sp.add_argument("id")
    sp.add_argument("--json", action="store_true")

    fp = sub.add_parser("file", help="file a new finding/issue")
    fp.add_argument("--title", required=True); fp.add_argument("--app", default="fleet-infra")
    fp.add_argument("--severity"); fp.add_argument("--desc"); fp.add_argument("--fix")
    fp.add_argument("--by", dest="reported_by"); fp.add_argument("--where", dest="location")
    fp.add_argument("--env"); fp.add_argument("--kind", dest="source_kind", default="agent-report")
    fp.add_argument("--uid", dest="external_uid"); fp.add_argument("--url", dest="source_url")

    cp = sub.add_parser("claim", help="mark in_progress and put your name on it")
    cp.add_argument("id"); cp.add_argument("--by", dest="addressed_by", required=True)
    cp.add_argument("--where", dest="location"); cp.add_argument("--env")

    stp = sub.add_parser("status", help="set status")
    stp.add_argument("id"); stp.add_argument("value")
    stp.add_argument("--by", dest="addressed_by"); stp.add_argument("--resolution")

    cmp_ = sub.add_parser("comment", help="comment on an item")
    cmp_.add_argument("id"); cmp_.add_argument("--by", dest="author", required=True)
    cmp_.add_argument("--text", required=True)
    cmp_.add_argument("--where", dest="location"); cmp_.add_argument("--env")

    sub.add_parser("stats", help="aggregate counts")

    a = p.parse_args()
    for dest in ("reported_by", "addressed_by", "author"):   # the --by payload fields;  --mine stays as typed
        if hasattr(a, dest):
            setattr(a, dest, canonical_seat(getattr(a, dest)))

    if a.cmd == "list":
        q = []
        for key, val in (("app", a.app), ("status", a.status), ("severity", a.severity),
                         ("source_kind", a.source_kind), ("search", a.search), ("limit", a.limit)):
            if val:
                q.append(f"{key}={urllib.parse.quote(str(val))}")
        d = call("GET", "/findings" + ("?" + "&".join(q) if q else ""))
        rows = d["findings"]
        if a.mine:
            rows = [f for f in rows if (f.get("addressed_by") or "").upper() == a.mine.upper()]
        if a.json:
            print(json.dumps(rows, indent=2)); return 0
        print(f"{len(rows)} shown of {d.get('total_matching', len(rows))} matching\n")
        for f in rows:
            print(fmt_row(f)); print()
        return 0

    if a.cmd == "show":
        d = call("GET", f"/findings/{a.id}")
        if a.json:
            print(json.dumps(d, indent=2)); return 0
        print(f"{d['severity'] or '--'}  {d['status']}  {d['app']}  ({d.get('source_kind')})")
        print(d["title"]); print()
        for label, key in (("Description", "description"), ("Fix", "recommended_fix"),
                           ("Resolution", "resolution")):
            if d.get(key):
                print(f"--- {label} ---"); print(d[key]); print()
        meta = {k: d.get(k) for k in ("reported_by", "addressed_by", "env", "location",
                                      "repo", "source_url", "created_at", "updated_at")}
        print("--- meta ---")
        for k, v in meta.items():
            if v:
                print(f"  {k}: {v}")
        if d.get("comments"):
            print("\n--- comments ---")
            for c in d["comments"]:
                where = " ".join(x for x in (c.get("env"), c.get("location")) if x)
                print(f"  [{c['created_at'][:16]}] {c['author']}"
                      + (f" ({where})" if where else "") + f": {c['text']}")
        return 0

    if a.cmd == "file":
        payload = {k: v for k, v in {
            "title": a.title, "app": a.app, "severity": a.severity,
            "description": a.desc, "recommended_fix": a.fix,
            "reported_by": a.reported_by, "location": a.location, "env": a.env,
            "source_kind": a.source_kind, "external_uid": a.external_uid,
            "source_url": a.source_url, "source": "filed via board CLI", "status": "open",
        }.items() if v}
        d = call("POST", "/findings", payload)
        print(f"filed {d['id']}  ({d.get('severity') or '--'} {d['app']})")
        return 0

    if a.cmd == "claim":
        payload = {k: v for k, v in {
            "status": "in_progress", "addressed_by": a.addressed_by,
            "location": a.location, "env": a.env,
        }.items() if v}
        d = call("PATCH", f"/findings/{a.id}", payload)
        print(f"claimed {d['id'][:8]} by {d.get('addressed_by')} -> {d['status']}")
        return 0

    if a.cmd == "status":
        payload = {k: v for k, v in {
            "status": a.value, "addressed_by": a.addressed_by, "resolution": a.resolution,
        }.items() if v}
        d = call("PATCH", f"/findings/{a.id}", payload)
        print(f"{d['id'][:8]} -> {d['status']}")
        return 0

    if a.cmd == "comment":
        payload = {k: v for k, v in {
            "author": a.author, "text": a.text, "location": a.location, "env": a.env,
        }.items() if v}
        call("POST", f"/findings/{a.id}/comments", payload)
        print(f"commented on {a.id[:8]} as {a.author}")
        return 0

    if a.cmd == "stats":
        d = call("GET", "/findings/stats")
        print(f"total {d['total']}   open {d['open']}   P0/P1 open {d['p0p1_open']}   done {d['done']}")
        for k, v in sorted(d.get("by_kind", {}).items()):
            print(f"  {k:<16} {v}")
        print("  apps: " + ", ".join(d.get("apps", [])))
        return 0

    return 1


if __name__ == "__main__":
    raise SystemExit(main())
