APP_NAME=socratic-app
# Coolify application uuid (also the running Docker name prefix on the host).
APP_UUID=<COOLIFY_APP_UUID>
# coolify.resourceName label when present; find_app_container also matches name=${APP_UUID}.
RESOURCE_NAME=socratic-app
# /api/live does no DB work (ST-4635).  /api/health was timing out on slow SQLite reads.
INTERNAL_HEALTH_URL=http://127.0.0.1:4000/api/live
HEALTH_URL=https://socratictrade.com/api/health
NOTIFY_TITLE=socratic.trade
# Run guard (ST-4635): defer a due restart while a strategy run is in progress,
# for at most RUN_GUARD_MAX_DEFER_SEC from the first deferral.  Read-only sqlite3.
RUN_GUARD_DB=/var/lib/docker/volumes/<COOLIFY_APP_UUID>-prod-app-data/_data/app.db
RUN_GUARD_MAX_DEFER_SEC=900
