#!/usr/bin/env python3
"""simple-notes: write Apple Notes in the owner's Coding folder.

The verbs are the ones the MCP `notes_*` tools expose (`create`, `update`, `pin`, `unpin`,
`status`), implemented by scripts/agent_sync/notes_cli.py.  This file is symlinked as
~/.local/bin/simple-notes, so it resolves its own real path before it puts the scripts
directory on sys.path.

The body never reaches a command line:  it comes from standard input or --body-file (or --html).

Under launchd or a GUI app, `/usr/bin/env python3` can be the system Python 3.9, which cannot
run this package.  Then the script re-runs itself with a Homebrew python3 when one exists.
This part must stay valid Python 3.9."""
import os
import sys

if sys.version_info < (3, 11):
    for candidate in ("/opt/homebrew/bin/python3", "/usr/local/bin/python3"):
        if os.access(candidate, os.X_OK) and os.path.realpath(candidate) != os.path.realpath(sys.executable):
            os.execv(candidate, [candidate, os.path.realpath(__file__)] + sys.argv[1:])
    sys.stderr.write("simple-notes: Python 3.11 or newer is required (found %d.%d)\n" % sys.version_info[:2])
    sys.exit(1)

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from agent_sync.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:], prog="simple-notes"))