[Unit]
Description=Operator registry to Google Sheets export drain (OPS-1037)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/operator-sheets/drain.env
ExecStart=/usr/bin/node /usr/local/lib/operator-sheets-drain/operator_sheets_drain.mjs --once
# A full backfill pass set takes minutes, not seconds; the timer's next run
# simply finds the writer lease held and exits if one ever overruns.
TimeoutStartSec=1800
Nice=10

[Install]
WantedBy=multi-user.target
