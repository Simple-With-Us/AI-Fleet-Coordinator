#!/usr/bin/env python3
"""A stand-in for ~/.local/bin/fleet-secrets in subprocess tests (AFC-359).  Reads FAKE_FLEET_SECRETS_FILE, a
JSON object {"/folder": {"NAME": "value"}}, and implements `names`, `get` and `run --only` with the real
command's exit codes (3 for an absent key).  Never reaches Infisical."""
import json
import os
import sys


def main(argv):
    try:
        with open(os.environ["FAKE_FLEET_SECRETS_FILE"], encoding="utf-8") as fh:
            data = json.load(fh)
    except (KeyError, OSError, ValueError):
        sys.stderr.write("fake fleet-secrets: no FAKE_FLEET_SECRETS_FILE\n")
        return 4
    if not argv:
        return 2
    command, rest = argv[0], argv[1:]
    tail = []
    if "--" in rest:
        split = rest.index("--")
        rest, tail = rest[:split], rest[split + 1:]
    opts, args, i = {"--path": "/", "--only": None}, [], 0
    while i < len(rest):
        if rest[i] in opts:
            opts[rest[i]] = rest[i + 1]
            i += 2
        else:
            args.append(rest[i])
            i += 1
    folder = data.get(opts["--path"], {})
    if command == "names":
        sys.stdout.write("".join(name + "\n" for name in sorted(folder)))
        return 0
    if command == "get":
        if args[0] not in folder:
            return 3
        sys.stdout.write(folder[args[0]])
        return 0
    if command == "run":
        only = [n for n in (opts["--only"] or "").split(",") if n] or sorted(folder)
        if any(n not in folder for n in only):
            return 3
        env = dict(os.environ)
        env.update({n: folder[n] for n in only})
        os.execvpe(tail[0], tail, env)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
