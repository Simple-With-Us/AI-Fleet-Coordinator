# The wake router for every platform (OPS-1048;  owner ruling, Nov 11, 2026:  "the router is
# supposed to be for every platform").  One process on loopback port 8794 serves every seat
# registered in simple_tools/wake_service.py (BUILDERS):  the listener's http wake for a seat posts
# to http://127.0.0.1:8794/wake/<SEAT>, and each seat has its own router, queue, workers and
# receipts under its own state folder.  /health reports every seat;  a seat whose module is not
# installed yet shows as not-installed and does not fail it.
#
# A systemd --user unit:  everything runs as the jay user, never root (owner ruling).  Template
# only:  nothing installs it.  To use it, install the checkout first (the fleet-cli current link
# moves on every release, and this unit resolves it at start), copy this file to
# ~/.config/systemd/user/afc-wake-router.service, then `systemctl --user daemon-reload` and
# `systemctl --user enable --now afc-wake-router.service`.  The user manager must outlive a login
# session for it to keep running (lingering on for jay).
#
# The environment file ~/.config/afc-wake-router/env (mode 0600) holds only
# FLEET_KNOBS_INFISICAL_TOKEN:  the Infisical service token afc-wake-router-ro, read-only and
# scoped to prod:/wake-router (AI Fleet Coordinator) and nothing else.  Every setting is a knob in
# that folder, and so are the secrets:  the one bearer WAKE_ROUTER_KEY that every seat's path is
# checked against (at least 16 characters), and the registry's address and signing key
# (WAKE_ROUTER_REGISTRY_URL and WAKE_ROUTER_REGISTRY_KEY).  No env file or ssh remote supplies the
# registry:  with either value missing every pick is a bounded retry and /health says
# registry-not-configured.  There is no key file:  the secrets are read at start and on every
# refresh and held in memory only.  A failed refresh keeps them;  only a fetch that worked changes
# them, so a revocation lands at the next refresh.  While the router holds no bearer, every seat
# refuses its requests with 503 and /health says why.  Delivery is switched by
# WAKE_ROUTER_DELIVERY_ENABLED and WAKE_ROUTER_DELIVERY_SEATS (it runs for a seat only when the
# first is true and the second names it).  Until then every wake is picked, receipted and held.
# The one local file ~/.local/state/wake-router/config.json can only narrow them, for every seat.
# SIGHUP (`systemctl --user reload afc-wake-router.service`) reads the knobs again at once.
[Unit]
Description=AFC wake router: the listener's wake webhook for every platform (OPS-1048)

[Service]
Type=simple
EnvironmentFile=-%h/.config/afc-wake-router/env
ExecStart=/usr/bin/python3 -I %h/.local/share/fleet-cli/current/scripts/simple-chat wake-router serve --bind 127.0.0.1 --port 8794
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10
# SIGTERM goes only to the router, which stops new work and waits up to shutdown_wait_seconds
# (1000) for running deliveries in every seat:  a resume (900) or a Mac delivery (974).  With the
# default KillMode the same SIGTERM would reach the `claude` and `ssh` children and end the very
# turns it is waiting for.  TimeoutStopSec is longer than that wait, so systemd never cuts it short.
KillMode=mixed
TimeoutStopSec=1030
Nice=5

[Install]
WantedBy=default.target
