# The ZCode wake bridge (OPS-1048):  the webhook the Operator's http wake reaches, and the
# deliverer that turns one wake into a prompt in a specific ZCode session.  Template:  copy to
# /etc/systemd/system/afc-zc-wake-bridge.service, `systemctl daemon-reload`, `systemctl enable
# --now afc-zc-wake-bridge.service`.  Install the checkout first (the fleet-cli current link
# moves on every release, and this unit resolves it at start), mint the routine key into
# Fleet-OPS /zulip as ZC_ROUTINE_KEY, and put the same value in the 0600 file below -- that
# file is the one secret here, and a key shorter than 16 characters or a group-readable one
# refuses every wake with 503.  Bind the tailnet address only:  the Mac listener reaches this
# host over Tailscale, and the public interface must never see a wake.  `ZC_WAKE_DELIVERY`
# The environment file carries ZC_WAKE_BIND (the tailnet address).  While the headless
# ZCode provider question is open (the desktop provider order's first entry holds a dead
# key on this server today), the state config (~/.local/state/zc-wake/config.json) carries
# delivery_enabled false and every accepted wake is logged undelivered instead of run.
[Unit]
Description=ZC wake bridge: the Operator's wake webhook for the ZCode seat (OPS-1048)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jay
Group=jay
Environment=HOME=/home/jay
# The shared registry env file is sourced first, exactly as the letter hooks source it:  the
# bridge signs its registry reads as the OPERATOR principal with the URL and key it exports.
ExecStart=/bin/sh -c '. "$HOME/.local/bin/operator-registry-env" 2>/dev/null; exec /usr/bin/python3 -I /home/jay/.local/share/fleet-cli/current/scripts/zc-wake-bridge serve --bind "${ZC_WAKE_BIND:-127.0.0.1}" --port 8791'
EnvironmentFile=-/etc/zc-wake-bridge.env
Restart=always
RestartSec=10
Nice=5

[Install]
WantedBy=multi-user.target
