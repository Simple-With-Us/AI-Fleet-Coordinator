# The TLS front for the one wake router (OPS-1048, AFC-694).  The router listens on loopback only
# (afc-wake-router.service, 127.0.0.1:8794) and speaks plain http, and the Eavesdropper refuses
# plain http to any address that is not loopback.  This front is the router's only door from the
# tailnet:  socat terminates TLS on the server's tailnet address, port 8795, and passes each
# connection to the router on loopback.  It is modelled on zc-wake-tls.service, which already runs
# socat this way as the jay user.
#
# A systemd --user unit:  everything runs as the jay user, never root (owner ruling, Nov 11, 2026).
# Template only:  install-wake-router.sh renders it into ~/.config/systemd/user/, filling in the
# tailnet address, the socat path and the router's loopback address and port.  The certificate
# and key it serves are the installer's copies under ~/.local/state/afc-wake-router/tls/ (key
# mode 0600).  The tailnet certificate expires Jan 21, 2027 at 9:05pm;  who renews it, and whether
# `tailscale cert` can run as jay, is not verified yet (docs/operator-wake-canary.md).
[Unit]
Description=AFC wake router TLS front: the tailnet door to the loopback router (OPS-1048)
Wants=afc-wake-router.service
After=afc-wake-router.service

[Service]
Type=simple
ExecStart=@SOCAT@ OPENSSL-LISTEN:@FRONT_PORT@,bind=@TAILNET_ADDR@,reuseaddr,fork,max-children=32,openssl-min-proto-version=TLS1.2,cert=%h/.local/state/afc-wake-router/tls/cert.pem,key=%h/.local/state/afc-wake-router/tls/key.pem,verify=0 TCP:@ROUTER_ADDR@:@ROUTER_PORT@
Restart=always
RestartSec=10
Nice=5

[Install]
WantedBy=default.target
