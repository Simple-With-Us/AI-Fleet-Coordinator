{
  "schemaVersion": 1,
  "about": "Registry for ios_testflight_freshness.mjs.  One row per App Store Connect record that ships through TestFlight.  appleId is the key that never goes stale (bundle ids were renamed for Socratic Trade, BotFleet and Usage Monitor).  paths is the native tree: a main commit touching any of them should reach TestFlight.  ship.workflow is the app's own ship workflow; ship.inputs are the workflow_dispatch inputs a catch-up ship needs;  ship.enabledVar names a repo variable that must be \"true\" for the ship job to upload; autoRemedy false means the check reports the gap but never dispatches;  an app with autoRemedy on must name a compileCheck.  inflightMaxHours is when a queued or running ship run counts as stuck;  remedyLandHours is how long a catch-up gets before an alert may say it did not land.  compileCheck is the exact check-run name of the iOS compile on main (a trailing * is a prefix match).  skip is a reason the app is listed but not checked.",
  "owner": "Simple-With-Us",
  "rateGateHours": 2.5,
  "staleAlertHours": 6,
  "inflightMaxHours": 3,
  "remedyLandHours": 3,
  "apps": {
    "socratic": {
      "displayName": "Socratic Trade",
      "appleId": "6815511597",
      "bundleId": "com.socratictrade.ios",
      "platform": "IOS",
      "repo": "Socratic-Trade",
      "paths": ["ios"],
      "ship": { "workflow": "ios-ship.yml", "inputs": {} },
      "sourceWorkflows": ["ios-ship.yml"],
      "compileCheck": "verify-ios / xcodebuild (unsigned)",
      "autoRemedy": true
    },
    "congress": {
      "displayName": "Congress.Trade",
      "appleId": "6798076688",
      "bundleId": "trade.congress.ios",
      "platform": "IOS",
      "repo": "Congress.Trade",
      "paths": ["clients/ios"],
      "ship": { "workflow": "ios-ship.yml", "inputs": {} },
      "sourceWorkflows": ["ios-ship.yml", "ios-appstore-gm.yml"],
      "compileCheck": "xcodebuild (unsigned)",
      "autoRemedy": true
    },
    "usage": {
      "displayName": "Usage Monitor Client",
      "appleId": "6820881005",
      "bundleId": "com.simplewithus.usage.client.ios",
      "platform": "IOS",
      "repo": "Usage-Monitor",
      "paths": ["ios"],
      "ship": { "workflow": "ios-ship.yml", "inputs": {} },
      "sourceWorkflows": ["ios-ship.yml", "ios-appstore-gm.yml"],
      "compileCheck": "xcodebuild (unsigned)",
      "autoRemedy": true
    },
    "usage-local": {
      "displayName": "Usage Monitor Local",
      "appleId": "6820885210",
      "bundleId": "com.simplewithus.usage.local.ios",
      "platform": "IOS",
      "repo": "Usage-Monitor",
      "paths": ["ios"],
      "ship": { "workflow": "ios-ship.yml", "inputs": {} },
      "sourceWorkflows": ["ios-ship.yml", "ios-appstore-gm.yml"],
      "compileCheck": "xcodebuild (unsigned)",
      "autoRemedy": true
    },
    "dealdex": {
      "displayName": "DealDex",
      "appleId": "6804249232",
      "bundleId": "net.dealdex",
      "platform": "IOS",
      "repo": "DealDex",
      "paths": ["native/ios"],
      "ship": { "workflow": "ios-ship.yml", "inputs": {} },
      "sourceWorkflows": ["ios-ship.yml"],
      "compileCheck": null,
      "autoRemedy": false,
      "manualReason": "no iOS compile check runs on DealDex main (ci.yml builds the web app only), and a catch-up needs a green one;  add an iOS compile job, name it here, and set autoRemedy true"
    },
    "contactlogo": {
      "displayName": "ContactLogo",
      "appleId": "6804247582",
      "bundleId": "com.contactlogo",
      "platform": "IOS",
      "repo": "ContactLogo",
      "paths": ["Apps/ContactLogoiOS", "Sources/ContactLogoKit", "project.yml"],
      "ship": { "workflow": "ios-testflight.yml", "inputs": {} },
      "sourceWorkflows": ["ios-testflight.yml"],
      "compileCheck": "apple (ContactLogoiOS*",
      "autoRemedy": true
    },
    "contactlogo-mac": {
      "displayName": "ContactLogo for Mac",
      "appleId": "6804248235",
      "bundleId": "com.contactlogo.macos",
      "platform": "MAC_OS",
      "repo": "ContactLogo",
      "paths": ["Apps/ContactLogoMac", "Sources", "project.yml"],
      "skip": "the Mac app ships through Sparkle GitHub releases (mac-release.yml), not TestFlight"
    },
    "botfleet": {
      "displayName": "BotFleet",
      "appleId": "6820175685",
      "bundleId": "app.botfleet.ios",
      "platform": "IOS",
      "repo": "BotFleet",
      "paths": ["ios"],
      "ship": { "workflow": "ios-ship.yml", "inputs": {} },
      "sourceWorkflows": ["ios-ship.yml"],
      "compileCheck": "Swift tests + iOS build",
      "autoRemedy": true
    },
    "botfleet-mac": {
      "displayName": "BotFleet for Mac",
      "appleId": "6806385361",
      "bundleId": "app.botfleet.macos",
      "platform": "MAC_OS",
      "repo": "BotFleet",
      "paths": ["ios"],
      "skip": "no TestFlight builds; the Mac app ships through GitHub releases (latest-mac.yml)"
    },
    "clutch": {
      "displayName": "Clutch.Codes",
      "appleId": "6817951255",
      "bundleId": "codes.clutch.ios",
      "platform": "IOS",
      "repo": "Clutch",
      "paths": ["ios", "assets/clutch-icon-1024.png"],
      "ship": { "workflow": "ios-ship.yml", "inputs": {} },
      "sourceWorkflows": ["ios-ship.yml"],
      "compileCheck": "iOS Build (Simulator)",
      "autoRemedy": true
    },
    "codecaps": {
      "displayName": "CodeCaps",
      "appleId": "6814623846",
      "bundleId": "com.simplewithus.codecaps.ios",
      "platform": "IOS",
      "repo": "CodeCaps",
      "paths": ["ios/CodeCapsCompanion"],
      "ship": { "workflow": "ios-ship.yml", "inputs": {} },
      "sourceWorkflows": ["ios-ship.yml"],
      "compileCheck": "iOS companion compile",
      "autoRemedy": true
    },
    "codecaps-mac": {
      "displayName": "CodeCaps for Mac",
      "appleId": "6814951477",
      "bundleId": "com.simplewithus.codecaps.macos",
      "platform": "MAC_OS",
      "repo": "CodeCaps",
      "paths": ["ios/CodeCapsCompanion"],
      "ship": { "workflow": "macos-ship.yml", "inputs": {} },
      "sourceWorkflows": ["macos-ship.yml"],
      "compileCheck": null,
      "autoRemedy": false,
      "manualReason": "macos-ship.yml is manual only by design (workflow_dispatch, no push trigger)"
    },
    "hoghunter": {
      "displayName": "Hog Hunter",
      "appleId": "6816633156",
      "bundleId": "com.simplewithus.hoghunter.ios",
      "platform": "IOS",
      "repo": "HogHunter",
      "paths": ["ios", "project.yml", "Assets.xcassets"],
      "ship": { "workflow": "ios-testflight.yml", "inputs": { "upload": "true" }, "enabledVar": "HH_IOS_TESTFLIGHT_ENABLED" },
      "sourceWorkflows": ["ios-testflight.yml"],
      "compileCheck": "test",
      "autoRemedy": true
    },
    "fleetlink": {
      "displayName": "FleetLink",
      "appleId": "6818901017",
      "bundleId": "online.fleetlink.ios",
      "platform": "IOS",
      "repo": "FleetLink",
      "paths": ["ios"],
      "ship": { "workflow": "ios-testflight.yml", "inputs": {} },
      "sourceWorkflows": ["ios-testflight.yml"],
      "compileCheck": "ios-build",
      "autoRemedy": true
    }
  }
}
