{
  // Fleet admin panel — deployed to https://admin.jays.services on the
  // Usage.Jays.Services Cloudflare account (zone jays.services).
  // Deploy with `wrangler deploy` from this directory.  Secrets are set with
  // `wrangler secret put NAME` — see README.md for the full list.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "admin-jays-services",
  "main": "src/index.js",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Only the custom domain, which sits behind Cloudflare Access.  No workers.dev or preview URL that would skip it.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "admin.jays.services",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "GITHUB_OWNER": "jaywedgeworth22",
    "SENTRY_ORG": "simple-with-us",
    "DD_SITE": "us5.datadoghq.com",
    "RECALL_BASE": "https://recall.jays.services",
    "BOARD_BASE": "https://mac.jays.services",
    "COOLIFY_BASE": "https://host.jays.services"
  }
}
