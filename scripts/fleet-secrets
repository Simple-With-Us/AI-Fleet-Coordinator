#!/usr/bin/env -S python3 -I
"""fleet-secrets entry point.  Resolves its own real path, so a symlink in ~/.local/bin works and
the fleet_secrets package is the one sitting next to the real file.  See INFISICAL.md."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from fleet_secrets.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
