{
  "name": "agent-sync-mcp",
  "version": "2.0.0-phase2",
  "private": true,
  "description": "Hosted agent-sync MCP server for cloud seats: OAuth 2.1, arming and consent, and the seven agent-sync tools, each seat posting as its own Zulip bot.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:workerd": "node test/integration.workerd.mjs",
    "bundle": "wrangler deploy --dry-run --outdir dist",
    "deploy": "echo 'Deploy by hand from DEPLOY.md, never from CI or on merge.' && exit 1"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@modelcontextprotocol/server": "2.3.1",
    "agents": "0.28.1",
    "graphql": "17.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "standardwebhooks": "1.1.1",
    "wrangler": "4.150.0"
  },
  "overrides": {
    "agents": {
      "@modelcontextprotocol/client": "$@modelcontextprotocol/client",
      "@modelcontextprotocol/sdk": "$@modelcontextprotocol/sdk",
      "@modelcontextprotocol/server": "$@modelcontextprotocol/server"
    }
  }
}
