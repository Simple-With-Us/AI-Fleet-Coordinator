{
  "//": "The reviewed git-relay seat policy (README, Policy).  seat_policy.py renders it into GIT_RELAY_SEATS_JSON and installs it on the relay host.  Every seat signs in with its own admin-minted ST-MCP bearer (auth shared) and acts as its own GitHub App, so no entry holds a token.  The App slug of each identity is the swu- App whose GitHub description names that seat;  three are not swu-<identity>:  MA is swu-rob, GROK is swu-grok-build, MM is swu-minimax.  JET-CHAT is absent:  it is a second login on Jet's bot, and one bot has one App (Q7).",
  "profiles": {
    "fleet": {
      "actions": [
        "open_pr",
        "edit_pr",
        "reply_thread",
        "comment_pr",
        "merge_pr",
        "workflow_dispatch",
        "resolve_thread",
        "wf_review_submit",
        "wf_review_inline",
        "wf_branch_create",
        "wf_pr_list",
        "wf_pr_files",
        "wf_file_get",
        "wf_tree",
        "wf_branches",
        "wf_commits",
        "wf_code_search",
        "wf_runs",
        "wf_run_jobs",
        "wf_checks",
        "wf_update_branch",
        "wf_run_rerun",
        "wf_run_cancel",
        "wf_run_approve",
        "wf_file_put",
        "wf_files_put",
        "wf_merge_guarded"
      ],
      "mint_permissions": {
        "actions": "write",
        "checks": "read",
        "contents": "write",
        "issues": "write",
        "metadata": "read",
        "pull_requests": "write"
      },
      "repos": [
        "Simple-With-Us/AI-Fleet-Coordinator",
