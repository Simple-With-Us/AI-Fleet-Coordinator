{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "minimumReleaseAge": "5 days",
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "non-major dependencies",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major"]
    },
    {
      "description": "The hosted agent-sync MCP Worker holds bot keys and runs its own OAuth server:  the fleet's two-week rule, and no automerge, because its path-filtered workerd check is not required and Renovate merged package.json bumps here without a matching lockfile (#408).",
      "matchFileNames": ["scripts/agent-sync-mcp/**"],
      "minimumReleaseAge": "14 days",
      "automerge": false,
      "labels": ["dependencies", "agent-sync-mcp"]
    }
  ],
  "vulnerabilityAlerts": { "labels": ["security"], "minimumReleaseAge": null }
}
